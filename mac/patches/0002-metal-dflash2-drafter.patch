diff --git a/zig/src/families/inkling2/metal/dflash2.zig b/zig/src/families/inkling2/metal/dflash2.zig
new file mode 100644
index 000000000..66d1b5d9f
--- /dev/null
+++ b/zig/src/families/inkling2/metal/dflash2.zig
@@ -0,0 +1,441 @@
+//! Inkling 2 Mini DFlash 2 drafter on Metal: five Qwen3+conv layers, sliding 2048 context rings, top-16 path selector.
+const std = @import("std");
+const mtl = @import("metal");
+const lanes = @import("lanes");
+const sys = @import("sys");
+const ck = @import("../../../core/checkpoint_metal.zig");
+const Model = @import("model.zig").Model;
+const fwd = @import("forward.zig");
+const w = @import("dflash2_weights.zig");
+const k = @import("dflash2_kernels.zig");
+
+const dr = lanes.drafter;
+const Stream = lanes.Stream;
+const Ref = k.Ref;
+const tap_list = [_]u32{ 5, 23, 41, 48 };
+const draft_prior = [_]f64{ 0.85, 0.80, 0.75, 0.70, 0.65, 0.60, 0.55 };
+const absorb_rows: usize = 256;
+const max_chunks: usize = (w.window_size + w.block_size + 127) / 128;
+
+fn at(buf: mtl.Buffer, off: usize) Ref {
+    return .{ .buf = buf, .off = off };
+}
+fn r(t: ck.Tensor) Ref {
+    return .{ .buf = t.buffer, .off = t.offset };
+}
+
+fn now() f64 {
+    var ts: sys.c.timespec = undefined;
+    _ = sys.c.clock_gettime(sys.c.CLOCK.MONOTONIC, &ts);
+    return @as(f64, @floatFromInt(ts.sec)) * 1000.0 + @as(f64, @floatFromInt(ts.nsec)) * 1e-6;
+}
+
+fn failed(cb: mtl.CommandBuffer, what: []const u8) !void {
+    cb.wait();
+    if (cb.failure()) |msg| {
+        std.log.err("inkling2_loop DFlash2 {s}: {s}", .{ what, msg });
+        return error.GpuFailed;
+    }
+}
+
+const scratch_fields = [_][]const u8{
+    "ids",  "resid", "x",  "xc",   "dyn", "q_raw", "k_raw",  "v_raw", "q",    "kb",  "vb",  "part",
+    "attn", "y",     "yc", "gate", "up",  "act",   "logits", "hid",   "tval", "tid", "seq", "fcx",
+    "hctx", "ck",    "cv",
+};
+
+fn scratchSizes() [scratch_fields.len]usize {
+    const n = w.block_size;
+    const d = n - 1;
+    const a = absorb_rows;
+    const bf = 2;
+    return .{
+        n * 4,
+        n * w.hidden * 4,
+        n * w.hidden * bf,
+        n * w.hidden * bf,
+        n * w.dyn_width * bf,
+        n * w.query_width * bf,
+        n * w.kv_width * bf,
+        n * w.kv_width * bf,
+        n * w.query_width * bf,
+        n * w.kv_width * bf,
+        n * w.kv_width * bf,
+        n * w.q_heads * max_chunks * 132 * 4,
+        n * w.query_width * bf,
+        n * w.hidden * bf,
+        n * w.hidden * bf,
+        n * w.intermediate * bf,
+        n * w.intermediate * bf,
+        n * w.intermediate * bf,
+        d * w.padded_vocab * bf,
+        d * w.rank * bf,
+        d * w.top_k * 4,
+        d * w.top_k * 4,
+        n * 4,
+        a * w.hidden * bf,
+        a * w.hidden * bf,
+        a * w.kv_width * bf,
+        a * w.kv_width * bf,
+    };
+}
+
+pub fn scratchBytes() u64 {
+    var total: u64 = 0;
+    for (scratchSizes()) |s| total += s;
+    return total;
+}
+
+pub fn streamBytes() u64 {
+    return @as(u64, w.layers_n) * 2 * w.ring_size * w.kv_width * 2;
+}
+
+const Scratch = struct {
+    ids: mtl.Buffer,
+    resid: mtl.Buffer,
+    x: mtl.Buffer,
+    xc: mtl.Buffer,
+    dyn: mtl.Buffer,
+    q_raw: mtl.Buffer,
+    k_raw: mtl.Buffer,
+    v_raw: mtl.Buffer,
+    q: mtl.Buffer,
+    kb: mtl.Buffer,
+    vb: mtl.Buffer,
+    part: mtl.Buffer,
+    attn: mtl.Buffer,
+    y: mtl.Buffer,
+    yc: mtl.Buffer,
+    gate: mtl.Buffer,
+    up: mtl.Buffer,
+    act: mtl.Buffer,
+    logits: mtl.Buffer,
+    hid: mtl.Buffer,
+    tval: mtl.Buffer,
+    tid: mtl.Buffer,
+    seq: mtl.Buffer,
+    fcx: mtl.Buffer,
+    hctx: mtl.Buffer,
+    ck: mtl.Buffer,
+    cv: mtl.Buffer,
+
+    fn init(device: mtl.Device) !Scratch {
+        @setEvalBranchQuota(10_000);
+        const ns = scratchSizes();
+        var s: Scratch = undefined;
+        var made: usize = 0;
+        errdefer inline for (scratch_fields, 0..) |f, i| if (i < made) @field(s, f).deinit();
+        inline for (scratch_fields, 0..) |f, i| {
+            @field(s, f) = try device.buffer(@max(ns[i], 16), mtl.ResourceOptions.shared);
+            made += 1;
+        }
+        return s;
+    }
+
+    fn deinit(s: *Scratch) void {
+        inline for (scratch_fields) |f| @field(s, f).deinit();
+        s.* = undefined;
+    }
+};
+
+const Lane = struct {
+    k: [w.layers_n]mtl.Buffer,
+    v: [w.layers_n]mtl.Buffer,
+    from: u64 = 0,
+    end: u64 = 0,
+    held: [w.block_size - 1]u32 = @splat(0),
+    held_len: u32 = 0,
+
+    fn init(device: mtl.Device) !Lane {
+        var l: Lane = .{ .k = undefined, .v = undefined };
+        const bytes = w.ring_size * w.kv_width * 2;
+        var made: usize = 0;
+        errdefer for (0..made) |i| {
+            l.k[i].deinit();
+            l.v[i].deinit();
+        };
+        for (0..w.layers_n) |i| {
+            l.k[i] = try device.buffer(bytes, mtl.ResourceOptions.private);
+            l.v[i] = device.buffer(bytes, mtl.ResourceOptions.private) catch |err| {
+                l.k[i].deinit();
+                return err;
+            };
+            made += 1;
+        }
+        return l;
+    }
+
+    fn deinit(l: *Lane) void {
+        for (0..w.layers_n) |i| {
+            l.k[i].deinit();
+            l.v[i].deinit();
+        }
+        l.* = undefined;
+    }
+};
+
+pub const Drafter = struct {
+    gpa: std.mem.Allocator,
+    target: *const Model,
+    loaded: w.Loaded,
+    pipelines: k.Pipelines,
+    scratch: Scratch,
+    contexts: std.AutoHashMapUnmanaged(*Stream, Lane) = .empty,
+    pending: ?mtl.CommandBuffer = null,
+    step_ms: f64 = 0,
+    use_embed_norm: bool = true,
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, device: mtl.Device, target: *const Model, drafter_dir: []const u8) !*Drafter {
+        const pool = mtl.objc.Pool.push();
+        defer pool.pop();
+        const d = try gpa.create(Drafter);
+        errdefer gpa.destroy(d);
+        d.* = .{
+            .gpa = gpa,
+            .target = target,
+            .loaded = try w.load(gpa, io, target, drafter_dir),
+            .pipelines = undefined,
+            .scratch = undefined,
+        };
+        errdefer d.loaded.deinit();
+        d.pipelines = try k.Pipelines.load(device);
+        errdefer d.pipelines.deinit();
+        d.scratch = try Scratch.init(device);
+        errdefer d.scratch.deinit();
+        try d.warm();
+        std.log.info("inkling2_loop DFlash2: loaded {s} (block={d}, top_k={d}, block_ms={d:.2})", .{
+            drafter_dir, d.loaded.config.block, d.loaded.config.top_k, d.step_ms * 7.0,
+        });
+        return d;
+    }
+
+    pub fn deinit(d: *Drafter) void {
+        d.settle() catch {};
+        var it = d.contexts.valueIterator();
+        while (it.next()) |lane| lane.deinit();
+        d.contexts.deinit(d.gpa);
+        d.scratch.deinit();
+        d.pipelines.deinit();
+        d.loaded.deinit();
+        d.gpa.destroy(d);
+    }
+
+    pub fn fixedBytes(d: *const Drafter) u64 {
+        return d.loaded.fixedBytes() + scratchBytes();
+    }
+
+    pub fn drafter(d: *Drafter) dr.Drafter {
+        return .{ .kind = "DFlash2", .ptr = d, .vtable = &.{ .taps = tapsFn, .facts = factsFn, .open = openFn, .absorb = absorbFn, .hold = holdFn, .held = heldFn, .release = releaseFn } };
+    }
+
+    fn cast(ptr: *anyopaque) *Drafter {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn tapsFn(_: *anyopaque) []const u32 {
+        return &tap_list;
+    }
+
+    fn factsFn(ptr: *anyopaque) dr.Facts {
+        const d = cast(ptr);
+        return .{ .fixed_block = true, .depth = w.block_size - 1, .step_ms = d.step_ms, .prior = &draft_prior, .plain_guard = false, .stream_bytes = @intCast(streamBytes()) };
+    }
+
+    fn settle(d: *Drafter) !void {
+        const cb = d.pending orelse return;
+        d.pending = null;
+        defer cb.release();
+        try failed(cb, "absorb");
+    }
+
+    fn openFn(ptr: *anyopaque, stream: *Stream) anyerror!void {
+        const d = cast(ptr);
+        if (d.contexts.contains(stream)) return error.DraftStreamOpen;
+        var lane = try Lane.init(d.target.device);
+        errdefer lane.deinit();
+        try d.contexts.put(d.gpa, stream, lane);
+    }
+
+    fn releaseFn(ptr: *anyopaque, stream: *Stream) void {
+        const d = cast(ptr);
+        d.settle() catch {};
+        if (d.contexts.fetchRemove(stream)) |entry| {
+            var lane = entry.value;
+            lane.deinit();
+        }
+    }
+
+    fn heldFn(ptr: *anyopaque, streams: []const *Stream, out: []const []u32) anyerror!void {
+        const d = cast(ptr);
+        for (streams, out) |stream, tokens| {
+            const lane = d.contexts.getPtr(stream) orelse return error.DraftStreamUnknown;
+            if (tokens.len > lane.held_len) return error.DraftHeldFewer;
+            @memcpy(tokens, lane.held[0..tokens.len]);
+        }
+    }
+
+    fn absorbRows(d: *Drafter, e: mtl.ComputeEncoder, lane: *const Lane, taps: Ref, start: u64, rows: usize) void {
+        const c = &d.loaded.config;
+        const s = &d.scratch;
+        fwd.dense(d.target, e, d.loaded.weights.fc, taps, at(s.fcx, 0), rows);
+        k.norm16(&d.pipelines, e, at(s.fcx, 0), r(d.loaded.weights.hidden_norm), at(s.hctx, 0), .{ .rows = @intCast(rows), .width = c.hidden, .eps = c.eps, .add = 0 });
+        for (d.loaded.weights.layers, 0..) |layer, i| {
+            fwd.dense(d.target, e, layer.k_proj, at(s.hctx, 0), at(s.ck, 0), rows);
+            fwd.dense(d.target, e, layer.v_proj, at(s.hctx, 0), at(s.cv, 0), rows);
+            k.ctxKv(&d.pipelines, e, at(s.ck, 0), at(s.cv, 0), r(layer.k_norm), at(lane.k[i], 0), at(lane.v[i], 0), .{
+                .rows = @intCast(rows),
+                .pos0 = @intCast(start),
+                .ring = @intCast(w.ring_size),
+                .eps = c.eps,
+                .theta = c.theta,
+            });
+        }
+    }
+
+    fn absorbFn(ptr: *anyopaque, items: []const dr.Absorb) anyerror!void {
+        const d = cast(ptr);
+        try d.settle();
+        if (items.len == 0) return;
+        const pool = mtl.objc.Pool.push();
+        defer pool.pop();
+        const cb = d.target.queue.commandBuffer();
+        const e = cb.compute(.serial);
+        const row_bytes = w.taps_n * w.hidden * 2;
+        const keep_window: u64 = w.window_size + w.block_size;
+        for (items) |item| {
+            const lane = d.contexts.getPtr(item.stream) orelse return error.DraftStreamUnknown;
+            const features = item.features;
+            if (features.space != .device or features.dtype != .bf16 or features.row_bytes != row_bytes) return error.DraftFeaturesUnsupported;
+            if (item.rows != null) return error.TreesNotBuilt;
+            if (features.rows == 0 or features.rows > 1048576) return error.DraftFeaturesUnsupported;
+            if (item.start < lane.end) return error.DraftContextGap;
+            if (item.start > lane.end) lane.from = item.start;
+            const end = item.start + features.rows;
+            const keep_from = if (item.prompt) @max(item.start, item.stream.prompt_len -| keep_window) else item.start;
+            if (keep_from > lane.from and keep_from > lane.end) lane.from = keep_from;
+            const source = mtl.Buffer{ .id = @ptrFromInt(features.buffer) };
+            var position = keep_from;
+            while (position < end) {
+                const rows: usize = @intCast(@min(absorb_rows, end - position));
+                const offset = features.offset + @as(usize, @intCast(position - item.start)) * row_bytes;
+                d.absorbRows(e, lane, at(source, offset), position, rows);
+                position += rows;
+            }
+            lane.end = end;
+            lane.held_len = 0;
+        }
+        e.end();
+        cb.commit();
+        d.pending = cb.retain();
+    }
+
+    fn encodeBlock(d: *Drafter, e: mtl.ComputeEncoder, lane: *const Lane, pending: u32, anchor: u64) void {
+        const c = &d.loaded.config;
+        const s = &d.scratch;
+        const n = w.block_size;
+        const ids = s.ids.slice(u32, n);
+        ids[0] = pending;
+        for (1..n) |j| ids[j] = c.mask;
+        s.seq.slice(u32, n)[0] = pending;
+        k.embed(&d.pipelines, e, at(s.ids, 0), r(d.target.weights.embed), r(d.target.weights.embed_norm), at(s.resid, 0), .{
+            .rows = n,
+            .width = c.hidden,
+            .use_norm = @intFromBool(d.use_embed_norm),
+            .eps = c.eps,
+        });
+        const lo = @max(lane.from, (anchor + 1) -| c.window);
+        const retained: u32 = @intCast(anchor - lo);
+        const keys: u32 = retained + @as(u32, n);
+        const chunks: u32 = (keys + 127) / 128;
+        const attend_args: k.AttendArgs = .{
+            .rows = n,
+            .anchor = @intCast(anchor),
+            .from = @intCast(lane.from),
+            .lo = @intCast(lo),
+            .retained = retained,
+            .keys = keys,
+            .window = c.window,
+            .ring = @intCast(w.ring_size),
+            .chunks = chunks,
+            .scale = 1.0 / @sqrt(128.0),
+        };
+        for (d.loaded.weights.layers, 0..) |layer, i| {
+            k.norm(&d.pipelines, e, at(s.resid, 0), at(s.yc, 0), r(layer.in_norm), at(s.x, 0), .{ .rows = n, .width = c.hidden, .eps = c.eps, .add = @intFromBool(i > 0) });
+            fwd.dense(d.target, e, layer.attn_conv.proj, at(s.x, 0), at(s.dyn, 0), n);
+            k.conv(&d.pipelines, e, at(s.x, 0), at(s.dyn, 0), r(layer.attn_conv.base), at(s.xc, 0), .{ .rows = n, .width = c.hidden, .block = n, .groups = w.conv_groups, .side = 0 });
+            fwd.dense(d.target, e, layer.q_proj, at(s.xc, 0), at(s.q_raw, 0), n);
+            fwd.dense(d.target, e, layer.k_proj, at(s.xc, 0), at(s.k_raw, 0), n);
+            fwd.dense(d.target, e, layer.v_proj, at(s.xc, 0), at(s.v_raw, 0), n);
+            k.blockQkv(&d.pipelines, e, at(s.q_raw, 0), at(s.k_raw, 0), at(s.v_raw, 0), r(layer.q_norm), r(layer.k_norm), at(s.q, 0), at(s.kb, 0), at(s.vb, 0), .{ .rows = n, .block = n, .pos0 = @intCast(anchor), .eps = c.eps, .theta = c.theta });
+            k.attend(&d.pipelines, e, at(s.q, 0), at(s.kb, 0), at(s.vb, 0), at(lane.k[i], 0), at(lane.v[i], 0), at(s.part, 0), at(s.attn, 0), attend_args);
+            fwd.dense(d.target, e, layer.o_proj, at(s.attn, 0), at(s.y, 0), n);
+            k.conv(&d.pipelines, e, at(s.y, 0), at(s.dyn, 0), r(layer.attn_conv.base), at(s.yc, 0), .{ .rows = n, .width = c.hidden, .block = n, .groups = w.conv_groups, .side = 1 });
+            k.norm(&d.pipelines, e, at(s.resid, 0), at(s.yc, 0), r(layer.post_norm), at(s.x, 0), .{ .rows = n, .width = c.hidden, .eps = c.eps, .add = 1 });
+            fwd.dense(d.target, e, layer.mlp_conv.proj, at(s.x, 0), at(s.dyn, 0), n);
+            k.conv(&d.pipelines, e, at(s.x, 0), at(s.dyn, 0), r(layer.mlp_conv.base), at(s.xc, 0), .{ .rows = n, .width = c.hidden, .block = n, .groups = w.conv_groups, .side = 0 });
+            fwd.dense(d.target, e, layer.gate_proj, at(s.xc, 0), at(s.gate, 0), n);
+            fwd.dense(d.target, e, layer.up_proj, at(s.xc, 0), at(s.up, 0), n);
+            k.siluMul(&d.pipelines, e, at(s.gate, 0), at(s.up, 0), at(s.act, 0), n * w.intermediate);
+            fwd.dense(d.target, e, layer.down_proj, at(s.act, 0), at(s.y, 0), n);
+            k.conv(&d.pipelines, e, at(s.y, 0), at(s.dyn, 0), r(layer.mlp_conv.base), at(s.yc, 0), .{ .rows = n, .width = c.hidden, .block = n, .groups = w.conv_groups, .side = 1 });
+        }
+        k.norm(&d.pipelines, e, at(s.resid, 0), at(s.yc, 0), r(d.loaded.weights.norm), at(s.x, 0), .{ .rows = n, .width = c.hidden, .eps = c.eps, .add = 1 });
+        const draft_rows = n - 1;
+        const x_draft = at(s.x, w.hidden * 2);
+        fwd.dense(d.target, e, d.target.weights.unembed, x_draft, at(s.logits, 0), draft_rows);
+        fwd.dense(d.target, e, d.loaded.weights.hidden_proj, x_draft, at(s.hid, 0), draft_rows);
+        k.topk16(&d.pipelines, e, at(s.logits, 0), at(s.tval, 0), at(s.tid, 0), .{ .rows = draft_rows, .vocab = w.valid_vocab, .k = c.top_k, .stride = w.padded_vocab });
+        k.walk(&d.pipelines, e, at(s.tval, 0), at(s.tid, 0), at(s.hid, 0), r(d.loaded.weights.pred_cb), r(d.loaded.weights.succ_cb), at(s.seq, 0), .{ .slots = draft_rows, .rank = c.rank, .top = c.top_k, .vocab = w.valid_vocab, .softcap = c.softcap });
+    }
+
+    fn holdFn(ptr: *anyopaque, items: []const dr.Hold) anyerror!void {
+        const d = cast(ptr);
+        try d.settle();
+        for (items) |item| {
+            const lane = d.contexts.getPtr(item.stream) orelse return error.DraftStreamUnknown;
+            if (item.depth == 0 or item.position == 0) return error.DraftDepth;
+            const anchor = item.position - 1;
+            if (lane.end != anchor) return error.DraftContextGap;
+            const depth: usize = @min(item.depth, w.block_size - 1);
+            const pool = mtl.objc.Pool.push();
+            defer pool.pop();
+            const cb = d.target.queue.commandBuffer();
+            const e = cb.compute(.serial);
+            d.encodeBlock(e, lane, item.pending, anchor);
+            e.end();
+            cb.commit();
+            try failed(cb, "hold");
+            const seq = d.scratch.seq.slice(u32, w.block_size);
+            for (seq[1..][0..depth], lane.held[0..depth]) |tok, *dst| {
+                if (tok >= w.valid_vocab) return error.DraftNonfinite;
+                dst.* = tok;
+            }
+            lane.held_len = @intCast(depth);
+        }
+    }
+
+    fn warm(d: *Drafter) !void {
+        var lane = try Lane.init(d.target.device);
+        defer lane.deinit();
+        var ms: f64 = 0;
+        for (0..3) |run| {
+            const t0 = now();
+            const pool = mtl.objc.Pool.push();
+            defer pool.pop();
+            const cb = d.target.queue.commandBuffer();
+            const e = cb.compute(.serial);
+            d.encodeBlock(e, &lane, 2, 0);
+            e.end();
+            cb.commit();
+            try failed(cb, "warm");
+            if (run == 2) ms = now() - t0;
+        }
+        d.step_ms = ms / @as(f64, @floatFromInt(w.block_size - 1));
+    }
+};
+
+test "DFlash2 stream and scratch accounting fit fixed ring geometry" {
+    try std.testing.expectEqual(@as(usize, 2176), w.ring_size);
+    try std.testing.expectEqual(@as(u64, 5 * 2 * 2176 * 1024 * 2), streamBytes());
+    try std.testing.expect(scratchBytes() > 0);
+}
diff --git a/zig/src/families/inkling2/metal/dflash2_kernels.zig b/zig/src/families/inkling2/metal/dflash2_kernels.zig
new file mode 100644
index 000000000..cc4c4147d
--- /dev/null
+++ b/zig/src/families/inkling2/metal/dflash2_kernels.zig
@@ -0,0 +1,215 @@
+//! Inkling 2 Mini DFlash 2 Metal kernel pipelines and typed launch wrappers.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("inkling2_metal");
+const w = @import("dflash2_weights.zig");
+
+pub const Ref = @import("inkling2_metal_ref").Ref;
+pub const hidden = w.hidden;
+pub const query_width = w.query_width;
+pub const kv_width = w.kv_width;
+pub const q_heads = w.q_heads;
+pub const kv_heads = w.kv_heads;
+pub const head_dim = w.head_dim;
+pub const intermediate = w.intermediate;
+pub const rank = w.rank;
+pub const conv_groups = w.conv_groups;
+pub const block_size = w.block_size;
+pub const top_k = w.top_k;
+
+pub const EmbedArgs = extern struct { rows: u32, width: u32, use_norm: u32, eps: f32 };
+pub const NormArgs = extern struct { rows: u32, width: u32, eps: f32, add: u32 };
+pub const ConvArgs = extern struct { rows: u32, width: u32, block: u32, groups: u32, side: u32 };
+pub const CtxArgs = extern struct { rows: u32, pos0: u32, ring: u32, eps: f32, theta: f32 };
+pub const BlockQkvArgs = extern struct { rows: u32, block: u32, pos0: u32, eps: f32, theta: f32 };
+pub const AttendArgs = extern struct { rows: u32, anchor: u32, from: u32, lo: u32, retained: u32, keys: u32, window: u32, ring: u32, chunks: u32, scale: f32 };
+pub const ActArgs = extern struct { count: u32 };
+pub const TopkArgs = extern struct { rows: u32, vocab: u32, k: u32, stride: u32 };
+pub const WalkArgs = extern struct { slots: u32, rank: u32, top: u32, vocab: u32, softcap: f32 };
+
+pub const Kind = enum {
+    embed,
+    norm,
+    norm16,
+    conv,
+    ctx_kv,
+    block_qkv,
+    attend,
+    attend_merge,
+    silu_mul,
+    topk16,
+    walk,
+
+    pub fn symbol(k: Kind) [:0]const u8 {
+        return switch (k) {
+            .embed => "tf_ink2_df2_embed",
+            .norm => "tf_ink2_df2_norm",
+            .norm16 => "tf_ink2_df2_norm16",
+            .conv => "tf_ink2_df2_conv",
+            .ctx_kv => "tf_ink2_df2_ctx_kv",
+            .block_qkv => "tf_ink2_df2_block_qkv",
+            .attend => "tf_ink2_df2_attend",
+            .attend_merge => "tf_ink2_df2_attend_merge",
+            .silu_mul => "tf_ink2_df2_silu_mul",
+            .topk16 => "tf_ink2_df2_topk16",
+            .walk => "tf_ink2_df2_walk",
+        };
+    }
+
+    pub fn label(k: Kind) []const u8 {
+        return switch (k) {
+            inline else => |v| std.fmt.comptimePrint("metal inkling2 dflash2 {s} {s}", .{ @tagName(v), comptime v.symbol() }),
+        };
+    }
+};
+
+pub const Pipelines = struct {
+    embed: mtl.Pipeline,
+    norm: mtl.Pipeline,
+    norm16: mtl.Pipeline,
+    conv: mtl.Pipeline,
+    ctx_kv: mtl.Pipeline,
+    block_qkv: mtl.Pipeline,
+    attend: mtl.Pipeline,
+    attend_merge: mtl.Pipeline,
+    silu_mul: mtl.Pipeline,
+    topk16: mtl.Pipeline,
+    walk: mtl.Pipeline,
+
+    pub fn load(device: mtl.Device) !Pipelines {
+        return loadSource(device, sources.inkling2_dflash2);
+    }
+
+    pub fn loadSource(device: mtl.Device, text: []const u8) !Pipelines {
+        const lib = try mtl.Library.fromSource(device, text, .{ .language = mtl.CompileOptions.mlx().language, .math_functions = .precise });
+        defer lib.deinit();
+        var out: Pipelines = undefined;
+        var made: usize = 0;
+        errdefer inline for (@typeInfo(Pipelines).@"struct".field_names, 0..) |name, i| {
+            if (made > i) @field(out, name).deinit();
+        };
+        inline for (@typeInfo(Pipelines).@"struct".field_names, 0..) |name, i| {
+            const kind: Kind = @fromBackingInt(@intCast(i));
+            @field(out, name) = try mtl.Pipeline.init(device, lib, kind.symbol(), false);
+            made += 1;
+        }
+        return out;
+    }
+
+    pub fn deinit(p: *Pipelines) void {
+        inline for (@typeInfo(Pipelines).@"struct".field_names) |name| @field(p, name).deinit();
+        p.* = undefined;
+    }
+};
+
+fn bind(e: mtl.ComputeEncoder, refs: []const Ref) void {
+    for (refs, 0..) |r, i| e.setBuffer(r.buf, r.off, i);
+}
+
+pub fn embed(p: *const Pipelines, e: mtl.ComputeEncoder, ids: Ref, table: Ref, weight: Ref, out: Ref, a: EmbedArgs) void {
+    e.setPipeline(p.embed);
+    bind(e, &.{ ids, table, weight });
+    e.setValue(a, 3);
+    e.setBuffer(out.buf, out.off, 4);
+    e.dispatchGroups(mtl.Size.of(a.rows, 1, 1), mtl.Size.of(256, 1, 1));
+}
+
+pub fn norm(p: *const Pipelines, e: mtl.ComputeEncoder, resid: Ref, add_x: Ref, weight: Ref, out: Ref, a: NormArgs) void {
+    e.setPipeline(p.norm);
+    bind(e, &.{ resid, add_x, weight });
+    e.setValue(a, 3);
+    e.setBuffer(out.buf, out.off, 4);
+    e.dispatchGroups(mtl.Size.of(a.rows, 1, 1), mtl.Size.of(256, 1, 1));
+}
+
+pub fn norm16(p: *const Pipelines, e: mtl.ComputeEncoder, x: Ref, weight: Ref, out: Ref, a: NormArgs) void {
+    e.setPipeline(p.norm16);
+    bind(e, &.{ x, weight });
+    e.setValue(a, 2);
+    e.setBuffer(out.buf, out.off, 3);
+    e.dispatchGroups(mtl.Size.of(a.rows, 1, 1), mtl.Size.of(256, 1, 1));
+}
+
+pub fn conv(p: *const Pipelines, e: mtl.ComputeEncoder, x: Ref, dyn: Ref, base: Ref, out: Ref, a: ConvArgs) void {
+    e.setPipeline(p.conv);
+    bind(e, &.{ x, dyn, base });
+    e.setValue(a, 3);
+    e.setBuffer(out.buf, out.off, 4);
+    e.dispatchThreads(mtl.Size.of(a.width, a.rows, 1), mtl.Size.of(256, 1, 1));
+}
+
+pub fn ctxKv(p: *const Pipelines, e: mtl.ComputeEncoder, k_raw: Ref, v_raw: Ref, k_norm: Ref, k_ring: Ref, v_ring: Ref, a: CtxArgs) void {
+    e.setPipeline(p.ctx_kv);
+    bind(e, &.{ k_raw, v_raw, k_norm });
+    e.setValue(a, 3);
+    e.setBuffer(k_ring.buf, k_ring.off, 4);
+    e.setBuffer(v_ring.buf, v_ring.off, 5);
+    e.dispatchGroups(mtl.Size.of(w.kv_heads, a.rows, 1), mtl.Size.of(32, 1, 1));
+}
+
+pub fn blockQkv(p: *const Pipelines, e: mtl.ComputeEncoder, q_raw: Ref, k_raw: Ref, v_raw: Ref, q_norm: Ref, k_norm: Ref, q: Ref, kb: Ref, vb: Ref, a: BlockQkvArgs) void {
+    e.setPipeline(p.block_qkv);
+    bind(e, &.{ q_raw, k_raw, v_raw, q_norm, k_norm });
+    e.setValue(a, 5);
+    e.setBuffer(q.buf, q.off, 6);
+    e.setBuffer(kb.buf, kb.off, 7);
+    e.setBuffer(vb.buf, vb.off, 8);
+    e.dispatchGroups(mtl.Size.of(w.q_heads + w.kv_heads, a.rows, 1), mtl.Size.of(32, 1, 1));
+}
+
+pub fn attendPart(p: *const Pipelines, e: mtl.ComputeEncoder, q: Ref, kb: Ref, vb: Ref, k_ring: Ref, v_ring: Ref, part: Ref, a: AttendArgs) void {
+    e.setPipeline(p.attend);
+    bind(e, &.{ q, kb, vb, k_ring, v_ring });
+    e.setValue(a, 5);
+    e.setBuffer(part.buf, part.off, 6);
+    e.dispatchGroups(mtl.Size.of(w.kv_heads, a.rows, a.chunks), mtl.Size.of(32, 1, 1));
+}
+
+pub fn attendMerge(p: *const Pipelines, e: mtl.ComputeEncoder, part: Ref, out: Ref, a: AttendArgs) void {
+    e.setPipeline(p.attend_merge);
+    e.setBuffer(part.buf, part.off, 0);
+    e.setValue(a, 1);
+    e.setBuffer(out.buf, out.off, 2);
+    e.dispatchGroups(mtl.Size.of(w.q_heads, a.rows, 1), mtl.Size.of(32, 1, 1));
+}
+
+pub fn attend(p: *const Pipelines, e: mtl.ComputeEncoder, q: Ref, kb: Ref, vb: Ref, k_ring: Ref, v_ring: Ref, part: Ref, out: Ref, a: AttendArgs) void {
+    attendPart(p, e, q, kb, vb, k_ring, v_ring, part, a);
+    attendMerge(p, e, part, out, a);
+}
+
+pub fn siluMul(p: *const Pipelines, e: mtl.ComputeEncoder, gate: Ref, up: Ref, out: Ref, count: u32) void {
+    e.setPipeline(p.silu_mul);
+    bind(e, &.{ gate, up });
+    e.setValue(ActArgs{ .count = count }, 2);
+    e.setBuffer(out.buf, out.off, 3);
+    e.dispatchThreads(mtl.Size.of(count, 1, 1), mtl.Size.of(256, 1, 1));
+}
+
+pub fn topk16(p: *const Pipelines, e: mtl.ComputeEncoder, logits: Ref, vals: Ref, ids: Ref, a: TopkArgs) void {
+    e.setPipeline(p.topk16);
+    e.setBuffer(logits.buf, logits.off, 0);
+    e.setValue(a, 1);
+    e.setBuffer(vals.buf, vals.off, 2);
+    e.setBuffer(ids.buf, ids.off, 3);
+    e.dispatchGroups(mtl.Size.of(a.rows, 1, 1), mtl.Size.of(512, 1, 1));
+}
+
+pub fn walk(p: *const Pipelines, e: mtl.ComputeEncoder, vals: Ref, ids: Ref, hid: Ref, pred: Ref, succ: Ref, seq: Ref, a: WalkArgs) void {
+    e.setPipeline(p.walk);
+    bind(e, &.{ vals, ids, hid, pred, succ });
+    e.setValue(a, 5);
+    e.setBuffer(seq.buf, seq.off, 6);
+    e.dispatchGroups(mtl.Size.of(1, 1, 1), mtl.Size.of(w.rank, 1, 1));
+}
+
+test "DFlash2 kernel argument ABI sizes match Metal structs" {
+    try std.testing.expectEqual(@as(usize, 16), @sizeOf(EmbedArgs));
+    try std.testing.expectEqual(@as(usize, 16), @sizeOf(NormArgs));
+    try std.testing.expectEqual(@as(usize, 20), @sizeOf(ConvArgs));
+    try std.testing.expectEqual(@as(usize, 20), @sizeOf(CtxArgs));
+    try std.testing.expectEqual(@as(usize, 20), @sizeOf(BlockQkvArgs));
+    try std.testing.expectEqual(@as(usize, 40), @sizeOf(AttendArgs));
+    try std.testing.expectEqual(@as(usize, 16), @sizeOf(TopkArgs));
+    try std.testing.expectEqual(@as(usize, 20), @sizeOf(WalkArgs));
+}
diff --git a/zig/src/families/inkling2/metal/dflash2_weights.zig b/zig/src/families/inkling2/metal/dflash2_weights.zig
new file mode 100644
index 000000000..1fa9b820e
--- /dev/null
+++ b/zig/src/families/inkling2/metal/dflash2_weights.zig
@@ -0,0 +1,263 @@
+//! Validated config.json and model.safetensors loader for incoai/Inkling-2-Mini-DFlash2.
+const std = @import("std");
+const ck = @import("../../../core/checkpoint_metal.zig");
+const Model = @import("model.zig").Model;
+
+pub const hidden: usize = 2304;
+pub const taps_n: usize = 4;
+pub const layers_n: usize = 5;
+pub const q_heads: usize = 32;
+pub const kv_heads: usize = 8;
+pub const head_dim: usize = 128;
+pub const query_width: usize = q_heads * head_dim;
+pub const kv_width: usize = kv_heads * head_dim;
+pub const intermediate: usize = 6912;
+pub const conv_group_size: usize = 16;
+pub const conv_groups: usize = hidden / conv_group_size;
+pub const dyn_width: usize = 4 * conv_groups;
+pub const block_size: usize = 8;
+pub const window_size: usize = 2048;
+pub const ring_size: usize = std.mem.alignForward(usize, window_size + block_size, 128);
+pub const rank: usize = 256;
+pub const top_k: usize = 16;
+pub const padded_vocab: usize = 201024;
+pub const valid_vocab: usize = 200058;
+
+pub const Config = struct {
+    layers: u32 = layers_n,
+    heads: u32 = q_heads,
+    kv_heads: u32 = kv_heads,
+    hidden: u32 = hidden,
+    ffn: u32 = intermediate,
+    window: u32 = window_size,
+    block: u32 = block_size,
+    mask: u32 = 200056,
+    rank: u32 = rank,
+    top_k: u32 = top_k,
+    conv_group_size: u32 = conv_group_size,
+    taps: [taps_n]u32 = .{ 5, 23, 41, 48 },
+    theta: f32 = 10000.0,
+    eps: f32 = 1e-6,
+    softcap: f32 = 30.0,
+
+    pub fn parse(gpa: std.mem.Allocator, text: []const u8) !Config {
+        var doc = try std.json.parseFromSlice(std.json.Value, gpa, text, .{});
+        defer doc.deinit();
+        if (doc.value != .object) return error.BadDFlash2Config;
+        const root = doc.value.object;
+        const arch = root.get("architectures") orelse return error.NotDFlash2Config;
+        if (arch != .array or arch.array.items.len == 0 or arch.array.items[0] != .string or
+            !std.mem.eql(u8, arch.array.items[0].string, "DFlash2DraftModel")) return error.NotDFlash2Config;
+        const dc_val = root.get("dflash_config") orelse return error.BadDFlash2Config;
+        if (dc_val != .object) return error.BadDFlash2Config;
+        const dc = dc_val.object;
+        const readInt = struct {
+            fn of(o: std.json.ObjectMap, k: []const u8) !u32 {
+                const v = o.get(k) orelse return error.BadDFlash2Config;
+                if (v != .integer or v.integer <= 0) return error.BadDFlash2Config;
+                return @intCast(v.integer);
+            }
+            fn flt(o: std.json.ObjectMap, k: []const u8) !f32 {
+                const v = o.get(k) orelse return error.BadDFlash2Config;
+                return switch (v) {
+                    .integer => |i| @floatFromInt(i),
+                    .float => |f| @floatCast(f),
+                    else => error.BadDFlash2Config,
+                };
+            }
+        };
+        const theta: f32 = if (root.get("rope_parameters")) |rp| blk: {
+            if (rp != .object) return error.BadDFlash2Config;
+            break :blk try readInt.flt(rp.object, "rope_theta");
+        } else try readInt.flt(root, "rope_theta");
+        const mode = dc.get("selector_softcap_mode") orelse return error.BadDFlash2Config;
+        if (mode != .string or !std.mem.eql(u8, mode.string, "after_correction")) return error.UnsupportedDFlash2Config;
+        var c: Config = .{
+            .layers = try readInt.of(root, "num_hidden_layers"),
+            .heads = try readInt.of(root, "num_attention_heads"),
+            .kv_heads = try readInt.of(root, "num_key_value_heads"),
+            .hidden = try readInt.of(root, "hidden_size"),
+            .ffn = try readInt.of(root, "intermediate_size"),
+            .window = try readInt.of(root, "sliding_window"),
+            .block = try readInt.of(dc, "block_size"),
+            .mask = try readInt.of(dc, "mask_token_id"),
+            .rank = try readInt.of(dc, "selector_rank"),
+            .top_k = try readInt.of(dc, "selector_top_k"),
+            .conv_group_size = try readInt.of(dc, "conv_group_size"),
+            .theta = theta,
+            .eps = try readInt.flt(root, "rms_norm_eps"),
+            .softcap = try readInt.flt(dc, "final_logit_softcapping"),
+        };
+        const taps_v = dc.get("target_layer_ids") orelse return error.BadDFlash2Config;
+        if (taps_v != .array or taps_v.array.items.len != taps_n) return error.UnsupportedDFlash2Config;
+        for (taps_v.array.items, &c.taps) |item, *dst| {
+            if (item != .integer or item.integer < 0) return error.BadDFlash2Config;
+            dst.* = @intCast(item.integer);
+        }
+        if ((try readInt.of(root, "head_dim")) != head_dim or
+            (try readInt.of(root, "vocab_size")) != padded_vocab or
+            (try readInt.of(dc, "conv_kernel_size")) != 2 or
+            c.layers != layers_n or c.heads != q_heads or c.kv_heads != kv_heads or
+            c.hidden != hidden or c.ffn != intermediate or c.window != window_size or
+            c.block != block_size or c.rank != rank or c.top_k != top_k or
+            c.conv_group_size != conv_group_size or c.mask >= padded_vocab or
+            !std.mem.eql(u32, &c.taps, &.{ 5, 23, 41, 48 }))
+            return error.UnsupportedDFlash2Config;
+        return c;
+    }
+};
+
+/// Returns true when `dir` holds a DFlash2DraftModel config.json rather than a DSpark checkpoint.
+pub fn isDFlash2Dir(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) bool {
+    if (std.mem.endsWith(u8, dir, ".safetensors")) return false;
+    const path = std.fs.path.join(gpa, &.{ dir, "config.json" }) catch return false;
+    defer gpa.free(path);
+    const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20)) catch return false;
+    defer gpa.free(bytes);
+    var doc = std.json.parseFromSlice(std.json.Value, gpa, bytes, .{}) catch return false;
+    defer doc.deinit();
+    if (doc.value != .object) return false;
+    const arch = doc.value.object.get("architectures") orelse return false;
+    if (arch != .array or arch.array.items.len == 0 or arch.array.items[0] != .string) return false;
+    return std.mem.eql(u8, arch.array.items[0].string, "DFlash2DraftModel");
+}
+
+pub const Conv = struct {
+    base: ck.Tensor,
+    proj: ck.Tensor,
+};
+
+pub const Layer = struct {
+    in_norm: ck.Tensor,
+    post_norm: ck.Tensor,
+    q_norm: ck.Tensor,
+    k_norm: ck.Tensor,
+    q_proj: ck.Tensor,
+    k_proj: ck.Tensor,
+    v_proj: ck.Tensor,
+    o_proj: ck.Tensor,
+    gate_proj: ck.Tensor,
+    up_proj: ck.Tensor,
+    down_proj: ck.Tensor,
+    attn_conv: Conv,
+    mlp_conv: Conv,
+};
+
+pub const Weights = struct {
+    fc: ck.Tensor,
+    hidden_norm: ck.Tensor,
+    norm: ck.Tensor,
+    hidden_proj: ck.Tensor,
+    pred_cb: ck.Tensor,
+    succ_cb: ck.Tensor,
+    layers: [layers_n]Layer,
+};
+
+pub const Loaded = struct {
+    checkpoint: ck.Checkpoint,
+    config: Config,
+    weights: Weights,
+
+    pub fn deinit(l: *Loaded) void {
+        l.checkpoint.deinit();
+        l.* = undefined;
+    }
+
+    pub fn fixedBytes(l: *const Loaded) u64 {
+        return l.checkpoint.residentBytes();
+    }
+};
+
+fn require(t: ck.Tensor, dims: []const usize) !ck.Tensor {
+    if (t.dtype != .bf16 or t.rank != dims.len) return error.DFlash2TensorShape;
+    var count: usize = 1;
+    for (dims, 0..) |d, i| {
+        if (t.shape[i] != d) return error.DFlash2TensorShape;
+        count = std.math.mul(usize, count, d) catch return error.DFlash2TensorShape;
+    }
+    if (t.bytes != count * 2) return error.DFlash2TensorShape;
+    return t;
+}
+
+fn get(c: *const ck.Checkpoint, name: []const u8, dims: []const usize) !ck.Tensor {
+    const t = c.get(name) catch {
+        std.log.err("DFlash2 model.safetensors is missing {s}", .{name});
+        return error.DFlash2MissingTensor;
+    };
+    return require(t, dims);
+}
+
+fn loadLayer(c: *const ck.Checkpoint, i: usize) !Layer {
+    var b: [128]u8 = undefined;
+    const g = struct {
+        fn tensor(cp: *const ck.Checkpoint, buf: []u8, idx: usize, suffix: []const u8, dims: []const usize) !ck.Tensor {
+            const name = try std.fmt.bufPrint(buf, "layers.{d}.{s}", .{ idx, suffix });
+            return get(cp, name, dims);
+        }
+    }.tensor;
+    return .{
+        .in_norm = try g(c, &b, i, "input_layernorm.weight", &.{hidden}),
+        .post_norm = try g(c, &b, i, "post_attention_layernorm.weight", &.{hidden}),
+        .q_norm = try g(c, &b, i, "self_attn.q_norm.weight", &.{head_dim}),
+        .k_norm = try g(c, &b, i, "self_attn.k_norm.weight", &.{head_dim}),
+        .q_proj = try g(c, &b, i, "self_attn.q_proj.weight", &.{ query_width, hidden }),
+        .k_proj = try g(c, &b, i, "self_attn.k_proj.weight", &.{ kv_width, hidden }),
+        .v_proj = try g(c, &b, i, "self_attn.v_proj.weight", &.{ kv_width, hidden }),
+        .o_proj = try g(c, &b, i, "self_attn.o_proj.weight", &.{ hidden, query_width }),
+        .gate_proj = try g(c, &b, i, "mlp.gate_proj.weight", &.{ intermediate, hidden }),
+        .up_proj = try g(c, &b, i, "mlp.up_proj.weight", &.{ intermediate, hidden }),
+        .down_proj = try g(c, &b, i, "mlp.down_proj.weight", &.{ hidden, intermediate }),
+        .attn_conv = .{
+            .base = try g(c, &b, i, "attention_conv.base_kernel", &.{ 2, 2, hidden }),
+            .proj = try g(c, &b, i, "attention_conv.kernel_projection.weight", &.{ dyn_width, hidden }),
+        },
+        .mlp_conv = .{
+            .base = try g(c, &b, i, "mlp_conv.base_kernel", &.{ 2, 2, hidden }),
+            .proj = try g(c, &b, i, "mlp_conv.kernel_projection.weight", &.{ dyn_width, hidden }),
+        },
+    };
+}
+
+pub fn load(gpa: std.mem.Allocator, io: std.Io, target: *const Model, dir: []const u8) !Loaded {
+    const cfg_path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+    defer gpa.free(cfg_path);
+    const cfg_text = try std.Io.Dir.cwd().readFileAlloc(io, cfg_path, gpa, .limited(1 << 20));
+    defer gpa.free(cfg_text);
+    const config = try Config.parse(gpa, cfg_text);
+    var checkpoint = ck.Checkpoint.init(gpa);
+    errdefer checkpoint.deinit();
+    const path = try std.fmt.allocPrintSentinel(gpa, "{s}/model.safetensors", .{dir}, 0);
+    defer gpa.free(path);
+    checkpoint.addFile(target.device, path, "") catch |err| {
+        std.log.err("DFlash2 cannot open {s}: {s}", .{ path, @errorName(err) });
+        return error.DFlash2MissingFile;
+    };
+    const c = &checkpoint;
+    var layers: [layers_n]Layer = undefined;
+    for (&layers, 0..) |*l, i| l.* = try loadLayer(c, i);
+    const weights: Weights = .{
+        .fc = try get(c, "fc.weight", &.{ hidden, taps_n * hidden }),
+        .hidden_norm = try get(c, "hidden_norm.weight", &.{hidden}),
+        .norm = try get(c, "norm.weight", &.{hidden}),
+        .hidden_proj = try get(c, "candidate_selector.hidden_projection.weight", &.{ rank, hidden }),
+        .pred_cb = try get(c, "candidate_selector.predecessor_codebook", &.{ padded_vocab, rank }),
+        .succ_cb = try get(c, "candidate_selector.successor_codebook", &.{ padded_vocab, rank }),
+        .layers = layers,
+    };
+    return .{ .checkpoint = checkpoint, .config = config, .weights = weights };
+}
+
+test "DFlash2 config parser accepts Inkling-2-Mini-DFlash2 and refuses mismatched shapes" {
+    const valid =
+        \\{"architectures":["DFlash2DraftModel"],"head_dim":128,"hidden_size":2304,"intermediate_size":6912,
+        \\"num_attention_heads":32,"num_hidden_layers":5,"num_key_value_heads":8,"rms_norm_eps":1e-6,
+        \\"rope_parameters":{"rope_theta":10000.0},"sliding_window":2048,"vocab_size":201024,
+        \\"dflash_config":{"block_size":8,"conv_group_size":16,"conv_kernel_size":2,"final_logit_softcapping":30.0,
+        \\"mask_token_id":200056,"selector_rank":256,"selector_softcap_mode":"after_correction",
+        \\"selector_top_k":16,"target_layer_ids":[5,23,41,48]}}
+    ;
+    const c = try Config.parse(std.testing.allocator, valid);
+    try std.testing.expectEqual(@as(u32, 200056), c.mask);
+    try std.testing.expectEqual(@as(u32, 16), c.top_k);
+    try std.testing.expectEqual(@as(f32, 30.0), c.softcap);
+}
