diff --git c/zig/src/families/inkling2/mini_sums.zig w/zig/src/families/inkling2/mini_sums.zig
new file mode 100644
index 0000000..cf3af5e
--- /dev/null
+++ w/zig/src/families/inkling2/mini_sums.zig
@@ -0,0 +1,492 @@
+//! TF_INKLING2_STATE_SUMS=<file> (a test hook): a stream's state sums as JSON lines; off, one cached check a site.
+const std = @import("std");
+const cuda = @import("cuda");
+const env = @import("sys").environment;
+const mm = @import("mini_model.zig");
+const snap = @import("mini_snap.zig");
+
+/// Set once at load when TF_INKLING2_STATE_SUMS names a writable file.
+pub var on: bool = false;
+
+const gpa = std.heap.c_allocator;
+var fd: c_int = -1;
+var next_sid: u64 = 0;
+/// TF_INKLING2_STATE_SUMS_PLANT=<visit>@<position>[:<bit>]: one flipped conv bit (default bit 0), once.
+var plant: ?struct { visit: usize, position: u64, bit: u5 } = null;
+var planted = false;
+/// TF_INKLING2_STATE_SUMS_DECODE_PROMPT=<1..8>: prompt chunks as decode windows of that many rows (0: off).
+pub var decode_prompt: usize = 0;
+/// TF_INKLING2_STATE_SUMS_RAW=1: rows events also carry raw taps and the K and V rows of `raw_visits`.
+var raw = false;
+const raw_visits = [_]struct { v: usize, k: []const u8, vk: []const u8 }{ .{ .v = 47, .k = "raw_k", .vk = "raw_v" }, .{ .v = 5, .k = "raw_k5", .vk = "raw_v5" } };
+const max_ring = 16;
+
+const Draft = struct { from: u64, end: u64, n: usize, ring: [max_ring]u64 };
+const Entry = struct { sid: u64, slot: usize, draft: ?Draft = null, decode_from: u64 = 0 };
+/// TF_INKLING2_STATE_SUMS_DECODE_FROM=<file>: its decimal N, read as each prompt pass begins (rows from N decode).
+var decode_from: ?[:0]u8 = null;
+var streams: std.AutoHashMapUnmanaged(usize, Entry) = .empty;
+
+pub const Kind = enum { prompt, decode };
+pub const When = enum { prefilled, release };
+
+pub fn init() void {
+    if (fd >= 0) return;
+    const name = "TF_INKLING2_STATE_SUMS";
+    const given = (env.path(name, env.rawText(name)) catch null) orelse return;
+    const path = gpa.dupeSentinel(u8, given, 0) catch return;
+    defer gpa.free(path);
+    fd = std.c.open(path, .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true, .CLOEXEC = true }, @as(std.c.mode_t, 0o644));
+    if (fd < 0) return std.log.err("TF_INKLING2_STATE_SUMS: cannot open {s}", .{path});
+    on = true;
+    raw = env.read(bool, "TF_INKLING2_STATE_SUMS_RAW", false) catch false;
+    decode_prompt = env.read(u32, "TF_INKLING2_STATE_SUMS_DECODE_PROMPT", 0) catch 0;
+    if (decode_prompt > 0) std.log.info("TF_INKLING2_STATE_SUMS_DECODE_PROMPT: prompt rows as decode windows of {d}", .{decode_prompt});
+    const fname = "TF_INKLING2_STATE_SUMS_DECODE_FROM";
+    if (env.path(fname, env.rawText(fname)) catch null) |f| decode_from = gpa.dupeSentinel(u8, f, 0) catch null;
+    if (decode_from) |f| std.log.info("{s}: prompt rows decode from the position in {s}", .{ fname, f });
+    std.log.info("TF_INKLING2_STATE_SUMS: state sums to {s}{s}", .{ path, if (raw) " with raw rows" else "" });
+    const pname = "TF_INKLING2_STATE_SUMS_PLANT";
+    const v = (env.path(pname, env.rawText(pname)) catch null) orelse return;
+    const at = std.mem.indexOfScalar(u8, v, '@') orelse return std.log.err("{s}: <visit>@<position>[:<bit>], not {s}", .{ pname, v });
+    const colon = std.mem.indexOfScalarPos(u8, v, at, ':') orelse v.len;
+    const vi = std.fmt.parseInt(usize, v[0..at], 10) catch return std.log.err("{s}: bad visit in {s}", .{ pname, v });
+    const p = std.fmt.parseInt(u64, v[at + 1 .. colon], 10) catch return std.log.err("{s}: bad position in {s}", .{ pname, v });
+    const bit = if (colon == v.len) 0 else std.fmt.parseInt(u5, v[colon + 1 ..], 10) catch return std.log.err("{s}: bad bit in {s}", .{ pname, v });
+    plant = .{ .visit = vi, .position = p, .bit = bit };
+    std.log.info("{s}: visit {d}'s attention conv bit {d} flips once a stream passes position {d}", .{ pname, vi, bit, p });
+}
+
+fn warn(e: anyerror) void {
+    std.log.warn("TF_INKLING2_STATE_SUMS: {s}", .{@errorName(e)});
+}
+
+const Line = struct {
+    b: std.ArrayList(u8) = .empty,
+
+    fn put(l: *Line, comptime f: []const u8, a: anytype) !void {
+        try l.b.print(gpa, f, a);
+    }
+
+    fn hex(l: *Line, h: u64) !void {
+        try l.put("{x:0>16}", .{h});
+    }
+
+    fn hexes(l: *Line, hs: []const u64) !void {
+        try l.b.append(gpa, '"');
+        for (hs) |h| try l.hex(h);
+        try l.b.append(gpa, '"');
+    }
+
+    fn b64(l: *Line, bytes: []const u8) !void {
+        const enc = std.base64.standard.Encoder;
+        try l.b.append(gpa, '"');
+        const at = l.b.items.len;
+        try l.b.resize(gpa, at + enc.calcSize(bytes.len));
+        _ = enc.encode(l.b.items[at..], bytes);
+        try l.b.append(gpa, '"');
+    }
+
+    fn head(l: *Line, ev: []const u8, e: Entry) !void {
+        try l.put("{{\"ev\":\"{s}\",\"sid\":{d},\"slot\":{d}", .{ ev, e.sid, e.slot });
+    }
+
+    fn deinit(l: *Line) void {
+        l.b.deinit(gpa);
+    }
+
+    /// The line and its newline in one write (O_APPEND).
+    fn end(l: *Line) !void {
+        try l.b.appendSlice(gpa, "}\n");
+        var at: usize = 0;
+        while (at < l.b.items.len) {
+            const n = std.c.write(fd, l.b.items.ptr + at, l.b.items.len - at);
+            if (n <= 0) return error.StateSumsWrite;
+            at += @intCast(n);
+        }
+    }
+};
+
+fn entry(st: *const anyopaque, slot: usize) Entry {
+    if (streams.get(@intFromPtr(st))) |e| return e;
+    return .{ .sid = std.math.maxInt(u64), .slot = slot };
+}
+
+fn get(d: *const cuda.Driver, src: u64, out: []u8) !void {
+    try cuda.memory.download(d, src, out);
+}
+
+fn hashAt(d: *const cuda.Driver, buf: *std.ArrayList(u8), src: u64, n: usize) !u64 {
+    try buf.resize(gpa, n);
+    try get(d, src, buf.items);
+    return std.hash.Wyhash.hash(0, buf.items);
+}
+
+fn convWidth(m: *const mm.Model, site: mm.Site) usize {
+    return if (site == .k or site == .v) @as(usize, m.c.local.kv) * m.c.local.dim else m.c.hidden;
+}
+
+/// The slot's conv states, visit-major in Site order (the stream synchronized).
+fn convSums(m: *const mm.Model, slot: usize, buf: *std.ArrayList(u8), out: []u64) !void {
+    for (0..m.w.plan.visits.len) |v| for (std.enums.values(mm.Site)) |site| {
+        const n = 3 * convWidth(m, site) * 4;
+        out[v * 4 + @backingInt(site)] = try hashAt(m.d, buf, m.conv[v][@backingInt(site)] + slot * n, n);
+    };
+}
+
+fn putConv(l: *Line, m: *const mm.Model, slot: usize) !void {
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(gpa);
+    const hs = try gpa.alloc(u64, m.w.plan.visits.len * 4);
+    defer gpa.free(hs);
+    try convSums(m, slot, &buf, hs);
+    try l.put(",\"conv\":", .{});
+    try l.hexes(hs);
+}
+
+/// A prompt pass begins (once a stream): its serial, prompt and the position a kept state restored.
+pub fn open(st: *const anyopaque, slot: usize, prompt: []const u32, resume_at: usize) void {
+    openInner(st, slot, prompt, resume_at) catch |e| warn(e);
+}
+
+/// A file's decimal position; missing, empty or unparsable: 0.
+fn readPosition(path: [:0]const u8) u64 {
+    const f = std.c.open(path, .{ .ACCMODE = .RDONLY, .CLOEXEC = true });
+    if (f < 0) return 0;
+    defer _ = std.c.close(f);
+    var b: [32]u8 = undefined;
+    const n = std.c.read(f, &b, b.len);
+    if (n <= 0) return 0;
+    return std.fmt.parseInt(u64, std.mem.trim(u8, b[0..@intCast(n)], " \t\r\n"), 10) catch 0;
+}
+
+/// DECODE_PROMPT: whether the stream's chunk at `at` runs as decode windows (at or past its DECODE_FROM position).
+pub fn decodes(st: *const anyopaque, at: usize) bool {
+    const e = streams.get(@intFromPtr(st)) orelse return true;
+    return at >= e.decode_from;
+}
+
+/// DECODE_PROMPT: a chunk's end, clamped to the decode start, or to one decode window past it.
+pub fn chunkEnd(st: *const anyopaque, at: usize, end: usize) usize {
+    const from: usize = if (streams.get(@intFromPtr(st))) |e| @intCast(@min(e.decode_from, std.math.maxInt(usize))) else 0;
+    return if (at < from) @min(end, from) else @min(end, at + decode_prompt);
+}
+
+fn openInner(st: *const anyopaque, slot: usize, prompt: []const u32, resume_at: usize) !void {
+    const got = try streams.getOrPut(gpa, @intFromPtr(st));
+    if (!got.found_existing) {
+        got.value_ptr.* = .{ .sid = next_sid, .slot = slot };
+        next_sid += 1;
+    }
+    got.value_ptr.slot = slot;
+    got.value_ptr.decode_from = if (decode_from) |f| readPosition(f) else 0;
+    var l: Line = .{};
+    defer l.deinit();
+    try l.head("open", got.value_ptr.*);
+    try l.put(",\"plen\":{d},\"ph\":\"{x:0>16}\",\"resume\":{d}", .{ prompt.len, std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(prompt)), resume_at });
+    try l.end();
+}
+
+/// Visit v's K or V rows [max(p0, from), p0 + n), every key head: codes as [head][n][row], fp8 scales [head][n].
+fn kvRows(m: *const mm.Model, slot: usize, v: usize, side: usize, p0: u64, n: usize, from: u64, codes: []u8, scales: []u8) !void {
+    const full = m.w.plan.visits.steps[v].of(.full) != null;
+    const len: usize = if (full) m.full.ring else m.sliding.ring;
+    const kvh: usize = m.c.local.kv;
+    const rb: usize = @as(usize, m.c.local.dim) * @as(usize, if (m.kv8) 1 else 2);
+    for (0..kvh) |h| {
+        const base = m.kv[side][v] + ((slot * kvh + h) * len) * rb;
+        const sbase = m.kvs[side][v] + ((slot * kvh + h) * len) * 4;
+        var p: u64 = @max(p0, from);
+        while (p < p0 + n) {
+            const row: usize = @intCast(p % len);
+            const i: usize = @intCast(p - p0);
+            const run = @min(n - i, len - row);
+            try get(m.d, base + row * rb, codes[(h * n + i) * rb ..][0 .. run * rb]);
+            if (m.kv8) try get(m.d, sbase + row * 4, scales[(h * n + i) * 4 ..][0 .. run * 4]);
+            p += run;
+        }
+    }
+}
+
+/// Rows [row0, row0 + n) of a forward at positions p0..: K, V, taps, logits (0: none) and the conv states after.
+pub fn rows(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, kind: Kind, p0: u64, n: usize, len: u64, row0: usize, logits: u64) void {
+    rowsInner(m, s, st, slot, kind, p0, n, len, row0, logits) catch |e| warn(e);
+}
+
+fn rowsInner(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, kind: Kind, p0: u64, n: usize, len: u64, row0: usize, logits: u64) !void {
+    try s.synchronize();
+    const visits = m.w.plan.visits.len;
+    const kvh: usize = m.c.local.kv;
+    const rb: usize = @as(usize, m.c.local.dim) * @as(usize, if (m.kv8) 1 else 2);
+    const end = p0 + n;
+    const codes = try gpa.alloc(u8, kvh * n * rb);
+    defer gpa.free(codes);
+    const scales = try gpa.alloc(u8, kvh * n * 4);
+    defer gpa.free(scales);
+    const sums = try gpa.alloc(u64, 2 * n * visits); // [side][row][visit]
+    defer gpa.free(sums);
+    // raw rows as stored: every head's codes, then (fp8) every head's scale; empty when not kept
+    const rr = kvh * rb + @as(usize, if (m.kv8) kvh * 4 else 0);
+    const raws = try gpa.alloc(u8, if (raw) raw_visits.len * 2 * n * rr else 0);
+    defer gpa.free(raws);
+    const raw_kept = try gpa.alloc(bool, if (raw) raw_visits.len * 2 * n else 0);
+    defer gpa.free(raw_kept);
+    for (0..visits) |v| for (0..2) |side| {
+        const full = m.w.plan.visits.steps[v].of(.full) != null;
+        const ring: u64 = if (full) m.full.ring else m.sliding.ring;
+        // kept rows only: not yet overwritten, and a sliding prompt chunk's last window - 1
+        var from: u64 = end -| ring;
+        if (!full and kind == .prompt) from = @max(from, end -| (m.c.window - 1));
+        try kvRows(m, slot, v, side, p0, n, from, codes, scales);
+        for (0..n) |r| {
+            var h = std.hash.Wyhash.init(0);
+            for (0..kvh) |hd| {
+                h.update(codes[(hd * n + r) * rb ..][0..rb]);
+                if (m.kv8) h.update(scales[(hd * n + r) * 4 ..][0..4]);
+            }
+            sums[(side * n + r) * visits + v] = if (p0 + r < from) 0 else h.final();
+        }
+        if (raw) for (raw_visits, 0..) |rv, j| if (rv.v == v) for (0..n) |r| {
+            const i = (j * 2 + side) * n + r;
+            const out = raws[i * rr ..][0..rr];
+            for (0..kvh) |hd| @memcpy(out[hd * rb ..][0..rb], codes[(hd * n + r) * rb ..][0..rb]);
+            if (m.kv8) for (0..kvh) |hd| @memcpy(out[kvh * rb + hd * 4 ..][0..4], scales[(hd * n + r) * 4 ..][0..4]);
+            raw_kept[i] = p0 + r >= from;
+        };
+    };
+    const e = entry(st, slot);
+    var l: Line = .{};
+    defer l.deinit();
+    try l.head("rows", e);
+    try l.put(",\"kind\":\"{s}\",\"p0\":{d},\"n\":{d},\"len\":{d}", .{ @tagName(kind), p0, n, len });
+    for ([_][]const u8{ "k", "v" }, 0..) |key, side| {
+        try l.put(",\"{s}\":[", .{key});
+        for (0..n) |r| {
+            if (r > 0) try l.put(",", .{});
+            try l.hexes(sums[(side * n + r) * visits ..][0..visits]);
+        }
+        try l.put("]", .{});
+    }
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(gpa);
+    if (m.taps_on) {
+        const tb = m.tapRowBytes();
+        const per = tb / mm.taps_n;
+        try buf.resize(gpa, n * tb);
+        try get(m.d, m.taps + row0 * tb, buf.items);
+        try l.put(",\"tap\":[", .{});
+        for (0..n) |r| {
+            if (r > 0) try l.put(",", .{});
+            var t: [mm.taps_n]u64 = undefined;
+            for (&t, 0..) |*x, i| x.* = std.hash.Wyhash.hash(0, buf.items[r * tb + i * per ..][0..per]);
+            try l.hexes(&t);
+        }
+        try l.put("]", .{});
+        if (raw) {
+            try l.put(",\"raw_tap\":[", .{});
+            for (0..n) |r| {
+                if (r > 0) try l.put(",", .{});
+                try l.b64(buf.items[r * tb ..][0..tb]);
+            }
+            try l.put("]", .{});
+        }
+    }
+    if (raw) for (raw_visits, 0..) |rv, j| if (rv.v < visits) for ([_][]const u8{ rv.k, rv.vk }, 0..) |key, side| {
+        try l.put(",\"{s}\":[", .{key});
+        for (0..n) |r| {
+            const i = (j * 2 + side) * n + r;
+            if (r > 0) try l.put(",", .{});
+            if (raw_kept[i]) try l.b64(raws[i * rr ..][0..rr]) else try l.put("\"\"", .{});
+        }
+        try l.put("]", .{});
+    };
+    const vb = @as(usize, m.c.unpadded_vocab) * 4;
+    try l.put(",\"logit\":[", .{});
+    const entries: usize = if (kind == .prompt) @intFromBool(logits != 0) else n;
+    for (0..entries) |r| {
+        if (r > 0) try l.put(",", .{});
+        if (logits == 0) {
+            try l.put("\"\"", .{});
+        } else {
+            try l.put("\"{x:0>16}\"", .{try hashAt(m.d, &buf, logits + r * vb, vb)});
+        }
+    }
+    try l.put("]", .{});
+    try putConv(&l, m, slot);
+    try l.end();
+}
+
+/// A cut window rolled back: the stream's length and conv states after it.
+pub fn kept(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, len: u64) void {
+    keptInner(m, s, st, slot, len) catch |e| warn(e);
+}
+
+fn keptInner(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, len: u64) !void {
+    try s.synchronize();
+    var l: Line = .{};
+    defer l.deinit();
+    try l.head("keep", entry(st, slot));
+    try l.put(",\"len\":{d}", .{len});
+    try putConv(&l, m, slot);
+    try l.end();
+}
+
+/// Sums of the kept-state bytes: each run `snap.each` yields, by the buffer it lies in.
+const Each = struct {
+    m: *const mm.Model,
+    k: []std.hash.Wyhash,
+    v: []std.hash.Wyhash,
+    conv: []u64,
+    all: *std.hash.Wyhash,
+    buf: *std.ArrayList(u8),
+
+    fn in(dev: u64, base: u64, n: usize) bool {
+        return dev >= base and dev < base + n;
+    }
+
+    fn take(c: Each, dev: u64, _: usize, len: usize) anyerror!void {
+        const m = c.m;
+        try c.buf.resize(gpa, len);
+        try get(m.d, dev, c.buf.items);
+        c.all.update(c.buf.items);
+        const kvw: usize = @as(usize, m.c.local.kv) * m.c.local.dim;
+        for (m.w.plan.visits.slice(), 0..) |step, v| {
+            const ring: usize = if (step.of(.full) != null) m.full.ring else m.sliding.ring;
+            const cb = m.slots * ring * kvw * @as(usize, if (m.kv8) 1 else 2);
+            const sb = m.slots * ring * @as(usize, m.c.local.kv) * 4;
+            for (0..2) |side| if (in(dev, m.kv[side][v], cb) or (m.kv8 and in(dev, m.kvs[side][v], sb))) {
+                (if (side == 0) c.k else c.v)[v].update(c.buf.items);
+                return;
+            };
+            for (std.enums.values(mm.Site)) |site| if (in(dev, m.conv[v][@backingInt(site)], m.slots * 3 * convWidth(m, site) * 4)) {
+                c.conv[v * 4 + @backingInt(site)] = std.hash.Wyhash.hash(0, c.buf.items);
+                return;
+            };
+        }
+        return error.StateSumsUnknownRun;
+    }
+};
+
+/// The kept-state sums of the slot at `at` (the prompt pass's end, or the stream's length at release).
+pub fn keptState(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, at: u64, when: When) void {
+    snapInner(m, s, st, slot, at, when) catch |e| warn(e);
+}
+
+fn snapInner(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, at: u64, when: When) !void {
+    try s.synchronize();
+    const visits = m.w.plan.visits.len;
+    const hs = try gpa.alloc(std.hash.Wyhash, 2 * visits);
+    defer gpa.free(hs);
+    for (hs) |*h| h.* = std.hash.Wyhash.init(0);
+    const conv = try gpa.alloc(u64, visits * 4);
+    defer gpa.free(conv);
+    @memset(conv, 0);
+    var all = std.hash.Wyhash.init(0);
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(gpa);
+    try snap.each(m, slot, @intCast(at), Each{ .m = m, .k = hs[0..visits], .v = hs[visits..], .conv = conv, .all = &all, .buf = &buf }, Each.take);
+    const e = entry(st, slot);
+    var l: Line = .{};
+    defer l.deinit();
+    try l.head("snap", e);
+    try l.put(",\"at\":{d},\"when\":\"{s}\"", .{ at, @tagName(when) });
+    for ([_][]const u8{ "k", "v" }, 0..) |key, side| {
+        try l.put(",\"{s}\":\"", .{key});
+        for (hs[side * visits ..][0..visits]) |*h| try l.hex(h.final());
+        try l.put("\"", .{});
+    }
+    try l.put(",\"conv\":", .{});
+    try l.hexes(conv);
+    try l.put(",\"all\":\"{x:0>16}\"", .{all.final()});
+    if (when == .release) if (e.draft) |dr| {
+        try l.put(",\"draft\":{{\"kind\":\"dflash2\",\"from\":{d},\"end\":{d},\"ring\":", .{ dr.from, dr.end });
+        try l.hexes(dr.ring[0..dr.n]);
+        try l.put("}}", .{});
+    };
+    try l.end();
+}
+
+/// The stream's lane goes: its kept-state sums (when its prompt pass finished), then its entry.
+pub fn release(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, len: u64, prefilled: bool) void {
+    if (prefilled) keptState(m, s, st, slot, len, .release);
+    _ = streams.remove(@intFromPtr(st));
+}
+
+/// A DFlash2 ring's K then V a layer over positions [max(from, end - window), end): the release snap's, else an event.
+pub fn draft(d: *const cuda.Driver, s: cuda.Stream, st: *const anyopaque, when: When, ring: u64, from: u64, end: u64, layers: usize, window: usize, row: usize) void {
+    draftInner(d, s, st, when, ring, from, end, layers, window, row) catch |e| warn(e);
+}
+
+fn draftInner(d: *const cuda.Driver, s: cuda.Stream, st: *const anyopaque, when: When, ring: u64, from: u64, end: u64, layers: usize, window: usize, row: usize) !void {
+    if (2 * layers > max_ring) return error.StateSumsRing;
+    try s.synchronize();
+    var dr: Draft = .{ .from = from, .end = end, .n = 2 * layers, .ring = @splat(0) };
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(gpa);
+    const lo = @max(from, end -| window);
+    for (0..2 * layers) |i| {
+        const base = ring + i * window * row;
+        var h = std.hash.Wyhash.init(0);
+        var p = lo;
+        while (p < end) {
+            const r: usize = @intCast(p % window);
+            const run: usize = @intCast(@min(end - p, window - r));
+            try buf.resize(gpa, run * row);
+            try get(d, base + r * row, buf.items);
+            h.update(buf.items);
+            p += run;
+        }
+        dr.ring[i] = h.final();
+    }
+    const got = streams.getPtr(@intFromPtr(st));
+    if (when == .release) {
+        if (got) |e| e.draft = dr;
+        return;
+    }
+    var l: Line = .{};
+    defer l.deinit();
+    try l.head("draft", if (got) |e| e.* else Entry{ .sid = std.math.maxInt(u64), .slot = 0 });
+    try l.put(",\"when\":\"{s}\",\"from\":{d},\"end\":{d},\"ring\":", .{ @tagName(when), from, end });
+    try l.hexes(dr.ring[0..dr.n]);
+    try l.end();
+}
+
+/// Before a decode call past the planted position: one bit of every fp32 in visit V's attention conv state flips, once.
+pub fn plantAt(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, len: u64) void {
+    const p = plant orelse return;
+    if (planted or len <= p.position) return;
+    planted = true;
+    plantInner(m, s, st, slot, len, p.visit, p.position, p.bit) catch |e| warn(e);
+}
+
+fn plantInner(m: *const mm.Model, s: cuda.Stream, st: *const anyopaque, slot: usize, len: u64, v: usize, position: u64, bit: u5) !void {
+    if (v >= m.w.plan.visits.len) return error.StateSumsPlantVisit;
+    try s.synchronize();
+    const n = 3 * convWidth(m, .attn);
+    const at = m.conv[v][@backingInt(mm.Site.attn)] + slot * n * 4;
+    const w = try gpa.alloc(u32, n);
+    defer gpa.free(w);
+    try get(m.d, at, std.mem.sliceAsBytes(w));
+    const first: f32 = @bitCast(w[0]);
+    var changed: usize = 0;
+    var most: f32 = 0;
+    for (w) |*x| {
+        const old: f32 = @bitCast(x.*);
+        x.* ^= @as(u32, 1) << bit;
+        const d = @abs(@as(f32, @bitCast(x.*)) - old);
+        changed += @intFromBool(d > 0);
+        if (d > most) most = d;
+    }
+    const view: cuda.DeviceBuffer = .{ .d = m.d, .ptr = at, .len = n * 4, .borrowed = true };
+    try view.upload(0, std.mem.sliceAsBytes(w));
+    try s.synchronize();
+    const back = try gpa.alloc(u32, n);
+    defer gpa.free(back);
+    try get(m.d, at, std.mem.sliceAsBytes(back));
+    if (!std.mem.eql(u32, w, back)) return error.StateSumsPlantNotWritten;
+    var l: Line = .{};
+    defer l.deinit();
+    try l.head("plant", entry(st, slot));
+    try l.put(",\"visit\":{d},\"position\":{d},\"bit\":{d},\"len\":{d},\"elements\":{d},\"changed\":{d},\"max_delta\":{e},\"first_before\":{e}", .{ v, position, bit, len, n, changed, most, first });
+    try l.end();
+}
