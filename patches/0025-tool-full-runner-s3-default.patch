+        self.produced = 0
+        self.prints = []
+        self.names = {}
+        self.imports = set()
+        self.calls = {}
+
+    def limits(self):
+        if len(self.ops) > 4096 or len(self.values) + self.produced > 8192 or len(self.prints) > 128:
+            raise Unsupported("program exceeds native packet bounds")
