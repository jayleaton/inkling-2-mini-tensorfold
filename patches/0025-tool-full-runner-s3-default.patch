+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    for ([_]u32{ c.go, tok(1, 0), tok(2, 1 | 4), tok(1, 0) }, 0..) |t, i| {
+        if (i == 2) try rc.writeWord(&s, 0, 5);
+        _ = try eval.step(&s, t);
+        try std.testing.expectEqual(@as(model.Scalar, 6), s.value(tiny.dims.sum));
+    }
+}
+
+test "banks sharing an address share one selection key per step but keep their own rows, as running every unit does" {
+    var c = try tinyCircuit(.banks);
+    defer c.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 1), c.flow.groups);
+    var lazy = try rc.State.init(gpa, &c);
+    defer lazy.deinit();
+    var full = try rc.State.init(gpa, &c);
+    defer full.deinit();
+    full.always = true;
+    const rows = [_]u32{ 1, 2, 1, 3, 0, 2, 1, 1, 2, 0, 3, 1, 2, 2, 1 };
+    for (0..3) |_| for (rows, 0..) |r, i| {
+        const t = if (i % 3 == 0) tok(2, r | 4) else tok(3, r);
+        try std.testing.expectEqual(try eval.step(&full, t), try eval.step(&lazy, t));
+        const want = try full.canonical(gpa);
+        defer gpa.free(want);
+        const got = try lazy.canonical(gpa);
+        defer gpa.free(got);
+        try std.testing.expectEqualSlices(u8, want, got);
+    };
+    try std.testing.expect(lazy.groups[0].memo.hits > 0);
+}
+
+test "a bank skipped on a step its group selects nothing still sees that step's inputs one step later" {
+    var c = try tinyCircuit(.banks);
+    defer c.deinit(gpa);
+    var lazy = try rc.State.init(gpa, &c);
+    defer lazy.deinit();
+    var full = try rc.State.init(gpa, &c);
+    defer full.deinit();
+    full.always = true;
+    // An A token selects no row in either bank: from the second cycle the mirror skips it, then a write reads it back.
+    for (0..3) |_| for ([_]u32{ tok(2, 1 | 4), tok(1, 0), tok(2, 2), tok(3, 2), tok(3, 1), tok(1, 0), tok(2, 3), tok(3, 3) }) |t| {
+        try std.testing.expectEqual(try eval.step(&full, t), try eval.step(&lazy, t));
+        const want = try full.canonical(gpa);
+        defer gpa.free(want);
+        const got = try lazy.canonical(gpa);
+        defer gpa.free(got);
+        try std.testing.expectEqualSlices(u8, want, got);
+    };
+}
+
+test "a node that reads a dim written earlier in stored order sees the write" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    try std.testing.expectEqual(@as(usize, 3), c.batches.len);
+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    _ = try eval.step(&s, tok(1, 0));
+    try std.testing.expectEqual(@as(model.Scalar, 1), s.value(tiny.dims.t1));
+    try std.testing.expectEqual(@as(model.Scalar, 1), s.value(tiny.dims.t2));
+}
+
+test "a machine boots the calc input as RAM data and runs to HALT under a step budget and a cancel flag" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var m = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "A" });
+    defer m.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 'A'), try rc.readWord(&m.state, 64));
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(gpa);
+    var trace: std.ArrayList(u32) = .empty;
+    defer trace.deinit(gpa);
+    var cancel: std.atomic.Value(bool) = .init(false);
+    const first = try m.run(2, &out, &trace, &cancel);
+    try std.testing.expectEqual(api.RunEnd{ .end = .budget, .steps = 2 }, first);
+    const rest = try m.run(100, &out, &trace, &cancel);
+    try std.testing.expectEqual(api.RunEnd{ .end = .halted, .steps = 1 }, rest);
+    try std.testing.expectEqualStrings("hi", out.items);
+    try std.testing.expectEqualSlices(u32, &.{ tok(4, 'h'), tok(4, 'i'), c.halt }, trace.items);
+    try std.testing.expectEqual(api.RunEnd{ .end = .halted, .steps = 0 }, try m.run(100, &out, null, &cancel));
+    var n = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer n.deinit(gpa);
+    cancel.store(true, .release);
+    try std.testing.expectEqual(api.RunEnd{ .end = .cancelled, .steps = 0 }, try n.run(100, &out, null, &cancel));
+    try std.testing.expectError(error.CircuitInputTooLong, rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = &long_input }));
+    try std.testing.expectError(error.CircuitInputNul, rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "1\x002" }));
+}
+
+test "the RAM patch round-trips words and an R read sees the booted input" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var m = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "AB" });
+    defer m.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 'A' | 'B' << 8), try rc.readWord(&m.state, 64));
+    try std.testing.expectEqual(tok(4, '1'), try eval.step(&m.state, tok(3, 2)));
+    var e = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer e.deinit(gpa);
+    try std.testing.expect(!e.state.rowPresent(c.program.ram_tables[0], 2));
+    try std.testing.expectEqual(tok(4, '0'), try eval.step(&e.state, tok(3, 2)));
+}
+
+test "snapshots are canonical: equal histories give equal bytes, a write or a lag changes them" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var a = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer a.deinit(gpa);
+    var b = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer b.deinit(gpa);
+    for ([_]u32{ tok(1, 0), tok(2, 5) }) |t| {
+        _ = try eval.step(&a.state, t);
+        _ = try eval.step(&b.state, t);
+    }
+    const sa = try a.snapshot(gpa);
+    defer gpa.free(sa);
+    const sb = try b.snapshot(gpa);
+    defer gpa.free(sb);
+    try std.testing.expectEqualSlices(u8, sa, sb);
+    _ = try eval.step(&b.state, tok(1, 0));
+    _ = try eval.step(&a.state, tok(4, 'h'));
+    const sa2 = try a.snapshot(gpa);
+    defer gpa.free(sa2);
+    const sb2 = try b.snapshot(gpa);
+    defer gpa.free(sb2);
+    try std.testing.expect(!std.mem.eql(u8, sa2, sb2));
+}
+
+const Seg = struct { typ: u32 = 1, vaddr: u32, data: []const u8, memsz: u32 };
+
+/// A static ELF32 RISC-V executable with the given program headers, data after the header table.
+fn elfImage(entry: u32, segs: []const Seg) ![]u8 {
+    var size: usize = 52 + 32 * segs.len;
+    for (segs) |sg| size += sg.data.len;
+    const b = try gpa.alloc(u8, size);
+    @memset(b, 0);
+    @memcpy(b[0..7], "\x7fELF\x01\x01\x01");
+    const w = std.mem.writeInt;
+    w(u16, b[16..18], 2, .little);
+    w(u16, b[18..20], 243, .little);
+    w(u32, b[24..28], entry, .little);
+    w(u32, b[28..32], 52, .little);
+    w(u16, b[42..44], 32, .little);
+    w(u16, b[44..46], @intCast(segs.len), .little);
+    var off: u32 = @intCast(52 + 32 * segs.len);
+    for (segs, 0..) |sg, i| {
+        const p = b[52 + 32 * i ..][0..32];
+        w(u32, p[0..4], sg.typ, .little);
+        w(u32, p[4..8], off, .little);
+        w(u32, p[8..12], sg.vaddr, .little);
+        w(u32, p[16..20], @intCast(sg.data.len), .little);
+        w(u32, p[20..24], sg.memsz, .little);
+        @memcpy(b[off..][0..sg.data.len], sg.data);
+        off += @intCast(sg.data.len);
+    }
+    return b;
+}
+
+test "an ELF's PT_LOAD segments land in ROM words, DROM and zero-filled RAM; bad images are refused" {
+    const code = [_]u8{ 0x13, 0x05, 0x50, 0x00, 0x73, 0x00, 0x00, 0x00 };
+    const good = try elfImage(0x40004, &.{ .{ .vaddr = 0x40000, .data = &code, .memsz = 8 }, .{ .vaddr = 0x100, .data = "hi", .memsz = 8 }, .{ .vaddr = 0x20000, .data = "ro", .memsz = 2 } });
+    defer gpa.free(good);
+    const img = try elf.parse(gpa, good);
+    defer img.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 0x00500513), img.rom[0]);
+    try std.testing.expectEqual(@as(u32, 0x73), img.rom[1]);
+    try std.testing.expectEqual(@as(u32, 0), img.rom[2]);
+    try std.testing.expectEqualStrings("hi\x00\x00", img.ram[0x100..0x104]);
+    try std.testing.expectEqualStrings("ro", img.drom[0..2]);
+    try std.testing.expectEqual(@as(u32, 0x40004), img.entry);
+    const Bad = struct { entry: u32, seg: Seg, want: anyerror };
+    for ([_]Bad{
+        .{ .entry = 0x40000, .seg = .{ .typ = 3, .vaddr = 0x40000, .data = &code, .memsz = 8 }, .want = error.ElfDynamic },
+        .{ .entry = 0x40000, .seg = .{ .vaddr = 0x7fff, .data = "ab", .memsz = 2 }, .want = error.ElfSegment },
+        .{ .entry = 0x40002, .seg = .{ .vaddr = 0x40000, .data = &code, .memsz = 8 }, .want = error.ElfEntry },
+        .{ .entry = 0x40000, .seg = .{ .vaddr = 0x40000, .data = &code, .memsz = 4 }, .want = error.ElfSegment },
+    }) |bad| {
+        const bytes = try elfImage(bad.entry, &.{bad.seg});
+        defer gpa.free(bytes);
+        try std.testing.expectError(bad.want, elf.parse(gpa, bytes));
+    }
+}
diff --git a/zig/src/core/runner_circuit_tiny_test.zig b/zig/src/core/runner_circuit_tiny_test.zig
new file mode 100644
index 000000000..36329ec6c
--- /dev/null
+++ b/zig/src/core/runner_circuit_tiny_test.zig
@@ -0,0 +1,211 @@
+//! A hand-built circuit file (store/load RAM, a lagged key, a clear decay, a hazard pair, variants) for host tests.
+const std = @import("std");
+
+const kappa = "0.00000095367431640625";
+pub const a_ref = "16777216.0";
+/// Families: 0 GO, 1 A, 2 W (row bits 0-1, data bit 2), 3 R (row bits 0-1), 4 BYTE, 5 HALT.
+pub const sizes = [_]u32{ 1, 1, 8, 4, 512, 1 };
+pub const dims = struct {
+    pub const is_w = 3;
+    pub const is_r = 4;
+    pub const rd = 13;
+    pub const code = 14;
+    pub const t1 = 33;
+    pub const t2 = 34;
+    pub const lagout = 35;
+    pub const lag3out = 36;
+    pub const sum = 37;
+    pub const count = 38;
+};
+pub const family_bits = 3;
+
+pub fn token(family: u32, payload: u32) u32 {
+    var base: u32 = 0;
+    for (sizes[0..family]) |s| base += s;
+    return base + payload;
+}
+
+/// Variants that break one rule, for negative controls.
+pub const Variant = enum { good, two_hot_key, unmapped_go, beta_gated, halving, chained, resting, banks };
+
+/// The container bytes of the tiny circuit.
+pub fn build(a: std.mem.Allocator, variant: Variant) ![]u8 {
+    var j: std.ArrayList(u8) = .empty;
+    defer j.deinit(a);
+    const w = Writer{ .a = a, .j = &j };
+    try w.s("{\"constants\":{\"a_bit\":128.0,\"a_ref\":" ++ a_ref ++ ",\"head_dim\":128,\"one_dim\":0,\"ref_cols\":[0,1]},\"dims\":[");
+    for (0..dims.count) |i| try w.f("{s}{{\"name\":\"d{d}\"}}", .{ if (i == 0) "" else ",", i });
+    try w.s("],\"features\":[");
+    for (0..6) |f| try w.f("{s}{{\"dim\":{d},\"kind\":\"family\",\"family\":{d}}}", .{ if (f == 0) "" else ",", f + 1, f });
+    const bits = [_][3]u32{ .{ 7, 2, 0 }, .{ 8, 2, 1 }, .{ 9, 2, 2 }, .{ 10, 3, 0 }, .{ 11, 3, 1 }, .{ 12, 4, 0 } };
+    for (bits) |b| try w.f(",{{\"dim\":{d},\"kind\":\"payload_bit\",\"family\":{d},\"bit\":{d}}}", .{ b[0], b[1], b[2] });
+    try w.s("],\"format\":\"tensorfold.runner.p2\",\"nodes\":[");
+    try lagHead(w);
+    try w.s(",");
+    try lag3Head(w);
+    try w.s(",");
+    try ramHead(w, variant);
+    if (variant == .banks) try bankHead(w);
+    try w.s(",{\"kind\":\"ffn\",\"name\":\"h1\",\"out\":33,\"into\":false,\"terms\":[[1.0,[[0,1.0]],[[2,1.0]]]]}");
+    try w.s(",{\"kind\":\"ffn\",\"name\":\"h2\",\"out\":34,\"into\":false,\"terms\":[[1.0,[[33,1.0]],[[0,1.0]]]]}");
+    if (variant == .chained) for ([_][2]u32{ .{ 1, 2 }, .{ 2, 3 }, .{ 4, 4 } }, 0..) |t, i| {
+        try w.f(",{{\"kind\":\"ffn\",\"name\":\"c{d}\",\"out\":{d},\"into\":{s},", .{ i, dims.sum, if (i == 0) "false" else "true" });
+        try w.f("\"terms\":[[{d}.0,[[0,1.0]],[[{d},1.0]]]]}}", .{ t[0], t[1] });
+    };
+    if (variant == .resting) try w.f(",{{\"kind\":\"ffn\",\"name\":\"r\",\"out\":{d},\"into\":false,\"terms\":[[3.0,[[0,1.0]],[[0,2.0]]]]}}", .{dims.sum});
+    try codeNodes(w, variant);
+    try w.s("],\"output\":{\"code_dims\":[");
+    for (0..family_bits + 16) |i| try w.f("{s}{d}", .{ if (i == 0) "" else ",", dims.code + i });
+    try w.f("],\"family_bits\":{d},\"families\":", .{family_bits});
+    try families(w);
+    try w.s(",\"payload_bits\":16},\"program\":{\"input_address\":256,\"input_capacity\":256,\"kind\":\"calc\",\"entry\":262144,");
+    try w.s("\"rom_le_hex\":\"");
+    for (0..1 << 16) |_| try w.s("00000000");
+    try w.s("\",\"drom_hex\":\"\",\"ram_hex\":\"");
+    for (0..1 << 13) |_| try w.s("00000000");
+    try w.s("\"},");
+    try w.f("\"stats\":{{\"dims\":{d}}},\"tokens\":{{\"byte_family\":4,\"families\":", .{dims.count});
+    try families(w);
+    try w.f(",\"go\":0,\"halt\":{d},\"vocab\":{d}}},\"version\":1}}", .{ token(5, 0), token(5, 0) + 1 });
+    return container(a, j.items);
+}
+
+pub fn container(a: std.mem.Allocator, body: []const u8) ![]u8 {
+    const out = try a.alloc(u8, 64 + body.len);
+    @memcpy(out[0..8], "TFIMR001");
+    std.mem.writeInt(u32, out[8..12], 1, .little);
+    std.mem.writeInt(u32, out[12..16], 64, .little);
+    std.mem.writeInt(u64, out[16..24], body.len, .little);
+    @memset(out[24..32], 0);
+    std.crypto.hash.sha2.Sha256.hash(body, out[32..64], .{});
+    @memcpy(out[64..], body);
+    return out;
+}
+
+const Writer = struct {
+    a: std.mem.Allocator,
+    j: *std.ArrayList(u8),
+    fn s(w: Writer, text: []const u8) !void {
+        try w.j.appendSlice(w.a, text);
+    }
+    fn f(w: Writer, comptime fmt: []const u8, args: anytype) !void {
+        const text = try std.fmt.allocPrint(w.a, fmt, args);
+        defer w.a.free(text);
+        try w.j.appendSlice(w.a, text);
+    }
+};
+
+fn families(w: Writer) !void {
+    const names = [_][]const u8{ "GO", "A", "W", "R", "BYTE", "HALT" };
+    try w.s("[");
+    for (names, sizes, 0..) |n, size, i| try w.f("{s}{{\"name\":\"{s}\",\"base\":{d},\"size\":{d}}}", .{ if (i == 0) "" else ",", n, token(@intCast(i), 0), size });
+    try w.s("]");
+}
+
+/// One-hot row select: relu(flag + sum of literals - bits) over the payload bits of a family.
+fn selectChannel(w: Writer, row: u32, flag: u32, bit_dims: [2]u32) !void {
+    return selectAt(w, row, row, flag, bit_dims);
+}
+
+/// Channel `at` fires when the payload bits spell `row`.
+fn selectAt(w: Writer, at: u32, row: u32, flag: u32, bit_dims: [2]u32) !void {
+    var flag_coef: i32 = 1;
+    for (0..2) |b| flag_coef += @intFromBool(row >> @intCast(b) & 1 == 0);
+    try w.f("[{d},{{\"expr\":[[{d},{d}.0]", .{ at, flag, flag_coef });
+    for (bit_dims, 0..) |d, b| try w.f(",[{d},{s}1.0]", .{ d, if (row >> @intCast(b) & 1 == 1) "" else "-" });
+    try w.s(",[0,-2.0]],\"taps\":[1.0,0.0,0.0,0.0]}]");
+}
+
+/// A key from the previous token being W (a lag-1 tap), a read on A, a clear on BYTE; output to lagout.
+fn lagHead(w: Writer) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"lag\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,");
+    try w.s("\"q\":[[0,{\"expr\":[[2,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"k\":[[0,{\"expr\":[[3,1.0]],\"taps\":[0.0,1.0,0.0,0.0]}]],");
+    try w.s("\"value_heads\":[{\"v\":[[0,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],");
+    try w.s("[2,{\"expr\":[[0,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"a\":[[5,238.0]],\"beta\":null,\"z\":[[2,[[0,1.0]]]],");
+    try w.s("\"out\":[[2,35,16384.0]],\"into\":false,\"init\":[]}]}");
+}
+
+/// A key from the token three back being W (taps 0,0,0,1), read on A, output to lag3out.
+fn lag3Head(w: Writer) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"lag3\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,");
+    try w.s("\"q\":[[0,{\"expr\":[[2,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"k\":[[0,{\"expr\":[[3,1.0]],\"taps\":[0.0,0.0,0.0,1.0]}]],");
+    try w.s("\"value_heads\":[{\"v\":[[0,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],");
+    try w.s("[2,{\"expr\":[[0,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"a\":[],\"beta\":null,\"z\":[[2,[[0,1.0]]]],");
+    try w.s("\"out\":[[2,36,16384.0]],\"into\":false,\"init\":[]}]}");
+}
+
+/// ram0: W writes row (payload bits 0-1), data bit 2 to column 2; R reads to rd; row 3 is 1. halving: A halves table 2.
+fn ramHead(w: Writer, variant: Variant) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"ram0\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,\"q\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectChannel(w, @intCast(r), dims.is_r, .{ 10, 11 });
+    }
+    try w.s("],\"k\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectChannel(w, @intCast(r), dims.is_w, .{ 7, 8 });
+    }
+    if (variant == .two_hot_key) try w.s(",[9,{\"expr\":[[3,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]");
+    const v = "\"v\":[[0,{\"expr\":[[3," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[3," ++ a_ref ++
+        "]],\"taps\":[1.0,0.0,0.0,0.0]}],[2,{\"expr\":[[9,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],";
+    const beta = if (variant == .beta_gated) "\"beta\":[[0,1.0],[9,-1.0]]," else "\"beta\":null,";
+    try w.s("],\"value_heads\":[{" ++ v ++ "\"a\":[],");
+    try w.s(beta);
+    try w.s("\"z\":[[2,[[4,1.0]]]],\"out\":[[2,13,16384.0]],\"into\":false,");
+    try w.s("\"init\":[[3,[[0," ++ a_ref ++ "],[1," ++ a_ref ++ "],[2,128.0]]]]},{" ++ v);
+    try w.s(if (variant == .halving) "\"a\":[[2,110.0]]," else "\"a\":[],");
+    try w.s(beta);
+    try w.s("\"z\":[],\"out\":[],\"into\":false,\"init\":[]}]}");
+}
+
+/// mirror for .banks: ram0's inputs, row r at table row r ^ 1, read to dims.sum; its data bit is the previous step's.
+fn bankHead(w: Writer) !void {
+    try w.s(",{\"kind\":\"head\",\"name\":\"mirror\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,\"q\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectAt(w, @intCast(r ^ 1), @intCast(r), dims.is_r, .{ 10, 11 });
+    }
+    try w.s("],\"k\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectAt(w, @intCast(r ^ 1), @intCast(r), dims.is_w, .{ 7, 8 });
+    }
+    try w.s("],\"value_heads\":[{\"v\":[[0,{\"expr\":[[3," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[3," ++ a_ref);
+    try w.s("]],\"taps\":[1.0,0.0,0.0,0.0]}],[2,{\"expr\":[[9,128.0]],\"taps\":[0.0,1.0,0.0,0.0]}]],\"a\":[],\"beta\":null,");
+    try w.f("\"z\":[[2,[[4,1.0]]]],\"out\":[[2,{d},16384.0]],\"into\":false,\"init\":[]}}]}}", .{dims.sum});
+}
+
+/// One FFN per code dim: GO->BYTE('h'), BYTE even->+1, BYTE odd->HALT, A->A, W->A, R->BYTE('0'+rd), HALT->HALT.
+fn codeNodes(w: Writer, variant: Variant) !void {
+    const Rule = struct { up: []const u8, target: u32 };
+    const rules = [_]Rule{
+        .{ .up = "[[1,1.0]]", .target = token(4, 'h') },
+        .{ .up = "[[2,1.0]]", .target = token(1, 0) },
+        .{ .up = "[[3,1.0]]", .target = token(1, 0) },
+        .{ .up = "[[4,1.0]]", .target = token(4, '0') },
+        .{ .up = "[[5,1.0],[12,-1.0]]", .target = token(4, 'i') },
+        .{ .up = "[[12,1.0]]", .target = token(5, 0) },
+        .{ .up = "[[6,1.0]]", .target = token(5, 0) },
+    };
+    for (0..family_bits + 16) |i| {
+        try w.f(",{{\"kind\":\"ffn\",\"name\":\"code{d}\",\"out\":{d},\"into\":false,\"terms\":[", .{ i, dims.code + i });
+        for (rules, 0..) |r, n| {
+            if (variant == .unmapped_go and n == 0) continue;
+            const code = codeOf(r.target);
+            const sign: []const u8 = if (code >> @intCast(i) & 1 == 1) "" else "-";
+            try w.f("{s}[{s}" ++ kappa ++ ",{s},[[0,1.0]]]", .{ if (n == @intFromBool(variant == .unmapped_go)) "" else ",", sign, r.up });
+        }
+        if (i == family_bits) try w.s(",[0.0000019073486328125,[[13,1.0]],[[4,1.0]]]");
+        try w.s("]}");
+    }
+}
+
+fn codeOf(t: u32) u64 {
+    var base: u32 = 0;
+    for (sizes, 0..) |s, f| {
+        if (t < base + s) return @as(u64, f) | @as(u64, t - base) << family_bits;
+        base += s;
+    }
+    unreachable;
+}
diff --git a/zig/src/core/runner_commit.zig b/zig/src/core/runner_commit.zig
new file mode 100644
index 000000000..6d78d767a
--- /dev/null
+++ b/zig/src/core/runner_commit.zig
@@ -0,0 +1,423 @@
+//! Answer-commit (PREFIX_COMMIT): an owned value of the task's own expression closes the think and is the answer.
+const std = @import("std");
+const scan = @import("runner_scan.zig");
+const value = @import("runner_output.zig").value;
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner);
+
+/// A request's commit settings (Request.run_commit); empty `close`: never fires.
+pub const Ask = struct {
+    close: []const u32 = &.{}, // the think close the stream writes (server.think_close)
+    task: []const u8 = "", // the last user message's text
+    eos: ?u32 = null, // the token that ends the reply after the answer
+    max_new: u32 = 0, // the reply's token limit
+    answer_max: u32 = 0, // tokens after the think close at most (0: max_new alone)
+    tools: bool = false, // the request offers tools: the answer may be a call, so never
+};
+
+/// A session's commit state: its ask, the think state of the token fed last, and whether it fired.
+pub const State = struct {
+    ask: Ask = .{},
+    think: bool = false,
+    fired: bool = false,
+};
+
+/// Feed: the token's think state kept for a trigger; true once fired (the scanner sees nothing after the answer).
+pub fn skip(st: *State, think_open: bool) bool {
+    st.think = think_open;
+    return st.fired;
+}
+
+/// The firing's write as it lands: the close, then the value (the answer field's bytes), then the end.
+pub const Record = struct {
+    cell: u32,
+    want: []u32, // close ++ value ++ eos (gpa)
+    close_len: u32,
+    value_len: u32,
+    landed: u32 = 0, // of `want`, committed in order (fewer: another token came, or the reply ended)
+    close_token: u32 = 0, // the reply's tokens before the close
+    token: u32 = 0, // the reply's tokens before the value
+    at: u64 = 0, // the content field's bytes before the value
+    value: std.ArrayList(u8) = .empty,
+    cut: bool = false,
+
+    /// A committed token after the cell's own write; `content_bytes`/`tokens` count those before it.
+    pub fn land(r: *Record, gpa: Allocator, id: u32, bytes: []const u8, content_bytes: u64, tokens: u32) Allocator.Error!void {
+        if (r.cut or r.landed >= r.want.len) return;
+        if (r.want[r.landed] != id) {
+            r.cut = true; // nothing after another token lands
+            return;
+        }
+        if (r.landed == 0) r.close_token = tokens;
+        if (r.landed == r.close_len) {
+            r.token = tokens;
+            r.at = content_bytes;
+        }
+        if (r.landed >= r.close_len and r.landed < r.close_len + r.value_len) try r.value.appendSlice(gpa, bytes);
+        r.landed += 1;
+    }
+
+    pub fn deinit(r: *Record, gpa: Allocator) void {
+        gpa.free(r.want);
+        r.value.deinit(gpa);
+    }
+};
+
+/// The receipt's `"commit"` object: the cell whose span is the task's expression, its answer as landed, where.
+pub fn write(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, r: Record) Allocator.Error!void {
+    const receipt = @import("runner_receipt.zig");
+    try o.print(gpa, ",\"commit\":{{\"cell\":{d},\"why\":\"whole-task\",", .{r.cell});
+    try receipt.text(o, gpa, "span", cells[r.cell].code);
+    try receipt.text(o, gpa, "value", r.value.items);
+    try o.print(gpa, "\"field\":\"content\",\"at\":{d},\"token\":{d},\"close_token\":{d},\"ids\":{d},\"landed\":{d},\"closed\":{},\"ended\":{}}}", .{ r.at, r.token, r.close_token, r.close_len + r.value_len + 1, r.landed, r.landed >= r.close_len, r.landed == r.close_len + r.value_len + 1 });
+}
+
+/// `ids` (the owned cell's result, already recorded) then the commit's tokens when it fires (`ids` freed or returned).
+pub fn after(s: anytype, cell: anytype, w: scan.Trigger, index: u32, ids: []u32) Allocator.Error![]u32 {
+    const gpa = s.r.gpa;
+    if (!s.r.cfg.commit or s.commit.fired or !try fires(gpa, s, cell, w)) return ids;
+    const tx = s.r.text.?;
+    const ask = s.commit.ask;
+    const v = value(cell.result.?.out);
+    const vid = try tx.encode(tx.ctx, gpa, v);
+    defer gpa.free(vid);
+    // after the think end: at most the close's own tokens, the value and the end
+    if (vid.len > s.r.cfg.max_tokens or (ask.answer_max > 0 and ask.close.len + vid.len + 1 > ask.answer_max)) return ids;
+    // the stream forces at most its room less one: every token must fit, or the answer would be a cut number
+    if (@as(u64, s.rec.tokens) + ids.len + ask.close.len + vid.len + 2 > ask.max_new) return ids;
+    const tail = try std.mem.concat(gpa, u32, &.{ ask.close, vid, &.{ask.eos.?} });
+    errdefer gpa.free(tail);
+    const all = try std.mem.concat(gpa, u32, &.{ ids, tail });
+    errdefer gpa.free(all);
+    s.rec.commit = .{ .cell = index, .want = tail, .close_len = @intCast(ask.close.len), .value_len = @intCast(vid.len) };
+    gpa.free(ids);
+    s.commit.fired = true;
+    if (s.forcing) |*f| f.left += tail.len;
+    log.info("reply {d} cell {d}: commit, the think closes and {d} value tokens are the answer", .{ s.id, index, vid.len });
+    return all;
+}
+
+/// Every guard but the room: only what the oracle checks (the task's one expression as the span, an integer value).
+fn fires(gpa: Allocator, s: anytype, cell: anytype, w: scan.Trigger) Allocator.Error!bool {
+    const ask = s.commit.ask;
+    if (ask.close.len == 0 or ask.eos == null or ask.tools or !s.rec.on) return false;
+    // inside reasoning, after a closed cell: never a trace envelope, an EOS hand-off or an open fence
+    if (!s.commit.think or w.trace or w.terminal or cell.stated != null or s.scan.state == .fence) return false;
+    const res = cell.result orelse return false;
+    if (res.status != .ok or !integer(value(res.out))) return false;
+    const task = try expression(gpa, ask.task) orelse return false;
+    defer gpa.free(task);
+    const span = try spanOf(gpa, cell.code, cell.form) orelse return false;
+    defer gpa.free(span);
+    return same(task, span);
+}
+
+/// A decimal integer as Python prints one: an optional minus, digits, no leading zero.
+pub fn integer(v: []const u8) bool {
+    const d = if (std.mem.startsWith(u8, v, "-")) v[1..] else v;
+    if (d.len == 0 or (d.len > 1 and d[0] == '0') or std.mem.eql(u8, v, "-0")) return false;
+    for (d) |c| if (!std.ascii.isDigit(c)) return false;
+    return true;
+}
+
+/// The one closed literal expression `text` states, normalized, when every digit in `text` is in it; else null.
+pub fn expression(a: Allocator, text: []const u8) Allocator.Error!?[]u8 {
+    const words = try spoken(a, text);
+    defer a.free(words);
+    var found: ?[]u8 = null;
+    errdefer if (found) |f| a.free(f);
+    var i: usize = 0;
+    var digits: usize = 0; // digits outside the expression found
+    while (i < words.len) {
+        if (!inRun(words[i])) {
+            i += 1;
+            continue;
+        }
+        var j = i;
+        while (j < words.len and inRun(words[j])) j += 1;
+        const run = std.mem.trim(u8, words[i..j], " \t\r\n,");
+        i = j;
+        var n: usize = 0;
+        for (run) |c| n += @intFromBool(std.ascii.isDigit(c));
+        if (n == 0) continue;
+        const e = try normalize(a, run, true) orelse {
+            digits += n;
+            continue;
+        };
+        if (found != null or !binary(e)) {
+            a.free(e);
+            digits += n;
+            continue;
+        }
+        found = e;
+    }
+    if (digits > 0) {
+        if (found) |f| a.free(f);
+        return null;
+    }
+    return found;
+}
+
+fn inRun(c: u8) bool {
+    return std.ascii.isDigit(c) or std.mem.indexOfScalar(u8, " \t+-*/%()^,_", c) != null;
+}
+
+/// `text` with the spelled operators as symbols (`divided by` `/`, `mod` `%`, `times` `*`, `×` `*`, `−` `-`, …).
+fn spoken(a: Allocator, text: []const u8) Allocator.Error![]u8 {
+    const subs = [_][2][]const u8{
+        .{ "divided by", "/" },
+        .{ "mod", "%" },
+        .{ "times", "*" },
+        .{ "plus", "+" },
+        .{ "minus", "-" },
+        .{ "\u{00d7}", "*" },
+        .{ "\u{00b7}", "*" },
+        .{ "\u{00f7}", "/" },
+        .{ "\u{2212}", "-" },
+    };
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    var i: usize = 0;
+    next: while (i < text.len) {
+        for (subs) |sub| if (i + sub[0].len <= text.len and std.ascii.eqlIgnoreCase(text[i .. i + sub[0].len], sub[0])) {
+            const word = std.ascii.isAlphabetic(sub[0][0]);
+            const before = i == 0 or !std.ascii.isAlphanumeric(text[i - 1]);
+            const end = i + sub[0].len;
+            if (!word or (before and (end == text.len or !std.ascii.isAlphanumeric(text[end])))) {
+                try out.appendSlice(a, sub[1]);
+                i = end;
+                continue :next;
+            }
+        };
+        try out.append(a, text[i]);
+        i += 1;
+    }
+    return out.toOwnedSlice(a);
+}
+
+/// A cell's span as the expression it computes: inline as written, else its last `print(<expr>)` over literal names.
+pub fn spanOf(a: Allocator, code: []const u8, form: anytype) Allocator.Error!?[]u8 {
+    if (form == .inline_expr) {
+        const words = try spoken(a, code);
+        defer a.free(words);
+        return normalize(a, words, true);
+    }
+    var names: std.ArrayList([2][]const u8) = .empty;
+    defer names.deinit(a);
+    var last: ?[]const u8 = null;
+    var it = std.mem.splitScalar(u8, std.mem.trim(u8, code, " \t\r\n"), '\n');
+    while (it.next()) |raw| {
+        var line = std.mem.trim(u8, raw, " \t\r");
+        if (std.mem.startsWith(u8, line, ">>> ")) line = line[4..];
+        if (line.len == 0) continue;
+        if (last != null) return null; // the printed expression is the cell's last statement
+        if (assignment(line)) |as| {
+            for (names.items) |n| if (std.mem.eql(u8, n[0], as[0])) return null; // rebound
+            try names.append(a, as);
+            continue;
+        }
+        last = if (std.mem.startsWith(u8, line, "print(") and line[line.len - 1] == ')') line[6 .. line.len - 1] else line;
+    }
+    const e = last orelse return null;
+    var sub: std.ArrayList(u8) = .empty;
+    defer sub.deinit(a);
+    var i: usize = 0;
+    while (i < e.len) {
+        if (std.ascii.isAlphabetic(e[i]) or e[i] == '_') {
+            var j = i;
+            while (j < e.len and (std.ascii.isAlphanumeric(e[j]) or e[j] == '_')) j += 1;
+            const name = e[i..j];
+            const rhs = for (names.items) |n| {
+                if (std.mem.eql(u8, n[0], name)) break n[1];
+            } else return null; // a call or an unknown name
+            try sub.print(a, "({s})", .{rhs});
+            i = j;
+            continue;
+        }
+        try sub.append(a, e[i]);
+        i += 1;
+    }
+    return normalize(a, sub.items, false);
+}
+
+/// `name = <literal right side>` (no other name on the right).
+fn assignment(line: []const u8) ?[2][]const u8 {
+    const eq = std.mem.indexOfScalar(u8, line, '=') orelse return null;
+    if (eq + 1 < line.len and line[eq + 1] == '=') return null;
+    const name = std.mem.trim(u8, line[0..eq], " \t");
+    if (name.len == 0 or !(std.ascii.isAlphabetic(name[0]) or name[0] == '_')) return null;
+    for (name) |c| if (!(std.ascii.isAlphanumeric(c) or c == '_')) return null;
+    const rhs = std.mem.trim(u8, line[eq + 1 ..], " \t");
+    for (rhs) |c| if (std.ascii.isAlphabetic(c)) return null;
+    return .{ name, rhs };
+}
+
+/// A literal-only expression in one spelling (digit groups joined, `**` powers, `(n)` as n); null if not well formed.
+pub fn normalize(a: Allocator, src: []const u8, caret: bool) Allocator.Error!?[]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    var i: usize = 0;
+    while (i < src.len) {
+        const c = src[i];
+        if (c == ' ' or c == '\t') {
+            i += 1;
+        } else if (std.ascii.isDigit(c)) {
+            while (i < src.len) {
+                if (std.ascii.isDigit(src[i])) {
+                    try out.append(a, src[i]);
+                    i += 1;
+                } else if ((src[i] == ',' and group(src, i + 1)) or
+                    (src[i] == '_' and i + 1 < src.len and std.ascii.isDigit(src[i + 1])))
+                {
+                    i += 1;
+                } else break;
+            }
+        } else if (c == '^') {
+            if (!caret) return fail(a, &out);
+            try out.appendSlice(a, "**");
+            i += 1;
+        } else if (std.mem.indexOfScalar(u8, "+-*/%()", c) != null) {
+            try out.append(a, c);
+            i += 1;
+        } else return fail(a, &out);
+    }
+    const s = try out.toOwnedSlice(a);
+    errdefer a.free(s);
+    const plain = try unbracket(a, s);
+    a.free(s);
+    if (!wellFormed(plain)) {
+        a.free(plain);
+        return null;
+    }
+    return plain;
+}
+
+fn fail(a: Allocator, out: *std.ArrayList(u8)) ?[]u8 {
+    out.deinit(a);
+    return null;
+}
+
+/// Three digits at `i`, then no further digit.
+fn group(s: []const u8, i: usize) bool {
+    if (i + 3 > s.len) return false;
+    for (s[i .. i + 3]) |c| if (!std.ascii.isDigit(c)) return false;
+    return i + 3 == s.len or !std.ascii.isDigit(s[i + 3]);
+}
+
+/// `(digits)` as `digits`, again until none is left, and brackets around the whole expression dropped.
+fn unbracket(a: Allocator, s: []const u8) Allocator.Error![]u8 {
+    var cur = try a.dupe(u8, s);
+    while (cur.len >= 2 and cur[0] == '(' and closing(cur) == cur.len - 1) {
+        const inner = try a.dupe(u8, cur[1 .. cur.len - 1]);
+        a.free(cur);
+        cur = inner;
+    }
+    while (true) {
+        var i: usize = 0;
+        const hit = while (i < cur.len) : (i += 1) {
+            if (cur[i] != '(') continue;
+            var j = i + 1;
+            while (j < cur.len and std.ascii.isDigit(cur[j])) j += 1;
+            if (j > i + 1 and j < cur.len and cur[j] == ')') break .{ i, j };
+        } else null;
+        const h = hit orelse return cur;
+        const next = try std.mem.concat(a, u8, &.{ cur[0..h[0]], cur[h[0] + 1 .. h[1]], cur[h[1] + 1 ..] });
+        a.free(cur);
+        cur = next;
+    }
+}
+
+/// The index of the bracket closing the one `e` opens with (null: unbalanced).
+fn closing(e: []const u8) ?usize {
+    var depth: usize = 0;
+    for (e, 0..) |c, i| switch (c) {
+        '(' => depth += 1,
+        ')' => {
+            if (depth == 0) return null;
+            depth -= 1;
+            if (depth == 0) return i;
+        },
+        else => {},
+    };
+    return null;
+}
+
+/// Infix over integers: unary signs, `+ - * / // % **`, balanced brackets.
+fn wellFormed(s: []const u8) bool {
+    var p: Parse = .{ .s = s };
+    return p.expr() and p.i == s.len;
+}
+
+const Parse = struct {
+    s: []const u8,
+    i: usize = 0,
+    depth: u32 = 0,
+
+    fn expr(p: *Parse) bool {
+        if (!p.unary()) return false;
+        while (p.i < p.s.len and std.mem.indexOfScalar(u8, "+-*/%", p.s[p.i]) != null) {
+            p.i += 1;
+            if (p.i < p.s.len and (p.s[p.i] == '*' or p.s[p.i] == '/') and p.s[p.i - 1] == p.s[p.i]) p.i += 1;
+            if (!p.unary()) return false;
+        }
+        return true;
+    }
+
+    fn unary(p: *Parse) bool {
+        while (p.i < p.s.len and (p.s[p.i] == '-' or p.s[p.i] == '+')) p.i += 1;
+        if (p.i >= p.s.len) return false;
+        if (std.ascii.isDigit(p.s[p.i])) {
+            while (p.i < p.s.len and std.ascii.isDigit(p.s[p.i])) p.i += 1;
+            return true;
+        }
+        if (p.s[p.i] != '(' or p.depth > 64) return false;
+        p.i += 1;
+        p.depth += 1;
+        if (!p.expr() or p.i >= p.s.len or p.s[p.i] != ')') return false;
+        p.depth -= 1;
+        p.i += 1;
+        return true;
+    }
+};
+
+/// A binary operator at any depth (not only a signed number).
+fn binary(e: []const u8) bool {
+    for (e, 0..) |c, i| if (i > 0 and std.mem.indexOfScalar(u8, "+-*/%", c) != null and
+        (std.ascii.isDigit(e[i - 1]) or e[i - 1] == ')')) return true;
+    return false;
+}
+
+/// The same expression, or one sum or product of two operands written the other way round.
+pub fn same(task: []const u8, span: []const u8) bool {
+    if (std.mem.eql(u8, task, span)) return true;
+    const x = split(task) orelse return false;
+    const y = split(span) orelse return false;
+    return x.op == y.op and std.mem.eql(u8, x.left, y.right) and std.mem.eql(u8, x.right, y.left);
+}
+
+const Split = struct { left: []const u8, op: u8, right: []const u8 };
+
+/// `left + right` or `left * right` when that is the only binary operator outside brackets.
+fn split(e: []const u8) ?Split {
+    var depth: i32 = 0;
+    var at: ?usize = null;
+    for (e, 0..) |c, i| {
+        switch (c) {
+            '(' => depth += 1,
+            ')' => depth -= 1,
+            '+', '-', '*', '/', '%' => if (depth == 0 and i > 0 and (std.ascii.isDigit(e[i - 1]) or e[i - 1] == ')')) {
+                if (at != null) return null;
+                at = i;
+            },
+            else => {},
+        }
+    }
+    const k = at orelse return null;
+    if (e[k] != '+' and e[k] != '*') return null;
+    if (k + 1 < e.len and (e[k + 1] == '*' or e[k + 1] == '/')) return null; // `**`
+    return .{ .left = e[0..k], .op = e[k], .right = e[k + 1 ..] };
+}
+
+test {
+    _ = @import("runner_commit_test.zig");
+}
diff --git a/zig/src/core/runner_commit_test.zig b/zig/src/core/runner_commit_test.zig
new file mode 100644
index 000000000..9a69b8b8c
--- /dev/null
+++ b/zig/src/core/runner_commit_test.zig
@@ -0,0 +1,355 @@
+//! PREFIX_COMMIT end to end on a lane host (the think closes after the owned value, the answer), and each guard.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const runner = @import("runner.zig");
+const scan = @import("runner_scan.zig");
+const answer = @import("runner_commit.zig");
+const rt = @import("runner_test.zig");
+
+const gpa = std.testing.allocator;
+const lead = "Let me check.\n```python\nprint(47 * 83)\n```\nResult:\n";
+const task = "What is 47 * 83? Give the exact integer.";
+const end = rt.id('|'); // the think end: `|` is in no script here
+const close = [_]u32{ rt.id('\n'), end, rt.id('\n') };
+const ask: answer.Ask = .{ .close = &close, .task = task, .eos = 96, .max_new = 400 };
+
+const Commit = struct { cell: u32, why: []const u8, span: []const u8, value: []const u8, field: []const u8, at: u64, token: u32, close_token: u32, ids: u32, landed: u32, closed: bool, ended: bool };
+const Receipt = struct { commit: ?Commit = null, cells: []const struct { cell: u32, value: []const u8, landed: u32, ids: u32 } = &.{} };
+
+/// One reply and its receipt with its wall-clock fields as 0 (both gpa).
+fn reply(text: []const u8, o: rt.Opts) !struct { text: []u8, receipt: []u8 } {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    var m = [_]rt.Model{.{ .lead = text }};
+    var sums: [1][]u8 = undefined;
+    var opts = o;
+    opts.summaries = &sums;
+    const texts = try rt.replies(&m, opts, &back);
+    defer gpa.free(texts);
+    defer gpa.free(sums[0]);
+    return .{ .text = texts[0], .receipt = try untimed(sums[0]) };
+}
+
+/// `receipt` with `held_ms` and `resume_ms` as 0: a loaded host's hold is longer, the reply the same.
+fn untimed(receipt: []const u8) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(gpa);
+    var i: usize = 0;
+    while (i < receipt.len) {
+        const at = for ([_][]const u8{ "\"held_ms\":", "\"resume_ms\":" }) |key| {
+            if (std.mem.startsWith(u8, receipt[i..], key)) break key.len;
+        } else null;
+        if (at) |n| {
+            try out.appendSlice(gpa, receipt[i .. i + n]);
+            try out.append(gpa, '0');
+            i += n;
+            while (i < receipt.len and std.ascii.isDigit(receipt[i])) i += 1;
+            continue;
+        }
+        try out.append(gpa, receipt[i]);
+        i += 1;
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+fn parse(receipt: []const u8) !std.json.Parsed(Receipt) {
+    return std.json.parseFromSlice(Receipt, gpa, receipt, .{ .ignore_unknown_fields = true, .allocate = .alloc_always });
+}
+
+test "runner commit: an owned value of the task's expression closes the think and is the answer, with its record" {
+    const on = try reply(lead, .{ .commit = true, .commit_ask = ask, .think_end = end });
+    defer gpa.free(on.text);
+    defer gpa.free(on.receipt);
+    try std.testing.expectEqualStrings(lead ++ "3901\n" ++ "\n|\n" ++ "3901", on.text);
+    const p = try parse(on.receipt);
+    defer p.deinit();
+    const c = p.value.commit.?;
+    try std.testing.expectEqual(@as(u32, 0), c.cell);
+    try std.testing.expectEqualStrings("whole-task", c.why);
+    try std.testing.expectEqualStrings("print(47 * 83)\n", c.span);
+    try std.testing.expectEqualStrings("3901", c.value);
+    try std.testing.expectEqualStrings("content", c.field);
+    try std.testing.expectEqual(@as(u32, close.len + 4 + 1), c.ids);
+    try std.testing.expectEqual(c.ids, c.landed);
+    try std.testing.expect(c.closed and c.ended);
+    // the cell's write lands, then the close, then the value: one content byte (the close's newline) before it
+    try std.testing.expectEqual(@as(u32, lead.len + 5), c.close_token);
+    try std.testing.expectEqual(@as(u32, lead.len + 5 + close.len), c.token);
+    try std.testing.expectEqual(@as(u64, 1), c.at);
+    try std.testing.expectEqual(@as(usize, 1), p.value.cells.len);
+    try std.testing.expectEqualStrings("\n3901\n", p.value.cells[0].value); // from the header's newline
+    try std.testing.expectEqual(p.value.cells[0].ids, p.value.cells[0].landed);
+}
