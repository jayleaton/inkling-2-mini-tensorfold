new file mode 100644
index 000000000..aa6112fac
--- /dev/null
+++ b/zig/src/core/runner_frontend_python_expr.zig
@@ -0,0 +1,360 @@
+const std = @import("std");
+const ast = @import("runner_frontend_python_ast.zig");
+
+pub fn parse(program: *ast.Program, source: []const u8) ast.Error!usize {
+    if (!std.unicode.utf8ValidateSlice(source)) return error.Unsupported;
+    var p: Parser = .{ .program = program, .source = source };
+    const root = try p.expression();
+    try p.end();
+    try boundedDepth(program, root, 0);
+    return root;
+}
+
+pub fn parseArgs(program: *ast.Program, source: []const u8) ast.Error![]const usize {
+    if (!std.unicode.utf8ValidateSlice(source)) return error.Unsupported;
+    var p: Parser = .{ .program = program, .source = source };
+    var args: std.ArrayList(usize) = .empty;
+    p.space();
+    if (p.pos == p.source.len) return &.{};
+    while (true) {
+        if (args.items.len >= 128) return error.Unsupported;
+        const root = try p.expression();
+        try boundedDepth(program, root, 0);
+        try args.append(program.a, root);
+        if (!p.eat(",")) break;
+        p.space();
+        if (p.pos == p.source.len) break;
+    }
+    try p.end();
+    return args.toOwnedSlice(program.a);
+}
+
+const Parser = struct {
+    program: *ast.Program,
+    source: []const u8,
+    pos: usize = 0,
+    depth: usize = 0,
+
+    fn space(p: *Parser) void {
+        while (p.pos < p.source.len and p.source[p.pos] == ' ') p.pos += 1;
+    }
+
+    fn eat(p: *Parser, token: []const u8) bool {
+        p.space();
+        if (!std.mem.startsWith(u8, p.source[p.pos..], token)) return false;
+        const end_pos = p.pos + token.len;
+        if (nameChar(token[token.len - 1]) and end_pos < p.source.len and nameChar(p.source[end_pos])) return false;
+        p.pos = end_pos;
+        return true;
+    }
+
+    fn need(p: *Parser, token: []const u8) ast.Invalid!void {
+        if (!p.eat(token)) return error.Unsupported;
+    }
+
+    fn end(p: *Parser) ast.Invalid!void {
+        p.space();
+        if (p.pos != p.source.len) return error.Unsupported;
+    }
+
+    fn identifier(p: *Parser) ast.Invalid![]const u8 {
+        p.space();
+        const start = p.pos;
+        if (start == p.source.len or !(std.ascii.isAlphabetic(p.source[start]) or p.source[start] == '_'))
+            return error.Unsupported;
+        p.pos += 1;
+        while (p.pos < p.source.len and nameChar(p.source[p.pos])) p.pos += 1;
+        return p.source[start..p.pos];
+    }
+
+    fn expression(p: *Parser) ast.Error!usize {
+        if (p.depth >= 8) return error.Unsupported;
+        p.depth += 1;
+        defer p.depth -= 1;
+        var root = try p.conjunction();
+        while (p.eat("or")) root = try p.binary(.logical_or, root, try p.conjunction());
+        return root;
+    }
+
+    fn conjunction(p: *Parser) ast.Error!usize {
+        var root = try p.inversion();
+        while (p.eat("and")) root = try p.binary(.logical_and, root, try p.inversion());
+        return root;
+    }
+
+    fn inversion(p: *Parser) ast.Error!usize {
+        if (p.eat("not")) {
+            if (p.depth >= 8) return error.Unsupported;
+            p.depth += 1;
+            defer p.depth -= 1;
+            return p.program.node(.{ .tag = .logical_not, .lhs = try p.inversion() });
+        }
+        var root = try p.additive();
+        const tag: ast.Tag = if (p.eat("==")) .eq else if (p.eat("!=")) .ne else if (p.eat("<=")) .le else if (p.eat(">=")) .ge else if (p.eat("<")) .lt else if (p.eat(">")) .gt else return root;
+        root = try p.binary(tag, root, try p.additive());
+        return root;
+    }
+
+    fn additive(p: *Parser) ast.Error!usize {
+        var root = try p.product();
+        while (true) {
+            const tag: ast.Tag = if (p.eat("+")) .add else if (p.eat("-")) .sub else break;
+            root = try p.binary(tag, root, try p.product());
+        }
+        return root;
+    }
+
+    fn product(p: *Parser) ast.Error!usize {
+        var root = try p.unary();
+        while (true) {
+            const tag: ast.Tag = if (p.eat("//")) .floor else if (p.eat("%")) .modulo else if (p.eat("*")) .mul else break;
+            root = try p.binary(tag, root, try p.unary());
+        }
+        return root;
+    }
+
+    fn unary(p: *Parser) ast.Error!usize {
+        if (p.eat("-")) {
+            if (p.depth >= 8) return error.Unsupported;
+            p.depth += 1;
+            defer p.depth -= 1;
+            return p.program.node(.{ .tag = .neg, .lhs = try p.unary() });
+        }
+        if (p.eat("+")) {
+            if (p.depth >= 8) return error.Unsupported;
+            p.depth += 1;
+            defer p.depth -= 1;
+            const zero = try p.program.node(.{ .tag = .integer });
+            return p.binary(.add, zero, try p.unary());
+        }
+        var root = try p.atom();
+        if (p.eat("[")) {
+            root = try p.program.node(.{ .tag = .index, .lhs = root, .rhs = try p.expression() });
+            try p.need("]");
+        }
+        return root;
+    }
+
+    fn binary(p: *Parser, tag: ast.Tag, lhs: usize, rhs: usize) ast.Error!usize {
+        return p.program.node(.{ .tag = tag, .lhs = lhs, .rhs = rhs });
+    }
+
+    fn atom(p: *Parser) ast.Error!usize {
+        if (p.eat("(")) {
+            const root = try p.expression();
+            try p.need(")");
+            return root;
+        }
+        if (p.eat("[")) return p.sequence();
+        if (p.eat("True")) return p.program.node(.{ .tag = .boolean, .value = 1 });
+        if (p.eat("False")) return p.program.node(.{ .tag = .boolean, .value = 0 });
+        p.space();
+        if (p.pos >= p.source.len) return error.Unsupported;
+        if (p.source[p.pos] == '\'' or p.source[p.pos] == '"') return p.string(false);
+        if (p.source[p.pos] == 'f' and p.pos + 1 < p.source.len and
+            (p.source[p.pos + 1] == '\'' or p.source[p.pos + 1] == '"'))
+        {
+            p.pos += 1;
+            return p.string(true);
+        }
+        if (std.ascii.isDigit(p.source[p.pos])) {
+            const start = p.pos;
+            while (p.pos < p.source.len and std.ascii.isDigit(p.source[p.pos])) p.pos += 1;
+            const text = p.source[start..p.pos];
+            if (text.len > 1 and text[0] == '0') return error.Unsupported;
+            const value = std.fmt.parseInt(i64, text, 10) catch return error.Unsupported;
+            if (value > std.math.maxInt(i32)) return error.Unsupported;
+            return p.program.node(.{ .tag = .integer, .value = value });
+        }
+        const name = try p.identifier();
+        if (p.eat("(")) return p.call(name);
+        if (!ast.validName(name)) return error.Unsupported;
+        return p.program.node(.{ .tag = .name, .text = name });
+    }
+
+    fn sequence(p: *Parser) ast.Error!usize {
+        var args: std.ArrayList(usize) = .empty;
+        if (!p.eat("]")) while (true) {
+            if (args.items.len >= 128) return error.Unsupported;
+            try args.append(p.program.a, try p.expression());
+            if (p.eat("]")) break;
+            try p.need(",");
+            if (p.eat("]")) break;
+        };
+        return p.program.node(.{ .tag = .list, .args = try args.toOwnedSlice(p.program.a) });
+    }
+
+    fn call(p: *Parser, name: []const u8) ast.Error!usize {
+        if (std.mem.eql(u8, name, "int")) {
+            try p.need("str");
+            try p.need("(");
+            const operand = try p.expression();
+            try p.need(")");
+            try p.need("[");
+            try p.need(":");
+            try p.need(":");
+            try p.need("-");
+            try p.need("1");
+            try p.need("]");
+            try p.need(")");
+            return p.program.node(.{ .tag = .reverse_digits, .lhs = operand });
+        }
+        const builtins = [_][]const u8{ "len", "sum", "range", "gcd", "all", "print", "ValueError" };
+        var allowed = ast.validName(name);
+        for (builtins) |builtin| {
+            if (std.mem.eql(u8, name, builtin)) allowed = true;
+        }
+        if (!allowed) return error.Unsupported;
+        var args: std.ArrayList(usize) = .empty;
+        if (!p.eat(")")) while (true) {
+            if (args.items.len >= 128) return error.Unsupported;
+            const arg = try p.expression();
+            if (args.items.len == 0 and (std.mem.eql(u8, name, "all") or std.mem.eql(u8, name, "sum")) and p.eat("for")) {
+                if (p.pos < 4 or p.source[p.pos - 4] != ' ') return error.Unsupported;
+                const variable = try p.identifier();
+                if (!ast.validName(variable)) return error.Unsupported;
+                try p.need("in");
+                const range = try p.expression();
+                const iterable = p.program.nodes.items[range];
+                const all = std.mem.eql(u8, name, "all");
+                if (all and (iterable.tag != .call or !std.mem.eql(u8, iterable.text, "range")))
+                    return error.Unsupported;
+                const filter: ?usize = if (!all and p.eat("if")) try p.expression() else null;
+                try p.need(")");
+                return p.program.node(.{
+                    .tag = if (all) .all_range else .sum_filtered,
+                    .text = variable,
+                    .lhs = arg,
+                    .rhs = range,
+                    .filter = filter,
+                });
+            }
+            try args.append(p.program.a, arg);
+            if (p.eat(")")) break;
+            try p.need(",");
+            if (p.eat(")")) break;
+        };
+        return p.program.node(.{ .tag = .call, .text = name, .args = try args.toOwnedSlice(p.program.a) });
+    }
+
+    fn string(p: *Parser, formatted: bool) ast.Error!usize {
+        const quote = p.source[p.pos];
+        p.pos += 1;
+        var bytes: std.ArrayList(u8) = .empty;
+        var pieces: std.ArrayList(usize) = .empty;
+        while (p.pos < p.source.len) {
+            const c = p.source[p.pos];
+            p.pos += 1;
+            if (c == quote) {
+                if (!formatted) return p.program.node(.{ .tag = .string, .text = try bytes.toOwnedSlice(p.program.a) });
+                try p.flush(&bytes, &pieces);
+                return p.program.node(.{ .tag = .format, .args = try pieces.toOwnedSlice(p.program.a) });
+            }
+            if (c == '\n' or c == '\r' or c == 0) return error.Unsupported;
+            if (c == '\\') {
+                try bytes.append(p.program.a, try p.escape());
+            } else if (formatted and (c == '{' or c == '}')) {
+                if (p.pos < p.source.len and p.source[p.pos] == c) {
+                    p.pos += 1;
+                    try bytes.append(p.program.a, c);
+                } else if (c == '{') {
+                    try p.flush(&bytes, &pieces);
+                    const interpolation = try p.field();
+                    if (p.depth >= 8) return error.Unsupported;
+                    var nested: Parser = .{ .program = p.program, .source = interpolation, .depth = p.depth };
+                    const root = try nested.expression();
+                    try nested.end();
+                    try pieces.append(p.program.a, root);
+                } else return error.Unsupported;
+            } else try bytes.append(p.program.a, c);
+        }
+        return error.Unsupported;
+    }
+
+    fn flush(p: *Parser, bytes: *std.ArrayList(u8), pieces: *std.ArrayList(usize)) ast.Error!void {
+        if (bytes.items.len == 0) return;
+        const text = try bytes.toOwnedSlice(p.program.a);
+        try pieces.append(p.program.a, try p.program.node(.{ .tag = .string, .text = text }));
+    }
+
+    fn escape(p: *Parser) ast.Error!u8 {
+        if (p.pos >= p.source.len) return error.Unsupported;
+        const c = p.source[p.pos];
+        p.pos += 1;
+        return switch (c) {
+            '\\', '\'', '"' => c,
+            'n' => '\n',
+            'r' => '\r',
+            't' => '\t',
+            'b' => 8,
+            'f' => 12,
+            'v' => 11,
+            'a' => 7,
+            'x' => blk: {
+                if (p.pos + 2 > p.source.len) return error.Unsupported;
+                for (p.source[p.pos .. p.pos + 2]) |digit| if (!std.ascii.isHex(digit)) return error.Unsupported;
+                const byte = std.fmt.parseInt(u8, p.source[p.pos .. p.pos + 2], 16) catch return error.Unsupported;
+                if (byte == 0 or byte >= 128) return error.Unsupported;
+                p.pos += 2;
+                break :blk byte;
+            },
+            else => error.Unsupported,
+        };
+    }
+
+    fn field(p: *Parser) ast.Invalid![]const u8 {
+        const start = p.pos;
+        var nesting: usize = 0;
+        var quote: u8 = 0;
+        var escaped = false;
+        while (p.pos < p.source.len) : (p.pos += 1) {
+            const c = p.source[p.pos];
+            if (quote != 0) {
+                if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+                continue;
+            }
+            switch (c) {
+                '\'', '"' => quote = c,
+                '(', '[' => {
+                    nesting += 1;
+                    if (nesting > 8) return error.Unsupported;
+                },
+                ')', ']' => {
+                    if (nesting == 0) return error.Unsupported;
+                    nesting -= 1;
+                },
+                '}' => {
+                    if (nesting != 0) return error.Unsupported;
+                    const result = p.source[start..p.pos];
+                    p.pos += 1;
+                    return result;
+                },
+                '{', ':', '\n', '\r' => return error.Unsupported,
+                '!' => {
+                    if (p.pos + 1 >= p.source.len or p.source[p.pos + 1] != '=') return error.Unsupported;
+                },
+                else => {},
+            }
+        }
+        return error.Unsupported;
+    }
+};
+
+fn nameChar(c: u8) bool {
+    return std.ascii.isAlphanumeric(c) or c == '_';
+}
+
+pub fn boundedDepth(program: *const ast.Program, id: usize, depth: usize) ast.Invalid!void {
+    if (depth >= 8) return error.Unsupported;
+    const node = program.nodes.items[id];
+    switch (node.tag) {
+        .integer, .boolean, .name, .string => {},
+        .format, .list, .call => for (node.args) |arg| try boundedDepth(program, arg, depth + 1),
+        .neg, .logical_not, .reverse_digits => try boundedDepth(program, node.lhs, depth + 1),
+        else => {
+            try boundedDepth(program, node.lhs, depth + 1);
+            try boundedDepth(program, node.rhs, depth + 1);
+            if (node.filter) |filter| try boundedDepth(program, filter, depth + 1);
+        },
+    }
+}
diff --git a/zig/src/core/runner_frontend_reference_test.zig b/zig/src/core/runner_frontend_reference_test.zig
new file mode 100644
index 000000000..00816c7e9
--- /dev/null
+++ b/zig/src/core/runner_frontend_reference_test.zig
@@ -0,0 +1,77 @@
+const std = @import("std");
+const api = @import("runner_api.zig");
+const t = std.testing;
+
+const reference =
+    \\import sys
+    \\from pathlib import Path
+    \\root = Path(sys.argv[1])
+    \\sys.path.insert(0, str(root / 'experimental/riscv'))
+    \\from chipformer.rv import calc, elf, ref
+    \\if sys.argv[2] == 'calc':
+    \\    m = calc.machine(sys.argv[3], root / 'experimental/riscv/tests/data/rv/calc.elf')
+    \\else:
+    \\    m = ref.Machine.from_program(elf.program(sys.argv[3]))
+    \\tokens = 1
+    \\while not m.halted and tokens < 4000000:
+    \\    tokens += len(m.record())
+    \\assert tokens <= 4000000, tokens
+    \\assert m.halted and m.fault is None and m.exit_code == 0, (m.halted, m.fault, m.exit_code)
+    \\sys.stdout.buffer.write(bytes(m.out))
+;
+
+pub fn check(root: []const u8, python: []const u8, program: api.Program, expected: []const u8) !void {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    var path: ?[:0]u8 = null;
+    defer if (path) |p| t.allocator.free(p);
+    var input = program.bytes;
+    if (program.kind == .elf) {
+        const file = try tmp.dir.createFile(t.io, "program.elf", .{});
+        defer file.close(t.io);
+        try file.writeStreamingAll(t.io, program.bytes);
+        path = try tmp.dir.realPathFileAlloc(t.io, "program.elf", t.allocator);
+        input = path.?;
+    }
+    const result = try std.process.run(t.allocator, t.io, .{
+        .argv = &.{ python, "-c", reference, root, @tagName(program.kind), input },
+        .stdout_limit = .limited(4096),
+        .stderr_limit = .limited(16384),
+        .timeout = .{ .duration = .{ .raw = .fromSeconds(10), .clock = .awake } },
+    });
+    defer t.allocator.free(result.stdout);
+    defer t.allocator.free(result.stderr);
+    if (!result.term.success()) {
+        std.debug.print("RV32 reference failed: {s}\n", .{result.stderr});
+        return error.ReferenceFailed;
+    }
+    try t.expectEqualStrings(expected, result.stdout);
+}
+
+test "accepted arithmetic executes in the firmware reference with exact output" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse {
+        std.debug.print("SKIP firmware reference: set TF_RUNNER_QWENPUTER to its source checkout\n", .{});
+        return error.SkipZigTest;
+    };
+    var context: @import("runner_frontend.zig").Context = .{ .io = t.io, .exact_tags = true };
+    const frontend = context.frontend();
+    const cases = [_][3][]const u8{
+        .{ "python", "print(123456789012345*987654321098765)", "121932631137021071359549253925\n" },
+        .{ "python", "print(123456789012345678901234567890*987654321098765432109876543210)", "121932631137021795226185032733622923332237463801111263526900\n" },
+        .{ "python", "2**100", "1267650600228229401496703205376\n" },
+        .{ "python", "-7//3", "-3\n" },
+        .{ "python", "-7%3", "2\n" },
+        .{ "exact", "1/3+2/3", "1\n" },
+        .{ "exact", "1.25*2.4", "3\n" },
+        .{ "exact", "123456789012345678901234567890.12345678901234567890123456789012", "123456789012345678901234567890.12345678901234567890123456789012\n" },
+        .{ "exact", "gcd(48,18)", "6\n" },
+    };
+    for (cases) |case| {
+        const result = try frontend.translate(frontend.ctx, t.allocator, .{ .form = .repl, .lang = case[0], .code = case[1] });
+        try t.expect(result == .program);
+        defer t.allocator.free(result.program.bytes);
+        try check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", result.program, case[2]);
+    }
+}
diff --git a/zig/src/core/runner_frontend_rvlink.zig b/zig/src/core/runner_frontend_rvlink.zig
new file mode 100644
index 000000000..69a4986c3
--- /dev/null
+++ b/zig/src/core/runner_frontend_rvlink.zig
@@ -0,0 +1,337 @@
+//! In-process link of RV32 objects (runtime, cell body) under compile's linker script; null when unsure (ld.lld then).
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+const text_base = 0x40000;
+const text_end = 0x80000;
+const rodata_base = 0x20000;
+const rodata_end = 0x40000;
+const ram_base = 0x100;
+/// The linker script's ASSERT: RAM leaves 4K for the stack.
+const ram_end = 0x7000;
+
+const Kind = enum { text_init, text, rodata, data, bss };
+
+const Input = struct { file: usize, index: usize, kind: Kind, addr: u32 = 0 };
+
+const Object = struct {
+    bytes: []const u8,
+    sections: []const [40]u8,
+    names: []const u8,
+    symtab: ?usize = null,
+    /// Output address of each section, 0 when it is not placed.
+    addrs: []u32,
+};
+
+fn word(comptime T: type, b: []const u8, off: usize) ?T {
+    if (off > b.len or b.len - off < @sizeOf(T)) return null;
+    return std.mem.readInt(T, b[off..][0..@sizeOf(T)], .little);
+}
+
+fn field(sh: [40]u8, comptime i: usize) u32 {
+    return std.mem.readInt(u32, sh[4 * i ..][0..4], .little);
+}
+
+fn cstr(b: []const u8, off: usize) ?[]const u8 {
+    if (off >= b.len) return null;
+    const end = std.mem.indexOfScalarPos(u8, b, off, 0) orelse return null;
+    return b[off..end];
+}
+
+fn prefixed(name: []const u8, comptime base: []const u8) bool {
+    return std.mem.eql(u8, name, base) or std.mem.startsWith(u8, name, base ++ ".");
+}
+
+/// The script's output section for an allocated input section; null when the script would not place it.
+fn classify(name: []const u8) ?Kind {
+    if (std.mem.eql(u8, name, ".text.init")) return .text_init;
+    if (prefixed(name, ".text")) return .text;
+    if (prefixed(name, ".rodata") or prefixed(name, ".srodata")) return .rodata;
+    if (prefixed(name, ".data") or prefixed(name, ".sdata")) return .data;
+    if (prefixed(name, ".bss") or prefixed(name, ".sbss")) return .bss;
+    return null;
+}
+
+fn parse(a: Allocator, b: []const u8) Allocator.Error!?Object {
+    if (b.len < 52 or !std.mem.eql(u8, b[0..7], "\x7fELF\x01\x01\x01")) return null;
+    if (word(u16, b, 16) != 1 or word(u16, b, 18) != 243 or word(u32, b, 36) != 0) return null;
+    const shoff = word(u32, b, 32) orelse return null;
+    const shentsize = word(u16, b, 46) orelse return null;
+    const shnum = word(u16, b, 48) orelse return null;
+    const shstrndx = word(u16, b, 50) orelse return null;
+    if (shentsize != 40 or shnum == 0 or shstrndx >= shnum or shoff > b.len or b.len - shoff < 40 * @as(usize, shnum)) return null;
+    const sections = std.mem.bytesAsSlice([40]u8, b[shoff..][0 .. 40 * @as(usize, shnum)]);
+    const strs = sections[shstrndx];
+    const names_off = field(strs, 4);
+    if (names_off > b.len or b.len - names_off < field(strs, 5)) return null;
+    var o: Object = .{ .bytes = b, .sections = sections, .names = b[names_off..][0..field(strs, 5)], .addrs = try a.alloc(u32, shnum) };
+    @memset(o.addrs, 0);
+    for (sections, 0..) |sh, i| {
+        const kind = field(sh, 1);
+        const flags = field(sh, 2);
+        if (kind == 2) {
+            if (o.symtab != null) return null;
+            o.symtab = i;
+        }
+        // SHT_REL, SHT_GROUP, SHT_SYMTAB_SHNDX and COMDAT or TLS sections are outside what the compile step emits
+        if (kind == 9 or kind == 17 or kind == 18 or flags & (0x200 | 0x400) != 0) return null;
+        if (kind != 1 and kind != 8 and flags & 2 != 0) return null;
+        if (kind == 1 or kind == 8) if (field(sh, 4) > b.len or (kind == 1 and b.len - field(sh, 4) < field(sh, 5))) return null;
+    }
+    return o;
+}
+
+fn sectionName(o: Object, sh: [40]u8) ?[]const u8 {
+    return cstr(o.names, field(sh, 0));
+}
+
+/// The three segments' bytes: text, rodata, data (bss is memory size only).
+const Image = struct { bytes: [3]std.ArrayList(u8) = @splat(.empty) };
+
+/// ELF32 executable bytes for `objects` (in command-line order), or null.
+pub fn link(a: Allocator, objects: []const []const u8) Allocator.Error!?[]u8 {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const objs = try arena.alloc(Object, objects.len);
+    for (objects, objs) |bytes, *o| o.* = try parse(arena, bytes) orelse return null;
+    var inputs: std.ArrayList(Input) = .empty;
+    for (objs, 0..) |o, f| for (o.sections, 0..) |sh, i| {
+        if (field(sh, 2) & 2 == 0) continue;
+        const kind = classify(sectionName(o, sh) orelse return null) orelse return null;
+        if ((kind == .bss) != (field(sh, 1) == 8)) return null;
+        try inputs.append(arena, .{ .file = f, .index = i, .kind = kind });
+    };
+    // the script's order: every .text.init first, then each output section's inputs in file and section order
+    var out: Image = .{};
+    var cursor = [5]u32{ text_base, 0, rodata_base, ram_base, 0 };
+    for ([_]Kind{ .text_init, .text, .rodata, .data, .bss }) |kind| {
+        const k = @backingInt(kind);
+        if (kind == .text) cursor[k] = cursor[0];
+        if (kind == .bss) cursor[k] = cursor[3];
+        // as ld.lld, an output section starts at the largest alignment of its inputs (.text continues .text.init)
+        var widest: u32 = 1;
+        for (inputs.items) |in| if (in.kind == kind) {
+            const alignment = @max(field(objs[in.file].sections[in.index], 8), 1);
+            if (!std.math.isPowerOfTwo(alignment) or alignment > 4096) return null;
+            widest = @max(widest, alignment);
+        };
+        if (kind != .text) cursor[k] = std.mem.alignForward(u32, cursor[k], widest);
+        for (inputs.items) |*in| if (in.kind == kind) {
+            const sh = objs[in.file].sections[in.index];
+            const at = std.mem.alignForward(u32, cursor[k], @max(field(sh, 8), 1));
+            const size = field(sh, 5);
+            if (size > text_end) return null;
+            in.addr = at;
+            objs[in.file].addrs[in.index] = at;
+            cursor[k] = std.math.add(u32, at, size) catch return null;
+        };
+    }
+    if (cursor[1] > text_end or cursor[2] > rodata_end or cursor[4] > ram_end or cursor[3] > ram_end) return null;
+    // section bytes into the three segments, then relocations patched in place
+    const segs = [3]struct { first: u32, last: u32 }{
+        .{ .first = text_base, .last = cursor[1] },
+        .{ .first = rodata_base, .last = cursor[2] },
+        .{ .first = ram_base, .last = cursor[3] },
+    };
+    for (&out.bytes, segs) |*list, seg| try list.appendNTimes(arena, 0, seg.last - seg.first);
+    for (inputs.items) |in| {
+        if (in.kind == .bss) continue;
+        const sh = objs[in.file].sections[in.index];
+        const s: usize = switch (in.kind) {
+            .text_init, .text => 0,
+            .rodata => 1,
+            else => 2,
+        };
+        const off = field(sh, 4);
+        @memcpy(out.bytes[s].items[in.addr - segs[s].first ..][0..field(sh, 5)], objs[in.file].bytes[off..][0..field(sh, 5)]);
+    }
+    var globals: std.StringHashMapUnmanaged(u32) = .empty;
+    for (objs) |o| {
+        const st = o.symtab orelse continue;
+        var it = symbols(o, st) orelse return null;
+        while (it.next()) |sym| {
+            if (sym.bind == 0 or sym.shndx == 0) continue;
+            const value = resolve(o, sym) orelse return null;
+            const got = try globals.getOrPut(arena, sym.name);
+            if (got.found_existing) return null;
+            got.value_ptr.* = value;
+        }
+    }
+    for (objs) |o| for (o.sections) |sh| {
+        if (field(sh, 1) != 4) continue;
+        const target = field(sh, 7);
+        if (target >= o.sections.len or o.symtab == null or field(sh, 6) != o.symtab.?) return null;
+        const place = o.addrs[target];
+        if (place == 0) {
+            if (field(o.sections[target], 2) & 2 != 0) return null;
+            continue;
+        }
+        const s: usize = if (place >= text_base) 0 else if (place >= rodata_base) 1 else 2;
+        const seg = out.bytes[s].items;
+        const rel_off = field(sh, 4);
+        const count = field(sh, 5) / 12;
+        if (rel_off > o.bytes.len or o.bytes.len - rel_off < 12 * @as(usize, count)) return null;
+        for (0..count) |r| {
+            const e = rel_off + 12 * r;
+            const offset = word(u32, o.bytes, e).?;
+            const info = word(u32, o.bytes, e + 4).?;
+            const addend: i32 = @bitCast(word(u32, o.bytes, e + 8).?);
+            const sym = symbol(o, o.symtab.?, info >> 8) orelse return null;
+            const value = if (sym.shndx == 0) globals.get(sym.name) orelse return null else resolve(o, sym) orelse return null;
+            if (offset >= field(o.sections[target], 5)) return null;
+            const p = place + offset;
+            if (!patch(seg, p - segs[s].first, @truncate(info), value +% @as(u32, @bitCast(addend)), p)) return null;
+        }
+    };
+    const entry = globals.get("_start") orelse return null;
+    return try write(a, entry, .{ out.bytes[0].items, out.bytes[1].items, out.bytes[2].items }, cursor[4] - ram_base);
+}
+
+/// Whether a relocatable object leaves `symbol_name` undefined (it calls into another object for it).
+pub fn references(bytes: []const u8, symbol_name: []const u8) bool {
+    var buf: [4096]u8 = undefined;
+    var fba = std.heap.FixedBufferAllocator.init(&buf);
+    const o = (parse(fba.allocator(), bytes) catch return false) orelse return false;
+    var it = symbols(o, o.symtab orelse return false) orelse return false;
+    while (it.next()) |sym| if (sym.shndx == 0 and std.mem.eql(u8, sym.name, symbol_name)) return true;
+    return false;
+}
+
+const Symbol = struct { name: []const u8, value: u32, shndx: u16, bind: u8, kind: u8 };
+
+const Symbols = struct {
+    o: Object,
+    strings: []const u8,
+    table: []const u8,
+    at: usize = 1,
+
+    fn next(it: *Symbols) ?Symbol {
+        if (it.at >= it.table.len / 16) return null;
+        defer it.at += 1;
+        return decode(it.table, it.strings, it.at);
+    }
+};
+
+fn decode(table: []const u8, strings: []const u8, i: usize) ?Symbol {
+    const e = 16 * i;
+    if (e + 16 > table.len) return null;
+    const info = table[e + 12];
+    return .{
+        .name = cstr(strings, word(u32, table, e).?) orelse return null,
+        .value = word(u32, table, e + 4).?,
+        .shndx = word(u16, table, e + 14).?,
+        .bind = info >> 4,
+        .kind = info & 0xf,
+    };
+}
+
+fn symbols(o: Object, st: usize) ?Symbols {
+    const sh = o.sections[st];
+    const link_index = field(sh, 6);
+    if (link_index >= o.sections.len) return null;
+    const strs = o.sections[link_index];
+    const off = field(sh, 4);
+    const str_off = field(strs, 4);
+    if (off > o.bytes.len or o.bytes.len - off < field(sh, 5) or str_off > o.bytes.len or o.bytes.len - str_off < field(strs, 5)) return null;
+    return .{ .o = o, .table = o.bytes[off..][0..field(sh, 5)], .strings = o.bytes[str_off..][0..field(strs, 5)] };
+}
+
+fn symbol(o: Object, st: usize, i: u32) ?Symbol {
+    const it = symbols(o, st) orelse return null;
+    return decode(it.table, it.strings, i);
+}
+
+/// A defined symbol's address: absolute, or its placed section's address plus its value (COMMON is not placed).
+fn resolve(o: Object, sym: Symbol) ?u32 {
+    if (sym.shndx == 0xfff1) return sym.value;
+    if (sym.shndx == 0 or sym.shndx >= o.sections.len) return null;
+    const base = o.addrs[sym.shndx];
+    if (base == 0) return null;
+    return base + sym.value;
+}
+
+/// Applies one RISC-V relocation at segment offset `at` (absolute place `p`); false when unknown or out of range.
+pub fn patch(seg: []u8, at: usize, kind: u8, value: u32, p: u32) bool {
+    const span: usize = if (kind == 18 or kind == 19) 8 else 4;
+    if (at > seg.len or seg.len - at < span) return false;
+    const insn = std.mem.readInt(u32, seg[at..][0..4], .little);
+    const rel = value -% p;
+    const put = struct {
+        fn at32(s: []u8, i: usize, v: u32) void {
+            std.mem.writeInt(u32, s[i..][0..4], v, .little);
+        }
+    }.at32;
+    switch (kind) {
+        1 => put(seg, at, value),
+        26 => put(seg, at, (insn & 0xfff) | ((value +% 0x800) & 0xfffff000)),
+        27 => put(seg, at, (insn & 0xfffff) | (value << 20)),
+        28 => put(seg, at, (insn & 0x1fff07f) | ((value & 0xfe0) << 20) | ((value & 0x1f) << 7)),
+        18, 19 => {
+            const next = std.mem.readInt(u32, seg[at + 4 ..][0..4], .little);
+            put(seg, at, (insn & 0xfff) | ((rel +% 0x800) & 0xfffff000));
+            put(seg, at + 4, (next & 0xfffff) | (rel << 20));
+        },
+        16 => {
+            const off: i32 = @bitCast(rel);
+            if (off < -4096 or off > 4094 or off & 1 != 0) return false;
+            const r = rel;
+            put(seg, at, (insn & 0x1fff07f) | (((r >> 12) & 1) << 31) | (((r >> 5) & 0x3f) << 25) | (((r >> 1) & 0xf) << 8) | (((r >> 11) & 1) << 7));
+        },
+        17 => {
+            const off: i32 = @bitCast(rel);
+            if (off < -(1 << 20) or off > (1 << 20) - 2 or off & 1 != 0) return false;
+            const r = rel;
+            put(seg, at, (insn & 0xfff) | (((r >> 20) & 1) << 31) | (((r >> 1) & 0x3ff) << 21) | (((r >> 11) & 1) << 20) | (((r >> 12) & 0xff) << 12));
+        },
+        else => return false,
+    }
+    return true;
+}
+
+/// Header, three PT_LOAD headers (text R+X, rodata R, data+bss R+W) and the segment bytes; no section headers.
+fn write(a: Allocator, entry: u32, segs: [3][]const u8, ram_size: u32) Allocator.Error![]u8 {
+    var offsets: [3]u32 = undefined;
+    var size: u32 = 52 + 3 * 32;
+    for (segs, &offsets) |s, *off| {
+        size = std.mem.alignForward(u32, size, 4);
+        off.* = size;
+        size += @intCast(s.len);
+    }
+    const b = try a.alloc(u8, size);
+    @memset(b, 0);
+    @memcpy(b[0..7], "\x7fELF\x01\x01\x01");
+    const put16 = struct {
+        fn f(x: []u8, i: usize, v: u16) void {
+            std.mem.writeInt(u16, x[i..][0..2], v, .little);
+        }
+    }.f;
+    const put32 = struct {
+        fn f(x: []u8, i: usize, v: u32) void {
+            std.mem.writeInt(u32, x[i..][0..4], v, .little);
+        }
+    }.f;
+    put16(b, 16, 2);
+    put16(b, 18, 243);
+    put32(b, 20, 1);
+    put32(b, 24, entry);
+    put32(b, 28, 52);
+    put16(b, 40, 52);
+    put16(b, 42, 32);
+    put16(b, 44, 3);
+    const vaddr = [3]u32{ text_base, rodata_base, ram_base };
+    const flags = [3]u32{ 5, 4, 6 };
+    for (0..3) |i| {
+        const ph = 52 + 32 * i;
+        put32(b, ph, 1);
+        put32(b, ph + 4, offsets[i]);
+        put32(b, ph + 8, vaddr[i]);
+        put32(b, ph + 12, vaddr[i]);
+        put32(b, ph + 16, @intCast(segs[i].len));
+        put32(b, ph + 20, if (i == 2) ram_size else @intCast(segs[i].len));
+        put32(b, ph + 24, flags[i]);
+        put32(b, ph + 28, 4);
+        @memcpy(b[offsets[i]..][0..segs[i].len], segs[i]);
+    }
+    return b;
+}
diff --git a/zig/src/core/runner_frontend_script_test.zig b/zig/src/core/runner_frontend_script_test.zig
new file mode 100644
index 000000000..15c6cbd5b
--- /dev/null
+++ b/zig/src/core/runner_frontend_script_test.zig
@@ -0,0 +1,144 @@
+const std = @import("std");
+const python = @import("runner_frontend_integer_python.zig");
+
+test "configured multiple wide prints execute immutable snapshots and preserve exact lines" {
+    const t = std.testing;
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    const cases = [_][2][]const u8{
+        .{ "x=7\nprint(x)\nx=11\nprint(x)", "7\n11\n" },
+        .{ "print(divmod(-7,3))\nprint(5*9)", "(-3, 2)\n45\n" },
+        .{
+            "a=11232463670103386525\nb=732667528837627997\nc=242246186388029\nprint(a-b*129+c)\nprint(b*129)",
+            "-83281405303764237059\n94514111220054011613\n",
+        },
+    };
+    for (cases) |case| {
+        const bytes = (try python.compile(t.allocator, t.io, case[0], .{
+            .clang = clang,
+            .linker = env.get("TF_RUNNER_LLD"),
+            .step_budget = 0,
+        })) orelse return error.UnexpectedAbstention;
+        defer t.allocator.free(bytes);
+        try @import("runner_frontend_reference_test.zig").check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", .{ .kind = .elf, .bytes = bytes }, case[1]);
+    }
+}
+
+test "assignment scripts preserve original wide operands in calc input" {
+    const cases = [_][2][]const u8{
+        .{
+            "a=140857552301908510213574088100\nb=690019271788334891377792747413\nprint(a+b)",
+            "(140857552301908510213574088100+690019271788334891377792747413)",
+        },
+        .{
+            "a=831680992073052982499463120866\nb=548277608446792630955630629392\nprint(a*b)",
+            "(831680992073052982499463120866*548277608446792630955630629392)",
+        },
+        .{ "a=7\nb=a\na=a+2\nprint(a*b)", "((7+2)*7)" },
+        .{ "a=-7\nb=3\nprint(a//b)", "((-7)//3)" },
+        .{ "a=7\nb=-3\nprint(a%b)", "(7%(-3))" },
+        .{ "a=-7\nb=-3\nprint(a//b)", "((-7)//(-3))" },
+        .{ "print(-2**2)", "(-(2**2))" },
+        .{ "print(2**114 - 3**67)", "((2**114)-(3**67))" },
+        .{ "import math\na=48\nprint(math.gcd(a,18))", "gcd(48,18)" },
+        .{ "from math import gcd\nprint(gcd(48,18))", "gcd(48,18)" },
+        .{ "unused=2*3\na=11 # original operand\nprint(a+7)\n", "(11+7)" },
+    };
+    for (cases) |case| {
+        const result = (try python.lowerCalc(std.testing.allocator, case[0])).?;
+        defer std.testing.allocator.free(result);
+        try std.testing.expectEqualStrings(case[1], result);
+    }
+}
+
+test "calc script validation refuses unused failures and non integer semantics" {
+    const cases = [_][]const u8{
+        "x=1//0\nprint(3)",
+        "x=10**62\nprint(3)",
+        "x=3\nx=1%0\nprint(3)",
+        "x=math.gcd(48,18)\nprint(3)",
+        "x=gcd(48,18)\nprint(3)",
+        "from math import *\nprint(3)",
+        "import math as m\nprint(3)",
+        "import os\nprint(3)",
+        "print=2\nprint(3)",
+        "int=2\nprint(3)",
+        "gcd=2\nprint(3)",
+        "x=input()\nprint(3)",
+        "x=1.25\nprint(x)",
+        "x=1/2\nprint(x)",
+        "from fractions import Fraction\nprint(Fraction(1,2))",
+        "from decimal import Decimal\nprint(Decimal('2'))",
+        "x=int('1.2')\nprint(x)",
+        "x=int('12',3)\nprint(x)",
+        "print(3)\nx=1//0",
+        "x=2\nprint(x)\nprint(x)",
+        "x=2\nx*2",
+        "x=0xff\nprint(x+1)",
+        "x=0b101\nprint(x+1)",
+        "x=int('ff',16)\nprint(x)",
+        "x=2\nprint(pow(x,10,7))",
+        "x=2\nprint(x**10%7)",
+        "x=3\nprint(1+(2+(3+(4+(5+(6+x))))))",
+        "x=1\nx=x+x\nx=x+x\nx=x+x\nx=x+x\nx=x+x\nx=x+x\nx=x+x\nprint(x)",
+        "x=99999999999999999999999999999999999999999999999999999999999999\nprint(x*0)",
+    };
+    for (cases) |code| {
+        const result = try python.lowerCalc(std.testing.allocator, code);
+        defer if (result) |bytes| std.testing.allocator.free(bytes);
+        try std.testing.expect(result == null);
+    }
+}
+
+test "firmware refusal leaves wide runtime lowering available" {
+    const code = "a=0x100\nb=0x20\nprint(a*b)";
+    try std.testing.expectEqual(@as(?[]u8, null), try python.lowerCalc(std.testing.allocator, code));
+    const source = (try python.lower(std.testing.allocator, code)).?;
+    defer std.testing.allocator.free(source);
+    try std.testing.expect(std.mem.indexOf(u8, source, "tf_run(tf_nodes,") != null);
+    try std.testing.expect(std.mem.indexOf(u8, source, "\"100\"") != null);
+}
+
+test "multiple wide prints retain runtime DAGs and charge the total deadline" {
+    const a = std.testing.allocator;
+    const code = "a=11232463670103386525\nb=732667528837627997\nc=242246186388029\n" ++
+        "print(a-b*129+c)\nprint(b*129)\n";
+    try std.testing.expectEqual(@as(?[]u8, null), try python.lowerCalc(a, code));
+    const result = (try python.lowerWithCost(a, code, std.math.maxInt(usize))).?;
+    defer a.free(result.source);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"11232463670103386525\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"732667528837627997\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"242246186388029\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"83281405303764237059\"") == null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "tf_roots") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "tf_nodes_1") == null);
+    const total = result.estimated_steps.?;
+    const exact = (try python.lowerWithCost(a, code, total)).?;
+    defer a.free(exact.source);
+    try std.testing.expectEqual(@as(?usize, total), exact.estimated_steps);
+    try std.testing.expect((try python.lowerWithCost(a, code, total - 1)) == null);
+    const single = (try python.lowerWithCost(a, "b=732667528837627997\nprint(b*129)", total)).?;
+    defer a.free(single.source);
+    try std.testing.expect(single.estimated_steps.? < total);
+}
+
+test "multiple prints snapshot bindings and validate the complete script" {
+    const a = std.testing.allocator;
+    const source = (try python.lower(a, "x=7\nprint(x)\nx=11\nprint(x)")).?;
+    defer a.free(source);
+    try std.testing.expect(std.mem.indexOf(u8, source, "tf_roots") != null);
+    try std.testing.expect(std.mem.indexOf(u8, source, "\"7\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, source, "\"11\"") != null);
+    for ([_][]const u8{
+        "x=7\nprint(x)\nx=1//0\nprint(3)",
+        "print(1)\nprint(2)\nx=10**62",
+        "print(1)\nimport os\nprint(2)",
+        "print(1)\nprint=3\nprint(2)",
+        "print(1)\nprint(2.5)",
+        "1\nprint(2)",
+        "1\nx=2\nprint(x)",
+        "print(1)\nprint(2)\nprint(3)\nprint(4)\nprint(5)\nprint(6)\nprint(7)\nprint(8)\nprint(9)",
+    }) |code| try std.testing.expectEqual(@as(?[]u8, null), try python.lower(a, code));
+}
diff --git a/zig/src/core/runner_frontend_spawn.zig b/zig/src/core/runner_frontend_spawn.zig
new file mode 100644
index 000000000..ed4137ee4
--- /dev/null
+++ b/zig/src/core/runner_frontend_spawn.zig
@@ -0,0 +1,263 @@
+//! The cross compiler's process by posix_spawn (Linux libc): unlike fork it never copies the runner's page tables.
+const std = @import("std");
+const builtin = @import("builtin");
+const linux = std.os.linux;
+const Allocator = std.mem.Allocator;
+
+/// A finished child's captured streams and whether it exited 0; the caller frees both streams.
+pub const Ran = struct {
+    stdout: []u8,
+    stderr: []u8,
+    ok: bool,
+
+    pub fn deinit(r: Ran, a: Allocator) void {
+        a.free(r.stdout);
+        a.free(r.stderr);
+    }
+};
+
+pub const Limits = struct { stdout: usize, stderr: usize, timeout: std.Io.Duration };
+
+const spawned = builtin.link_libc and builtin.os.tag == .linux;
+const spawn_setpgroup: c_short = 0x02;
+
+/// argv run with stdin on /dev/null (PATH for a bare name); null if it cannot start, overflows a limit or times out.
+pub fn run(a: Allocator, io: std.Io, argv: []const []const u8, limits: Limits) Allocator.Error!?Ran {
+    if (comptime !spawned) return forked(a, io, argv, limits);
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const args = try arena.allocSentinel(?[*:0]const u8, argv.len, null);
+    for (argv, 0..) |arg, i| args[i] = try arena.dupeSentinel(u8, arg, 0);
+    var fds: [4]linux.fd_t = @splat(-1);
+    defer for (fds) |fd| if (fd >= 0) close(fd);
+    for (0..2) |i| {
+        var pair: [2]linux.fd_t = undefined;
+        if (linux.errno(linux.pipe2(&pair, .{ .CLOEXEC = true })) != .SUCCESS) return null;
+        fds[2 * i] = pair[0];
+        fds[2 * i + 1] = pair[1];
+    }
+    const deadline = now() +| @as(u64, @intCast(@max(limits.timeout.toNanoseconds(), 0)));
+    var pid: linux.pid_t = 0;
+    if (!start(&pid, args, fds[1], fds[3])) return null;
+    for ([_]usize{ 1, 3 }) |i| {
+        close(fds[i]);
+        fds[i] = -1;
+    }
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(a);
+    var err: std.ArrayList(u8) = .empty;
+    defer err.deinit(a);
+    const drained = drain(a, &fds, &out, &err, limits, deadline) catch |e| {
+        kill(pid);
+        return e;
+    };
+    if (!drained) {
+        kill(pid);
+        return null;
+    }
+    const status = switch (waitUntil(pid, deadline)) {
+        .done => |status| status,
+        .timed_out => {
+            kill(pid);
+            return null;
+        },
+        .lost => return null,
+    };
+    const stdout = try out.toOwnedSlice(a);
+    errdefer a.free(stdout);
+    return .{ .stdout = stdout, .stderr = try err.toOwnedSlice(a), .ok = status == 0 };
+}
+
+/// Reads both pipes to end of stream; false on a passed limit, the deadline or a failed poll.
+fn drain(a: Allocator, fds: *[4]linux.fd_t, out: *std.ArrayList(u8), err: *std.ArrayList(u8), limits: Limits, deadline: u64) Allocator.Error!bool {
+    var buf: [4096]u8 = undefined;
+    while (fds[0] >= 0 or fds[2] >= 0) {
+        const t = now();
+        if (t >= deadline) return false;
+        var pf = [_]linux.pollfd{
+            .{ .fd = fds[0], .events = linux.POLL.IN, .revents = 0 },
+            .{ .fd = fds[2], .events = linux.POLL.IN, .revents = 0 },
+        };
+        const wait: i32 = @intCast(@min((deadline - t) / std.time.ns_per_ms + 1, std.math.maxInt(i32)));
+        const rc = linux.poll(&pf, pf.len, wait);
+        if (linux.errno(rc) == .INTR) continue;
+        if (linux.errno(rc) != .SUCCESS) return false;
+        for ([_]usize{ 0, 2 }, [_]*std.ArrayList(u8){ out, err }, [_]usize{ limits.stdout, limits.stderr }, 0..) |i, list, limit, p| {
+            if (pf[p].revents == 0) continue;
+            const n = linux.read(fds[i], &buf, buf.len);
+            if (linux.errno(n) == .INTR or linux.errno(n) == .AGAIN) continue;
+            if (linux.errno(n) != .SUCCESS or n == 0) {
+                close(fds[i]);
+                fds[i] = -1;
+                continue;
+            }
+            if (list.items.len + n > limit) return false;
+            try list.appendSlice(a, buf[0..n]);
+        }
+    }
+    return true;
+}
+
+const libc = struct {
+    extern "c" fn posix_spawnp(pid: *linux.pid_t, file: [*:0]const u8, actions: *const Opaque, attr: ?*const anyopaque, argv: [*:null]const ?[*:0]const u8, envp: [*:null]const ?[*:0]const u8) c_int;
+    extern "c" fn posix_spawn_file_actions_init(actions: *Opaque) c_int;
+    extern "c" fn posix_spawn_file_actions_destroy(actions: *Opaque) c_int;
+    extern "c" fn posix_spawn_file_actions_adddup2(actions: *Opaque, fd: c_int, to: c_int) c_int;
+    extern "c" fn posix_spawn_file_actions_addopen(actions: *Opaque, fd: c_int, path: [*:0]const u8, flags: c_int, mode: c_uint) c_int;
+    extern "c" fn posix_spawnattr_init(attr: *Opaque) c_int;
+    extern "c" fn posix_spawnattr_destroy(attr: *Opaque) c_int;
+    extern "c" fn posix_spawnattr_setpgroup(attr: *Opaque, group: linux.pid_t) c_int;
+    extern "c" fn posix_spawnattr_setflags(attr: *Opaque, flags: c_short) c_int;
+    extern "c" fn getsid(pid: linux.pid_t) linux.pid_t;
+    extern "c" var environ: [*:null]?[*:0]u8;
+};
+
+const Opaque = extern struct { bytes: [512]u8 align(16) = undefined };
+
+fn start(pid: *linux.pid_t, argv: [:null]?[*:0]const u8, stdout: linux.fd_t, stderr: linux.fd_t) bool {
+    var attr: Opaque = .{};
+    if (libc.posix_spawnattr_init(&attr) != 0) return false;
+    defer _ = libc.posix_spawnattr_destroy(&attr);
+    if (libc.posix_spawnattr_setpgroup(&attr, 0) != 0 or libc.posix_spawnattr_setflags(&attr, spawn_setpgroup) != 0) return false;
+    var actions: Opaque = .{};
+    if (libc.posix_spawn_file_actions_init(&actions) != 0) return false;
+    defer _ = libc.posix_spawn_file_actions_destroy(&actions);
+    var rc = libc.posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", 0, 0);
+    if (rc == 0) rc = libc.posix_spawn_file_actions_adddup2(&actions, stdout, 1);
+    if (rc == 0) rc = libc.posix_spawn_file_actions_adddup2(&actions, stderr, 2);
+    if (rc == 0) rc = libc.posix_spawnp(pid, argv[0].?, &actions, &attr, argv.ptr, @ptrCast(libc.environ));
+    return rc == 0;
+}
+
+fn kill(pid: linux.pid_t) void {
+    _ = linux.kill(-pid, .KILL);
+    _ = reap(pid);
+}
+
+/// Pipe EOF does not prove exit: a child that closes its streams still has the original deadline.
+fn waitUntil(pid: linux.pid_t, deadline: u64) union(enum) { done: u32, timed_out, lost } {
+    while (true) {
+        var st: i32 = 0;
+        const rc = linux.wait4(pid, &st, 1, null);
+        switch (linux.errno(rc)) {
+            .SUCCESS => if (rc != 0) return .{ .done = @bitCast(st) },
+            .INTR => continue,
+            else => return .lost,
+        }
+        if (now() >= deadline) return .timed_out;
+        const pause: linux.timespec = .{ .sec = 0, .nsec = std.time.ns_per_ms };
+        _ = linux.nanosleep(&pause, null);
+    }
+}
+
+/// The child's wait status, or null when it cannot be reaped.
+fn reap(pid: linux.pid_t) ?u32 {
+    while (true) {
+        var st: i32 = 0;
+        switch (linux.errno(linux.wait4(pid, &st, 0, null))) {
+            .SUCCESS => return @bitCast(st),
+            .INTR => continue,
+            else => return null,
+        }
+    }
+}
+
+fn close(fd: linux.fd_t) void {
+    _ = linux.close(fd);
+}
+
+fn now() u64 {
+    var ts: linux.timespec = undefined;
+    _ = linux.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+/// Hosts without Linux libc (macOS builds) keep std.process.run.
+fn forked(a: Allocator, io: std.Io, argv: []const []const u8, limits: Limits) Allocator.Error!?Ran {
+    const r = std.process.run(a, io, .{
+        .argv = argv,
+        .stdout_limit = .limited(limits.stdout),
+        .stderr_limit = .limited(limits.stderr),
+        .timeout = .{ .duration = .{ .raw = limits.timeout, .clock = .awake } },
+    }) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return null,
+    };
+    return .{ .stdout = r.stdout, .stderr = r.stderr, .ok = r.term.success() };
+}
+
+test "spawned compiler process: exit status, captured streams, limits, timeout and a missing program" {
+    const t = std.testing;
+    const ok = (try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "printf out; printf err >&2" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) })).?;
+    defer ok.deinit(t.allocator);
+    try t.expect(ok.ok);
+    try t.expectEqualStrings("out", ok.stdout);
+    try t.expectEqualStrings("err", ok.stderr);
+    const failed = (try run(t.allocator, t.io, &.{ "sh", "-c", "read x; exit 3" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) })).?;
+    defer failed.deinit(t.allocator);
+    try t.expect(!failed.ok);
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "head -c 200 /dev/zero" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) }));
+    const t0 = now();
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "sleep 5" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(100) }));
+    try t.expect(now() - t0 < 3 * std.time.ns_per_s);
+    if (comptime spawned) {
+        const closed = now();
+        try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "exec 1>/dev/null 2>&1; sleep 5" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(100) }));
+        try t.expect(now() - closed < 3 * std.time.ns_per_s);
+        try descendantsStop();
+    }
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{"/nonexistent/tf-clang"}, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) }));
+}
+
+/// A timed-out compiler driver must leave no live worker in the scope, even when the worker outlives the driver.
+fn descendantsStop() !void {
+    const t = std.testing;
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(t.io, ".", t.allocator);
+    defer t.allocator.free(dir);
+    const path = try std.fs.path.join(t.allocator, &.{ dir, "child" });
+    defer t.allocator.free(path);
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "sleep 30 & echo $! > \"$1\"; wait", "compiler", path }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(200) }));
+    const bytes = try tmp.dir.readFileAlloc(t.io, "child", t.allocator, .limited(64));
+    defer t.allocator.free(bytes);
+    const pid = try std.fmt.parseInt(linux.pid_t, std.mem.trim(u8, bytes, " \r\n\t"), 10);
+    const proc = try std.fmt.allocPrint(t.allocator, "/proc/{d}/stat", .{pid});
+    defer t.allocator.free(proc);
+    const settled_by = now() + std.time.ns_per_s;
+    var alive = true;
+    var owned = false;
+    while (true) {
+        const file = std.Io.Dir.cwd().openFile(t.io, proc, .{}) catch |err| switch (err) {
+            error.FileNotFound => return,
+            else => return err,
+        };
+        defer file.close(t.io);
+        var buffer: [4096]u8 = undefined;
+        var reader = file.readerStreaming(t.io, &buffer);
+        // a stat that opens but fails to read (ESRCH) belongs to a task already gone; the open can keep succeeding
+        const stat = reader.interface.allocRemaining(t.allocator, .limited(4096)) catch |err| switch (err) {
+            error.ReadFailed => {
+                alive = false;
+                break;
+            },
+            else => return err,
+        };
+        defer t.allocator.free(stat);
+        if (stat.len == 0) return;
+        const end = std.mem.lastIndexOfScalar(u8, stat, ')') orelse return error.InvalidProcStat;
+        var fields = std.mem.tokenizeScalar(u8, stat[end + 1 ..], ' ');
+        const state = fields.next() orelse return error.InvalidProcStat;
+        _ = fields.next() orelse return error.InvalidProcStat;
+        _ = fields.next() orelse return error.InvalidProcStat;
+        const sid = try std.fmt.parseInt(linux.pid_t, fields.next() orelse return error.InvalidProcStat, 10);
+        alive = state[0] != 'Z' and state[0] != 'X';
+        owned = sid == libc.getsid(0) and std.mem.indexOf(u8, stat, "(sleep)") != null;
+        if (!alive or now() >= settled_by) break;
+        const pause: linux.timespec = .{ .sec = 0, .nsec = std.time.ns_per_ms };
+        _ = linux.nanosleep(&pause, null);
+    }
+    if (alive and owned) _ = linux.kill(pid, .KILL);
+    try t.expect(!alive);
+}
diff --git a/zig/src/core/runner_frontend_split.zig b/zig/src/core/runner_frontend_split.zig
new file mode 100644
index 000000000..2b1719143
--- /dev/null
+++ b/zig/src/core/runner_frontend_split.zig
@@ -0,0 +1,161 @@
+//! Runtime compiled once per clang and level; a body using none of its statics compiles alone, as in the whole file.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const compile = @import("runner_frontend_program_compile.zig");
+const forkserver = @import("runner_frontend_forkserver.zig");
+const rvlink = @import("runner_frontend_rvlink.zig");
+const log = std.log.scoped(.runner_frontend);
+
+/// The whole file's runtime compiled alone: its static printf and helpers drop out, memset and memcpy stay.
+pub const runtime = compile.runtime;
+
+/// What a body sees of the runtime: its types, macros and Python's print, and the two functions it may call.
+pub const declarations = compile.runtime[0..std.mem.indexOf(u8, compile.runtime, "void *memset").?] ++
+    \\void *memset(void *destination, int value, size_t count);
+    \\void *memcpy(void *destination, const void *source, size_t count);
+    \\
+;
+
+/// A body may compile alone when it names no runtime static or inlinable call; tf_py_print is assembly in both builds.
+pub fn eligible(body: []const u8) bool {
+    var i: usize = 0;
+    while (i < body.len) {
+        const c = body[i];
+        if (!(std.ascii.isAlphabetic(c) or c == '_')) {
+            i += 1;
+            continue;
+        }
+        const start = i;
+        while (i < body.len and (std.ascii.isAlphanumeric(body[i]) or body[i] == '_')) i += 1;
+        const word = body[start..i];
+        for ([_][]const u8{ "printf", "putchar", "puts", "memset", "memcpy" }) |helper| if (std.mem.eql(u8, word, helper)) return false;
+        if (std.mem.startsWith(u8, word, "tf_") and !std.mem.eql(u8, word, "tf_py_print")) return false;
+    }
+    return true;
+}
+
+const Prebuilt = struct { clang: [256]u8 = undefined, clang_len: usize = 0, optimize: u8 = 0, object: []u8 = &.{}, su: []u8 = &.{} };
+
+var lock: std.Io.Mutex = .init;
+var prebuilt: [4]Prebuilt = @splat(.{});
+var published: std.atomic.Value(usize) = .init(0); // entries below this never change, so calls read them unlocked
+
+fn level(optimize: anytype) []const u8 {
+    return switch (optimize) {
+        .O0 => "-O0",
+        .O1 => "-O1",
+        .O2 => "-O2",
+    };
+}
+
+/// The compile step's flags for an object: the whole-file build's, without the link.
+fn objectArgv(config: compile.Config, src: []const u8, out: []const u8) [22][]const u8 {
+    return .{
+        config.clang,           "--target=riscv32-unknown-elf", "-march=rv32im_zba",  "-mabi=ilp32",
+        level(config.optimize), "-ffreestanding",               "-fno-builtin",       "-nostdinc",
+        "-fno-stack-protector", "-fno-pic",                     "-mno-relax",         "-Werror=format",
+        "-Wno-format-security", "-fstack-usage",                "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
+        "-c",                   "-x",                           "c",                  src,
+        "-o",                   out,
+    };
+}
+
+fn find(config: compile.Config) ?Prebuilt {
+    for (prebuilt[0..published.load(.acquire)]) |e| if (e.optimize == @backingInt(config.optimize) and std.mem.eql(u8, e.clang[0..e.clang_len], config.clang)) return e;
+    return null;
+}
+
+/// The runtime object and stack report for `config`, else compiled in empty `path`; a call (`wait` false) never queues.
+fn runtimeFor(a: Allocator, io: std.Io, path: []const u8, config: compile.Config, timeout: std.Io.Duration, wait: bool) Allocator.Error!?Prebuilt {
+    if (config.clang.len > 256) return null;
+    if (find(config)) |e| return e;
+    if (wait) lock.lockUncancelable(io) else if (!lock.tryLock()) return null;
+    defer lock.unlock(io);
+    if (find(config)) |e| return e;
+    const n = published.load(.monotonic);
+    if (n == prebuilt.len) return null;
+    const src = try std.fs.path.join(a, &.{ path, "runtime.c" });
+    defer a.free(src);
+    const obj = try std.fs.path.join(a, &.{ path, "runtime.o" });
+    defer a.free(obj);
+    std.Io.Dir.cwd().writeFile(io, .{ .sub_path = src, .data = runtime }) catch return null;
+    var argv = objectArgv(config, src, obj);
+    const ran = try forkserver.run(a, io, path, &argv, .{ .stdout = 4096, .stderr = 16384, .timeout = timeout }) orelse return null;
+    defer ran.deinit(a);
+    if (!ran.ok) return null;
+    const object = readFile(io, path, "runtime.o", 1 << 20) orelse return null;
+    const su = readFile(io, path, "runtime.su", 65536) orelse {
+        std.heap.page_allocator.free(object);
+        return null;
+    };
+    var entry: Prebuilt = .{ .optimize = @backingInt(config.optimize), .object = object, .su = su, .clang_len = config.clang.len };
+    @memcpy(entry.clang[0..config.clang.len], config.clang);
+    prebuilt[n] = entry;
+    published.store(n + 1, .release);
+    return entry;
+}
+
+fn readFile(io: std.Io, dir: []const u8, name: []const u8, limit: usize) ?[]u8 {
+    var buf: [4096]u8 = undefined;
+    const path = std.fmt.bufPrint(&buf, "{s}/{s}", .{ dir, name }) catch return null;
+    return std.Io.Dir.cwd().readFileAlloc(io, path, std.heap.page_allocator, .limited(limit)) catch null;
+}
+
+/// A linked image and the summed stack report of runtime and body; the caller frees both.
+pub const Built = struct {
+    elf: []u8,
+    su: []u8,
+
+    pub fn deinit(b: Built, a: Allocator) void {
+        a.free(b.elf);
+        a.free(b.su);
+    }
+};
+
+/// The body compiled alone in `path`, linked with the runtime; null on any failure (the whole file builds instead).
+pub fn build(a: Allocator, io: std.Io, path: []const u8, body: []const u8, config: compile.Config, timeout: std.Io.Duration) Allocator.Error!?Built {
+    // the identity tests cover O1 and O2, the levels calls use
+    if (config.optimize == .O0) return null;
+    const rt = try runtimeFor(a, io, path, config, timeout, false) orelse return null;
+    const src = try std.fs.path.join(a, &.{ path, "body.c" });
+    defer a.free(src);
+    const obj = try std.fs.path.join(a, &.{ path, "body.o" });
+    defer a.free(obj);
+    const text = try std.mem.concat(a, u8, &.{ declarations, body });
+    defer a.free(text);
+    std.Io.Dir.cwd().writeFile(io, .{ .sub_path = src, .data = text }) catch return null;
+    var argv = objectArgv(config, src, obj);
+    const ran = try forkserver.run(a, io, path, &argv, .{ .stdout = 4096, .stderr = 16384, .timeout = timeout }) orelse return null;
+    defer ran.deinit(a);
+    if (!ran.ok) return null;
+    const object = readFile(io, path, "body.o", 1 << 20) orelse return null;
+    defer std.heap.page_allocator.free(object);
+    // an aggregate copy or fill the compiler lowered to a call: the whole file may inline that function
+    if (rvlink.references(object, "memset") or rvlink.references(object, "memcpy")) return null;
+    const body_su = readFile(io, path, "body.su", 65536) orelse return null;
+    defer std.heap.page_allocator.free(body_su);
+    const elf = try rvlink.link(a, &.{ rt.object, object }) orelse {
+        log.debug("in-process link declined a body; ld.lld links it", .{});
+        return null;
+    };
+    errdefer a.free(elf);
+    return .{ .elf = elf, .su = try std.mem.concat(a, u8, &.{ rt.su, body_su }) };
+}
+
+/// Starts the fork server and compiles the runtime at O1 and O2 (numeric programs); best effort, off the call path.
+pub fn warm(a: Allocator, io: std.Io, config: compile.Config) Allocator.Error!void {
+    if (!std.fs.path.isAbsolute(config.scratch_root)) return;
+    const parent = std.Io.Dir.cwd().openDir(io, config.scratch_root, .{}) catch return;
+    defer parent.close(io);
+    var name_buf: [64]u8 = undefined;
+    const name = compile.scratch(io, parent, &name_buf) orelse return;
+    defer parent.deleteTree(io, name) catch {};
+    const path = try std.fs.path.join(a, &.{ config.scratch_root, name });
+    defer a.free(path);
+    _ = try forkserver.start(a, io, config.clang, config.linker, path);
+    for ([_]@TypeOf(config.optimize){ .O1, .O2 }) |optimize| {
+        var at = config;
+        at.optimize = optimize;
+        _ = try runtimeFor(a, io, path, at, .fromMilliseconds(10_000), true);
+    }
+}
diff --git a/zig/src/core/runner_frontend_split_test.zig b/zig/src/core/runner_frontend_split_test.zig
new file mode 100644
index 000000000..88476c389
--- /dev/null
+++ b/zig/src/core/runner_frontend_split_test.zig
@@ -0,0 +1,348 @@
+//! Split compile vs the whole file: same functions, ld.lld's loaded image, served clang answering as spawned.
+const std = @import("std");
+const split = @import("runner_frontend_split.zig");
+const rvlink = @import("runner_frontend_rvlink.zig");
+const forkserver = @import("runner_frontend_forkserver.zig");
+const compile = @import("runner_frontend_program_compile.zig");
+const program = @import("runner_frontend_program.zig");
+const blocks = @import("runner_frontend_python_blocks.zig");
+const spawn = @import("runner_frontend_spawn.zig");
+const t = std.testing;
+
+/// The 10 slow ELF cells' functions (S3 window, run-check and earlier dr cells).
+const cells = [_][]const u8{
+    "def square_perimeter(side):\n    return 4 * side\n\nassert square_perimeter(10) == 40\nprint(square_perimeter(10))",
+    "def factorial(n):\n    result = 1\n    for i in range(2, n + 1):\n        result *= i\n    return result\n\nfor n in [0, 1, 5, 12]:\n    print(factorial(n))\n",
+    "def centered_hexagonal_number(n):\n    return 3 * n * (n - 1) + 1\n\nassert centered_hexagonal_number(10) == 271\nprint(centered_hexagonal_number(10))",
+    "def check(n):\n    rev = int(str(n)[::-1])\n    return n == 2 * rev - 1\n\nprint(check(70))\nprint(check(13))\nprint(check(0))\n",
+    "def pos_count(numbers):\n    return sum(1 for number in numbers if number > 0)\n\nassert pos_count([1, -2, 3, -4]) == 2\nprint(pos_count([1, -2, 3, -4]))",
+    "def tetrahedral_number(n):\n    return n * (n + 1) * (n + 2) // 6\n\nassert tetrahedral_number(5) == 35\nprint(tetrahedral_number(5))",
+};
+
+test "split: a body compiles alone only when it names none of the runtime's statics or inlinable calls" {
+    try t.expect(split.eligible("static void py_out(int c) {} int main(void) { py_out(10); return 0; }"));
+    try t.expect(!split.eligible("int main(void) { printf(\"%d\", 1); return 0; }"));
+    try t.expect(!split.eligible("int main(void) { char b[8]; memset(b, 0, 8); return b[1]; }"));
+    try t.expect(!split.eligible("int main(void) { puts(\"y\"); }"));
+    try t.expect(!split.eligible("int main(void) { tf_print_int(3); }"));
+    try t.expect(split.eligible("int main(void) { char d[10]; tf_py_print(-3, 0, d); }"));
+    try t.expect(!split.eligible("int main(void) { putchar(10); }"));
+    try t.expect(std.mem.indexOf(u8, split.declarations, "printf") == null);
+}
+
+test "in-process link: the relocations the compile step emits patch as ld.lld does; others decline" {
+    var seg: [8]u8 = undefined;
+    std.mem.writeInt(u32, seg[0..4], 0x00000537, .little);
+    try t.expect(rvlink.patch(&seg, 0, 26, 0x20abc, 0));
+    try t.expectEqual(@as(u32, 0x00021537), std.mem.readInt(u32, seg[0..4], .little));
+    std.mem.writeInt(u32, seg[0..4], 0x00050513, .little);
+    try t.expect(rvlink.patch(&seg, 0, 27, 0x20abc, 0));
+    try t.expectEqual(@as(u32, 0xabc50513), std.mem.readInt(u32, seg[0..4], .little));
+    std.mem.writeInt(u32, seg[0..4], 0x00a52023, .little);
+    try t.expect(rvlink.patch(&seg, 0, 28, 0x123, 0));
+    try t.expectEqual(@as(u32, 0x12a521a3), std.mem.readInt(u32, seg[0..4], .little));
+    std.mem.writeInt(u32, seg[0..4], 0x00000097, .little);
+    std.mem.writeInt(u32, seg[4..8], 0x000080e7, .little);
+    try t.expect(rvlink.patch(&seg, 0, 19, 0x40000 - 0x10, 0x40000));
+    try t.expectEqual(@as(u32, 0x00000097), std.mem.readInt(u32, seg[0..4], .little));
+    try t.expectEqual(@as(u32, 0xff0080e7), std.mem.readInt(u32, seg[4..8], .little));
+    try t.expect(!rvlink.patch(&seg, 0, 51, 0, 0));
+    try t.expect(!rvlink.patch(&seg, 6, 1, 0, 0));
+    try t.expectEqual(@as(?[]u8, null), try rvlink.link(t.allocator, &.{"not an object"}));
+}
+
+fn clangOr() ?[]const u8 {
+    const c = std.c.getenv("TF_RUNNER_CLANG") orelse return null;
+    return std.mem.span(c);
+}
+
+/// A cell's C source as the frontend builds it (the plain lowering, else the structured one).
+fn cellSource(a: std.mem.Allocator, code: []const u8) ![]u8 {
+    if (try program.lowerWithCost(a, code)) |body| {
+        defer a.free(body.source);
+        return program.wrapBody(a, body.source);
+    }
+    return (try blocks.lowerWithCost(a, code)).?.source;
+}
+
+fn run(a: std.mem.Allocator, argv: []const []const u8) !void {
+    const r = (try spawn.run(a, t.io, argv, .{ .stdout = 1 << 20, .stderr = 1 << 16, .timeout = .fromMilliseconds(20_000) })).?;
+    if (!r.ok) std.debug.print("{s}\n", .{r.stderr});
+    try t.expect(r.ok);
+}
+
+/// Function bodies of clang's assembly by name, compiler-local labels renamed and comments dropped.
+fn functions(a: std.mem.Allocator, asm_text: []const u8) !std.StringHashMapUnmanaged([]const u8) {
+    var out: std.StringHashMapUnmanaged([]const u8) = .empty;
+    var want: ?[]const u8 = null;
+    var name: ?[]const u8 = null;
+    var body: std.ArrayList(u8) = .empty;
+    var lines = std.mem.splitScalar(u8, asm_text, '\n');
+    while (lines.next()) |raw| {
+        const hash = std.mem.indexOf(u8, raw, " #") orelse std.mem.indexOf(u8, raw, "\t#") orelse raw.len;
+        const line = std.mem.trimEnd(u8, raw[0..hash], " \t");
+        if (line.len == 0 or line[0] == '#') continue;
+        if (std.mem.startsWith(u8, line, "\t.type\t") and std.mem.endsWith(u8, line, ",@function")) {
+            want = line[7 .. line.len - 10];
+            continue;
+        }
+        if (want != null and line.len == want.?.len + 1 and std.mem.startsWith(u8, line, want.?) and line[line.len - 1] == ':') {
+            name = want;
+            want = null;
+            body = .empty;
+            continue;
+        }
+        if (name == null) continue;
+        if (std.mem.startsWith(u8, line, ".Lfunc_end")) {
+            try out.put(a, name.?, try body.toOwnedSlice(a));
+            name = null;
+            continue;
+        }
+        try body.appendSlice(a, try local(a, line));
+        try body.append(a, '\n');
+    }
+    return out;
+}
+
+/// .LBB3_2 -> .LBB_2 and the like: label numbers follow function order, which differs between the two files.
+fn local(a: std.mem.Allocator, line: []const u8) ![]const u8 {
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 0;
+    while (i < line.len) {
+        inline for (.{ ".LBB", ".LJTI", ".Ltmp", ".Lpcrel_hi", ".L.str", ".Lfunc_end" }) |p| {
+            if (std.mem.startsWith(u8, line[i..], p)) {
+                try out.appendSlice(a, p);
+                i += p.len;
+                while (i < line.len and (std.ascii.isDigit(line[i]) or (std.mem.eql(u8, p, ".L.str") and line[i] == '.'))) i += 1;
+                break;
+            }
+        } else {
+            try out.append(a, line[i]);
+            i += 1;
+        }
+    }
+    return out.items;
+}
+
+const flags = [_][]const u8{ "--target=riscv32-unknown-elf", "-march=rv32im_zba", "-mabi=ilp32", "-ffreestanding", "-fno-builtin", "-nostdinc", "-fno-stack-protector", "-fno-pic", "-mno-relax", "-Werror=format", "-Wno-format-security", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables" };
+
+fn assembly(a: std.mem.Allocator, clang: []const u8, dir: []const u8, name: []const u8, text: []const u8, level: []const u8) ![]const u8 {
+    const src = try std.fmt.allocPrint(a, "{s}/{s}.c", .{ dir, name });
+    const out = try std.fmt.allocPrint(a, "{s}/{s}.s", .{ dir, name });
+    try std.Io.Dir.cwd().writeFile(t.io, .{ .sub_path = src, .data = text });
+    var argv: std.ArrayList([]const u8) = .empty;
+    try argv.appendSlice(a, &.{ clang, level });
+    try argv.appendSlice(a, &flags);
+    try argv.appendSlice(a, &.{ "-S", "-x", "c", src, "-o", out });
+    try run(a, argv.items);
+    return std.Io.Dir.cwd().readFileAlloc(t.io, out, a, .limited(1 << 22));
+}
