+    const tok = b.createModule(.{ .root_source_file = b.path("zig/src/families/deepseek_v41/serve/tokenizer.zig"), .target = target, .optimize = .ReleaseFast, .imports = &.{.{ .name = "tokenizer", .module = core_tok }} });
