+    defer env.deinit();
+    const settings = try config(&env);
+    if (env.get("TF_RUNNER_QWENPUTER") == null) return error.SkipZigTest;
+    for (scope_cases) |example| {
+        const source = (try blocks.lowerPython(t.allocator, example.code)) orelse return error.UnexpectedAbstention;
+        defer t.allocator.free(source);
+        const bytes = (try compiler.compile(t.allocator, t.io, source, settings)) orelse return error.CompilationFailed;
+        defer t.allocator.free(bytes);
+        try checkReference(&env, bytes, example.expected);
+    }
+}
+
+test "configured RV32 nested singleton loops preserve twenty seven full global lists" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const settings = try config(&env);
+    if (env.get("TF_RUNNER_QWENPUTER") == null) return error.SkipZigTest;
+    var code: std.ArrayList(u8) = .empty;
+    defer code.deinit(t.allocator);
+    for (0..27) |i| try code.print(t.allocator, "a{d} = []\n", .{i});
+    try code.appendSlice(t.allocator, "for n in range(128):\n");
+    for (0..27) |i| try code.print(t.allocator, "    a{d}.append(1)\n", .{i});
+    try code.appendSlice(t.allocator,
+        \\def f():
+        \\    for v in [0]:
+        \\        for v in [0]:
+        \\            for v in [0]:
+        \\                for v in [0]:
+        \\                    for v in [0]:
+        \\                        for v in [0]:
+        \\                            return 0
+        \\print(f(),
+    );
+    for (0..27) |i| {
+        if (i != 0) try code.appendSlice(t.allocator, ", ");
+        try code.print(t.allocator, "sum(a{d})", .{i});
+    }
+    try code.appendSlice(t.allocator, ")\n");
+    var expected: std.ArrayList(u8) = .empty;
+    defer expected.deinit(t.allocator);
+    try expected.appendSlice(t.allocator, "0");
+    for (0..27) |_| try expected.appendSlice(t.allocator, " 128");
+    try expected.appendSlice(t.allocator, "\n");
+    const source = (try blocks.lowerPython(t.allocator, code.items)) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(source);
+    const bytes = (try compiler.compile(t.allocator, t.io, source, settings)) orelse return error.CompilationFailed;
+    defer t.allocator.free(bytes);
+    try checkReference(&env, bytes, expected.items);
+}
+
+test "configured compiler stack guard refuses a real oversized frame with disabled guard countercheck" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    var settings = try config(&env);
+    const source = "volatile unsigned int at=4999; int main(void) { volatile char buf[5000]; buf[at] = 0; return buf[at]; }\n";
+    const guarded = try compiler.compile(t.allocator, t.io, source, settings);
+    defer if (guarded) |bytes| t.allocator.free(bytes);
+    try t.expect(guarded == null);
+    settings.stack_limit = 0;
+    const unguarded = (try compiler.compile(t.allocator, t.io, source, settings)) orelse return error.CompilationFailed;
+    defer t.allocator.free(unguarded);
+    try t.expect(compiler.validElf(unguarded));
+}
diff --git a/zig/src/core/runner_frontend_boot.zig b/zig/src/core/runner_frontend_boot.zig
new file mode 100644
index 000000000..9bfaf042d
--- /dev/null
+++ b/zig/src/core/runner_frontend_boot.zig
@@ -0,0 +1,43 @@
+//! Model-free boot capability check; only the compiler runs on the host, never the compiled RV32 program.
+const std = @import("std");
+const program = @import("runner_frontend_program.zig");
+
+pub const Config = struct {
+    compiler: program.Config = .{},
+    required: bool = false,
+};
+
+const source =
+    \\int main(void) {
+    \\ volatile int value = 7;
+    \\ value = value * 6;
+    \\ return value == 42 ? 0 : 1;
+    \\}
+;
+
+/// Returns compiler capability after compile() validates the ELF; required boot fails closed on unavailability.
+pub fn selfTest(a: std.mem.Allocator, io: std.Io, config: Config) !bool {
+    const elf = try program.compile(a, io, source, config.compiler);
+    defer if (elf) |bytes| a.free(bytes);
+    return capability(elf != null, config.required);
+}
+
+fn capability(available: bool, required: bool) error{RunnerUnavailable}!bool {
+    if (required and !available) return error.RunnerUnavailable;
+    return available;
+}
+
+test "optional and required boot capability policy" {
+    try std.testing.expect(!try capability(false, false));
+    try std.testing.expect(try capability(true, false));
+    try std.testing.expect(try capability(true, true));
+    try std.testing.expectError(error.RunnerUnavailable, capability(false, true));
+}
+
+test "missing compiler permits ordinary boot and refuses required boot" {
+    const a = std.testing.allocator;
+    var config: Config = .{ .compiler = .{ .clang = "/nonexistent-tensorfold-boot-clang" } };
+    try std.testing.expect(!try selfTest(a, std.testing.io, config));
+    config.required = true;
+    try std.testing.expectError(error.RunnerUnavailable, selfTest(a, std.testing.io, config));
+}
diff --git a/zig/src/core/runner_frontend_boot_main.zig b/zig/src/core/runner_frontend_boot_main.zig
new file mode 100644
index 000000000..96257d0a9
--- /dev/null
+++ b/zig/src/core/runner_frontend_boot_main.zig
@@ -0,0 +1,141 @@
+//! Standalone compiler boot probe; enabling the runner requires a working RV32 toolchain.
+const std = @import("std");
+const boot = @import("runner_frontend_boot.zig");
+const usage = "Usage: tf-runner-frontend-check [--require] [--clang PATH] [--linker PATH] [--circuit PATH] [--help]\n";
+
+const Options = struct {
+    config: boot.Config = .{},
+    help: bool = false,
+    circuit: ?[]const u8 = null, // also run the loop probe (core/runner_probe.zig) on this circuit: wrong is exit 1
+};
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    var buffer: [512]u8 = undefined;
+    var output = std.Io.File.stderr().writerStreaming(init.io, &buffer);
+    defer output.interface.flush() catch {};
+    const options = parseWith(args[1..], environment(init.environ_map)) catch {
+        try output.interface.writeAll(usage);
+        return 2;
+    };
+    if (options.help) {
+        try output.interface.writeAll(usage);
+        return 0;
+    }
+    const available = boot.selfTest(init.gpa, init.io, options.config) catch |err| switch (err) {
+        error.RunnerUnavailable => {
+            try output.interface.writeAll("runner compiler: unavailable (required; clang/lld RV32 ELF check failed)\n");
+            return 1;
+        },
+        else => return err,
+    };
+    try output.interface.writeAll(if (available)
+        "runner compiler: available (rv32im_zba ELF validated)\n"
+    else
+        "runner compiler: unavailable (optional; clang/lld RV32 ELF check failed)\n");
+    if (options.circuit) |path| return probe(init.gpa, init.io, &output.interface, path, options.config.compiler, available);
+    return 0;
+}
+
+/// The image's circuit route: the probe cells compiled here and run on `path` must print what Python or C prints.
+fn probe(gpa: std.mem.Allocator, io: std.Io, out: *std.Io.Writer, path: []const u8, compiler: @import("runner_frontend_program.zig").Config, available: bool) !u8 {
+    if (!available) {
+        try out.print("runner circuit {s}: not probed (no RV32 compiler)\n", .{path});
+        return 1;
+    }
+    var c = @import("runner_circuit.zig").Circuit.load(gpa, path) catch |e| {
+        try out.print("runner circuit {s}: does not load ({t})\n", .{ path, e });
+        return 1;
+    };
+    defer c.deinit(gpa);
+    const backend = @import("runner_circuit_backend.zig");
+    const b = try backend.backend(gpa, &c, 1);
+    defer backend.destroy(b);
+    var ctx: @import("runner_frontend.zig").Context = .{ .io = io, .compiler = compiler };
+    var why: [256]u8 = undefined;
+    const got = try @import("runner_probe.zig").run(gpa, ctx.frontend(), b, true, &why);
+    if (got.wrong) |w| {
+        try out.print("runner circuit {s}: WRONG: {s}\n", .{ path, w });
+        return 1;
+    }
+    try out.print("runner circuit {s}: {d} probe cells print the right output in {d} steps\n", .{ path, got.ran, got.steps });
+    return 0;
+}
+
+fn parse(args: []const [:0]const u8) error{InvalidArguments}!Options {
+    return parseWith(args, .{});
+}
+
+fn environment(env: *const std.process.Environ.Map) Options {
+    var options: Options = .{};
+    if (env.get("TF_RUNNER_CLANG")) |path| options.config.compiler.clang = path;
+    options.config.compiler.linker = env.get("TF_RUNNER_LLD");
+    const value = env.get("TF_RUNNER") orelse "";
+    options.config.required = value.len != 0 and !std.mem.eql(u8, value, "0") and
+        !std.ascii.eqlIgnoreCase(value, "false") and !std.ascii.eqlIgnoreCase(value, "off") and
+        !std.ascii.eqlIgnoreCase(value, "no");
+    return options;
+}
+
+fn parseWith(args: []const [:0]const u8, initial: Options) error{InvalidArguments}!Options {
+    var options = initial;
+    var i: usize = 0;
+    while (i < args.len) : (i += 1) {
+        const arg = args[i];
+        if (std.mem.eql(u8, arg, "--require")) {
+            options.config.required = true;
+        } else if (std.mem.eql(u8, arg, "--help")) {
+            options.help = true;
+        } else if (std.mem.eql(u8, arg, "--clang") or std.mem.eql(u8, arg, "--linker") or std.mem.eql(u8, arg, "--circuit")) {
+            i += 1;
+            if (i == args.len or args[i].len == 0 or std.mem.startsWith(u8, args[i], "--"))
+                return error.InvalidArguments;
+            if (std.mem.eql(u8, arg, "--clang")) {
+                options.config.compiler.clang = args[i];
+            } else if (std.mem.eql(u8, arg, "--circuit")) {
+                options.circuit = args[i];
+            } else {
+                options.config.compiler.linker = args[i];
+            }
+        } else return error.InvalidArguments;
+    }
+    return options;
+}
+
+test "CLI defaults optional and passes explicit toolchain paths to the boot probe" {
+    try std.testing.expect(!(try parse(&.{})).config.required);
+    const options = try parse(&.{ "--require", "--clang", "/missing/clang", "--linker", "/missing/ld.lld" });
+    try std.testing.expect(options.config.required);
+    try std.testing.expectEqualStrings("/missing/clang", options.config.compiler.clang);
+    try std.testing.expectEqualStrings("/missing/ld.lld", options.config.compiler.linker.?);
+    try std.testing.expectEqualStrings("/c.tfpc", (try parse(&.{ "--circuit", "/c.tfpc" })).circuit.?);
+    try std.testing.expectEqual(null, options.circuit);
+}
+
+test "CLI refuses missing toolchain paths and unknown arguments" {
+    try std.testing.expectError(error.InvalidArguments, parse(&.{"--clang"}));
+    try std.testing.expectError(error.InvalidArguments, parse(&.{ "--linker", "--require" }));
+    try std.testing.expectError(error.InvalidArguments, parse(&.{ "--clang", "" }));
+    try std.testing.expectError(error.InvalidArguments, parse(&.{"--unknown"}));
+}
+
+test "environment enables fail closed only for a requested runner" {
+    var env = std.process.Environ.Map.init(std.testing.allocator);
+    defer env.deinit();
+    try std.testing.expect(!environment(&env).config.required);
+    for ([_][]const u8{ "", "0", "false", "off", "no", "FALSE" }) |value| {
+        try env.put("TF_RUNNER", value);
+        try std.testing.expect(!environment(&env).config.required);
+    }
+    for ([_][]const u8{ "1", "true", "on", "yes", "invalid" }) |value| {
+        try env.put("TF_RUNNER", value);
+        try std.testing.expect(environment(&env).config.required);
+    }
+    try env.put("TF_RUNNER_CLANG", "/missing/compiler");
+    try env.put("TF_RUNNER_LLD", "/missing/linker");
+    const options = environment(&env);
+    try std.testing.expectEqualStrings("/missing/compiler", options.config.compiler.clang);
+    try std.testing.expectEqualStrings("/missing/linker", options.config.compiler.linker.?);
+    const overridden = try parseWith(&.{ "--clang", "/explicit/compiler" }, options);
+    try std.testing.expectEqualStrings("/explicit/compiler", overridden.config.compiler.clang);
+}
diff --git a/zig/src/core/runner_frontend_budget_test.zig b/zig/src/core/runner_frontend_budget_test.zig
new file mode 100644
index 000000000..ce416d286
--- /dev/null
+++ b/zig/src/core/runner_frontend_budget_test.zig
@@ -0,0 +1,115 @@
+const std = @import("std");
+const frontend = @import("runner_frontend.zig");
+const compiler = @import("runner_frontend_program_compile.zig");
+const program = @import("runner_frontend_program.zig");
+const t = std.testing;
+
+pub const observed_gcd =
+    \\int gcd(int a, int b) {
+    \\    while (b != 0) { int temp = b; b = a % b; a = temp; }
+    \\    return a;
+    \\}
+    \\int main(void) {
+    \\    int a = 462; int b = 1071;
+    \\    printf("gcd(%d, %d) = %d\n", a, b, gcd(a, b)); return 0;
+    \\}
+;
+
+test "saved C Euclid swap order retains default admission and rejects noncontracting mutations" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const config: compiler.Config = .{ .clang = clang, .linker = env.get("TF_RUNNER_LLD") };
+    const bytes = (try compiler.compile(t.allocator, t.io, observed_gcd, config)) orelse
+        return error.UnexpectedAbstention;
+    defer t.allocator.free(bytes);
+    for ([_][]const u8{ "a + b", "a % a + b" }) |replacement| {
+        const changed = try std.mem.replaceOwned(u8, t.allocator, observed_gcd, "a % b", replacement);
+        defer t.allocator.free(changed);
+        const refused = try compiler.compile(t.allocator, t.io, changed, config);
+        defer if (refused) |elf| t.allocator.free(elf);
+        try t.expect(refused == null);
+    }
+    try @import("runner_frontend_reference_test.zig").check(env.get("TF_RUNNER_QWENPUTER") orelse
+        return error.SkipZigTest, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", .{ .kind = .elf, .bytes = bytes }, "gcd(462, 1071) = 21\n");
+}
+
+test "estimated cell steps reject long integer walks before compilation" {
+    const short = (try program.lowerWithCost(t.allocator, "n = 0\nwhile n < 5:\n    n += 1\nprint(n)")) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(short.source);
+    const long = (try program.lowerWithCost(t.allocator, "n = 0\nwhile n < 10000:\n    n += 1\nprint(n)")) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(long.source);
+    try t.expect(short.estimated_steps <= 10522);
+    try t.expect(long.estimated_steps > 10522);
+}
+
+test "configured public frontend applies the step budget with a disabled policy control" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{ .clang = clang, .linker = env.get("TF_RUNNER_LLD") } };
+    const cells = [_][]const u8{
+        "n = 0\nwhile n < 10000:\n    n += 1\nprint(n)",
+        "int main(void){int n=0;for(int i=0;i<10000;++i)n+=i;printf(\"%d\\n\",n);return 0;}",
+    };
+    for (cells, 0..) |code, index| {
+        const cell: frontend.Cell = .{ .lang = if (index == 0) "python" else "c", .form = .fence, .code = code };
+        const f = context.frontend();
+        const refused = try f.translate(f.ctx, t.allocator, cell);
+        if (refused == .program) t.allocator.free(refused.program.bytes);
+        try t.expect(refused == .abstain);
+        context.compiler.step_budget = 0;
+        const admitted = try f.translate(f.ctx, t.allocator, cell);
+        try t.expect(admitted == .program);
+        t.allocator.free(admitted.program.bytes);
+        context.compiler.step_budget = 10522;
+    }
+    const source = "int main(void){printf(\"%d\\n\",2*3);return 0;}";
+    const small = (try compiler.compile(t.allocator, t.io, source, context.compiler)) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(small);
+    try t.expect(compiler.validElf(small));
+    context.compiler.estimated_steps = 10523;
+    try t.expectEqual(@as(?[]u8, null), try compiler.compile(t.allocator, t.io, source, context.compiler));
+    context.compiler.estimated_steps = null;
+    context.compiler.deadline = std.Io.Clock.awake.now(t.io).subDuration(.fromNanoseconds(1));
+    try t.expectEqual(@as(?[]u8, null), try compiler.compile(t.allocator, t.io, source, context.compiler));
+    const f = context.frontend();
+    const expired = try f.translate(f.ctx, t.allocator, .{ .form = .fence, .lang = "c", .code = source });
+    if (expired == .program) t.allocator.free(expired.program.bytes);
+    try t.expect(expired == .abstain);
+}
+
+test "restoration bytes are budgeted independently of short source text" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const config: compiler.Config = .{ .clang = clang, .linker = env.get("TF_RUNNER_LLD") };
+    const copied = "static char data[4096]={1};int main(void){puts(\"ok\");return 0;}";
+    const refused = try compiler.compile(t.allocator, t.io, copied, config);
+    defer if (refused) |bytes| t.allocator.free(bytes);
+    try t.expect(refused == null);
+    const literal = "static char data[4096]=\"x\";int main(void){puts(\"ok\");return 0;}";
+    const bytes = (try compiler.compile(t.allocator, t.io, literal, config)) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(bytes);
+    try t.expect(compiler.validElf(bytes));
+    try @import("runner_frontend_reference_test.zig").check(env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", .{ .kind = .elf, .bytes = bytes }, "ok\n");
+}
+
+test "firmware and inline forms share the per-cell admission budget" {
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{ .step_budget = 1, .clang = "/nonexistent-t5-clang" } };
+    for ([_]frontend.Cell{
+        .{ .form = .fence, .lang = "python", .code = "print(2*3)" },
+        .{ .form = .inline_expr, .lang = "python", .code = "2*3" },
+    }) |cell| {
+        const f = context.frontend();
+        const refused = try f.translate(f.ctx, t.allocator, cell);
+        if (refused == .program) t.allocator.free(refused.program.bytes);
+        try t.expect(refused == .abstain);
+        context.compiler.step_budget = 0;
+        const admitted = try f.translate(f.ctx, t.allocator, cell);
+        try t.expect(admitted == .program);
+        defer t.allocator.free(admitted.program.bytes);
+        try t.expectEqual(.calc, admitted.program.kind);
+        context.compiler.step_budget = 1;
+    }
+}
diff --git a/zig/src/core/runner_frontend_c_cost.zig b/zig/src/core/runner_frontend_c_cost.zig
new file mode 100644
index 000000000..645c0b723
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_cost.zig
@@ -0,0 +1,320 @@
+const std = @import("std");
+const m = @import("runner_frontend_c_cost_model.zig");
+const expression = @import("runner_frontend_c_cost_expr.zig");
+const loops = @import("runner_frontend_c_cost_loops.zig");
+const printing = @import("runner_frontend_c_cost_print.zig");
+const Allocator = std.mem.Allocator;
+const V = m.V;
+const Error = m.Error;
+const Value = m.Value;
+const Env = m.Env;
+
+// Estimates original typed C only; the caller reserves any additional opacity-copy startup cost.
+pub fn estimate(a: Allocator, ast_json: []const u8, source_offset: usize, limit: usize) Allocator.Error!?usize {
+    if (ast_json.len > 4 * 1024 * 1024 or limit == std.math.maxInt(usize) or !m.validateJson(ast_json)) return null;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const scratch = arena.allocator();
+    const parsed = std.json.parseFromSlice(V, scratch, ast_json, .{}) catch |err| {
+        if (err == error.OutOfMemory) return error.OutOfMemory;
+        return null;
+    };
+    defer parsed.deinit();
+    var pass: Pass = .{ .a = scratch, .limit = limit, .offset = source_offset };
+    return pass.run(parsed.value) catch |err| {
+        if (err == error.OutOfMemory) return error.OutOfMemory;
+        return null;
+    };
+}
+
+pub const Flow = struct {
+    normal: bool = true,
+    returned: ?Value = null,
+
+    pub fn include(f: *Flow, other: Flow) Error!void {
+        if (other.returned) |v| f.returned = if (f.returned) |old| try old.join(v) else v;
+    }
+};
+
+const Pass = struct {
+    a: Allocator,
+    limit: usize,
+    offset: usize,
+    cost: usize = 0,
+    work: usize = 0,
+    snapshots: usize = 0,
+    functions: std.ArrayList(V) = .empty,
+    runtime: std.ArrayList(V) = .empty,
+    globals: Env = .{},
+    active: [32][]const u8 = undefined,
+    depth: usize = 0,
+    expression_depth: usize = 0,
+    locked: std.ArrayList([]const u8) = .empty,
+
+    pub fn touch(p: *Pass) Error!void {
+        if (p.work >= 100_000) return error.Unsupported;
+        p.work += 1;
+    }
+    pub fn charge(p: *Pass, n: usize) Error!void {
+        p.cost += @min(n, p.limit + 1 - p.cost);
+        if (p.cost > p.limit) return error.Unsupported;
+    }
+    pub fn clone(p: *Pass, env: *const Env) Error!Env {
+        if (p.snapshots >= 1024) return error.Unsupported;
+        p.snapshots += 1;
+        return env.clone(p.a);
+    }
+    pub fn eval(p: *Pass, env: *Env, node: V) Error!Value {
+        if (p.expression_depth >= 64) return error.Unsupported;
+        p.expression_depth += 1;
+        defer p.expression_depth -= 1;
+        return expression.eval(p, env, node);
+    }
+    pub fn store(p: *Pass, env: *Env, target: V, value: Value) Error!void {
+        const id = m.ref(target);
+        if (id.len != 0) {
+            for (p.locked.items) |s| if (std.mem.eql(u8, id, s)) return error.Unsupported;
+            const b = env.find(id) orelse return error.Unsupported;
+            if (b.global and p.depth > 1) return error.Unsupported;
+            const t = b.typ orelse return error.Unsupported;
+            var v = value;
+            const r = try v.numeric();
+            if (!t.fits(r)) v.number = t.range();
+            b.value = v;
+            return;
+        }
+        const n = m.strip(target);
+        const c = m.children(n);
+        if (!m.is(n, "ArraySubscriptExpr") or c.len != 2) return error.Unsupported;
+        const index = try (try p.eval(env, c[1])).numeric();
+        const b = env.find(m.ref(c[0])) orelse return error.Unsupported;
+        if (b.indirect) return error.Unsupported;
+        if (b.global and p.depth > 1) return error.Unsupported;
+        for (p.locked.items) |s| if (std.mem.eql(u8, b.id, s)) return error.Unsupported;
+        var array = b.value.array orelse return error.Unsupported;
+        if (index.lo < 0 or index.hi >= array.count) return error.Unsupported;
+        _ = try value.numeric();
+        array.element = array.element_type.range();
+        array.text = null;
+        b.value.array = array;
+        try p.charge(6);
+    }
+    pub fn declare(p: *Pass, env: *Env, node: V, global: bool) Error!void {
+        if (!m.is(node, "VarDecl")) return error.Unsupported;
+        if (!global and std.mem.eql(u8, m.text(m.field(node, "storageClass")), "static")) return error.Unsupported;
+        const raw = m.typ(node);
+        const c = m.children(node);
+        const id = m.text(m.field(node, "id"));
+        if (id.len == 0) return error.Unsupported;
+        if (m.arrayType(raw)) |t| {
+            var ar: m.Array = .{
+                .count = t.count,
+                .element_type = t.element,
+                .element = if (global) m.Range.exact(0) else t.element.range(),
+                .readable = global or c.len == 1,
+            };
+            if (c.len > 1) return error.Unsupported;
+            if (c.len == 1) {
+                if (m.is(m.strip(c[0]), "StringLiteral")) {
+                    ar.text = try m.string(p.a, c[0]);
+                    if (t.element.bits != 8 or ar.text.?.len >= ar.count) return error.Unsupported;
+                    ar.element = .{ .lo = 0, .hi = 255 };
+                } else if (m.is(c[0], "InitListExpr")) {
+                    const init = m.children(c[0]);
+                    const filler = m.field(c[0], "array_filler");
+                    if (filler != .null or init.len > t.count) return error.Unsupported;
+                    var bound: ?m.Range = if (init.len < t.count) m.Range.exact(0) else null;
+                    for (init) |n| {
+                        const r = try (try p.eval(env, n)).numeric();
+                        if (!t.element.fits(r)) return error.Unsupported;
+                        bound = if (bound) |old| old.join(r) else r;
+                    }
+                    ar.element = bound orelse return error.Unsupported;
+                } else return error.Unsupported;
+            }
+            try env.add(p.a, .{ .id = id, .value = .{ .array = ar }, .typ = null, .global = global });
+            const bytes = t.count * @max(@as(usize, 1), t.element.bits / 8);
+            try p.charge(if (global) 4 else bytes * 10 + 4);
+        } else if (m.integerType(raw)) |t| {
+            if (c.len > 1) return error.Unsupported;
+            var value = if (c.len == 1) try p.eval(env, c[0]) else if (global) Value.integer(0) else Value{};
+            if (value.number) |r| {
+                if (!t.fits(r)) value.number = t.range();
+            }
+            try env.add(p.a, .{ .id = id, .value = value, .typ = t, .global = global });
+            try p.charge(2);
+        } else if (std.mem.indexOfScalar(u8, raw, '*') != null and c.len == 1) {
+            const value = try p.eval(env, c[0]);
+            if (value.text == null and (value.array == null or value.array.?.text == null)) return error.Unsupported;
+            try env.add(p.a, .{ .id = id, .value = value, .typ = null, .global = global, .indirect = true });
+            try p.charge(3);
+        } else return error.Unsupported;
+    }
+    pub fn block(p: *Pass, env: *Env, nodes: []const V) Error!Flow {
+        const mark = env.bindings.items.len;
+        defer env.bindings.shrinkRetainingCapacity(mark);
+        var result: Flow = .{};
+        for (nodes) |node| {
+            const next = try p.stmt(env, node);
+            try result.include(next);
+            result.normal = next.normal;
+            if (!result.normal) break;
+        }
+        return result;
+    }
+    pub fn stmt(p: *Pass, env: *Env, node: V) Error!Flow {
+        try p.touch();
+        const c = m.children(node);
+        if (m.is(node, "CompoundStmt")) return p.block(env, c);
+        if (m.is(node, "DeclStmt")) {
+            for (c) |n| try p.declare(env, n, false);
+        } else if (m.is(node, "ReturnStmt")) {
+            if (c.len > 1) return error.Unsupported;
+            try p.charge(8);
+            return .{ .normal = false, .returned = if (c.len == 1) try p.eval(env, c[0]) else Value.integer(0) };
+        } else if (m.is(node, "IfStmt")) {
+            if (c.len < 2 or c.len > 3) return error.Unsupported;
+            return p.branch(env, c[0], c[1], if (c.len == 3) c[2] else .null);
+        } else if (m.is(node, "ForStmt")) {
+            return loops.forLoop(p, env, node);
+        } else if (m.is(node, "WhileStmt")) {
+            return loops.whileLoop(p, env, node);
+        } else if (!m.is(node, "NullStmt")) {
+            _ = try p.eval(env, node);
+        }
+        return .{};
+    }
+    fn branch(p: *Pass, env: *Env, cond: V, yes: V, no: V) Error!Flow {
+        const r = try (try p.eval(env, cond)).numeric();
+        try p.charge(2);
+        if (r.lo == 0 and r.hi == 0) {
+            expression.refine(env, cond, false);
+            return if (no == .null) .{} else p.stmt(env, no);
+        }
+        if (r.lo > 0 or r.hi < 0) {
+            expression.refine(env, cond, true);
+            return p.stmt(env, yes);
+        }
+        var other = try p.clone(env);
+        expression.refine(env, cond, true);
+        expression.refine(&other, cond, false);
+        const base = p.cost;
+        var result = try p.stmt(env, yes);
+        const yes_cost = p.cost;
+        p.cost = base;
+        const next = if (no == .null) Flow{} else try p.stmt(&other, no);
+        p.cost = @max(p.cost, yes_cost);
+        try result.include(next);
+        if (result.normal and next.normal) try env.merge(&other) else if (next.normal) env.* = other;
+        result.normal = result.normal or next.normal;
+        return result;
+    }
+    pub fn conditionalValue(p: *Pass, env: *Env, c: []const V) Error!Value {
+        const r = try (try p.eval(env, c[0])).numeric();
+        try p.charge(2);
+        if (r.lo == 0 and r.hi == 0) return p.eval(env, c[2]);
+        if (r.lo > 0 or r.hi < 0) return p.eval(env, c[1]);
+        var other = try p.clone(env);
+        expression.refine(env, c[0], true);
+        expression.refine(&other, c[0], false);
+        const base = p.cost;
+        const x = try p.eval(env, c[1]);
+        const yes_cost = p.cost;
+        p.cost = base;
+        const y = try p.eval(&other, c[2]);
+        p.cost = @max(p.cost, yes_cost);
+        try env.merge(&other);
+        return x.join(y);
+    }
+    pub fn call(p: *Pass, env: *Env, node: V) Error!Value {
+        const c = m.children(node);
+        if (c.len == 0 or c.len > 17) return error.Unsupported;
+        const ref = m.field(m.strip(c[0]), "referencedDecl");
+        if (!m.is(ref, "FunctionDecl")) return error.Unsupported;
+        const name = m.text(m.field(ref, "name"));
+        if (std.mem.eql(u8, name, "printf") and (c.len < 2 or !m.is(m.strip(c[1]), "StringLiteral")))
+            return error.Unsupported;
+        var args: [16]Value = undefined;
+        for (c[1..], 0..) |arg, i| args[i] = try p.eval(env, arg);
+        try p.charge(12);
+        for (p.functions.items) |f| if (std.mem.eql(u8, name, m.text(m.field(f, "name"))))
+            return p.invoke(env, f, args[0 .. c.len - 1]);
+        const id = m.text(m.field(ref, "id"));
+        for (p.runtime.items) |f| {
+            if (!std.mem.eql(u8, id, m.text(m.field(f, "id")))) continue;
+            return printing.call(p, name, args[0 .. c.len - 1]);
+        }
+        return error.Unsupported;
+    }
+    fn invoke(p: *Pass, caller: *Env, function: V, args: []const Value) Error!Value {
+        const name = m.text(m.field(function, "name"));
+        if (p.depth >= p.active.len) return error.Unsupported;
+        for (p.active[0..p.depth]) |s| if (std.mem.eql(u8, s, name)) return error.Unsupported;
+        p.active[p.depth] = name;
+        p.depth += 1;
+        defer p.depth -= 1;
+        var env: Env = .{};
+        for (caller.bindings.items) |b| if (b.global) try env.add(p.a, b);
+        var n: usize = 0;
+        var body: V = .null;
+        for (m.children(function)) |node| {
+            if (m.is(node, "ParmVarDecl")) {
+                if (n >= args.len) return error.Unsupported;
+                const t = m.integerType(m.typ(node));
+                var value = args[n];
+                if (t) |scalar| {
+                    if (!scalar.fits(try value.numeric())) value.number = scalar.range();
+                } else if (value.text == null and (value.array == null or value.array.?.text == null)) return error.Unsupported;
+                try env.add(p.a, .{ .id = m.text(m.field(node, "id")), .value = value, .typ = t, .indirect = t == null });
+                n += 1;
+            } else if (m.is(node, "CompoundStmt")) body = node else return error.Unsupported;
+        }
+        if (n != args.len or body == .null) return error.Unsupported;
+        const saved = p.locked.items.len;
+        defer p.locked.shrinkRetainingCapacity(saved);
+        const flow = try p.stmt(&env, body);
+        if (p.depth == 1) {
+            for (env.bindings.items) |b| if (b.global) {
+                if (caller.find(b.id)) |target| target.value = b.value;
+            };
+        }
+        var result = flow.returned;
+        if (flow.normal) {
+            if (!std.mem.eql(u8, name, "main") and !std.mem.startsWith(u8, m.typ(function), "void ("))
+                return error.Unsupported;
+            result = if (result) |old| try old.join(Value.integer(0)) else Value.integer(0);
+        }
+        return result orelse error.Unsupported;
+    }
+    fn run(p: *Pass, root: V) Error!usize {
+        if (!m.is(root, "TranslationUnitDecl")) return error.Unsupported;
+        try p.charge(200);
+        var main: V = .null;
+        for (m.children(root)) |node| {
+            const loc = m.field(node, "loc");
+            const expansion = m.field(loc, "expansionLoc");
+            const raw_offset = m.field(if (expansion == .null) loc else expansion, "offset");
+            if (raw_offset != .integer or raw_offset.integer < 0) continue;
+            const user = @as(u128, @intCast(raw_offset.integer)) >= p.offset;
+            if (m.is(node, "FunctionDecl")) {
+                if (!user) {
+                    try p.runtime.append(p.a, node);
+                    continue;
+                }
+                var defined = false;
+                for (m.children(node)) |child| {
+                    if (m.is(child, "CompoundStmt")) defined = true;
+                }
+                if (!defined) continue;
+                if (p.functions.items.len >= 32) return error.Unsupported;
+                try p.functions.append(p.a, node);
+                if (std.mem.eql(u8, m.text(m.field(node, "name")), "main")) main = node;
+            } else if (user and m.is(node, "VarDecl")) {
+                try p.declare(&p.globals, node, true);
+            } else if (user and !m.is(node, "TypedefDecl") and !m.is(node, "EmptyDecl")) return error.Unsupported;
+        }
+        if (main == .null) return error.Unsupported;
+        _ = try p.invoke(&p.globals, main, &.{});
+        return p.cost;
+    }
+};
diff --git a/zig/src/core/runner_frontend_c_cost_expr.zig b/zig/src/core/runner_frontend_c_cost_expr.zig
