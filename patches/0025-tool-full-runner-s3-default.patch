+    try std.testing.expect(cases[0].a.len == 256 and cases[1].a.len == 256);
+    try std.testing.expect(cases[0].a[0] != cases[1].a[0]);
+    try std.testing.expectEqualStrings(cases[0].a[1..], cases[1].a[1..]);
+    const narrow = try packets.Builder.named(gpa, "powmod-128", &.{ cases[0].a, cases[0].b, cases[0].m });
+    defer gpa.free(narrow);
+    try std.testing.expectError(error.GraphNarrowBinding, graph.Machine.boot(gpa, &both.bank, narrow));
+    const oversize = try packets.Builder.named(gpa, "powmod-256", &.{ &excessive, "1", "7" });
+    defer gpa.free(oversize);
+    try std.testing.expectError(error.GraphLiteral, graph.Machine.boot(gpa, &both.bank, oversize));
+    try std.testing.expectEqual(@as(usize, 0), both.bank.preparedCount());
+    try std.testing.expectEqual(@as(u64, 0), both.bank.loadAttempts());
+    const first = try packets.Builder.integer(gpa, .powmod, &.{ cases[0].a, cases[0].b, cases[0].m });
+    defer gpa.free(first);
+    const second = try packets.Builder.integer(gpa, .powmod, &.{ cases[1].a, cases[1].b, cases[1].m });
+    defer gpa.free(second);
+    for ([_][]const u8{ first, second }) |bytes|
+        try std.testing.expect(std.mem.indexOf(u8, bytes, "powmod-256") != null);
+    try std.testing.expectEqual(@as(usize, 0), both.bank.preparedCount());
+    const one = try both.graph.start(1, .{ .kind = .graph, .bytes = first }, 4_000_000);
+    defer both.graph.release(1);
+    const two = try both.graph.start(2, .{ .kind = .graph, .bytes = second }, 4_000_000);
+    defer both.graph.release(2);
+    const r_two = finish(both.graph, two);
+    try std.testing.expectEqual(rapi.Status.ok, r_two.status);
+    try std.testing.expectEqualStrings(cases[1].want, r_two.out);
+    const r_one = finish(both.graph, one);
+    try std.testing.expectEqual(rapi.Status.ok, r_one.status);
+    try std.testing.expectEqualStrings(cases[0].want, r_one.out);
+    try std.testing.expect(both.bank.preparedCount() > 0);
+    try std.testing.expect(both.bank.loadAttempts() > 0);
+    std.debug.print("powmod streams: {s} and {s} exact CPython; lazy prepared {d}, attempts {d}\n", .{ cases[0].id, cases[1].id, both.bank.preparedCount(), both.bank.loadAttempts() });
+}
diff --git a/zig/src/core/runner_receipt.zig b/zig/src/core/runner_receipt.zig
new file mode 100644
index 000000000..bea886a61
--- /dev/null
+++ b/zig/src/core/runner_receipt.zig
@@ -0,0 +1,234 @@
+//! A reply's runner receipt (runtime.runner): cell counts, holds and a record per owned cell's span, route and write.
+const std = @import("std");
+const abstain = @import("runner_abstain.zig");
+const answer = @import("runner_commit.zig");
+const Allocator = std.mem.Allocator;
+
+/// A span longer than this is recorded as its sha256 and length: the reply holds it in full.
+const span_max = 512;
+
+/// One owned cell's write as it landed in the reply.
+const Record = struct {
+    cell: u32,
+    content: bool, // its field: content (after the think end), else reasoning
+    at: u64, // the field's bytes before the write
+    token: u32, // the reply's tokens before the write
+    round: u32, // the session's ticks when the cell was owned
+    want: []u32, // the result's tokens (gpa)
+    landed: u32 = 0, // of them, committed in order (fewer: the reply's budget cut them, or another token came)
+    drafted: u32 = 0, // of those, committed in the trigger's own commit: the model's verify agreed (sync, never held)
+    sync: bool = false, // settled at its trigger (sync_graph), else held and forced after the hold
+    value: std.ArrayList(u8) = .empty, // the landed tokens' bytes
+    told: ?u32 = null, // landed when `notes` last gave it to the stream (null: never)
+};
+
+/// A record as it stands, for the stream (`notes`): its field, the field's bytes through its last landed byte, JSON.
+pub const Note = struct { index: u32, content: bool, end: u64, json: []const u8 };
+
+/// The records and the counters they need; every committed token passes through `token` (Session.feed).
+pub const Log = struct {
+    on: bool = true,
+    tokens: u32 = 0,
+    bytes: [2]u64 = .{ 0, 0 }, // per field: reasoning, content
+    content: bool = false, // the last token's field
+    rounds: u32 = 0, // Session.tick calls: one per engine round
+    writing: bool = false, // the last record's tokens are still landing
+    records: std.ArrayList(Record) = .empty,
+    out: std.ArrayList(u8) = .empty, // the receipt JSON (write)
+    live: std.ArrayList(u8) = .empty, // the JSON `notes` gave last
+    notes: std.ArrayList(Note) = .empty,
+    abstains_on: bool = false, // PREFIX_ABSTAINS (records on): abstained cells too, with their sources (runner_abstain.zig)
+    text: [2]std.ArrayList(u8) = .{ .empty, .empty }, // abstain records: per field, the reply's bytes (to find sources)
+    closes: std.ArrayList(abstain.Close) = .empty, // abstain records: where each cell's source closed
+    abstains: std.ArrayList(abstain.Abstain) = .empty,
+    dropped: u32 = 0, // abstain records out of memory
+    anchors_lost: bool = false, // a source anchor out of memory: the records stand, the census is incomplete
+    commit: ?answer.Record = null, // PREFIX_COMMIT fired: its close and answer, landing after its cell's write
+
+    /// A committed token: counted in its field, and matched against a write still landing.
+    pub fn token(l: *Log, gpa: Allocator, id: u32, bytes: []const u8, think_open: bool) Allocator.Error!void {
+        if (!l.on) return;
+        l.content = !think_open;
+        if (l.abstains_on) l.text[@intFromBool(l.content)].appendSlice(gpa, bytes) catch {
+            l.anchors_lost = true;
+        };
+        defer {
+            l.tokens += 1;
+            l.bytes[@intFromBool(l.content)] += bytes.len;
+        }
+        if (!l.writing) return if (l.commit) |*c| c.land(gpa, id, bytes, l.bytes[1], l.tokens);
+        const r = &l.records.items[l.records.items.len - 1];
+        l.writing = r.want[r.landed] == id;
+        if (!l.writing) return;
+        try r.value.appendSlice(gpa, bytes);
+        r.landed += 1;
+        if (r.sync and l.rounds == r.round) r.drafted += 1;
+        l.writing = r.landed < r.want.len;
+    }
+
+    /// Cell `cell` owned with `ids` to force after the token just fed (copied).
+    pub fn owned(l: *Log, gpa: Allocator, cell: u32, ids: []const u32) Allocator.Error!void {
+        if (!l.on) return;
+        l.writing = false;
+        const want = try gpa.dupe(u32, ids);
+        errdefer gpa.free(want);
+        try l.records.append(gpa, .{ .cell = cell, .content = l.content, .at = l.bytes[@intFromBool(l.content)], .token = l.tokens, .round = l.rounds, .want = want });
+        l.writing = ids.len > 0;
+    }
+
+    /// The record just owned settled at its trigger (sync_graph): its tokens in this commit are the model's own drafts.
+    pub fn synced(l: *Log) void {
+        if (l.records.items.len > 0) l.records.items[l.records.items.len - 1].sync = true;
+    }
+
+    /// Cell `cell`'s source closed with the token fed last (abstain records: where to find it).
+    pub fn closed(l: *Log, gpa: Allocator, cell: u32) void {
+        if (!l.on or !l.abstains_on) return;
+        l.closes.append(gpa, .{ .cell = cell, .content = l.content, .end = l.bytes[@intFromBool(l.content)] }) catch {
+            l.anchors_lost = true;
+        };
+    }
+
+    /// Cell `a.cell` abstained here: the reply's field, bytes, tokens and rounds at its decision (abstain records).
+    pub fn abstained(l: *Log, gpa: Allocator, a: abstain.Abstain) void {
+        if (!l.on or !l.abstains_on) return;
+        var x = a;
+        x.content = l.content;
+        x.at = l.bytes[@intFromBool(l.content)];
+        x.token = l.tokens;
+        x.round = l.rounds;
+        l.abstains.append(gpa, x) catch {
+            l.dropped += 1;
+        };
+    }
+
+    pub fn deinit(l: *Log, gpa: Allocator) void {
+        for (l.records.items) |*r| {
+            gpa.free(r.want);
+            r.value.deinit(gpa);
+        }
+        l.records.deinit(gpa);
+        if (l.commit) |*c| c.deinit(gpa);
+        l.out.deinit(gpa);
+        l.live.deinit(gpa);
+        l.notes.deinit(gpa);
+        for (&l.text) |*t| t.deinit(gpa);
+        l.closes.deinit(gpa);
+        l.abstains.deinit(gpa);
+    }
+};
+
+/// Session `s`'s receipt JSON (runner.Session), in its log's buffer until the session is destroyed ("": out of memory).
+pub fn write(s: anytype) []const u8 {
+    const l = &s.rec;
+    l.out.clearRetainingCapacity();
+    const cfg = if (comptime @typeInfo(@TypeOf(s.r)) == .pointer) &s.r.cfg else null;
+    put(s.cells.items, l, s.r.gpa, s.held_ms, s.resume_ms, cfg) catch return "";
+    return l.out.items;
+}
+
+/// Session `s`'s records new or grown since the last call (null: none, or records off), for a stream cut early.
+pub fn notes(s: anytype) ?[]const Note {
+    const l = &s.rec;
+    if (!l.on) return null;
+    fresh(s.cells.items, l, s.r.gpa) catch return null; // out of memory: the next call gives them again
+    return if (l.notes.items.len > 0) l.notes.items else null;
+}
+
+fn fresh(cells: anytype, l: *Log, gpa: Allocator) Allocator.Error!void {
+    l.notes.clearRetainingCapacity();
+    l.live.clearRetainingCapacity();
+    for (l.records.items, 0..) |r, i| if (r.told != r.landed) {
+        const from = l.live.items.len;
+        try record(&l.live, gpa, cells, r);
+        try l.notes.append(gpa, .{ .index = @intCast(i), .content = r.content, .end = r.at + r.value.items.len, .json = l.live.items[from..] });
+    };
+    var from: usize = 0;
+    for (l.notes.items) |*n| {
+        n.json = l.live.items[from..][0..n.json.len]; // the buffer may have moved as it grew
+        from += n.json.len;
+        l.records.items[n.index].told = l.records.items[n.index].landed;
+    }
+}
+
+pub const form_names = [_][]const u8{ "fence", "repl", "inline", "trace" };
+
+fn put(cells: anytype, l: *Log, gpa: Allocator, held_ms: u64, resume_ms: u64, cfg: anytype) Allocator.Error!void {
+    var forms = std.mem.zeroes([4][4]u32);
+    var kinds = std.mem.zeroes([3]u32);
+    for (cells) |c| {
+        const f = &forms[if (c.stated != null) 3 else @backingInt(c.form)];
+        f[0] += 1;
+        switch (c.told) {
+            .none => {},
+            .owned => {
+                f[1] += 1;
+                f[3] += c.owned_tokens;
+                if (c.translation == .program) kinds[@backingInt(c.translation.program.kind)] += 1;
+            },
+            .abstained => f[2] += 1,
+        }
+    }
+    const o = &l.out;
+    try o.append(gpa, '{');
+    for (forms, form_names) |f, name|
+        try o.print(gpa, "\"{s}\":{{\"closed\":{d},\"owned\":{d},\"abstained\":{d},\"owned_tokens\":{d}}},", .{ name, f[0], f[1], f[2], f[3] });
+    try o.print(gpa, "\"owned_by\":{{\"calc\":{d},\"elf\":{d},\"graph\":{d}}},\"held_ms\":{d},\"resume_ms\":{d}", .{ kinds[0], kinds[1], kinds[2], held_ms, resume_ms });
+    if (l.on) {
+        try o.appendSlice(gpa, ",\"cells\":[");
+        for (l.records.items, 0..) |r, i| {
+            if (i > 0) try o.append(gpa, ',');
+            try record(o, gpa, cells, r);
+        }
+        try o.append(gpa, ']');
+        if (l.abstains_on) try abstain.write(o, gpa, cells, l, cfg);
+        if (l.commit) |c| try answer.write(o, gpa, cells, c);
+    }
+    try o.append(gpa, '}');
+}
+
+/// One record's JSON object, as the receipt's `cells` and the stream's notes give it.
+fn record(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, r: Record) Allocator.Error!void {
+    const c = cells[r.cell];
+    const route = if (c.translation == .program) @tagName(c.translation.program.kind) else "none";
+    const status = if (c.result) |res| @tagName(res.status) else "none";
+    try o.print(gpa, "{{\"cell\":{d},\"form\":\"{s}\",\"route\":\"{s}\",\"status\":\"{s}\",", .{ r.cell, form_names[if (c.stated != null) 3 else @backingInt(c.form)], route, status });
+    try text(o, gpa, "lang", c.lang);
+    if (c.code.len <= span_max) try text(o, gpa, "span", c.code) else {
+        var digest: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(c.code, &digest, .{});
+        try o.print(gpa, "\"span_sha256\":\"{s}\",\"span_len\":{d},", .{ std.fmt.bytesToHex(digest, .lower), c.code.len });
+    }
+    if (c.stated) |st| try text(o, gpa, "display", st.display);
+    try text(o, gpa, "value", r.value.items);
+    try o.print(gpa, "\"field\":\"{s}\",\"at\":{d},\"token\":{d},\"ids\":{d},\"landed\":{d},\"drafted\":{d},\"forced\":{d},\"path\":\"{s}\"}}", .{ if (r.content) "content" else "reasoning", r.at, r.token, r.want.len, r.landed, r.drafted, r.landed - r.drafted, if (r.sync) "sync" else "held" });
+}
+
+/// `"name":"bytes",` as a JSON string; bytes that are not UTF-8 (a cut mid-character) go as `"name_hex"` instead.
+pub fn text(o: *std.ArrayList(u8), gpa: Allocator, name: []const u8, bytes: []const u8) Allocator.Error!void {
+    if (!std.unicode.utf8ValidateSlice(bytes)) {
+        try o.print(gpa, "\"{s}_hex\":\"", .{name});
+        for (bytes) |b| try o.print(gpa, "{x:0>2}", .{b});
+        return o.appendSlice(gpa, "\",");
+    }
+    try o.print(gpa, "\"{s}\":", .{name});
+    try quoted(o, gpa, bytes);
+    try o.append(gpa, ',');
+}
+
+/// `bytes` as one JSON value: a string, or `{"hex":"…"}` when they are not UTF-8.
+pub fn quoted(o: *std.ArrayList(u8), gpa: Allocator, bytes: []const u8) Allocator.Error!void {
+    if (!std.unicode.utf8ValidateSlice(bytes)) {
+        try o.appendSlice(gpa, "{\"hex\":\"");
+        for (bytes) |b| try o.print(gpa, "{x:0>2}", .{b});
+        return o.appendSlice(gpa, "\"}");
+    }
+    try o.append(gpa, '"');
+    for (bytes) |b| switch (b) {
+        '"' => try o.appendSlice(gpa, "\\\""),
+        '\\' => try o.appendSlice(gpa, "\\\\"),
+        0...0x1f, 0x7f => try o.print(gpa, "\\u{x:0>4}", .{b}),
+        else => try o.append(gpa, b),
+    };
+    try o.append(gpa, '"');
+}
diff --git a/zig/src/core/runner_receipt_test.zig b/zig/src/core/runner_receipt_test.zig
new file mode 100644
index 000000000..fb4cf206f
--- /dev/null
+++ b/zig/src/core/runner_receipt_test.zig
@@ -0,0 +1,208 @@
+//! The receipt's per-cell records: end to end on a lane host (held results), and the log's drafted/forced/cut rules.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const scan = @import("runner_scan.zig");
+const records = @import("runner_receipt.zig");
+const rt = @import("runner_test.zig");
+
+const gpa = std.testing.allocator;
+
+test {
+    _ = @import("runner_abstain_test.zig");
+}
+
+/// The first record of a receipt, parsed.
+const Rec = struct { cell: u32, form: []const u8, route: []const u8, status: []const u8, lang: []const u8, span: []const u8, value: []const u8, field: []const u8, at: u64, token: u32, ids: u32, landed: u32, drafted: u32, forced: u32, path: []const u8 };
+
+const Receipt = struct { cells: []const Rec };
+
+fn first(receipt: []const u8) !std.json.Parsed(Receipt) {
+    return std.json.parseFromSlice(Receipt, gpa, receipt, .{ .ignore_unknown_fields = true, .allocate = .alloc_always });
+}
+
+test "runner receipt: a held fence result records its span, route and the bytes that landed after the header" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    var m = [_]rt.Model{.{ .lead = rt.mul_cell }};
+    var sums: [1][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums }, &back);
+    defer rt.freeAll(texts);
+    defer gpa.free(sums[0]);
+    const p = try first(sums[0]);
+    defer p.deinit();
+    try std.testing.expectEqual(1, p.value.cells.len);
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("fence", r.form);
+    try std.testing.expectEqualStrings("calc", r.route);
+    try std.testing.expectEqualStrings("ok", r.status);
+    try std.testing.expectEqualStrings("python", r.lang);
+    try std.testing.expectEqualStrings("print(123456789012345678901234567890 * 987654321098765432109876543210)\n", r.span);
+    // one token a character: the write starts at the header's newline (the result's), its bytes are the reply's there
+    try std.testing.expectEqualStrings("content", r.field);
+    try std.testing.expectEqual(rt.mul_cell.len - 1, r.at);
+    try std.testing.expectEqual(rt.mul_cell.len - 1, r.token);
+    try std.testing.expectEqualStrings(texts[0][r.at..][0..r.value.len], r.value);
+    try std.testing.expect(std.mem.startsWith(u8, r.value, "\n" ++ rt.product));
+    try std.testing.expectEqual(r.ids, r.landed);
+    try std.testing.expectEqual(0, r.drafted);
+    try std.testing.expectEqual(r.landed, r.forced);
+    try std.testing.expectEqualStrings("held", r.path);
+}
+
+test "runner receipt: an inline value records the parsed expression and the value after `=`" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    const lead = "Exact: 1.5+2.25 =";
+    var m = [_]rt.Model{.{ .lead = lead }};
+    var sums: [1][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums, .inline_math = true }, &back);
+    defer rt.freeAll(texts);
+    defer gpa.free(sums[0]);
+    const p = try first(sums[0]);
+    defer p.deinit();
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("inline", r.form);
+    try std.testing.expectEqualStrings("1.5+2.25", std.mem.trim(u8, r.span, " "));
+    try std.testing.expectEqualStrings(" 3.75", r.value);
+    try std.testing.expectEqual(lead.len, r.at);
+    try std.testing.expectEqualStrings(" 3.75", texts[0][r.at..][0..r.value.len]);
+}
+
+/// The fields records.write reads off a runner.Session and its cells.
+const FakeCell = struct {
+    form: rapi.Form = .repl,
+    stated: ?scan.Stated = null,
+    told: enum { none, owned, abstained } = .owned,
+    owned_tokens: u32 = 0,
+    translation: rapi.Translation = .{ .program = .{ .kind = .graph, .bytes = "" } },
+    result: ?rapi.Result = .{ .status = .ok },
+    lang: []const u8 = "python",
+    code: []const u8 = "2**8",
+};
+
+const FakeSession = struct {
+    r: struct { gpa: std.mem.Allocator = gpa } = .{},
+    cells: struct { items: []const *FakeCell },
+    held_ms: u64 = 0,
+    resume_ms: u64 = 0,
+    rec: records.Log = .{},
+};
+
+test "runner receipt: a sync write is drafted within its trigger's commit and forced after a round; a cut lands less" {
+    var cell: FakeCell = .{};
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try s.rec.token(gpa, 1, "x", true);
+    try s.rec.owned(gpa, 0, &.{ 7, 8, 9 });
+    s.rec.synced();
+    try s.rec.token(gpa, 7, "25", true); // the trigger's commit: the model's verify had the result's token
+    s.rec.rounds += 1;
+    try s.rec.token(gpa, 8, "6", true); // forced in the next round
+    try s.rec.token(gpa, 5, "?", true); // not the result's: the write is cut there
+    try s.rec.token(gpa, 9, "!", true);
+    const p = try first(records.write(&s));
+    defer p.deinit();
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("256", r.value);
+    try std.testing.expectEqual(3, r.ids);
+    try std.testing.expectEqual(2, r.landed);
+    try std.testing.expectEqual(1, r.drafted);
+    try std.testing.expectEqual(1, r.forced);
+    try std.testing.expectEqualStrings("sync", r.path);
+    try std.testing.expectEqualStrings("reasoning", r.field);
+    try std.testing.expectEqual(1, r.at);
+    try std.testing.expectEqual(1, r.token);
+    try std.testing.expectEqualStrings("graph", r.route);
+}
+
+test "runner receipt: escapes, a long span as sha256, bytes cut mid-character as hex, and no records when off" {
+    const long: [600]u8 = @splat('x');
+    var cell: FakeCell = .{ .code = &long };
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try s.rec.token(gpa, 0, "", false); // the think end: content from here
+    try s.rec.owned(gpa, 0, &.{ 1, 2 });
+    try s.rec.token(gpa, 1, "\"a\\\n", false);
+    try s.rec.token(gpa, 2, "\xcf", false);
+    const got = records.write(&s);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"span_len\":600,") != null);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"value_hex\":\"22615c0acf\",") != null);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"field\":\"content\",\"at\":0,") != null);
+    cell.code = "say \"hi\"\n";
+    s.rec.records.items[0].value.items.len = 4;
+    const esc = records.write(&s);
+    try std.testing.expect(std.mem.indexOf(u8, esc, "\"span\":\"say \\\"hi\\\"\\u000a\",\"value\":\"\\\"a\\\\\\u000a\",") != null);
+    var off: FakeSession = .{ .cells = .{ .items = &.{&cell} }, .rec = .{ .on = false } };
+    defer off.rec.deinit(gpa);
+    try off.rec.owned(gpa, 0, &.{1});
+    try off.rec.token(gpa, 1, "1", false);
+    try std.testing.expect(std.mem.endsWith(u8, records.write(&off), "\"resume_ms\":0}"));
+}
+
+test "runner receipt: each record reaches the stream as it lands, byte for byte as the finished receipt writes it" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    var m = [_]rt.Model{ .{ .lead = rt.mul_cell }, .{ .lead = "Exact: 1.5+2.25 =" } };
+    var sums: [2][]u8 = undefined;
+    var live: [2][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums, .live = &live, .inline_math = true }, &back);
+    defer rt.freeAll(texts);
+    for (sums, live) |sum, notes| {
+        defer gpa.free(sum);
+        defer gpa.free(notes);
+        try std.testing.expect(notes.len > 0);
+        const cells = try std.mem.concat(gpa, u8, &.{ "\"cells\":[", notes, "]}" });
+        defer gpa.free(cells);
+        try std.testing.expect(std.mem.endsWith(u8, sum, cells));
+    }
+    // records off: no note, and the same tokens
+    var off_sums: [2][]u8 = undefined;
+    var off_live: [2][]u8 = undefined;
+    const off = try rt.replies(&m, .{ .summaries = &off_sums, .live = &off_live, .inline_math = true, .cells = false }, &back);
+    defer rt.freeAll(off);
+    for (off_sums, off_live, texts, off) |sum, notes, on_text, off_text| {
+        defer gpa.free(sum);
+        defer gpa.free(notes);
+        try std.testing.expectEqual(0, notes.len);
+        try std.testing.expect(std.mem.indexOf(u8, sum, "\"cells\"") == null);
+        try std.testing.expectEqualStrings(on_text, off_text);
+    }
+}
+
+test "runner receipt: notes give a record when owned and each time it grows, never twice, none when records are off" {
+    var cell: FakeCell = .{};
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.token(gpa, 1, "ab", true);
+    try s.rec.owned(gpa, 0, &.{ 7, 8 });
+    const owned = records.notes(&s).?;
+    try std.testing.expectEqual(1, owned.len);
+    try std.testing.expectEqual(2, owned[0].end); // nothing landed: it ends where it starts
+    try std.testing.expect(std.mem.indexOf(u8, owned[0].json, "\"value\":\"\",") != null);
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.token(gpa, 7, "25", true);
+    const grown = records.notes(&s).?;
+    try std.testing.expectEqual(0, grown[0].index);
+    try std.testing.expectEqual(4, grown[0].end);
+    try std.testing.expect(!grown[0].content);
+    try std.testing.expect(std.mem.indexOf(u8, grown[0].json, "\"value\":\"25\",") != null);
+    try std.testing.expect(std.mem.indexOf(u8, grown[0].json, "\"landed\":1,") != null);
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.token(gpa, 3, "!", true); // not the result's: the record stops growing
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.owned(gpa, 0, &.{9});
+    try s.rec.token(gpa, 9, "6", true);
+    const second = records.notes(&s).?;
+    try std.testing.expectEqual(1, second.len);
+    try std.testing.expectEqual(1, second[0].index);
+    const receipt = records.write(&s);
+    const tail = try std.mem.concat(gpa, u8, &.{ second[0].json, "]}" });
+    defer gpa.free(tail);
+    try std.testing.expect(std.mem.endsWith(u8, receipt, tail));
+    var off: FakeSession = .{ .cells = .{ .items = &.{&cell} }, .rec = .{ .on = false } };
+    defer off.rec.deinit(gpa);
+    try off.rec.owned(gpa, 0, &.{1});
+    try off.rec.token(gpa, 1, "1", false);
+    try std.testing.expect(records.notes(&off) == null);
+}
diff --git a/zig/src/core/runner_s3_bench.zig b/zig/src/core/runner_s3_bench.zig
new file mode 100644
index 000000000..952947f4c
--- /dev/null
+++ b/zig/src/core/runner_s3_bench.zig
@@ -0,0 +1,315 @@
+//! S3 lane calls (whole tool scripts) through the served runner, run as S3 runs them: route, steps, ms; no GPU.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const runner = @import("runner.zig");
+const ropen = @import("runner_open.zig");
+const prog = @import("runner_graph_program.zig");
+const lane = @import("compute_lane.zig");
+const rc = @import("runner_circuit.zig");
+const elf_cache = @import("runner_frontend_elf_cache.zig");
+const s3 = @import("compute_circuit.zig");
+const linux = std.os.linux;
+
+fn now() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+var environ: ?*const std.process.Environ.Map = null; // main's, which env reads the knobs from
+
+fn env(name: []const u8) ?[]const u8 {
+    const v = (environ orelse return null).get(name) orelse return null;
+    return if (v.len == 0) null else v;
+}
+
+fn pinTo(cpu: u32) void {
+    var set: [16]u64 = @splat(0);
+    set[cpu / 64] = @as(u64, 1) << @intCast(cpu % 64);
+    _ = linux.syscall3(.sched_setaffinity, 0, @sizeOf(@TypeOf(set)), @intFromPtr(&set));
+}
+
+const Cell = struct { id: []const u8, code: []const u8, want: []const u8 };
+
+/// The route a program takes on the served backend: one bank packet, a sequence of them, calc or ELF on the circuit.
+fn route(p: api.Program) []const u8 {
+    return switch (p.kind) {
+        .graph => if (std.mem.startsWith(u8, p.bytes, prog.seq_magic_v2)) "graph-seq2" else if (std.mem.startsWith(u8, p.bytes, prog.seq_magic)) "graph-seq" else "graph",
+        .calc => "calc",
+        .elf => "elf",
+    };
+}
+
+/// Pieces in a graph sequence (1 for anything else).
+fn pieces(p: api.Program) usize {
+    if (p.kind != .graph or !std.mem.startsWith(u8, p.bytes, "TFGS")) return 1;
+    return std.mem.count(u8, p.bytes[prog.seq_magic.len..], "\n");
+}
+
+/// One cell's staged run: translate, then start and spin-poll to the end (the backend's own time, no S3 naps).
+const Staged = struct { route: []const u8 = "abstain", pieces: usize = 0, bytes: usize = 0, translate: u64 = 0, run: u64 = 0, steps: u64 = 0, exec: u64 = 0, boot: u64 = 0, eval: u64 = 0, ok: bool = false };
+
+/// A circuit program's boot (the snapshot and the program loaded) and its steps, timed apart on this thread.
+fn split(c: *const rc.Circuit, p: api.Program, budget: u64, s: *Staged) !void {
+    const gpa = std.heap.c_allocator;
+    const t0 = now();
+    var m = try rc.Machine.boot(gpa, c, p);
+    defer m.deinit(gpa);
+    const t1 = now();
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(gpa);
+    const never: std.atomic.Value(bool) = .init(false);
+    _ = try m.run(budget, &out, null, &never);
+    s.boot = t1 - t0;
+    s.eval = now() - t1;
+}
+
+fn staged(a: std.mem.Allocator, r: *runner.Runner, c: Cell, stream: u64, circuit: ?*const rc.Circuit) !Staged {
+    var s: Staged = .{};
+    const t0 = now();
+    const t = try r.frontend.translate(r.frontend.ctx, a, .{ .form = .fence, .lang = "python", .code = c.code });
+    const t1 = now();
+    s.translate = t1 - t0;
+    const p = switch (t) {
+        .program => |p| p,
+        .abstain => return s,
+    };
+    s.route = route(p);
+    s.pieces = pieces(p);
+    s.bytes = p.bytes.len;
+    defer r.backend.release(stream);
+    const job = try r.backend.start(stream, p, r.cfg.max_steps);
+    const res = while (true) switch (r.backend.poll(job)) {
+        .running => std.atomic.spinLoopHint(),
+        .done => |x| break x,
+    };
+    s.run = now() - t1;
+    s.steps = res.steps;
+    s.exec = res.exec_ns;
+    s.ok = res.status == .ok and std.mem.eql(u8, res.out, c.want);
+    if (circuit) |k| if (p.kind != .graph) try split(k, p, r.cfg.max_steps, &s);
+    return s;
+}
+
+/// One S3 call as compute_circuit.Exec.run makes it (Doug-lane S3): translate, start, poll with 1 ms naps; its body.
+fn call(a: std.mem.Allocator, r: *runner.Runner, code: []const u8, stream: u64) !?[]u8 {
+    const t = try r.frontend.translate(r.frontend.ctx, a, .{ .form = .fence, .lang = "python", .code = code });
+    const p = switch (t) {
+        .program => |p| p,
+        .abstain => return null,
+    };
+    defer r.backend.release(stream);
+    const job = while (true) {
+        if (r.backend.start(stream, p, r.cfg.max_steps)) |j| break j else |e| switch (e) {
+            error.OutOfMemory => return e,
+            error.Busy => nap(),
+        }
+    };
+    while (true) {
+        switch (r.backend.poll(job)) {
+            .running => {},
+            .done => |x| return if (x.status == .ok) try lane.runner.body(a, .{ .status = .ok, .stdout = x.out }, 0, 0) else null,
+        }
+        nap();
+    }
+}
+
+fn nap() void {
+    const ts: std.c.timespec = .{ .sec = 0, .nsec = std.time.ns_per_ms };
+    _ = std.c.nanosleep(&ts, null);
+}
+
+const Row = struct { st: Staged, e2e: [2]u64, served_ok: bool };
+
+fn median(xs: []u64) u64 {
+    std.mem.sort(u64, xs, {}, std.sort.asc(u64));
+    return xs[xs.len / 2];
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e6;
+}
+
+/// The code tool S3 falls back to (TF_S3_BENCH_SANDBOX=1): each call in the lane's sandbox, first and p50 as S3's.
+fn sandboxed(gpa: std.mem.Allocator, cells: []const Cell, reps: u32) !u8 {
+    const cfg = (try lane.Config.parse(&env, "TF_COMPUTE_LANE")) orelse {
+        std.debug.print("TF_COMPUTE_LANE is off\n", .{});
+        return 2;
+    };
+    var pool = lane.Pool.init(cfg, &.{ "/proc/self/exe", "__compute_sandbox" });
+    const e2es = try gpa.alloc(u64, reps);
+    var first: std.ArrayList(u64) = .empty;
+    var all: std.ArrayList(u64) = .empty;
+    var same: u32 = 0;
+    std.debug.print("| cell | route | exec ms | sandbox first ms | sandbox p50 ms | body |\n|---|---|---|---|---|---|\n", .{});
+    for (cells) |c| {
+        var ok = true;
+        var exec: u64 = 0;
+        for (0..reps) |i| {
+            var arena = std.heap.ArenaAllocator.init(gpa);
+            defer arena.deinit();
+            const t0 = now();
+            const o = try pool.run(arena.allocator(), c.code, null);
+            e2es[i] = now() - t0;
+            exec = o.exec_ns;
+            if (o.status != .ok or !std.mem.eql(u8, o.stdout, c.want)) ok = false;
+        }
+        try first.append(gpa, e2es[0]);
+        try all.append(gpa, median(e2es));
+        same += @intFromBool(ok);
+        std.debug.print("| {s} | sandbox | {d:.2} | {d:.2} | {d:.2} | {s} |\n", .{ c.id, ms(exec), ms(e2es[0]), ms(median(e2es)), if (ok) "= CPython" else "DIFFERS" });
+    }
+    std.mem.sort(u64, all.items, {}, std.sort.asc(u64));
+    std.mem.sort(u64, first.items, {}, std.sort.asc(u64));
+    const v = all.items;
+    std.debug.print("\nS3 call p50 over cells: median {d:.2} ms, p90 {d:.2} ms, max {d:.2} ms; {d}/{d} bodies = CPython\n", .{ ms(v[v.len / 2]), ms(v[(v.len * 9) / 10]), ms(v[v.len - 1]), same, v.len });
+    std.debug.print("S3 first call over cells: median {d:.2} ms, max {d:.2} ms; sandbox\n", .{ ms(first.items[first.items.len / 2]), ms(first.items[first.items.len - 1]) });
+    return if (same == v.len) 0 else 1;
+}
+
+/// n request threads at once (TF_S3_BENCH_THREADS=n), as the server's at c=n: S3's own executor or the lane's pool.
+const Load = struct { cells: []const Cell, reps: u32, threads: usize, exec: ?*s3.Exec, pool: ?*lane.Pool, io: std.Io, ns: []u64, ok: []bool };
+
+fn worker(l: *Load, t: usize) void {
+    const n = l.cells.len;
+    for (0..l.reps) |rep| for (0..n) |k| {
+        // threads start three cells apart, so calls at one time are mostly different cells
+        const i = (k + t * 3) % n;
+        const c = l.cells[i];
+        var arena = std.heap.ArenaAllocator.init(std.heap.c_allocator);
+        defer arena.deinit();
+        const want = lane.runner.body(arena.allocator(), .{ .status = .ok, .stdout = c.want }, 0, 0) catch return;
+        const t0 = now();
+        const good = if (l.exec) |e| blk: {
+            elf_cache.reset(l.io);
+            const o = e.run(arena.allocator(), c.code, null) catch break :blk false;
+            break :blk o == .owned and std.mem.eql(u8, o.owned.body, want);
+        } else blk: {
+            const o = l.pool.?.run(arena.allocator(), c.code, null) catch break :blk false;
+            break :blk o.status == .ok and std.mem.eql(u8, o.stdout, c.want);
+        };
+        l.ns[(t * l.reps + rep) * n + i] = now() - t0;
+        if (!good) l.ok[i] = false;
+    };
+}
+
+/// Per cell: first = median of the threads' first calls, p50 over all; the ELF arm empties the image cache per call.
+fn concurrent(gpa: std.mem.Allocator, io: std.Io, cells: []const Cell, reps: u32, threads: usize, r: ?*runner.Runner) !u8 {
+    var exec: s3.Exec = undefined;
+    var pool: lane.Pool = undefined;
+    var l: Load = .{ .cells = cells, .reps = reps, .threads = threads, .exec = null, .pool = null, .io = io, .ns = try gpa.alloc(u64, threads * reps * cells.len), .ok = try gpa.alloc(bool, cells.len) };
+    @memset(l.ok, true);
+    if (r) |served| {
+        var cfg = try s3.Config.parse(&env, "TF_COMPUTE_LANE_RUNNER");
+        cfg.elf = true;
+        exec = s3.Exec.init(.{ .runner = served, .cfg = cfg });
+        l.exec = &exec;
+    } else {
+        const cfg = (try lane.Config.parse(&env, "TF_COMPUTE_LANE")) orelse return 2;
+        pool = lane.Pool.init(cfg, &.{ "/proc/self/exe", "__compute_sandbox" });
+        l.pool = &pool;
+    }
+    const hits = elf_cache.hitCount(io);
+    const handles = try gpa.alloc(std.Thread, threads);
+    for (handles, 0..) |*h, t| h.* = try std.Thread.spawn(.{}, worker, .{ &l, t });
+    for (handles) |h| h.join();
+    const arm = if (r != null) "elf" else "sandbox";
+    std.debug.print("| cell | route | first ms | p50 ms | body |\n|---|---|---|---|---|\n", .{});
+    const firsts = try gpa.alloc(u64, threads);
+    const calls = try gpa.alloc(u64, threads * reps);
+    var same: u32 = 0;
+    for (cells, 0..) |c, i| {
+        for (0..threads) |t| {
+            firsts[t] = l.ns[(t * reps) * cells.len + i];
+            for (0..reps) |rep| calls[t * reps + rep] = l.ns[(t * reps + rep) * cells.len + i];
+        }
+        same += @intFromBool(l.ok[i]);
+        std.debug.print("| {s} | {s} | {d:.2} | {d:.2} | {s} |\n", .{ c.id, arm, ms(median(firsts)), ms(median(calls)), if (l.ok[i]) "= CPython" else "DIFFERS" });
+    }
+    std.debug.print("\n{s} at c={d}: {d}/{d} bodies = CPython; image cache hits {d}\n", .{ arm, threads, same, cells.len, elf_cache.hitCount(io) - hits });
+    return if (same == cells.len) 0 else 1;
+}
+
+/// runner-s3-bench <cells.jsonl> [reps] [engine-cpu]; a line is {"id", "code", "want"} (want: CPython's stdout).
+pub fn main(init: std.process.Init) !u8 {
+    environ = init.environ_map;
+    const gpa = std.heap.c_allocator;
+    const argv = try init.minimal.args.toSlice(init.arena.allocator());
+    if (argv.len >= 2 and std.mem.eql(u8, argv[1], "__compute_sandbox")) lane.sandbox.main(argv[2..]);
+    if (argv.len < 2) {
+        std.debug.print("usage: runner-s3-bench <cells.jsonl> [reps] [engine-cpu] (TF_COMPUTE_LANE_RUNNER* knobs)\n", .{});
+        return 2;
+    }
+    const reps = if (argv.len > 2) try std.fmt.parseInt(u32, argv[2], 10) else 5;
+    if (argv.len > 3) pinTo(try std.fmt.parseInt(u32, argv[3], 10));
+    const text = try std.Io.Dir.cwd().readFileAlloc(init.io, argv[1], gpa, .limited(1 << 26));
+    var cells: std.ArrayList(Cell) = .empty;
+    var lines = std.mem.splitScalar(u8, text, '\n');
+    while (lines.next()) |line| if (line.len > 0) {
+        const p = try std.json.parseFromSlice(Cell, gpa, line, .{ .ignore_unknown_fields = true });
+        try cells.append(gpa, p.value);
+    };
+    const threads = if (env("TF_S3_BENCH_THREADS")) |v| try std.fmt.parseInt(usize, v, 10) else 0;
+    if (env("TF_S3_BENCH_SANDBOX") != null) return if (threads > 0) concurrent(gpa, init.io, cells.items, reps, threads, null) else sandboxed(gpa, cells.items, reps);
+    const cfg = (try runner.Config.parse(&env, "TF_COMPUTE_LANE_RUNNER")) orelse {
+        std.debug.print("TF_COMPUTE_LANE_RUNNER is off\n", .{});
+        return 2;
+    };
+    const r = try ropen.open(gpa, cfg);
+    if (threads > 0) return concurrent(gpa, init.io, cells.items, reps, threads, r);
+    // a second copy of the circuit: ELF and calc programs' boot and steps timed apart from the backend
+    var circuit = try rc.Circuit.load(gpa, cfg.circuit);
+    defer circuit.deinit(gpa);
+    const rows = try gpa.alloc(Row, cells.items.len);
+    const e2es = try gpa.alloc(u64, reps);
+    const tr = try gpa.alloc(u64, reps);
+    const run = try gpa.alloc(u64, reps);
+    var stream: u64 = 1 << 40;
+    // TF_S3_BENCH_COLD=1 empties the compiled-image cache before every call: each ELF cell pays its compile
+    const cold = env("TF_S3_BENCH_COLD") != null;
+    std.debug.print("| cell | route | pieces | bytes | steps | translate ms | backend ms | exec ms | boot ms | steps ms | S3 first ms | S3 p50 ms | body |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|\n", .{});
+    for (cells.items, rows) |c, *row| {
+        row.* = .{ .st = .{}, .e2e = .{ 0, 0 }, .served_ok = true };
+        for (0..reps) |i| {
+            var arena = std.heap.ArenaAllocator.init(gpa);
+            defer arena.deinit();
+            // the served call first (cold on rep 0: no translation or run of this cell before it)
+            stream += 1;
+            if (cold) elf_cache.reset(init.io);
+            const t0 = now();
+            const got = try call(arena.allocator(), r, c.code, stream);
+            e2es[i] = now() - t0;
+            const want = try lane.runner.body(arena.allocator(), .{ .status = .ok, .stdout = c.want }, 0, 0);
+            if (got == null or !std.mem.eql(u8, got.?, want)) row.served_ok = false;
+            stream += 1;
+            if (cold) elf_cache.reset(init.io);
+            const st = try staged(arena.allocator(), r, c, stream, &circuit);
+            row.st = st;
+            row.st.route = st.route;
+            tr[i] = st.translate;
+            run[i] = st.run;
+            if (!st.ok) row.served_ok = false;
+        }
+        row.e2e = .{ e2es[0], median(e2es) };
+        row.st.translate = median(tr);
+        row.st.run = median(run);
+        std.debug.print("| {s} | {s} | {d} | {d} | {d} | {d:.2} | {d:.2} | {d:.2} | {d:.2} | {d:.2} | {d:.2} | {d:.2} | {s} |\n", .{ c.id, row.st.route, row.st.pieces, row.st.bytes, row.st.steps, ms(row.st.translate), ms(row.st.run), ms(row.st.exec), ms(row.st.boot), ms(row.st.eval), ms(row.e2e[0]), ms(row.e2e[1]), if (row.served_ok) "= CPython" else if (std.mem.eql(u8, row.st.route, "abstain")) "declined" else "DIFFERS" });
+    }
+    var all: std.ArrayList(u64) = .empty;
+    var first: std.ArrayList(u64) = .empty;
+    var under: u32 = 0;
+    var same: u32 = 0;
+    for (rows) |row| {
+        try all.append(gpa, row.e2e[1]);
+        try first.append(gpa, row.e2e[0]);
+        under += @intFromBool(row.e2e[1] < 40 * std.time.ns_per_ms);
+        same += @intFromBool(row.served_ok);
+    }
+    const v = all.items;
+    std.mem.sort(u64, v, {}, std.sort.asc(u64));
+    std.debug.print("\nS3 call p50 over cells: median {d:.2} ms, p90 {d:.2} ms, max {d:.2} ms; {d}/{d} under 40 ms; {d}/{d} bodies = CPython\n", .{ ms(v[v.len / 2]), ms(v[(v.len * 9) / 10]), ms(v[v.len - 1]), under, v.len, same, v.len });
+    const w = first.items;
+    std.mem.sort(u64, w, {}, std.sort.asc(u64));
+    std.debug.print("S3 first call over cells: median {d:.2} ms, max {d:.2} ms; image cache {s}, {d} hits\n", .{ ms(w[w.len / 2]), ms(w[w.len - 1]), if (cold) "emptied per call" else "kept", elf_cache.hitCount(init.io) });
+    return if (same == v.len) 0 else 1;
+}
diff --git a/zig/src/core/runner_scan.zig b/zig/src/core/runner_scan.zig
new file mode 100644
index 000000000..df3e1f958
--- /dev/null
+++ b/zig/src/core/runner_scan.zig
@@ -0,0 +1,563 @@
+//! The in-model runner's scanner: closed code cells and the model's own result headers, from committed reply bytes.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const trace = @import("runner_trace.zig");
+const header = @import("runner_scan_boundary.zig");
+const inline_scan = @import("runner_scan_inline.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Config = struct {
+    fence: bool = true, // ```lang … ``` blocks
+    repl: bool = true, // `>>> ` lines
+    lookahead: u32 = 64, // tokens after a closed fence in which a result header counts
+    reasoning_only: bool = false, // triggers only while the think block is open
+    inline_math: bool = false, // `A op B =` at a line's end: the value after `=` (exact math semantics)
+    inline_mod: bool = true, // with inline_math: `A mod M =` and `A % M =` on literals, after any earlier `=`
+    inline_arith: bool = true, // with inline_math: thousands commas (`147,000+73`), a whole `gcd(a, b)` or `0xFF`
+    inline_chain: bool = false, // opt-in, T5 decides: the last `<expr> =` after an earlier `=` statement
+    float_window: u32 = 512, // tokens after a Python-float cue in which an inline span with `.` or `/` abstains
+    trace: bool = false, // a computation the reasoning states, owned as `[exact: …]` where its hand trace starts
+    trace_window: u32 = 512, // tokens after a stated computation's line in which a hand-trace cue counts
+    trace_repeat: u8 = 0, // a restated, already owned line is owned again up to this many times
+    trace_whole: bool = false, // opt-in (TF_RUNNER_STATED): trace also takes the whole-statement shapes
+};
+
+/// Trace ownerships per reply, and trace cells (stated computations) a reply may open.
+const trace_owned_max = 16;
+const trace_cells_max = 32;
+
+/// Text after which a reply keeps its own decimals and fractions: Python floats, or a common denominator.
+const float_cues = [_][]const u8{ "float", "Decimal(", "sum(", "round(", "0.1+0.2", "0.1 + 0.2", "lcm", "LCM", "LCD", "denominator" };
+/// Text after which `a + b` may join digits rather than add them (live: `Concatenate: … 1119 + 392 = 1119392`).
+const join_cues = [_][]const u8{ "oncatenat", "join", "Join" };
+/// Lines after a join cue in which a bare `a + b` opening its line keeps the model's own value.
+const join_lines = 2;
+
+/// A closed cell; `lang` and `code` live in the scanner until the next `feed`.
+pub const Closed = struct { index: u32, form: api.Form, lang: []const u8, code: []const u8, own_context: bool = false, trace: ?Stated = null }; // own_context: the reply keeps its value
+
+/// A trace cell's line text: what `[exact: … = value]` shows, and whether the value is a (quotient, remainder) pair.
+pub const Stated = struct { display: []const u8, divmod: bool };
+
+/// Cell `index`'s result begins: `fenced` closes a fence after it; `inline_space` (inline: value only) adds a space.
+pub const Trigger = struct { index: u32, fenced: bool = false, inline_space: ?bool = null, trace: bool = false, newline_before: bool = false, terminal: bool = false }; // trace: `[exact: …]` line
+
+pub const Events = struct { closed: ?Closed = null, trigger: ?Trigger = null };
+
+const State = enum { prose, fence, after };
+
+pub const Scanner = struct {
+    cfg: Config,
+    state: State = .prose,
+    line: std.ArrayList(u8) = .empty,
+    lang: std.ArrayList(u8) = .empty,
+    code: std.ArrayList(u8) = .empty,
+    cells: u32 = 0, // cells closed so far; the next one's index
+    pending: u32 = 0, // the fence or REPL cell a result header refers to
+    since: u32 = 0, // tokens since the pending cell closed (state .after)
+    terminal_ready: bool = false,
+    armed: ?Trigger = null, // a trigger this token set; later non-blank bytes in the same token spoil it
+    tokens: u32 = 0, // tokens fed
+    float_at: ?u32 = null, // the token of the last float cue or closed code cell
+    lines: u32 = 0, // newlines fed
+    join_line: ?u32 = null, // the line of the last join cue
+    tail: [16]u8 = undefined, // the last bytes fed, for cues split across tokens
+    tail_len: usize = 0,
+    think: bool = false, // the think block was open at the last token
+    code_cells: u32 = 0, // fence and REPL cells closed so far
+    tracer: ?trace.Tracer = null, // names and owned statements (form trace; made at the first reasoning line)
+    trace_src: std.ArrayList(u8) = .empty, // the pending statement's Python source
+    trace_disp: std.ArrayList(u8) = .empty,
+    trace_armed: std.ArrayList(u8) = .empty, // the display of the trace cell armed in this token
+    trace_cell: ?u32 = null, // the stated computation waiting for its cue
+    trace_at: u32 = 0, // the token its line ended at
+    trace_cells: u32 = 0,
+    trace_owned: u32 = 0,
+    above: [3]std.ArrayList(u8) = .{ .empty, .empty, .empty }, // with STATED: the last three lines, newest first
+
+    pub fn deinit(s: *Scanner, a: Allocator) void {
+        for (&s.above) |*l| l.deinit(a);
+        s.line.deinit(a);
+        s.lang.deinit(a);
+        s.code.deinit(a);
+        s.trace_src.deinit(a);
+        s.trace_disp.deinit(a);
+        s.trace_armed.deinit(a);
+        if (s.tracer) |*t| t.deinit();
+    }
+
+    /// One committed token's bytes; `think_open`: the think block is open at this token.
+    pub fn feed(s: *Scanner, a: Allocator, bytes: []const u8, think_open: bool) Allocator.Error!Events {
+        var ev: Events = .{};
+        s.armed = null;
+        s.tokens +|= 1;
+        // the think block's end has no bytes of its own, yet the answer starts on a new line
+        if (s.think and !think_open and s.line.items.len > 0) {
+            try s.endLine(a, &ev, true);
+            try s.keepLine(a);
+            s.line.clearRetainingCapacity();
+        }
+        s.think = think_open;
+        if (s.state == .after) {
+            s.since += 1;
+            if (s.since > s.cfg.lookahead) s.state = .prose;
+        }
+        if (s.trace_cell != null and s.tokens - s.trace_at > s.cfg.trace_window) s.trace_cell = null;
+        for (bytes) |b| {
+            s.cue(b);
+            if (s.state == .after and !std.ascii.isWhitespace(b)) s.terminal_ready = false;
+            if (s.armed != null and b != '\n' and b != ' ' and b != '\t' and b != '\r') s.armed = null;
+            if (b != '\n') {
+                try s.line.append(a, b);
+                continue;
+            }
+            s.lines +|= 1;
+            try s.endLine(a, &ev, think_open);
+            try s.keepLine(a);
+            s.line.clearRetainingCapacity();
+        }
+        ev.trigger = s.armed;
+        if (ev.trigger) |t| if (t.trace) try s.traceSpent(t.index);
+        const allowed = think_open or !s.cfg.reasoning_only;
+        if (ev.trigger == null and s.state == .after and allowed and header.ready(s.line.items)) {
+            s.fire(false);
+            ev.trigger = s.armed;
+            ev.trigger.?.newline_before = true;
+        }
+        if (s.cfg.inline_math and allowed and s.state != .fence and ev.closed == null and ev.trigger == null and
+            std.mem.indexOfScalar(u8, bytes, '=') != null)
+        {
+            const floats = s.float_at != null and s.tokens - s.float_at.? <= s.cfg.float_window;
+            // a modular step first: inlineExpr alone would take `10^18` of `3^400 mod 10^18 =` for the whole
+            if (if (s.cfg.inline_mod) inline_scan.inlineMod(s.line.items) else null) |m| {
+                s.lang.clearRetainingCapacity();
+                try s.lang.appendSlice(a, "python");
+                s.code.clearRetainingCapacity();
+                try m.code(a, &s.code);
+                ev.closed = s.close(.inline_expr);
+                // Python reads 1e9 as a float: a reply reasoning in floats keeps its own value
+                ev.closed.?.own_context = floats and std.mem.indexOfScalar(u8, m.modulus, 'e') != null;
+                ev.trigger = .{ .index = ev.closed.?.index, .inline_space = m.space };
+            } else if (inline_scan.inlineExpr(s.line.items, s.cfg.inline_arith, s.cfg.inline_chain)) |x| {
+                s.lang.clearRetainingCapacity();
+                try s.lang.appendSlice(a, "python");
+                s.code.clearRetainingCapacity();
+                // thousands commas go: Python would read `147,000+73` as a tuple
+                if (x.call) {
+                    try s.code.appendSlice(a, x.expr);
+                } else for (x.expr) |c| {
+                    if (c != ',') try s.code.append(a, c);
+                }
+                ev.closed = s.close(.inline_expr);
+                // `1119 + 392 =` opening its line, just after a join cue: the model may be joining digit groups
+                const lead = std.mem.trim(u8, s.line.items[0 .. @intFromPtr(x.expr.ptr) - @intFromPtr(s.line.items.ptr)], " \t");
+                const joined = s.join_line != null and s.lines - s.join_line.? <= join_lines and lead.len == 0 and
+                    inline_scan.twoInts(x.expr);
+                ev.closed.?.own_context = joined or (floats and std.mem.indexOfAny(u8, x.expr, "./") != null);
+                ev.trigger = .{ .index = ev.closed.?.index, .inline_space = x.space };
+            } else if (if (s.cfg.trace_whole) inline_scan.stacked(s.line.items, s.above[2].items, s.above[1].items, s.above[0].items) else null) |c| {
+                // STATED: a stacked column (`264,278,…` / `+771,565,…` / `= ?`), the `=` alone on its line
+                s.lang.clearRetainingCapacity();
+                try s.lang.appendSlice(a, "python");
+                s.code.clearRetainingCapacity();
+                for (c.x) |d| if (d != ',') try s.code.append(a, d);
+                try s.code.append(a, c.op);
+                for (c.y) |d| if (d != ',') try s.code.append(a, d);
+                ev.closed = s.close(.inline_expr);
+                // a join cue just above the column: its two lines may be digit groups to join, as for `1119 + 392 =`
+                ev.closed.?.own_context = c.op == '+' and s.join_line != null and s.lines - s.join_line.? <= join_lines + 2;
+                ev.trigger = .{ .index = ev.closed.?.index, .inline_space = c.space };
+            }
+        }
+        return ev;
+    }
+
+    /// STATED keeps the last three lines for a stacked column; a line too long for one is kept as a non-number.
+    fn keepLine(s: *Scanner, a: Allocator) Allocator.Error!void {
+        if (!s.cfg.trace_whole) return;
+        const oldest = s.above[2];
+        s.above[2] = s.above[1];
+        s.above[1] = s.above[0];
+        s.above[0] = oldest;
+        s.above[0].clearRetainingCapacity();
+        const l = std.mem.trimEnd(u8, s.line.items, "\r");
+        try s.above[0].appendSlice(a, if (l.len > 200) "-" else l);
+    }
+
+    pub fn finishEos(s: *Scanner, a: Allocator, think_open: bool) Allocator.Error!Events {
+        var ev: Events = .{};
+        s.tokens +|= 1;
+        if (s.state == .fence and header.fenceClose(std.mem.trimEnd(u8, s.line.items, "\r"))) {
+            try s.endLine(a, &ev, think_open);
+            s.line.clearRetainingCapacity();
+        }
+        if (s.state == .after and s.terminal_ready and s.since < s.cfg.lookahead and
+            (think_open or !s.cfg.reasoning_only))
+        {
+            s.fire(false);
+            ev.trigger = s.armed;
+            ev.trigger.?.terminal = true;
+        }
+        return ev;
+    }
+
+    fn endLine(s: *Scanner, a: Allocator, ev: *Events, think_open: bool) Allocator.Error!void {
+        const raw = std.mem.trimEnd(u8, s.line.items, "\r");
+        const allowed = think_open or !s.cfg.reasoning_only;
+        switch (s.state) {
+            .fence => {
+                if (header.fenceClose(raw)) {
+                    const prev = s.pending;
+                    const had = s.code_cells > 0;
+                    ev.closed = s.close(.fence);
+                    // `gcc x.c -o x && ./x` runs the cell before it: a header after it names that cell
+                    if (had and runsPrevious(ev.closed.?.lang, ev.closed.?.code)) s.pending = prev;
+                    s.state = .after;
+                    s.since = 0;
+                    s.terminal_ready = true;
+                } else {
+                    try s.code.appendSlice(a, raw);
+                    try s.code.append(a, '\n');
+                }
+            },
+            .prose, .after => {
+                if (s.state == .after and allowed) {
+                    // a header line only: a bare output fence is no handoff (T6 census)
+                    if (header.complete(raw)) return s.fire(false);
+                }
+                if (s.cfg.fence) if (header.fenceOpen(raw)) |lang| {
+                    s.lang.clearRetainingCapacity();
+                    for (lang) |c| try s.lang.append(a, std.ascii.toLower(c));
+                    s.code.clearRetainingCapacity();
+                    s.state = .fence;
+                    return;
+                };
+                if (s.cfg.repl) if (replLine(raw)) |src| {
+                    s.lang.clearRetainingCapacity();
+                    try s.lang.appendSlice(a, "python");
+                    s.code.clearRetainingCapacity();
+                    try s.code.appendSlice(a, src);
+                    ev.closed = s.close(.repl);
+                    s.state = .after;
+                    if (allowed) s.fire(false);
+                    return;
+                };
+                if (s.cfg.trace and allowed) try s.traceLine(a, ev, raw);
+            },
+        }
+    }
+
+    /// A reasoning prose line: a pending statement's cue fires it; the line's own statement opens a trace cell.
+    fn traceLine(s: *Scanner, a: Allocator, ev: *Events, raw: []const u8) Allocator.Error!void {
+        if (s.tracer == null) {
+            s.tracer = trace.Tracer.init(a);
+            s.tracer.?.repeat = s.cfg.trace_repeat;
+            s.tracer.?.whole = s.cfg.trace_whole;
+        }
+        const t = &s.tracer.?;
+        var fired = false;
+        if (s.trace_cell != null and trace.cue(raw)) fired = try s.traceArm(a);
+        const found = try t.line(raw) orelse return;
+        if (s.trace_cell != null and std.mem.eql(u8, found.display, s.trace_disp.items)) return;
+        if (ev.closed != null or s.trace_cells >= trace_cells_max or s.trace_owned >= trace_owned_max) return;
+        s.trace_src.clearRetainingCapacity();
+        try s.trace_src.appendSlice(a, found.run);
+        s.trace_disp.clearRetainingCapacity();
+        try s.trace_disp.appendSlice(a, found.display);
+        ev.closed = .{ .index = s.cells, .form = .repl, .lang = "python", .code = s.trace_src.items, .trace = .{ .display = s.trace_disp.items, .divmod = found.divmod } };
+        s.trace_cell = s.cells;
+        s.trace_at = s.tokens;
+        s.cells += 1;
+        s.trace_cells += 1;
+        if (found.same_line and !fired) _ = try s.traceArm(a);
+    }
+
+    /// Arms the pending trace cell's trigger at this line's end, unless another form's trigger is armed.
+    fn traceArm(s: *Scanner, a: Allocator) Allocator.Error!bool {
+        if (s.armed != null) return false;
+        s.armed = .{ .index = s.trace_cell.?, .trace = true };
+        s.trace_armed.clearRetainingCapacity();
+        try s.trace_armed.appendSlice(a, s.trace_disp.items);
+        return true;
+    }
+
+    /// The armed trace trigger survived its token: that statement is owned once, and no longer pending.
+    fn traceSpent(s: *Scanner, index: u32) Allocator.Error!void {
+        if (s.tracer) |*t| try t.fire(s.trace_armed.items);
+        if (s.trace_cell == index) s.trace_cell = null;
+        s.trace_owned += 1;
+    }
+
+    fn cue(s: *Scanner, b: u8) void {
+        if (s.tail_len == s.tail.len) {
+            std.mem.copyForwards(u8, s.tail[0 .. s.tail.len - 1], s.tail[1..]);
+            s.tail_len -= 1;
+        }
+        s.tail[s.tail_len] = b;
+        s.tail_len += 1;
+        for (float_cues) |c| if (std.mem.endsWith(u8, s.tail[0..s.tail_len], c)) {
+            s.float_at = s.tokens;
+        };
+        for (join_cues) |c| if (std.mem.endsWith(u8, s.tail[0..s.tail_len], c)) {
+            s.join_line = s.lines;
+        };
+    }
+
+    fn close(s: *Scanner, form: api.Form) Closed {
+        const c: Closed = .{ .index = s.cells, .form = form, .lang = s.lang.items, .code = s.code.items };
+        if (form != .inline_expr) {
+            s.pending = s.cells;
+            s.float_at = s.tokens;
+            s.code_cells += 1;
+        }
+        s.cells += 1;
+        return c;
+    }
+
+    fn fire(s: *Scanner, fenced: bool) void {
+        s.armed = .{ .index = s.pending, .fenced = fenced };
+        s.state = .prose;
+        s.terminal_ready = false;
+    }
+};
+
+/// A shell fence whose every command compiles or runs a program (no defines, pipes or redirects).
+fn runsPrevious(lang: []const u8, code: []const u8) bool {
+    const shells = [_][]const u8{ "bash", "sh", "shell", "zsh", "console" };
+    for (shells) |sh| {
+        if (std.mem.eql(u8, lang, sh)) break;
+    } else return false;
+    const tools = [_][]const u8{ "gcc ", "g++ ", "cc ", "clang ", "clang++ ", "tcc ", "./", "python ", "python3 ", "node " };
+    var any = false;
+    var lines = std.mem.splitScalar(u8, code, '\n');
+    while (lines.next()) |raw| {
+        var line = std.mem.trim(u8, raw, " \t\r");
+        if (std.mem.startsWith(u8, line, "$ ")) line = line[2..];
+        if (line.len == 0 or line[0] == '#') continue;
+        if (std.mem.indexOfAny(u8, line, "|<>;`") != null or std.mem.indexOf(u8, line, "-D") != null) return false;
+        var parts = std.mem.splitSequence(u8, line, "&&");
+        while (parts.next()) |part| {
+            const cmd = std.mem.trim(u8, part, " \t");
+            for (tools) |t| {
+                if (std.mem.startsWith(u8, cmd, t)) break;
+            } else return false;
+            any = true;
+        }
+    }
+    return any;
+}
+
+/// ">>> code" (one line, not opening a block): the code, else null.
+fn replLine(line: []const u8) ?[]const u8 {
+    const t = header.indentOk(line) orelse return null;
+    if (!std.mem.startsWith(u8, t, ">>> ")) return null;
+    const src = std.mem.trim(u8, t[4..], " \t");
+    if (src.len == 0 or src[src.len - 1] == ':') return null;
+    return src;
+}
+
+fn run(a: Allocator, s: *Scanner, tokens: []const []const u8, out: *std.ArrayList(Events)) !void {
+    for (tokens) |t| try out.append(a, try s.feed(a, t, true));
+}
+
+test "runner scan: a fence closes a cell; the header after it triggers that cell, plain" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{} };
+    defer s.deinit(a);
+    var ev: std.ArrayList(Events) = .empty;
+    defer ev.deinit(a);
+    try run(a, &s, &.{ "let me check.\n```", "Python\n", "print(2*3)\n", "```\n", "Result", ":\n", "6" }, &ev);
+    try std.testing.expectEqual(@as(?Closed, null), ev.items[2].closed);
+    const c = ev.items[3].closed.?;
+    try std.testing.expectEqual(@as(u32, 0), c.index);
+    try std.testing.expectEqual(api.Form.fence, c.form);
+    try std.testing.expectEqual(Trigger{ .index = 0, .fenced = false }, ev.items[5].trigger.?);
+    for (ev.items[0..5]) |e| try std.testing.expectEqual(@as(?Trigger, null), e.trigger);
+}
+
+test "runner scan: cell code and lang are kept exactly" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{} };
+    defer s.deinit(a);
+    _ = try s.feed(a, "```py\nx = 3\nprint(x*x)\n", true);
+    const e = try s.feed(a, "```\n", true);
+    try std.testing.expectEqualStrings("py", e.closed.?.lang);
+    try std.testing.expectEqualStrings("x = 3\nprint(x*x)\n", e.closed.?.code);
+}
+
+test "runner scan: a bare result fence after a cell is no trigger; nor is a header in prose without a cell" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{} };
+    defer s.deinit(a);
+    try std.testing.expectEqual(@as(?Trigger, null), (try s.feed(a, "Result:\n", true)).trigger);
+    _ = try s.feed(a, "```python\nprint(1)\n```\n", true);
+    try std.testing.expectEqual(@as(?Trigger, null), (try s.feed(a, "```text\n", true)).trigger);
+}
+
+test "runner scan: a REPL line is a cell and its own trigger; a block opener is not" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{} };
+    defer s.deinit(a);
+    const e = try s.feed(a, ">>> 2**100\n", true);
+    try std.testing.expectEqualStrings("2**100", e.closed.?.code);
+    try std.testing.expectEqual(api.Form.repl, e.closed.?.form);
+    try std.testing.expectEqual(Trigger{ .index = 0, .fenced = false }, e.trigger.?);
+    const f = try s.feed(a, ">>> for i in range(3):\n", true);
+    try std.testing.expect(f.closed == null and f.trigger == null);
+}
+
+test "runner scan: no trigger past the lookahead, when the model already writes in the trigger's token, or a claim line" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{ .lookahead = 2 } };
+    defer s.deinit(a);
+    _ = try s.feed(a, "```python\nprint(1)\n```\n", true);
+    _ = try s.feed(a, "So", true);
+    _ = try s.feed(a, " then", true);
+    try std.testing.expectEqual(@as(?Trigger, null), (try s.feed(a, "\nOutput:\n", true)).trigger);
+    var t: Scanner = .{ .cfg = .{} };
+    defer t.deinit(a);
+    _ = try t.feed(a, "```python\nprint(1)\n```\n", true);
+    try std.testing.expectEqual(@as(?Trigger, null), (try t.feed(a, "Output:\n1", true)).trigger);
+    try std.testing.expectEqual(@as(?Trigger, null), (try t.feed(a, "Result: we need O(n)\n", true)).trigger);
+}
+
+test "runner scan: reasoning_only ignores headers outside the think block" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{ .reasoning_only = true } };
+    defer s.deinit(a);
+    _ = try s.feed(a, "```python\nprint(1)\n```\n", false);
+    try std.testing.expectEqual(@as(?Trigger, null), (try s.feed(a, "Output:\n", false)).trigger);
+}
+
+fn inlineOf(line: []const u8) ?[]const u8 {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{ .inline_math = true } };
+    defer s.deinit(a);
+    const e = s.feed(a, line, true) catch return null;
+    const t = e.trigger orelse return null;
+    if (t.inline_space == null or e.closed == null or e.closed.?.form != .inline_expr) return null;
+    return a.dupe(u8, e.closed.?.code) catch null;
+}
+
+test "runner scan: an inline expression at a line's end is a cell and its own trigger" {
+    const a = std.testing.allocator;
+    for ([_][2][]const u8{
+        .{ "So 47 * 83 =", "47 * 83" },                 .{ "15*16*17 = ", "15*16*17" },
+        .{ "47 × 83 =", "47 × 83" },
+        .{ "Compute: -3 * (4 + 5) =", "-3 * (4 + 5)" }, .{ "2**10 =", "2**10" },
+        .{ "3 * -4 =", "3 * -4" },
+        .{ "43210 − 98765 + 1 =", "43210 − 98765 + 1" },
+        .{ "So 9876 - 4321 =", "9876 - 4321" },         .{ "9876-4321=", "9876-4321" },
+        .{ "2^100 - 3^50 =", "2^100 - 3^50" },
+        .{ "≈ 2*3 =", "2*3" },
+        .{ "φ: 2^18 =", "2^18" },
+    }) |c| {
+        const got = inlineOf(c[0]) orelse return error.TestExpectedInline;
+        defer a.free(got);
+        try std.testing.expectEqualStrings(c[1], got);
+    }
+}
+
+test "runner scan: inline refuses chains, comparisons, words, lists and incomplete expressions" {
+    for ([_][]const u8{
+        "a = 3*4 =",                     "15*16 = 240*17 =", "3*4 ==",    "x <= 3*4 =",    "2x + 3 =",  "x3*4 =",   "f(2)*3 =",
+        "1673, +10 =",                   "1,23 + 5 =",       "a - 3*4 =", "3 + 4 + ... =", "3 4 + 5 =", "(3 + 4 =", "3 + =",
+        "42 =",                          "$5 + 3 =",         "50% * 2 =", "3 *",           "**3*4** =", "2(3+4) =", "3*4 = 12",
+        "Rightmost 9 positions 12-20 =", "pages 3-5 + 1 =",
+        "Since φ(2^18)=",
+        "φ(5^18) =",
+        "λ(10^18)=",
+    }) |line| {
+        if (inlineOf(line)) |got| {
+            std.testing.allocator.free(got);
+            std.debug.print("accepted: {s}\n", .{line});
+            return error.TestUnexpectedInline;
+        }
+    }
+}
+
+test "runner scan: inline stays off by default, inside a fence and in the token after the value" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{} };
+    defer s.deinit(a);
+    try std.testing.expect((try s.feed(a, "47 * 83 =", true)).trigger == null);
+    var f: Scanner = .{ .cfg = .{ .inline_math = true } };
+    defer f.deinit(a);
+    _ = try f.feed(a, "```python\n", true);
+    try std.testing.expect((try f.feed(a, "x = 47 * 83 =", true)).trigger == null);
+    var g: Scanner = .{ .cfg = .{ .inline_math = true } };
+    defer g.deinit(a);
+    try std.testing.expect((try g.feed(a, "47 * 83 = 3901", true)).trigger == null);
+}
+
+test "runner scan: a Python-float reply marks inline decimals and fractions, not integers (live run-check-014)" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{ .inline_math = true } };
+    defer s.deinit(a);
+    for ([_][]const u8{ "Actually Python:\n", ">>> sum([0.1]*10)\n", "0.9999999999999999\n", "I think yes. ", "Let's recall common: " }) |t|
+        _ = try s.feed(a, t, true);
+    const live = try s.feed(a, "0.1+0.2 =", true);
+    try std.testing.expect(live.closed.?.form == .inline_expr and live.closed.?.own_context);
+    _ = try s.feed(a, " 0.3\n", true);
+    for ([_][]const u8{ "7/12 =", "6 * 7 =" }, [_]bool{ true, false }) |t, want| {
+        const e = try s.feed(a, t, true);
+        try std.testing.expectEqual(want, e.closed.?.own_context);
+        _ = try s.feed(a, " 1\n", true);
+    }
+    var far: Scanner = .{ .cfg = .{ .inline_math = true, .float_window = 4 } };
+    defer far.deinit(a);
+    _ = try far.feed(a, "a flo", true);
+    _ = try far.feed(a, "at\n", true); // a cue split across tokens
+    try std.testing.expect((try far.feed(a, "1.5+2 =", true)).closed.?.own_context);
+    _ = try far.feed(a, " 3.5\n", true);
+    for (0..4) |_| _ = try far.feed(a, "ok\n", true);
+    try std.testing.expect(!(try far.feed(a, "1.5+2 =", true)).closed.?.own_context);
+    var plain: Scanner = .{ .cfg = .{ .inline_math = true } };
+    defer plain.deinit(a);
+    try std.testing.expect(!(try plain.feed(a, "Discount: 889.35*0.075 =", true)).closed.?.own_context);
+}
+
+test "runner scan: an answer's first fence opens a cell when the reasoning ended mid-line (live run-check-004)" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{} };
+    defer s.deinit(a);
+    _ = try s.feed(a, "Let's craft.", true);
+    _ = try s.feed(a, "", true); // the think block's end: no bytes
+    for ([_][]const u8{ "```python\n", "print(2**100)\n" }) |t| _ = try s.feed(a, t, false);
+    const closed = (try s.feed(a, "```\n", false)).closed.?;
+    try std.testing.expectEqualStrings("python", closed.lang);
+    try std.testing.expectEqualStrings("print(2**100)\n", closed.code);
+    try std.testing.expectEqual(@as(u32, 0), (try s.feed(a, "Output:\n", false)).trigger.?.index);
+}
+
+test "runner scan: a header after a compile-and-run shell fence names the program cell" {
+    const a = std.testing.allocator;
+    for ([_][]const u8{
+        "```bash\ngcc -Wall -o gcd gcd.c\n./gcd\n```\n",
+        "```sh\n$ cc fib.c -o fib && ./fib\n```\n",
+        "```bash\necho 42\n```\n",
+        "```bash\ngcc -DN=5 x.c -o x && ./x\n```\n",
+        "```bash\n./x | head\n```\n",
+    }, [_]u32{ 0, 0, 1, 1, 1 }) |shell, want| {
+        var s: Scanner = .{ .cfg = .{} };
+        defer s.deinit(a);
+        _ = try s.feed(a, "```c\nint main(void) { return 0; }\n```\n", false);
+        _ = try s.feed(a, shell, false);
+        try std.testing.expectEqual(want, (try s.feed(a, "Output:\n", false)).trigger.?.index);
+    }
+}
+
+test "runner scan: a header after an inline cell still names the fence cell before it" {
+    const a = std.testing.allocator;
+    var s: Scanner = .{ .cfg = .{ .inline_math = true } };
+    defer s.deinit(a);
+    _ = try s.feed(a, "```python\nprint(1)\n```\n", true);
+    const e = try s.feed(a, "Note 2 + 2 =", true);
+    try std.testing.expectEqual(@as(u32, 1), e.trigger.?.index);
+    _ = try s.feed(a, " 4\n", true);
+    try std.testing.expectEqual(Trigger{ .index = 0, .fenced = false }, (try s.feed(a, "Output:\n", true)).trigger.?);
+}
+
+comptime {
+    _ = @import("runner_scan_result_test.zig");
+}
diff --git a/zig/src/core/runner_scan_boundary.zig b/zig/src/core/runner_scan_boundary.zig
new file mode 100644
index 000000000..1611be55e
--- /dev/null
+++ b/zig/src/core/runner_scan_boundary.zig
@@ -0,0 +1,56 @@
+const std = @import("std");
+
+const header_words = [_][]const u8{
+    "result",      "results",      "output",           "outputs",            "it prints",
+    "this prints", "prints",       "running it gives", "running this gives", "expected output",
+    "the output",  "this outputs", "it outputs",       "the result",         "output is",
+    "running it",  "running this", "executing it",     "executing this",
+};
+
+/// A short line naming the result and ending in ':' ("Result:", "**Output:**", "Running this gives:").
+pub fn complete(line: []const u8) bool {
+    var t = std.mem.trim(u8, line, " \t*#->_");
+    if (t.len < 2 or t.len > 60 or t[t.len - 1] != ':') return false;
+    t = std.mem.trim(u8, t[0 .. t.len - 1], " \t*_");
+    var buf: [64]u8 = undefined;
+    const low = std.ascii.lowerString(&buf, t);
+    for (header_words) |w| if (std.mem.eql(u8, low, w)) return true;
+    return false;
+}
+
+pub fn ready(line: []const u8) bool {
+    if (!complete(line)) return false;
+    const t = std.mem.trim(u8, line, " \t");
+    for ([_][]const u8{ "**", "__", "*", "_" }) |wrap| {
+        if (std.mem.startsWith(u8, t, wrap)) return std.mem.endsWith(u8, t, wrap);
+    }
+    return true;
+}
+
+pub fn indentOk(line: []const u8) ?[]const u8 {
+    var i: usize = 0;
+    while (i < line.len and line[i] == ' ') i += 1;
+    return if (i <= 3) line[i..] else null;
+}
+
+/// "```lang" (lang may be empty; result-like tags excluded): the lowercase-able tag, else null.
+pub fn fenceOpen(line: []const u8) ?[]const u8 {
+    const t = indentOk(line) orelse return null;
+    if (!std.mem.startsWith(u8, t, "```")) return null;
+    const tag = std.mem.trim(u8, t[3..], " \t");
+    for (tag) |c| if (!(std.ascii.isAlphanumeric(c) or c == '+' or c == '#' or c == '-' or c == '_' or c == '.')) return null;
+    if (isResultTag(tag)) return null;
+    return tag;
+}
+
+pub fn fenceClose(line: []const u8) bool {
+    const t = indentOk(line) orelse return false;
+    return std.mem.eql(u8, std.mem.trimEnd(u8, t, " \t"), "```");
+}
+
+const result_tags = [_][]const u8{ "output", "text", "console", "stdout", "plaintext", "txt", "result" };
+
+fn isResultTag(tag: []const u8) bool {
+    for (result_tags) |r| if (std.ascii.eqlIgnoreCase(tag, r)) return true;
+    return false;
+}
diff --git a/zig/src/core/runner_scan_inline.zig b/zig/src/core/runner_scan_inline.zig
new file mode 100644
index 000000000..3f2d0426b
--- /dev/null
+++ b/zig/src/core/runner_scan_inline.zig
@@ -0,0 +1,525 @@
+//! Inline triggers: a whole arithmetic expression or a modular step ending a reply line at `=`, as a cell's code.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// Whether `word` ends in a TeX command (`\times`, `\bmod`, `\cdot`) or `times`: an operator before the expression.
+fn operatorWord(word: []const u8) bool {
+    var k = word.len;
+    while (k > 0 and std.ascii.isAlphabetic(word[k - 1])) k -= 1;
+    if (k == word.len) return false;
+    if (k > 0 and word[k - 1] == '\\') return true;
+    return std.ascii.eqlIgnoreCase(word[k..], "times");
+}
+
+/// A whole arithmetic expression ending the line at `=` or `= ` (no comparison, word, gap; chain only with `chain`).
+pub fn inlineExpr(line: []const u8, arith: bool, chain: bool) ?struct { expr: []const u8, space: bool, call: bool = false } {
+    var t = line;
+    var space = true;
+    if (std.mem.endsWith(u8, t, " ")) {
+        t = t[0 .. t.len - 1];
+        space = false;
+    }
+    if (t.len < 4 or t[t.len - 1] != '=') return null;
+    const before = t[0 .. t.len - 1];
+    // chain (opt-in): only the text after the last `=`, when that `=` ends a statement of its own (`chained` below)
+    var seg_from: usize = 0;
+    if (std.mem.lastIndexOfScalar(u8, before, '=')) |k| {
+        if (!chain or (k > 0 and before[k - 1] == '=')) return null;
+        seg_from = k + 1;
+    }
+    if (std.mem.indexOfAny(u8, before, "<>!") != null) return null;
+    if (arith and seg_from == 0) if (gcdCall(before)) |g| return .{ .expr = g, .space = space, .call = true };
+    // live R4 d_mirror hex-a and hex: `0xABCDEF0123456789 =`, the whole conversion as one Python literal
+    if (arith and seg_from == 0) if (hexLiteral(before)) |h| return .{ .expr = h, .space = space, .call = true };
+    var start = before.len;
+    var period_stop = false;
+    while (start > seg_from) {
+        const b = before[start - 1];
+        // chain: `… = 5. 3*4 =`, a full stop before a space ends the sentence, not a decimal
+        if (chain and b == '.' and start < before.len and (before[start] == ' ' or before[start] == '\t')) {
+            period_stop = true;
+            break;
+        }
+        if (std.ascii.isDigit(b) or std.mem.indexOfScalar(u8, " \t+-*/^().", b) != null) {
+            start -= 1;
+        } else if (arith and b == ',' and start >= 2 and std.ascii.isDigit(before[start - 2]) and start + 3 <= before.len and
+            allDigits(before[start .. start + 3]))
+        {
+            start -= 1; // a thousands comma; `thousands` checks the whole number below
+        } else if (start >= 2 and before[start - 2] == 0xC3 and (b == 0x97 or b == 0xB7)) {
+            start -= 2; // × ÷
+        } else if (start >= 3 and before[start - 3] == 0xE2 and before[start - 2] == 0x88 and b == 0x92) {
+            start -= 3; // −
+        } else break;
+    }
+    const lead = before[0..start];
+    const expr = std.mem.trim(u8, before[start..], " \t");
+    if (expr.len < 3 or expr.len > 120 or std.mem.indexOf(u8, expr, "..") != null) return null;
+    if (lead.len > 0) {
+        const stop = lead[lead.len - 1];
+        // φ(2^18): a parenthesis glued to a non-ASCII letter is a function call (live bn-011 got 262144 for φ)
+        if (stop >= 0x80 and before[start] == '(') return null;
+        // a word glued to the expression (x3, f(2), $5) or a list (1673, +10) is not a whole expression
+        if (stop == ',' or stop == '$' or stop == '%' or stop == '_' or std.ascii.isAlphanumeric(stop)) {
+            if (before[start] != ' ' and before[start] != '\t') return null;
+            if (stop == ',') return null;
+        }
+        // after a word, an unspaced "12-20" is a range ("positions 12-20 ="), not a subtraction
+        const word = std.mem.trimEnd(u8, lead, " \t");
+        // the modulus of `A mod M` or `A % M` is not the whole expression (live bn-011: `3^400 mod 10^18 =`)
+        if (std.mem.endsWith(u8, word, "%") or (word.len >= 3 and std.ascii.eqlIgnoreCase(word[word.len - 3 ..], "mod") and
+            (word.len == 3 or !std.ascii.isAlphanumeric(word[word.len - 4])))) return null;
+        // nor is the right operand of a TeX or worded operator (SparkDash: `\(4 \times 49 - 11 =` got 38, `\bmod` 9563)
+        if (operatorWord(word)) return null;
+        // `1, 234 + 5 =`: the expression is the next item of a number list
+        if (word.len >= 2 and word[word.len - 1] == ',' and std.ascii.isDigit(word[word.len - 2])) return null;
+        // `Add 11,529,600 +1 =` adds to a running total the model holds; a lone operand (`subtract 3^67 =`) is fine
+        if (runningOperand(std.mem.trimEnd(u8, word, ":")) and topSum(expr)) return null;
+        if (word.len > 0 and std.ascii.isAlphabetic(word[word.len - 1])) {
+            for (1..expr.len - 1) |k| {
+                if (expr[k] == '-' and std.ascii.isDigit(expr[k - 1]) and std.ascii.isDigit(expr[k + 1])) return null;
+            }
+        }
+    }
+    const first = expr[0];
+    if (!(std.ascii.isDigit(first) or first == '(' or first == '-')) return null;
+    if (first == '-' and std.mem.trimEnd(u8, lead, " \t").len > 0 and !std.mem.endsWith(u8, std.mem.trimEnd(u8, lead, " \t"), ":")) return null;
+    const last = expr[expr.len - 1];
+    if (!(std.ascii.isDigit(last) or last == ')')) return null;
+    // a comma inside an open ( [ { is a tuple, list or call argument; else every grouped number must read as thousands
+    if (std.mem.indexOfScalar(u8, expr, ',') != null and (opensBracket(lead) or !thousands(expr))) return null;
+    // integers only with commas, so the value is CPython's: `/` and a point would be floats there
+    if (std.mem.indexOfScalar(u8, expr, ',') != null and
+        (std.mem.indexOfAny(u8, expr, "./") != null or std.mem.indexOf(u8, expr, "÷") != null)) return null;
+    // a cell only the chain knob opens: integers only, and its `=` statement must stand alone
+    if ((seg_from > 0 or period_stop) and chainUnsafe(expr)) return null;
+    if (seg_from > 0 and (!clauseBreak(before[seg_from..start]) or chainContext(lead))) return null;
+    var depth: i32 = 0;
+    var ops: u32 = 0;
+    var prev: enum { none, num, op, open, close } = .none;
+    var gap = false;
+    var i: usize = 0;
+    while (i < expr.len) : (i += 1) {
+        const c = expr[i];
+        if (c == ' ' or c == '\t') {
+            gap = true;
+            continue;
+        }
+        defer gap = false;
+        if (std.ascii.isDigit(c) or c == '.' or c == ',') {
+            if ((prev == .num and gap) or prev == .close) return null;
+            prev = .num;
+        } else if (c == '(') {
+            if (prev == .num or prev == .close) return null;
+            depth += 1;
+            prev = .open;
+        } else if (c == ')') {
+            depth -= 1;
+            if (depth < 0 or prev == .op or prev == .open) return null;
+            prev = .close;
+        } else {
+            const n: usize = if (c == 0xC3) 2 else if (c == 0xE2) 3 else 1;
+            const unary = c == '-' and (prev == .none or prev == .open or prev == .op);
+            const power = c == '*' and i + 1 < expr.len and expr[i + 1] == '*';
+            if (!unary) {
+                if (prev != .num and prev != .close) return null;
+                ops += 1;
+            }
+            i += n - 1;
+            if (power) i += 1;
+            prev = .op;
+        }
+    }
+    if (depth != 0 or ops == 0) return null;
+    return .{ .expr = expr, .space = space };
+}
+
+/// A modular step closing a line: `A` as the model wrote it, its literal modulus, and the space flag as inlineExpr.
+pub const Mod = struct {
+    left: []const u8,
+    modulus: []const u8,
+    space: bool,
+
+    /// `A mod M` in plain digits for the cell (the graph binder's math syntax; `%` there would read as a percent).
+    pub fn code(m: Mod, a: Allocator, out: *std.ArrayList(u8)) Allocator.Error!void {
+        var i: usize = 0;
+        while (i < m.left.len) : (i += 1) {
+            if (std.mem.startsWith(u8, m.left[i..], "×")) {
+                try out.append(a, '*');
+                i += "×".len - 1;
+            } else if (std.mem.startsWith(u8, m.left[i..], "−")) {
+                try out.append(a, '-');
+                i += "−".len - 1;
+            } else if (m.left[i] != ',') try out.append(a, m.left[i]);
+        }
+        try out.appendSlice(a, " mod ");
+        if (std.mem.indexOfScalar(u8, m.modulus, 'e')) |e| {
+            try out.print(a, "({s}*10^{s})", .{ m.modulus[0..e], m.modulus[e + 1 ..] });
+        } else for (m.modulus) |c| if (c != ',') try out.append(a, c);
+    }
+};
+
+/// `A mod M =` or `A % M =` ending a line, after any earlier `=`: A over `* × ^ **`, M a nonzero literal; no names.
+pub fn inlineMod(line: []const u8) ?Mod {
+    var t = line;
+    var space = true;
+    if (std.mem.endsWith(u8, t, " ")) {
+        t = t[0 .. t.len - 1];
+        space = false;
+    }
+    if (t.len < 6 or t[t.len - 1] != '=') return null;
+    const before = t[0 .. t.len - 1];
+    if (std.mem.indexOfScalar(u8, "=<>!", before[before.len - 1]) != null) return null;
+    var seg = before;
+    if (std.mem.lastIndexOfScalar(u8, before, '=')) |k| {
+        if (k > 0 and std.mem.indexOfScalar(u8, "=<>!", before[k - 1]) != null) return null;
+        seg = before[k + 1 ..];
+    }
+    const s = std.mem.trimEnd(u8, seg, " \t");
+    var m_start = s.len;
+    while (m_start > 0 and (std.ascii.isDigit(s[m_start - 1]) or std.mem.indexOfScalar(u8, ",^*e", s[m_start - 1]) != null))
+        m_start -= 1;
+    const modulus = s[m_start..];
+    if (!literalModulus(modulus)) return null;
+    var rest = std.mem.trimEnd(u8, s[0..m_start], " \t");
+    if (std.mem.endsWith(u8, rest, "%")) {
+        rest = rest[0 .. rest.len - 1];
+    } else if (std.mem.endsWith(u8, rest, "mod") and rest.len > 3 and (rest[rest.len - 4] == ' ' or rest[rest.len - 4] == '\t')) {
+        rest = rest[0 .. rest.len - 3];
+    } else return null;
+    const left_text = std.mem.trimEnd(u8, rest, " \t");
+    var start = left_text.len;
+    while (start > 0) {
+        const b = left_text[start - 1];
+        if (std.ascii.isDigit(b) or std.mem.indexOfScalar(u8, " \t*^()+-,", b) != null) {
+            start -= 1;
+        } else if (start >= 2 and left_text[start - 2] == 0xC3 and b == 0x97) {
+            start -= 2; // ×
+        } else if (start >= 3 and left_text[start - 3] == 0xE2 and left_text[start - 2] == 0x88 and b == 0x92) {
+            start -= 3; // −
+        } else break;
+    }
+    const lead = left_text[0..start];
+    const left = std.mem.trim(u8, left_text[start..], " \t");
+    if (left.len == 0 or left.len > 120 or !grouped(left)) return null;
+    if (!(std.ascii.isDigit(left[0]) or left[0] == '(')) return null;
+    if (!(std.ascii.isDigit(left[left.len - 1]) or left[left.len - 1] == ')')) return null;
+    if (lead.len > 0) {
+        const stop = lead[lead.len - 1];
+        // glued to a word or a decimal (x3, 3.5), or after an operator, comparison or symbol: not a whole operand
+        if ((std.ascii.isAlphanumeric(stop) or stop == '_' or stop == '$' or stop == '.') and
+            left_text[start] != ' ' and left_text[start] != '\t') return null;
+        const word = std.mem.trimEnd(u8, lead, " \t");
+        if (word.len > 0 and (word[word.len - 1] >= 0x80 or std.mem.indexOfScalar(u8, ",/%<>!", word[word.len - 1]) != null))
+            return null;
+    }
+    var depth: u32 = 0;
+    var prev: enum { none, num, op, open, close } = .none;
+    var gap = false;
+    var i: usize = 0;
+    while (i < left.len) : (i += 1) {
+        const c = left[i];
+        if (c == ' ' or c == '\t') {
+            gap = true;
+            continue;
+        }
+        defer gap = false;
+        if (std.ascii.isDigit(c) or c == ',') {
+            if ((prev == .num and gap) or prev == .close) return null;
+            prev = .num;
+        } else if (c == '(') {
+            if (prev == .num or prev == .close) return null;
+            depth += 1;
+            prev = .open;
+        } else if (c == ')') {
+            if (depth == 0 or prev == .op or prev == .open) return null;
+            depth -= 1;
+            prev = .close;
+        } else {
+            const n: usize = if (c == 0xC3) 2 else if (c == 0xE2) 3 else 1;
+            // which side `mod` takes in `2 + 3 mod 7` is a convention; inside parentheses a sum is one operand
+            if ((c == '+' or c == '-' or c == 0xE2) and depth == 0) return null;
+            if (prev != .num and prev != .close) return null;
+            if (c == '*' and i + 1 < left.len and left[i + 1] == '*') i += 1;
+            i += n - 1;
+            prev = .op;
+        }
+    }
+    if (depth != 0 or prev == .op) return null;
+    return .{ .left = left, .modulus = modulus, .space = space };
+}
+
+/// A stacked column at a lone `=`: `first` a literal, `second` an operator (`+ - * ×`) and a literal, as `x op y`.
+pub const Stacked = struct { x: []const u8, op: u8, y: []const u8, space: bool };
+
+/// `line` only `=` (or `= `) under `first` and `second`; `before`, the line above, may not be one of the column's own.
+pub fn stacked(line: []const u8, before: []const u8, first: []const u8, second: []const u8) ?Stacked {
+    const l = std.mem.trimStart(u8, line, " \t");
+    if (!std.mem.eql(u8, l, "=") and !std.mem.eql(u8, l, "= ")) return null;
+    // a longer column or a multiplication table: which lines the `=` sums is the model's layout, not one reading
+    if (columnLiteral(before) != null or columnOperand(before) != null) return null;
+    const x = columnLiteral(first) orelse return null;
+    const o = columnOperand(second) orelse return null;
+    return .{ .x = x, .op = o.op, .y = o.y, .space = l.len == 1 };
+}
+
+/// A line that is one plain non-negative integer: digits or thousands groups, no leading zero, at most 120 bytes.
+fn columnLiteral(line: []const u8) ?[]const u8 {
+    const t = std.mem.trim(u8, line, " \t\r");
+    if (t.len == 0 or t.len > 120 or (t[0] == '0' and t.len > 1) or !std.ascii.isDigit(t[0])) return null;
+    for (t) |c| if (!std.ascii.isDigit(c) and c != ',') return null;
+    if (std.mem.indexOfScalar(u8, t, ',')) |first| if (first > 3 or !grouped(t)) return null;
+    return t;
+}
+
+/// A line that is an operator, then a column literal (`+771,565,…`, `× 48`).
+fn columnOperand(line: []const u8) ?struct { op: u8, y: []const u8 } {
+    const t = std.mem.trimStart(u8, line, " \t");
+    if (std.mem.startsWith(u8, t, "×")) return .{ .op = '*', .y = columnLiteral(t[2..]) orelse return null };
+    if (t.len < 2 or std.mem.indexOfScalar(u8, "+-*", t[0]) == null) return null;
+    return .{ .op = t[0], .y = columnLiteral(t[1..]) orelse return null };
+}
+
+/// Thousands groups only: each `,` has a digit before it and exactly three digits after it.
+fn grouped(text: []const u8) bool {
+    for (text, 0..) |c, i| if (c == ',') {
+        if (i == 0 or !std.ascii.isDigit(text[i - 1]) or i + 4 > text.len) return false;
+        for (text[i + 1 .. i + 4]) |d| if (!std.ascii.isDigit(d)) return false;
+        if (i + 4 < text.len and std.ascii.isDigit(text[i + 4])) return false;
+    };
+    return true;
+}
+
+/// A `.`, `;`, `?` or `:` ending a clause between an earlier `=` and the expression: not that statement's right side.
+fn clauseBreak(gap: []const u8) bool {
+    for (gap, 0..) |c, i| {
+        if (std.mem.indexOfScalar(u8, ".;?:", c) != null and (i + 1 == gap.len or gap[i + 1] == ' ' or gap[i + 1] == '\t'))
+            return true;
+    }
+    return false;
+}
+
+fn powAt(e: []const u8, i: usize) ?usize {
+    if (i < e.len and e[i] == '^') return 1;
+    if (i + 1 < e.len and e[i] == '*' and e[i + 1] == '*') return 2;
+    return null;
+}
+
+fn blank(e: []const u8, i: usize) usize {
+    var j = i;
+    while (j < e.len and (e[j] == ' ' or e[j] == '\t')) j += 1;
+    return j;
+}
+
+/// Not CPython's integer: a float (`.`, `/`, `÷`, `2^-53`), a zero-led literal (`014`) or a power tower (`3^20^20`).
+fn chainUnsafe(e: []const u8) bool {
+    if (std.mem.indexOfAny(u8, e, "./") != null or std.mem.indexOf(u8, e, "÷") != null) return true;
+    for (e, 0..) |c, i| {
+        const after_digit = i > 0 and (std.ascii.isDigit(e[i - 1]) or e[i - 1] == ',');
+        if (c == '0' and i + 1 < e.len and std.ascii.isDigit(e[i + 1]) and !after_digit) return true;
+    }
+    for (0..e.len) |i| {
+        const w = powAt(e, i) orelse continue;
+        var j = blank(e, i + w);
+        if (j < e.len and e[j] == '-') return true;
+        const d = j;
+        while (j < e.len and std.ascii.isDigit(e[j])) j += 1;
+        if (j > d and powAt(e, blank(e, j)) != null) return true;
+    }
+    return false;
+}
+
+fn wordChar(c: u8) bool {
+    return std.ascii.isAlphanumeric(c) or c == '_';
+}
+
+/// `mod 97 =` or `% 97 =`: an earlier residue chain, where `=` means congruent.
+fn residueChain(t: []const u8) bool {
+    for (0..t.len) |i| {
+        var j: usize = if (t[i] == '%') i + 1 else if (i + 3 <= t.len and std.ascii.eqlIgnoreCase(t[i .. i + 3], "mod") and
+            (i == 0 or !wordChar(t[i - 1]))) i + 3 else continue;
+        j = blank(t, j);
+        const d = j;
+        while (j < t.len and (std.ascii.isDigit(t[j]) or std.mem.indexOfScalar(u8, "^*e,", t[j]) != null)) j += 1;
+        if (j > d and blank(t, j) < t.len and t[blank(t, j)] == '=') return true;
+    }
+    return false;
+}
+
+/// A name beside an earlier `=` (`a6=7^64`, `= a6^2`): variable or modular bookkeeping, not plain values.
+fn nameBeside(t: []const u8) bool {
+    for (t, 0..) |c, k| {
+        if (c != '=') continue;
+        var j = k;
+        while (j > 0 and (t[j - 1] == ' ' or t[j - 1] == '\t')) j -= 1;
+        var s = j;
+        while (s > 0 and wordChar(t[s - 1])) s -= 1;
+        if (s < j and (std.ascii.isAlphabetic(t[s]) or t[s] == '_')) return true;
+        var r = blank(t, k + 1);
+        if (r < t.len and t[r] == '-') r += 1;
+        if (r < t.len and (std.ascii.isAlphabetic(t[r]) or t[r] == '_')) return true;
+    }
+    return false;
+}
+
+/// Words before the expression that make it an operand of something else (`Times 10^6 =`, `digits of 3^100 =`).
+const chain_words = [_][]const u8{
+    "of",         "by",     "times",   "plus", "minus", "add",  "adding", "subtract", "subtracting", "multiply",
+    "multiplied", "divide", "divided", "than", "to",    "from", "with",   "into",     "over",
+};
+
+/// Whether `w` (lowercase ASCII) occurs in `text`, either case.
+fn containsIgnoreCase(text: []const u8, w: []const u8) bool {
+    if (text.len < w.len) return false;
+    for (0..text.len - w.len + 1) |i| if (std.ascii.eqlIgnoreCase(text[i..][0..w.len], w)) return true;
+    return false;
+}
+
+/// Before a chained expression: congruence (`≡`, a residue chain), names, digit counts or pieces, operand words.
+fn chainContext(lead: []const u8) bool {
+    if (std.mem.indexOf(u8, lead, "≡") != null or residueChain(lead) or nameBeside(lead)) return true;
+    for ([_][]const u8{ "digit", "group", "concaten", "append", "length" }) |w| {
+        if (containsIgnoreCase(lead, w)) return true;
+    }
+    const word = std.mem.trimEnd(u8, lead, " \t:");
+    var s = word.len;
+    while (s > 0 and std.ascii.isAlphabetic(word[s - 1])) s -= 1;
+    if (s == word.len) return false;
+    for (chain_words) |w| if (std.ascii.eqlIgnoreCase(word[s..], w)) return true;
+    return false;
+}
+
+fn allDigits(text: []const u8) bool {
+    for (text) |c| if (!std.ascii.isDigit(c)) return false;
+    return text.len > 0;
+}
+
+/// Each comma number reads as thousands: 1-3 lead digits, no leading 0, a point only after the last group (not `3,5`).
+fn thousands(e: []const u8) bool {
+    var i: usize = 0;
+    while (i < e.len) {
+        if (!std.ascii.isDigit(e[i]) and e[i] != '.') {
+            i += 1;
+            continue;
+        }
+        const s = i;
+        while (i < e.len and (std.ascii.isDigit(e[i]) or e[i] == '.' or e[i] == ',')) i += 1;
+        const num = e[s..i];
+        const last = std.mem.lastIndexOfScalar(u8, num, ',') orelse continue;
+        const first = std.mem.indexOfScalar(u8, num, ',').?;
+        if (first == 0 or first > 3 or num[0] == '0' or !grouped(num)) return false;
+        if (std.mem.indexOfScalar(u8, num[0..last], '.') != null) return false;
+    }
+    return true;
+}
+
+/// An unclosed `(`, `[` or `{` in the text before an expression: its commas would be a tuple's, list's or call's.
+fn opensBracket(lead: []const u8) bool {
+    var depth: usize = 0;
+    for (lead) |c| switch (c) {
+        '(', '[', '{' => depth += 1,
+        ')', ']', '}' => depth -|= 1,
+        else => {},
+    };
+    return depth > 0;
+}
+
+/// A `+` or binary `-` outside parentheses: the expression is a sum or difference.
+fn topSum(e: []const u8) bool {
+    var depth: usize = 0;
+    var operand = false;
+    var i: usize = 0;
+    while (i < e.len) : (i += 1) {
+        const c = e[i];
+        if (c == '(') depth += 1 else if (c == ')') depth -|= 1;
+        const minus = c == '-' or std.mem.startsWith(u8, e[i..], "−");
+        if (depth == 0 and (c == '+' or minus) and operand) return true;
+        if (std.ascii.isDigit(c) or c == ')') operand = true else if (c != ' ' and c != '\t') operand = false;
+    }
+    return false;
+}
+
+/// A lead ending in an operator word (`Add`, `minus`): the expression is an operand of a value the model holds.
+fn runningOperand(word: []const u8) bool {
+    for ([_][]const u8{ "add", "adding", "plus", "minus", "subtract", "subtracting" }) |w| {
+        if (word.len >= w.len and std.ascii.eqlIgnoreCase(word[word.len - w.len ..], w) and
+            (word.len == w.len or !std.ascii.isAlphanumeric(word[word.len - w.len - 1]))) return true;
+    }
+    return false;
+}
+
+/// `1119 + 392`: two plain non-negative integers added, nothing else (after a join cue it may be a concatenation).
+pub fn twoInts(e: []const u8) bool {
+    const plus = std.mem.indexOfScalar(u8, e, '+') orelse return false;
+    for ([_][]const u8{ e[0..plus], e[plus + 1 ..] }) |side| {
+        const t = std.mem.trim(u8, side, " \t");
+        if (t.len == 0) return false;
+        for (t) |c| if (!std.ascii.isDigit(c) and c != ',') return false;
+    }
+    return true;
+}
+
+/// `gcd(a, b)` on plain non-negative literals ending the text, as its own phrase (not `2 * gcd(…)`, `math.gcd`).
+fn gcdCall(before: []const u8) ?[]const u8 {
+    const s = std.mem.trimEnd(u8, before, " \t");
+    if (!std.mem.endsWith(u8, s, ")")) return null;
+    const at = std.mem.lastIndexOf(u8, s, "gcd(") orelse return null;
+    if (at > 0) {
+        if (s[at - 1] != ' ' and s[at - 1] != '\t') return null;
+        const word = std.mem.trimEnd(u8, s[0..at], " \t");
+        if (word.len > 0) {
+            const w = word[word.len - 1];
+            // an operand of a bigger expression, of `mod` or of a running value
+            if (std.ascii.isDigit(w) or w >= 0x80 or std.mem.indexOfScalar(u8, "+-*/^%(,.", w) != null) return null;
+            if (std.mem.endsWith(u8, word, "mod") and (word.len == 3 or !std.ascii.isAlphanumeric(word[word.len - 4])))
+                return null;
+            if (runningOperand(std.mem.trimEnd(u8, word, ":"))) return null;
+        }
+    }
+    const args = s[at + 4 .. s.len - 1];
+    const comma = std.mem.indexOfScalar(u8, args, ',') orelse return null;
+    const y = args[comma + 1 ..];
+    for ([_][]const u8{ args[0..comma], if (std.mem.startsWith(u8, y, " ")) y[1..] else y }) |n| {
+        if (n.len > 60 or !allDigits(n) or (n[0] == '0' and n.len > 1)) return null;
+    }
+    return s[at..];
+}
+
+/// A bare `0x…` literal of 2 to 100 hex digits ending the text, as its own word (not `#0xFF`, `-0xFF`, `mod 0xFF`).
+fn hexLiteral(before: []const u8) ?[]const u8 {
+    const s = std.mem.trimEnd(u8, before, " \t");
+    var at = s.len;
+    while (at > 0 and std.ascii.isHex(s[at - 1])) at -= 1;
+    if (s.len - at < 2 or s.len - at > 100 or at < 2 or s[at - 2] != '0' or (s[at - 1] != 'x' and s[at - 1] != 'X'))
+        return null;
+    const from = at - 2;
+    if (from > 0 and s[from - 1] != ' ' and s[from - 1] != '\t') return null;
+    const word = std.mem.trimEnd(u8, s[0..from], " \t");
+    if (word.len > 0) {
+        const w = word[word.len - 1];
+        // an operand of a bigger expression (live 0633: `0xFFFFFFFFFFFFFFFF - 0xFEDC… =`), of mod or of a total
+        if (std.ascii.isDigit(w) or w >= 0x80 or std.mem.indexOfScalar(u8, "+-*/^%(,&|<>~", w) != null) return null;
+        if (std.mem.endsWith(u8, word, "mod") and (word.len == 3 or !std.ascii.isAlphanumeric(word[word.len - 4])))
+            return null;
+        if (runningOperand(std.mem.trimEnd(u8, word, ":"))) return null;
+    }
+    return s[from..];
+}
+
+/// A nonzero literal modulus: digits, `b^k`, `b**k`, `dek` (1e9), or thousands groups.
+fn literalModulus(m: []const u8) bool {
+    // a zero or a leading zero (0, 007, 0^3, 0e5, 0,000): Python raises or reads it otherwise
+    if (m.len == 0 or !std.ascii.isDigit(m[0]) or m[0] == '0') return false;
+    if (std.mem.indexOfScalar(u8, m, ',') != null) {
+        if (std.mem.indexOfAny(u8, m, "^*e") != null) return false;
+        const first = std.mem.indexOfScalar(u8, m, ',').?;
+        return first <= 3 and grouped(m);
+    }
+    const sep = std.mem.indexOfAny(u8, m, "^*e") orelse return true;
+    const width: usize = if (std.mem.startsWith(u8, m[sep..], "**")) 2 else if (m[sep] == '*') return false else 1;
+    const exponent = m[sep + width ..];
+    if (exponent.len == 0 or exponent.len > 3) return false;
+    for (m[0..sep]) |c| if (!std.ascii.isDigit(c)) return false;
+    for (exponent) |c| if (!std.ascii.isDigit(c)) return false;
+    return !(exponent[0] == '0' and exponent.len > 1);
+}
