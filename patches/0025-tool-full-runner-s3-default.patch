+        "range = 1\nprint(range)",                                       "import os\nprint(1)",                     "x = 1.0\nprint(x)",                                   "print(1/2)",
+        "x = 1\nif x:\n    x = 2\nprint(x)",                             "print(1)\nprint(2)",                      "x = [1]\nprint(x)",                                   "print(1//0)",
