+    fn poll(ctx: *anyopaque, _: api.runner_api.JobId) api.runner_api.Poll {
+        const c: *Circuit = @ptrCast(@alignCast(ctx));
+        return .{ .done = .{ .status = .ok, .out = c.out, .steps = 3 } };
+    }
+    fn noop(_: *anyopaque, _: u64) void {}
