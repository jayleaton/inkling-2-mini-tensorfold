+    s.finished = true;
+    s.reason = .cancelled;
+    try t.expect(!try hold.resumeAwaiting(&s, a, &.{6}));
+    try t.expectEqualSlices(u32, &.{9}, s.emitted());
+    try t.expectEqual(@as(usize, 0), s.force.items.len);
