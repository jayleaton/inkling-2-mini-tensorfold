new file mode 100644
index 000000000..bbc66ab86
--- /dev/null
+++ b/tools/runner_trace_report.py
@@ -0,0 +1,126 @@
+"""TF_DSV41_RUNNER_TRACE log -> per-phase round table: baseline, trigger, the rounds after each resume, holds."""
+import argparse
+import json
+import statistics
+import sys
+
+MARK = '{"rt":'
+
+
+def records(paths):
+    """Every trace object in the files (server log lines included: each object starts at its marker)."""
+    for path in paths:
+        with (sys.stdin if path == "-" else open(path, encoding="utf-8", errors="replace")) as f:
+            for line in f:
+                at = line.find(MARK)
+                if at < 0:
+                    continue
+                try:
+                    yield json.loads(line[at:])
+                except json.JSONDecodeError:
+                    continue
+
+
+def phase(r, around, split):
+    """A round's phase: trigger, after+k (k = rounds since the resume, the feeding round is 1), or baseline."""
+    if r["phase"] == "trigger":
+        return "trigger"
+    since = r.get("since", -1)
+    if r["phase"] == "post":
+        return f"after+{since}" if since <= split else f"after+{split + 1}..{around}"
+    # a round before a hold that is still inside an earlier resume's window is not a baseline
+    return "baseline" if since < 0 or since > around else "near-fire"
+
+
+SPEC_WHY = ("commit", "slots", "unused", "pending", "other")
+
+
+def drops(r):
+    """A round's dropped speculative DSpark passes, every reason."""
+    return sum(r.get(f"spec_{w}", 0) for w in SPEC_WHY)
+
+
+def why(g):
+    """The phase's drops by reason (c=commit, s=slots, u=unused, p=pending, o=other)."""
+    return " ".join(f"{w[0]}{n}" for w in SPEC_WHY if (n := sum(r.get(f"spec_{w}", 0) for r in g)))
+
+
+def mean(xs):
+    return statistics.fmean(xs) if xs else float("nan")
+
+
+def median(xs):
+    return statistics.median(xs) if xs else float("nan")
+
+
+def table(rounds, around, split, streams):
+    """The phases' rows: means per round, sums of rare events, wall and GPU change against the baseline."""
+    groups = {}
+    for r in rounds:
+        if streams is not None and r.get("streams") != streams:
+            continue
+        groups.setdefault(phase(r, around, split), []).append(r)
+    order = ["baseline", "near-fire", "trigger"] + [f"after+{k}" for k in range(1, split + 1)] + [f"after+{split + 1}..{around}"]
+    base = groups.get("baseline", [])
+    base_wall = mean([r["wall_us"] for r in base])
+    base_gpu = mean([r.get("gpu_us", 0) for r in base])
+    head = ["phase", "n", "wall ms", "med", "gpu ms", "host ms", "gap ms", "wall %", "gpu %", "rows", "drafted",
+            "kept", "got", "tok/s", "held next", "forced", "spec hit", "spec drop", "drop why", "held", "fed", "engram miss",
+            "captures", "builds", "evicted", "eager", "lost"]
+    out = ["| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
+    for name in order:
+        g = groups.get(name)
+        if not g:
+            continue
+        wall = [r["wall_us"] / 1e3 for r in g]
+        gpu = [r.get("gpu_us", 0) / 1e3 for r in g]
+        gap = [r["gap_us"] / 1e3 for r in g]
+        got = sum(r["got"] for r in g)
+        span = sum(wall) + sum(gap)
+        windows = sum(r.get("windows", 0) for r in g)
+        rows = sum(r.get("rows", 0) for r in g) / windows if windows else float("nan")
+        cells = [name, len(g), f"{mean(wall):.2f}", f"{median(wall):.2f}", f"{mean(gpu):.2f}",
+                 f"{mean(wall) - mean(gpu):.2f}", f"{mean(gap):.2f}",
+                 f"{100 * (mean(wall) * 1e3 / base_wall - 1):+.1f}" if base else "",
+                 f"{100 * (mean(gpu) * 1e3 / base_gpu - 1):+.1f}" if base and base_gpu > 0 else "",
+                 f"{rows:.2f}", f"{mean([r['drafted'] for r in g]):.2f}", f"{mean([r['kept'] for r in g]):.2f}",
+                 f"{got / len(g):.2f}", f"{1e3 * got / span:.1f}" if span else "",
+                 f"{mean([r['held_next'] for r in g]):.2f}", sum(r["kind"] == "forced" for r in g),
+                 f"{mean([r.get('spec_hit', 0) for r in g]):.2f}", f"{mean([drops(r) for r in g]):.2f}", why(g),
+                 sum(r.get("spec_held", 0) for r in g), sum(r.get("spec_fed", 0) for r in g),
+                 f"{mean([r.get('engram_misses', 0) for r in g]):.1f}",
+                 sum(r.get("captures", 0) for r in g), sum(r.get("builds", 0) for r in g),
+                 sum(r.get("evicted", 0) + r.get("dropped", 0) for r in g),
+                 sum(r.get("eager", 0) for r in g), sum(r.get("lost", 0) for r in g)]
+        out.append("| " + " | ".join(str(c) for c in cells) + " |")
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("logs", nargs="*", default=["-"], help="trace files or server logs (- for stdin)")
+    ap.add_argument("--split", type=int, default=4, help="rounds after a resume shown one by one")
+    ap.add_argument("--streams", type=int, help="only rounds of steps with this many live streams (1: c=1)")
+    a = ap.parse_args()
+    objs = list(records(a.logs))
+    opens = [o for o in objs if o["rt"] == "open"]
+    around = opens[-1]["rounds"] if opens else 12
+    rounds = [o for o in objs if o["rt"] == "round"]
+    resumes = [o for o in objs if o["rt"] == "resume"]
+    holds = [o for o in objs if o["rt"] == "hold"]
+    if len(opens) > 1:
+        print(f"note: {len(opens)} trace opens (boots) in the input; rounds are pooled")
+    print(f"{len(holds)} holds, {len(resumes)} resumes, {len(rounds)} rounds traced, {around} rounds each side")
+    if resumes:
+        held = [o["held_us"] / 1e3 for o in resumes]
+        forced = [o["forced"] for o in resumes]
+        print(f"held ms: mean {mean(held):.1f}, median {median(held):.1f}, max {max(held):.1f}; "
+              f"forced tokens per resume: mean {mean(forced):.1f}")
+    print("\n".join(table(rounds, around, min(a.split, around), a.streams)))
+    print("wall: step time; gpu: the target windows' GPU time; host = wall - gpu (drafter, sampling, bookkeeping); "
+          "gap: time before the step; spec hit/drop: speculative DSpark passes used / dropped per round (drop why: "
+          "sums by reason); captures/builds/evicted/eager/lost: sums over the phase")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/test_runner_circuit.py b/tools/test_runner_circuit.py
new file mode 100644
index 000000000..5058cdbcf
--- /dev/null
+++ b/tools/test_runner_circuit.py
@@ -0,0 +1,145 @@
+"""The P2 container rejects corrupted and malformed weight artifacts before evaluation."""
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+import struct
+import tempfile
+import unittest
+
+from runner_circuit import CONSTANTS, P2_LAYOUT, read_circuit
+from runner_export import check_elf, write_circuit
+
+
+def document():
+    families, base = [], 0
+    for name, size in P2_LAYOUT:
+        families.append({"name": name, "base": base, "size": size})
+        base += size
+    ids = {f["name"]: f["base"] for f in families}
+    return {"format": "tensorfold.runner.p2", "version": 1, "stats": {"dims": 22},
+            "constants": copy.deepcopy(CONSTANTS),
+            "dims": [{"name": "one", "kind": "one", "level": 0}] * 22,
+            "tokens": {"families": families, "vocab": base, "go": ids["GO"],
+                       "halt": ids["HALT"], "byte_family": 6},
+            "output": {"families": families, "family_bits": 5, "payload_bits": 16,
+                       "code_dims": list(range(1, 22))}, "features": [],
+            "nodes": [{"kind": "ffn", "out": 1, "into": False,
+                       "terms": [[1.0, [[0, 1.0]], [[0, 1.0]]]]}],
+            "program": {"rom_base": 0x40000, "rom_words": 65536, "drom_base": 0x20000,
+                        "kind": "calc", "entry": 0x40000, "input_address": 256, "input_capacity": 256,
+                        "ram_base": 0, "ram_bytes": 32768, "rom_le_hex": "00" * 262144,
+                        "ram_hex": "00" * 32768, "drom_hex": ""}}
+
+
+class CircuitContainer(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name) / "circuit.tfpc"
+        self.doc = document()
+        write_circuit(self.doc, self.path)
+        self.data = self.path.read_bytes()
+
+    def rewrite_payload(self, doc):
+        payload = json.dumps(doc, separators=(",", ":")).encode()
+        header = struct.pack("<8sIIQII32s", b"TFIMR001", 1, 64, len(payload), 0, 0,
+                             hashlib.sha256(payload).digest())
+        self.path.write_bytes(header + payload)
+
+    def test_deterministic_file_and_sidecar(self):
+        result = write_circuit(self.doc, self.path)
+        self.assertEqual(self.path.read_bytes(), self.data)
+        self.assertEqual(read_circuit(self.path), self.doc)
+        self.assertEqual(hashlib.sha256(self.data).hexdigest(), result["sha256"])
+        self.assertEqual(self.path.with_suffix(".tfpc.sha256").read_text(),
+                         f"{result['sha256']}  circuit.tfpc\n")
+
+    def test_byte_corruption_is_not_a_valid_weight_change(self):
+        changed = bytearray(self.data)
+        changed[-2] ^= 1
+        self.path.write_bytes(changed)
+        with self.assertRaisesRegex(ValueError, "checksum"):
+            read_circuit(self.path)
+
+    def test_truncation_and_trailing_bytes(self):
+        for data in (self.data[:63], self.data[:-1], self.data + b"\0"):
+            with self.subTest(length=len(data)):
+                self.path.write_bytes(data)
+                with self.assertRaises(ValueError):
+                    read_circuit(self.path)
+
+    def test_version_flags_and_endian(self):
+        for offset, replacement in ((8, struct.pack("<I", 2)), (24, struct.pack("<I", 1)),
+                                    (28, struct.pack("<I", 1)), (8, struct.pack(">I", 1))):
+            with self.subTest(offset=offset, replacement=replacement):
+                data = bytearray(self.data)
+                data[offset:offset + 4] = replacement
+                self.path.write_bytes(data)
+                with self.assertRaisesRegex(ValueError, "header"):
+                    read_circuit(self.path)
+
+    def test_valid_checksum_cannot_hide_invalid_dimensions(self):
+        for dim in (-1, 22, True):
+            with self.subTest(dim=dim):
+                doc = copy.deepcopy(self.doc)
+                doc["nodes"][0]["terms"][0][1] = [[dim, 1.0]]
+                self.rewrite_payload(doc)
+                with self.assertRaisesRegex(ValueError, "index"):
+                    read_circuit(self.path)
+
+    def test_valid_checksum_cannot_hide_nonfinite_weights(self):
+        doc = copy.deepcopy(self.doc)
+        doc["nodes"][0]["terms"][0][0] = float("inf")
+        self.rewrite_payload(doc)
+        with self.assertRaisesRegex(ValueError, "number"):
+            read_circuit(self.path)
+
+    def test_duplicate_expression_dimensions(self):
+        doc = copy.deepcopy(self.doc)
+        doc["nodes"][0]["terms"][0][1] = [[0, 1.0], [0, 2.0]]
+        self.rewrite_payload(doc)
+        with self.assertRaisesRegex(ValueError, "duplicate expression"):
+            read_circuit(self.path)
+
+    def test_unknown_features(self):
+        doc = copy.deepcopy(self.doc)
+        doc["features"] = [{"dim": 1, "kind": "execute_instruction"}]
+        self.rewrite_payload(doc)
+        with self.assertRaisesRegex(ValueError, "unsupported input feature"):
+            read_circuit(self.path)
+
+    def test_execution_constants_and_control_ids(self):
+        for mutate in (lambda doc: doc.pop("constants"),
+                       lambda doc: doc["tokens"].update(go=0),
+                       lambda doc: doc["constants"].update(swiglu_k=64.0)):
+            doc = copy.deepcopy(self.doc)
+            mutate(doc)
+            self.rewrite_payload(doc)
+            with self.assertRaisesRegex(ValueError, "constants|identities"):
+                read_circuit(self.path)
+
+    def test_compressed_or_float_abi_elf_is_refused(self):
+        for flags in (1, 2, 4, 6, 8):
+            with self.subTest(flags=flags):
+                data = bytearray(52)
+                data[:7] = b"\x7fELF\x01\x01\x01"
+                struct.pack_into("<HH", data, 16, 2, 243)
+                struct.pack_into("<I", data, 36, flags)
+                path = Path(self.directory.name) / "unsupported.elf"
+                path.write_bytes(data)
+                with self.assertRaisesRegex(ValueError, "ILP32 and uncompressed"):
+                    check_elf(path, object())
+
+    def test_empty_value_head_array_is_refused(self):
+        doc = copy.deepcopy(self.doc)
+        doc["nodes"] = [{"kind": "head", "n_cols": 128, "levels": "bit", "tiny": 0.0,
+                         "q": [], "k": [], "value_heads": []}]
+        self.rewrite_payload(doc)
+        with self.assertRaisesRegex(ValueError, "at least one value head"):
+            read_circuit(self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
