+        "    a = b = 0\n" ++
+        "    for i, value in enumerate(xs):\n" ++
+        "        a, b = b, value\n" ++
+        "    return a\n" ++
+        "digits = [3, 1, 2]\n" ++
+        "print(''.join(map(str, sorted(\n" ++
+        "    digits, reverse=True))))\n" ++
+        "print(sorted([[2], [1]], key=sum))\n" ++
