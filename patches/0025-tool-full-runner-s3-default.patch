+    const b = Fixture.reference("b", "int");
+    const body = try f.block(&.{
+        try f.declare("tmp", "int", try f.binary("%", "int", a, b)),
+        try f.binary("=", "int", a, b),
+        try f.binary("=", "int", b, Fixture.reference("tmp", "int")),
+    });
