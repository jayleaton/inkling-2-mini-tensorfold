diff --git a/zig/runner_proof_shard_runner.zig b/zig/runner_proof_shard_runner.zig
new file mode 100644
index 000000000..e2a06cb2f
--- /dev/null
+++ b/zig/runner_proof_shard_runner.zig
@@ -0,0 +1,192 @@
+//! Singleton metadata over Zig 0.17's test server protocol; original indices are emitted on stderr.
+
+// Allocator, IO, result flags and logging adapted from Zig's MIT-licensed compiler/test_runner.zig.
+
+// Copyright (c) Zig contributors; see LICENSES/Zig-MIT.txt.
+const std = @import("std");
+const builtin = @import("builtin");
+const testing = std.testing;
+const Io = std.Io;
+const Results = std.zig.Server.Message.TestResults;
+const limit = 256;
+const runner_io: Io = Io.Threaded.global_single_threaded.io();
+
+pub const std_options: std.Options = .{ .logFn = log };
+var log_err_count: usize = 0;
+var args_buffer: [8192]u8 = undefined;
+
+comptime {
+    if (!std.mem.eql(u8, builtin.zig_version_string, "0.17.0")) @compileError("proof runner requires Zig 0.17.0");
+    if (builtin.fuzz) @compileError("proof sharding does not support fuzz mode");
+}
+
+pub fn main(init: std.process.Init.Minimal) void {
+    @disableInstrumentation();
+    run(init) catch |err| std.debug.panic("proof shard runner: {t}", .{err});
+}
+
+fn run(init: std.process.Init.Minimal) !void {
+    if (builtin.test_functions.len == 0) return error.EmptyProofPopulation;
+    if (builtin.test_functions.len > limit) return error.ProofPopulationExceedsShardLimit;
+    var fba: std.heap.FixedBufferAllocator = .init(&args_buffer);
+    const args = try init.args.toSlice(fba.allocator());
+    var selected: ?usize = null;
+    var listen = false;
+    var catalog = false;
+    for (args[1..]) |arg| {
+        if (std.mem.startsWith(u8, arg, "--proof-shard-index=")) {
+            if (selected != null) return error.DuplicateProofShard;
+            selected = try std.fmt.parseUnsigned(usize, arg["--proof-shard-index=".len..], 10);
+            if (selected.? >= limit) return error.InvalidProofShard;
+        } else if (std.mem.eql(u8, arg, "--proof-catalog")) {
+            if (catalog) return error.DuplicateProofCatalog;
+            catalog = true;
+        } else if (std.mem.eql(u8, arg, "--listen=-")) {
+            if (listen) return error.DuplicateProofListen;
+            listen = true;
+        } else if (std.mem.startsWith(u8, arg, "--seed=")) {
+            testing.random_seed = try std.fmt.parseUnsigned(u32, arg["--seed=".len..], 0);
+        } else if (std.mem.startsWith(u8, arg, "--cache-dir=")) {
+            continue;
+        } else return error.UnknownProofArgument;
+    }
+    if (catalog) {
+        if (listen or selected != null) return error.InvalidProofCatalogArguments;
+        try emit(.{ .event = "catalog_begin", .total = builtin.test_functions.len, .limit = limit });
+        for (builtin.test_functions, 0..) |test_fn, index| {
+            try emit(.{ .event = "catalog", .index = index, .name = test_fn.name });
+        }
+        try emit(.{ .event = "catalog_end", .total = builtin.test_functions.len });
+        return;
+    }
+    if (!listen or selected == null) return error.MissingProofShardArguments;
+    try mainServer(init, selected.?);
+}
+
+fn mainServer(init: std.process.Init.Minimal, selected: usize) !void {
+    @disableInstrumentation();
+    var in_buffer: [4096]u8 = undefined;
+    var out_buffer: [4096]u8 = undefined;
+    var reader: Io.File.Reader = .initStreaming(.stdin(), runner_io, &in_buffer);
+    var writer: Io.File.Writer = .initStreaming(.stdout(), runner_io, &out_buffer);
+    var server: std.zig.Server = .{ .in = &reader.interface, .out = &writer.interface };
+    try server.serveStringMessage(.zig_version, builtin.zig_version_string);
+    var metadata_sent = false;
+    var executed = false;
+    const active = selected < builtin.test_functions.len;
+    while (true) {
+        const header = try server.receiveMessage();
+        switch (header.tag) {
+            .exit => {
+                if (header.bytes_len != 0) return error.InvalidProofMessageLength;
+                if (metadata_sent and active and !executed) return error.MissingProofExecution;
+                // The SDK can restart after a crash only to send exit, retaining its previous metadata.
+                if (!metadata_sent) std.process.exit(0);
+                if (!active) try emit(.{ .event = "empty", .index = selected, .total = builtin.test_functions.len });
+                std.process.exit(0);
+            },
+            .query_test_metadata => {
+                if (header.bytes_len != 0) return error.InvalidProofMessageLength;
+                if (metadata_sent) return error.DuplicateProofMetadata;
+                try metadata(&server, selected);
+                metadata_sent = true;
+            },
+            .run_test => {
+                if (header.bytes_len != @sizeOf(u32)) return error.InvalidProofMessageLength;
+                const local_index = try server.receiveBody_u32();
+                if (local_index != 0 or !active) return error.InvalidProofTestIndex;
+                if (!metadata_sent) return error.MissingProofMetadata;
+                if (executed) return error.DuplicateProofExecution;
+                executed = true;
+                try execute(&server, init, selected);
+            },
+            else => return error.UnsupportedProofMessage,
+        }
+    }
+}
+
+fn metadata(server: *std.zig.Server, selected: usize) !void {
+    if (selected >= builtin.test_functions.len) {
+        return server.serveTestMetadata(.{ .names = &.{}, .expected_panic_msgs = &.{}, .string_bytes = &.{0} });
+    }
+    var sa: std.heap.SafeAllocator = .init(std.heap.page_allocator, .{});
+    defer if (sa.deinit() != 0) @panic("internal proof runner memory leak");
+    const a = sa.allocator();
+    const name = builtin.test_functions[selected].name;
+    const bytes = try a.alloc(u8, name.len + 2);
+    defer a.free(bytes);
+    bytes[0] = 0;
+    @memcpy(bytes[1 .. name.len + 1], name);
+    bytes[name.len + 1] = 0;
+    try server.serveTestMetadata(.{ .names = &.{1}, .expected_panic_msgs = &.{0}, .string_bytes = bytes });
+}
+
+fn execute(server: *std.zig.Server, init: std.process.Init.Minimal, selected: usize) !void {
+    @disableInstrumentation();
+    const test_fn = builtin.test_functions[selected];
+    try emit(.{ .event = "start", .index = selected, .name = test_fn.name, .total = builtin.test_functions.len });
+    testing.environ = init.environ;
+    testing.allocator_instance = .init(std.heap.page_allocator, .{
+        .canary = 0xc3a701ba,
+        .check_write_after_free = true,
+    });
+    testing.io_instance = .init(testing.allocator, .{ .argv0 = .init(init.args), .environ = init.environ });
+    log_err_count = 0;
+    try server.serveStringMessage(.test_started, &.{});
+    const status: Results.Status = if (test_fn.func()) |v| s: {
+        v;
+        break :s .pass;
+    } else |err| switch (err) {
+        error.SkipZigTest => .skip,
+        else => s: {
+            if (@errorReturnTrace()) |trace| std.debug.dumpErrorReturnTrace(trace);
+            break :s .fail;
+        },
+    };
+    testing.io_instance.deinit();
+    const leak_count = testing.allocator_instance.deinit();
+    try emit(.{
+        .event = "result",
+        .index = selected,
+        .name = test_fn.name,
+        .total = builtin.test_functions.len,
+        .status = @tagName(status),
+        .log_err_count = log_err_count,
+        .leak_count = leak_count,
+    });
+    try server.serveTestResults(.{
+        .index = 0,
+        .flags = .{
+            .status = status,
+            .fuzz = false,
+            .log_err_count = std.math.lossyCast(@FieldType(Results.Flags, "log_err_count"), log_err_count),
+            .leak_count = std.math.lossyCast(@FieldType(Results.Flags, "leak_count"), leak_count),
+        },
+    });
+}
+
+fn emit(row: anytype) !void {
+    const stderr = std.debug.lockStderr(&.{}).terminal();
+    defer std.debug.unlockStderr();
+    try stderr.writer.writeAll("\nPROOF_SHARD ");
+    try std.json.Stringify.value(row, .{}, stderr.writer);
+    try stderr.writer.writeByte('\n');
+}
+
+pub fn log(comptime level: std.log.Level, comptime scope: @EnumLiteral(), comptime format: []const u8, args: anytype) void {
+    @disableInstrumentation();
+    if (@backingInt(level) <= @backingInt(std.log.Level.err)) log_err_count +|= 1;
+    if (@backingInt(level) <= @backingInt(testing.log_level)) {
+        std.debug.print("[" ++ @tagName(scope) ++ "] (" ++ @tagName(level) ++ "): " ++ format ++ "\n", args);
+    }
+}
+
+pub fn fuzz(
+    context: anytype,
+    comptime testOne: fn (@TypeOf(context), *std.testing.Smith) anyerror!void,
+    options: testing.FuzzInputOptions,
+) anyerror!void {
+    _ = testOne;
+    _ = options;
+    return error.ProofFuzzUnsupported;
+}
diff --git a/zig/src/core/compute_circuit.zig b/zig/src/core/compute_circuit.zig
new file mode 100644
index 000000000..9647d73a7
--- /dev/null
+++ b/zig/src/core/compute_circuit.zig
@@ -0,0 +1,159 @@
+//! S3: a compute lane call whose code the frontend accepts runs on the circuit (in-model runner), else in the sandbox.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const runner = @import("runner.zig");
+const lane = @import("compute_lane.zig");
+const Allocator = std.mem.Allocator;
+
+/// The executor names a report gives; a number never adds the two.
+pub const in_model = "in-model runner";
+pub const code_tool = "code tool";
+
+/// S3's knobs beside the runner's under the same prefix (PREFIX_WALL_MS, PREFIX_BUSY_MS, PREFIX_VERIFY, PREFIX_ELF).
+pub const Config = struct {
+    wall_ms: u32 = 2000, // the safety net: a run still going is cancelled and the call goes to the sandbox
+    busy_ms: u32 = 2000, // how long a call waits for a free backend slot before it goes to the sandbox
+    verify: bool = false, // shadow: the sandbox runs too, its result is inserted and the bodies compared
+    elf: bool = false, // compile ELF programs too: off, as clang alone (80-410 ms) loses to the sandbox (~15 ms)
+
+    pub fn parse(get: *const fn ([]const u8) ?[]const u8, comptime prefix: []const u8) error{BadKnob}!Config {
+        var c: Config = .{};
+        c.wall_ms = try knob(u32, get, prefix ++ "_WALL_MS", c.wall_ms, 1, 3_600_000);
+        c.busy_ms = try knob(u32, get, prefix ++ "_BUSY_MS", c.busy_ms, 0, 3_600_000);
+        c.verify = try knob(u1, get, prefix ++ "_VERIFY", 0, 0, 1) == 1;
+        c.elf = try knob(u1, get, prefix ++ "_ELF", 0, 0, 1) == 1;
+        return c;
+    }
+
+    fn knob(comptime T: type, get: *const fn ([]const u8) ?[]const u8, comptime name: []const u8, default: T, min: T, max: T) error{BadKnob}!T {
+        const text = get(name) orelse return default;
+        if (text.len == 0) return default;
+        const v = std.fmt.parseInt(T, text, 10) catch return bad(name, text);
+        return if (v < min or v > max) bad(name, text) else v;
+    }
+
+    fn bad(name: []const u8, value: []const u8) error{BadKnob} {
+        std.log.warn("{s}={s} is not a valid value", .{ name, value });
+        return error.BadKnob;
+    }
+};
+
+/// What the engine hands the server: the runner S3 opened for itself (its own backend) and S3's knobs.
+pub const Setup = struct { runner: *runner.Runner, cfg: Config };
+
+/// Why a call went to the sandbox: an abstain, an ELF with _ELF off, a non-ok run, no slot, the wall net, or gone.
+pub const Decline = enum { language, unsupported, syntax, name, too_long, too_big, context, abstain, elf, budget, fault, busy, wall, cancelled };
+pub const Kind = @FieldType(api.Program, "kind");
+/// A call the circuit ran to its halt: the lane's result body made of its stdout, and what ran it.
+pub const Owned = struct { body: []const u8, kind: Kind, steps: u64, exec_ns: u64 };
+pub const Outcome = union(enum) { owned: Owned, declined: Decline };
+
+/// One server's S3 executor; request threads share it, and every backend call happens under its lock.
+pub const Exec = struct {
+    frontend: api.Frontend,
+    backend: api.Backend,
+    max_steps: u64,
+    cfg: Config,
+    lock: std.atomic.Value(bool) = .init(false),
+    next_stream: std.atomic.Value(u64) = .init(1),
+
+    pub fn init(s: Setup) Exec {
+        return .{ .frontend = s.runner.frontend, .backend = s.runner.backend, .max_steps = s.runner.cfg.max_steps, .cfg = s.cfg };
+    }
+
+    /// The call's code as a fresh fence cell (a lane call sees no earlier call's names), run to its halt or declined.
+    pub fn run(e: *Exec, a: Allocator, code: []const u8, hook: ?lane.Cancel) Allocator.Error!Outcome {
+        const t = try e.frontend.translate(e.frontend.ctx, a, .{ .form = .fence, .lang = "python", .code = code });
+        const program = switch (t) {
+            .program => |p| p,
+            .abstain => |why| return .{ .declined = from(why) },
+        };
+        // the no-compile frontend builds none, yet a cached ELF may come back: S3 runs one only under _ELF=1
+        if (program.kind == .elf and !e.cfg.elf) return .{ .declined = .elf };
+        const stream = e.next_stream.fetchAdd(1, .monotonic);
+        defer e.release(stream);
+        const t0 = nowNs();
+        const job = while (true) {
+            if (e.start(stream, program)) |j| break j else |err| switch (err) {
+                error.OutOfMemory => return error.OutOfMemory,
+                error.Busy => if (nowNs() - t0 >= @as(u64, e.cfg.busy_ms) * std.time.ns_per_ms) return .{ .declined = .busy },
+            }
+            if (gone(hook)) return .{ .declined = .cancelled };
+            sleepMs(1);
+        };
+        const t1 = nowNs();
+        while (true) {
+            switch (e.poll(job)) {
+                .running => {},
+                .done => |r| return switch (r.status) {
+                    // `out` is the backend's until its next call for this stream: the body is copied first
+                    .ok => .{ .owned = .{ .body = try body(a, r.out), .kind = program.kind, .steps = r.steps, .exec_ns = r.exec_ns } },
+                    .abstain => .{ .declined = if (r.abstain) |why| from(why) else .abstain },
+                    .budget => .{ .declined = .budget },
+                    .fault => .{ .declined = .fault },
+                },
+            }
+            const late = nowNs() - t1 >= @as(u64, e.cfg.wall_ms) * std.time.ns_per_ms;
+            if (late or gone(hook)) {
+                e.cancel(job);
+                return .{ .declined = if (late) .wall else .cancelled };
+            }
+            sleepMs(1);
+        }
+    }
+
+    fn start(e: *Exec, stream: u64, program: api.Program) error{ OutOfMemory, Busy }!api.JobId {
+        e.acquire();
+        defer e.lock.store(false, .release);
+        return e.backend.start(stream, program, e.max_steps);
+    }
+
+    fn poll(e: *Exec, job: api.JobId) api.Poll {
+        e.acquire();
+        defer e.lock.store(false, .release);
+        return e.backend.poll(job);
+    }
+
+    fn cancel(e: *Exec, job: api.JobId) void {
+        e.acquire();
+        defer e.lock.store(false, .release);
+        e.backend.vtable.cancel(e.backend.ctx, job);
+    }
+
+    fn release(e: *Exec, stream: u64) void {
+        e.acquire();
+        defer e.lock.store(false, .release);
+        e.backend.vtable.release(e.backend.ctx, stream);
+    }
+
+    fn acquire(e: *Exec) void {
+        while (e.lock.cmpxchgWeak(false, true, .acquire, .monotonic) != null) std.atomic.spinLoopHint();
+    }
+};
+
+/// The lane's result body for a run that printed `out` and ended ok: the sandbox's rule, so the bytes match.
+pub fn body(a: Allocator, out: []const u8) Allocator.Error![]u8 {
+    return lane.runner.body(a, .{ .status = .ok, .stdout = out }, 0, 0);
+}
+
+fn from(why: api.Abstain) Decline {
+    return switch (why) {
+        inline else => |w| @field(Decline, @tagName(w)),
+    };
+}
+
+fn gone(hook: ?lane.Cancel) bool {
+    const c = hook orelse return false;
+    return c.gone(c.ctx);
+}
+
+fn sleepMs(ms: u64) void {
+    const ts: std.c.timespec = .{ .sec = 0, .nsec = @intCast(ms * std.time.ns_per_ms) };
+    _ = std.c.nanosleep(&ts, null);
+}
+
+pub fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
