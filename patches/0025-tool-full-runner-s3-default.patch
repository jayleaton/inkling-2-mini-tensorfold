diff --git a/zig/src/core/runner.zig b/zig/src/core/runner.zig
new file mode 100644
index 000000000..feee10fed
--- /dev/null
+++ b/zig/src/core/runner.zig
@@ -0,0 +1,600 @@
+//! The in-model runner: per-reply sessions run closed cells on the circuit and own the model's result positions.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("runner_api.zig");
+const scan = @import("runner_scan.zig");
+const trace = @import("runner_trace.zig");
+const records = @import("runner_receipt.zig");
+const abstain = @import("runner_abstain.zig");
+pub const place = @import("runner_place.zig");
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner);
+const output = @import("runner_output.zig");
+const answer = @import("runner_commit.zig");
+
+/// Opt-in attribution on a successfully owned inline value; plain-text tokens, not a special token.
+pub const inline_mark_suffix = output.suffix;
+
+pub const Config = struct {
+    name: []const u8 = "TF_RUNNER", // the PREFIX it was parsed from, for its log lines
+    scan: scan.Config = .{},
+    max_steps: u64 = 4_000_000, // per run (a step count: wall time never changes a result)
+    compile_steps: usize = 10522, // PREFIX_COMPILE_STEPS: frontend cost limit; opt-in maximum 32768, not an instruction cap
+    max_tokens: u32 = 512, // owned result tokens before the cut note
+    workers: u8 = 2,
+    device: enum { cpu, cuda } = .cpu,
+    circuit: []const u8 = "", // calc and ELF programs run here (with the graph backend too)
+    backend: enum { circuit, graph } = .circuit,
+    graph_bank: []const u8 = "", // PREFIX_GRAPH_BANK: T1's bank manifest, loaded at boot (backend graph)
+    exact: bool = false, // `calc` / `exact` cells (firmware exact rationals, not any language's print) run
+    place: place.Config = .{}, // PREFIX_CPUS / PREFIX_NICE: where the runner's threads run (core/runner_place.zig)
+    settle_us: u32 = 0, // PREFIX_SETTLE_US: a held tick waits this long for its cell; 0: one stage per tick (as before)
+    guide: []const u8 = "", // PREFIX_GUIDE: "1" RUNNER-GUIDE.md, else a file, as chats' default guide (server/runner_guide.zig)
+    guide_max_bytes: usize = 512, // PREFIX_GUIDE_MAX_BYTES: request guide cap, opt-in up to 2048 bytes
+    compile: bool = true, // false: the frontend never builds an ELF (no clang); calc and graph programs only (S3)
+    inline_mark: bool = false, // PREFIX_INLINE_MARK: tag owned inline values; off preserves their bytes
+    sync_graph: bool = false, // PREFIX_SYNC_GRAPH: a graph result settles at its trigger token, in that round (no hold)
+    cells: bool = true, // PREFIX_CELLS: the receipt records each owned cell's span, route and landed value (runner_receipt.zig)
+    abstains: bool = false, // PREFIX_ABSTAINS: with cells, each abstained cell's source, reason and stage (runner_abstain.zig)
+    commit: bool = false, // PREFIX_COMMIT: an owned value of the task's own expression closes the think and is the answer
+
+    /// PREFIX "1" enables (unset, "" or "0": null); PREFIX_* knobs override defaults; a bad value is error.BadKnob.
+    pub fn parse(get: *const fn ([]const u8) ?[]const u8, comptime prefix: []const u8) error{BadKnob}!?Config {
+        const on = get(prefix) orelse return null;
+        if (on.len == 0 or std.mem.eql(u8, on, "0")) return null;
+        if (!std.mem.eql(u8, on, "1")) return bad(prefix, on);
+        var c: Config = .{ .name = prefix };
+        if (get(prefix ++ "_BACKEND")) |b| if (b.len > 0) {
+            c.backend = std.meta.stringToEnum(@TypeOf(c.backend), b) orelse return bad(prefix ++ "_BACKEND", b);
+        };
+        c.graph_bank = get(prefix ++ "_GRAPH_BANK") orelse "";
+        if (c.backend == .graph and c.graph_bank.len == 0) return bad(prefix ++ "_GRAPH_BANK", "(unset)");
+        c.circuit = get(prefix ++ "_CIRCUIT") orelse "";
+        if (c.circuit.len == 0) return bad(prefix ++ "_CIRCUIT", "(unset)");
+        if (get(prefix ++ "_DEVICE")) |d| if (d.len > 0) {
+            c.device = std.meta.stringToEnum(@TypeOf(c.device), d) orelse return bad(prefix ++ "_DEVICE", d);
+        };
+        c.workers = try knob(u8, get, prefix ++ "_WORKERS", c.workers, 1, 64);
+        c.max_steps = try knob(u64, get, prefix ++ "_MAX_STEPS", c.max_steps, 1, 1 << 40);
+        c.compile_steps = try knob(usize, get, prefix ++ "_COMPILE_STEPS", c.compile_steps, 1, 32768);
+        c.max_tokens = try knob(u32, get, prefix ++ "_MAX_TOKENS", c.max_tokens, 1, 1 << 20);
+        c.exact = try knob(u1, get, prefix ++ "_EXACT", 0, 0, 1) == 1;
+        c.settle_us = try knob(u32, get, prefix ++ "_SETTLE_US", c.settle_us, 0, 100_000);
+        c.inline_mark = try knob(u1, get, prefix ++ "_INLINE_MARK", 0, 0, 1) == 1;
+        c.sync_graph = try knob(u1, get, prefix ++ "_SYNC_GRAPH", 0, 0, 1) == 1;
+        if (c.sync_graph and c.backend != .graph) return bad(prefix ++ "_SYNC_GRAPH", "1 (backend is not graph)");
+        c.cells = try knob(u1, get, prefix ++ "_CELLS", 1, 0, 1) == 1;
+        c.abstains = try knob(u1, get, prefix ++ "_ABSTAINS", 0, 0, 1) == 1;
+        c.commit = try knob(u1, get, prefix ++ "_COMMIT", 0, 0, 1) == 1;
+        c.guide = get(prefix ++ "_GUIDE") orelse "";
+        if (std.mem.eql(u8, c.guide, "0")) c.guide = "";
+        c.guide_max_bytes = try knob(usize, get, prefix ++ "_GUIDE_MAX_BYTES", c.guide_max_bytes, 512, 2048);
+        c.place = try place.Config.parse(get, prefix);
+        c.scan.lookahead = try knob(u32, get, prefix ++ "_LOOKAHEAD", c.scan.lookahead, 1, 4096);
+        c.scan.float_window = try knob(u32, get, prefix ++ "_FLOAT_WINDOW", c.scan.float_window, 0, 65536);
+        c.scan.inline_mod = try knob(u1, get, prefix ++ "_INLINE_MOD", 1, 0, 1) == 1;
+        c.scan.inline_arith = try knob(u1, get, prefix ++ "_INLINE_ARITH", 1, 0, 1) == 1;
+        c.scan.inline_chain = try knob(u1, get, prefix ++ "_INLINE_CHAIN", 0, 0, 1) == 1;
+        c.scan.trace_window = try knob(u32, get, prefix ++ "_TRACE_WINDOW", c.scan.trace_window, 1, 65536);
+        c.scan.trace_whole = try knob(u1, get, prefix ++ "_STATED", 0, 0, 1) == 1;
+        if (get(prefix ++ "_FORMS")) |f| if (f.len > 0) {
+            c.scan.fence = false;
+            c.scan.repl = false;
+            c.scan.inline_math = false;
+            c.scan.trace = false;
+            var it = std.mem.splitScalar(u8, f, ',');
+            while (it.next()) |form| {
+                if (std.mem.eql(u8, form, "fence")) c.scan.fence = true else if (std.mem.eql(u8, form, "repl")) c.scan.repl = true else if (std.mem.eql(u8, form, "inline")) c.scan.inline_math = true else if (std.mem.eql(u8, form, "trace")) c.scan.trace = true else return bad(prefix ++ "_FORMS", f);
+            }
+        };
+        // the knob widens form trace's statements: without the form it would do nothing
+        if (c.scan.trace_whole and !c.scan.trace) return bad(prefix ++ "_STATED", "1 (form trace is off)");
+        if (get(prefix ++ "_SPANS")) |sp| if (sp.len > 0) {
+            if (std.mem.eql(u8, sp, "reasoning")) c.scan.reasoning_only = true else if (!std.mem.eql(u8, sp, "all")) return bad(prefix ++ "_SPANS", sp);
+        };
+        return c;
+    }
+
+    fn knob(comptime T: type, get: *const fn ([]const u8) ?[]const u8, comptime name: []const u8, default: T, min: T, max: T) error{BadKnob}!T {
+        const text = get(name) orelse return default;
+        if (text.len == 0) return default;
+        const v = std.fmt.parseInt(T, text, 10) catch return bad(name, text);
+        if (v < min or v > max) return bad(name, text);
+        return v;
+    }
+
+    fn bad(name: []const u8, value: []const u8) error{BadKnob} {
+        log.warn("{s}={s} is not a valid value", .{ name, value });
+        return error.BadKnob;
+    }
+};
+
+/// The engine's tokenizer as the runner needs it: one token's bytes, and text to token ids.
+pub const Text = output.Text;
+
+/// A request's say over form trace (runner_trace.zig); defaults change nothing.
+pub const TraceAsk = trace.Ask;
+
+/// The server-wide runner: a frontend, a backend and the server's tokenizer (set at its start); sessions are per reply.
+pub const Runner = struct {
+    gpa: Allocator,
+    cfg: Config,
+    frontend: api.Frontend,
+    backend: api.Backend,
+    text: ?Text = null,
+    next_id: u64 = 1,
+    placer: ?*place.Placer = null, // the backend's job threads and the translations run placed
+    quick: ?api.Frontend = null, // cfg.sync_graph: translates on the engine thread, graph programs or abstain only
+
+    /// A reply's session; null until the server has given the runner its tokenizer.
+    pub fn session(r: *Runner, ask: TraceAsk) Allocator.Error!?*Session {
+        if (r.text == null) return null;
+        const format = try r.gpa.dupe(u8, ask.format);
+        errdefer r.gpa.free(format);
+        const s = try r.gpa.create(Session);
+        var cfg = r.cfg.scan;
+        if (ask.off) cfg.trace = false;
+        cfg.trace_repeat = ask.repeat;
+        s.* = .{ .r = r, .id = r.next_id, .scan = .{ .cfg = cfg }, .format = format, .check = ask.check, .rec = .{ .on = r.cfg.cells, .abstains_on = r.cfg.abstains } };
+        r.next_id += 1;
+        return s;
+    }
+};
+
+const Cell = struct {
+    lang: []u8,
+    code: []u8,
+    form: api.Form,
+    arena: std.heap.ArenaAllocator,
+    thread: ?std.Thread = null,
+    translated: std.atomic.Value(bool) = .init(false),
+    translation: api.Translation = .{ .abstain = .unsupported },
+    job: ?api.JobId = null,
+    result: ?api.Result = null, // out copied into the arena
+    abstained: bool = false,
+    told: enum { none, owned, abstained } = .none, // what its result header got
+    owned_tokens: u32 = 0,
+    stated: ?scan.Stated = null, // form trace: the `[exact: …]` line's expression (text in the arena)
+};
+
+/// One reply's cells, runs and the trigger it waits on; every method runs on the engine thread.
+pub const Session = struct {
+    r: *Runner,
+    id: u64,
+    scan: scan.Scanner,
+    cells: std.ArrayList(*Cell) = .empty,
+    waiting: ?scan.Trigger = null,
+    held_at: u64 = 0, // monotonic ns when the stream began to wait (the serving log's latency, never a result)
+    owned_n: u32 = 0,
+    abstained_n: u32 = 0,
+    held_ms: u64 = 0, // summed over the reply's holds
+    held_ticks: u32 = 0, // the current hold's ticks so far (the serving log's)
+    /// An owned result's forced tokens still to commit.
+    forcing: ?struct { at: u64, left: usize, cell: u32, inline_bytes_left: ?usize = null } = null,
+    resume_ms: u64 = 0, // summed: an owned result's settling to the model's first token after it
+    terminal_seen: bool = false,
+    broken: bool = false, // out of memory once: no more cells, no more holds
+    sync_ids: []u32 = &.{}, // cfg.sync_graph: the result a trigger settled with, forced by the stream (hook.settled)
+    format: []u8, // TraceAsk.format, owned
+    check: bool = false, // TraceAsk.check
+    rec: records.Log = .{}, // the receipt's per-cell records
+    commit: answer.State = .{}, // PREFIX_COMMIT: the request's ask (lane_stream), the think state, whether it fired
+
+    pub fn hook(s: *Session) lanes.stream.RunnerHook {
+        return .{ .ptr = s, .token = onToken, .settled = if (s.r.cfg.sync_graph) settled else null, .eos = onEos };
+    }
+
+    /// The tokens a trigger's run settled with at the token itself (once; null: hold for them as before).
+    fn settled(ptr: *anyopaque) ?[]const u32 {
+        const s: *Session = @ptrCast(@alignCast(ptr));
+        return if (s.sync_ids.len > 0) s.sync_ids else null;
+    }
+
+    fn onToken(ptr: *anyopaque, token: u32, think_open: bool, can_hold: bool, think_end: bool) bool {
+        const s: *Session = @ptrCast(@alignCast(ptr));
+        if (s.broken) return false;
+        return s.feed(token, think_open, can_hold, think_end) catch {
+            s.broken = true;
+            return false;
+        };
+    }
+
+    fn onEos(ptr: *anyopaque, think_open: bool, can_hold: bool) bool {
+        const s: *Session = @ptrCast(@alignCast(ptr));
+        if (s.broken or s.terminal_seen or s.commit.fired) return false;
+        return s.finishEos(think_open, can_hold) catch {
+            s.broken = true;
+            return false;
+        };
+    }
+
+    fn finishEos(s: *Session, think_open: bool, can_hold: bool) Allocator.Error!bool {
+        const ev = try s.scan.finishEos(s.r.gpa, think_open);
+        if (ev.closed) |c| try s.open(c);
+        const trigger = ev.trigger orelse return false;
+        if (!can_hold or trigger.index >= s.cells.items.len) return false;
+        s.waiting = trigger;
+        s.held_at = nowNs();
+        s.held_ticks = 0;
+        s.terminal_seen = true;
+        return true;
+    }
+
+    fn feed(s: *Session, token: u32, think_open: bool, can_hold: bool, think_end: bool) Allocator.Error!bool {
+        const tx = s.r.text.?;
+        if (s.forcing) |*r| {
+            // the forced tokens commit first; the next token is the model's own, one round after the result settled
+            if (r.left > 0) r.left -= 1 else {
+                const ms = (nowNs() -| r.at) / std.time.ns_per_ms;
+                s.resume_ms += ms;
+                log.info("reply {d} cell {d}: model's next token {d} ms after its result", .{ s.id, r.cell, ms });
+                s.forcing = null;
+            }
+        }
+        if (s.sync_ids.len > 0) {
+            s.r.gpa.free(s.sync_ids);
+            s.sync_ids = &.{};
+        }
+        const bytes = if (think_end) "" else tx.bytes(tx.ctx, token);
+        try s.rec.token(s.r.gpa, token, bytes, think_open);
+        if (answer.skip(&s.commit, think_open)) return false;
+        const scanning = if (s.forcing) |*r| output.scanning(&r.inline_bytes_left, bytes) else bytes;
+        if (scanning.len == 0 and bytes.len > 0) return false;
+        const ev = try s.scan.feed(s.r.gpa, scanning, think_open);
+        if (ev.closed) |c| try s.open(c);
+        const t = ev.trigger orelse return false;
+        if (!can_hold or t.index >= s.cells.items.len) return false;
+        if (s.r.cfg.sync_graph and !t.trace) if (try s.now(t)) |ids| {
+            // settled here: owned tokens go to the stream as forced ones (empty: abstained, the model's own text stays)
+            if (ids.len == 0) {
+                s.r.gpa.free(ids);
+                return false;
+            }
+            s.sync_ids = ids;
+            s.rec.synced();
+            return true;
+        };
+        s.waiting = t;
+        s.held_at = nowNs();
+        s.held_ticks = 0;
+        return true;
+    }
+
+    fn open(s: *Session, c: scan.Closed) Allocator.Error!void {
+        const gpa = s.r.gpa;
+        const cell = try gpa.create(Cell);
+        errdefer gpa.destroy(cell);
+        cell.* = .{ .lang = try gpa.dupe(u8, c.lang), .code = undefined, .form = c.form, .arena = .init(gpa) };
+        errdefer gpa.free(cell.lang);
+        cell.code = try gpa.dupe(u8, c.code);
+        errdefer gpa.free(cell.code);
+        // earlier code cells are the notebook; inline values and stated computations define nothing
+        var n: usize = 0;
+        for (s.cells.items) |p| n += @intFromBool(p.form != .inline_expr and p.stated == null);
+        const prior = try cell.arena.allocator().alloc([]const u8, n);
+        n = 0;
+        for (s.cells.items) |p| if (p.form != .inline_expr and p.stated == null) {
+            prior[n] = p.code;
+            n += 1;
+        };
+        try s.cells.append(gpa, cell);
+        s.rec.closed(gpa, c.index);
+        // a stated computation is literals only: no notebook names to shadow
+        if (c.trace) |st| {
+            cell.stated = .{ .display = try cell.arena.allocator().dupe(u8, st.display), .divmod = st.divmod };
+            const task: Translate = .{ .cell = cell, .fe = s.r.frontend, .prior = &.{}, .placer = s.r.placer };
+            cell.thread = std.Thread.spawn(.{}, Translate.spawned, .{task}) catch blk: {
+                task.run();
+                break :blk null;
+            };
+            return;
+        }
+        // exact inline math would contradict a reply reasoning in Python floats
+        if (c.own_context) {
+            cell.translation = .{ .abstain = .context };
+            cell.translated.store(true, .release);
+            return;
+        }
+        if (!s.r.cfg.exact and (std.mem.eql(u8, cell.lang, "calc") or std.mem.eql(u8, cell.lang, "exact"))) {
+            cell.translation = .{ .abstain = .language };
+            cell.translated.store(true, .release);
+            return;
+        }
+        const task: Translate = .{ .cell = cell, .fe = s.r.frontend, .prior = prior, .placer = s.r.placer };
+        // sync_graph: what the quick frontend finds on the engine thread (graph steps; inline: all) needs no thread
+        if (s.r.cfg.sync_graph) if (s.r.quick) |q| {
+            const quick: api.Cell = .{ .form = cell.form, .lang = cell.lang, .code = cell.code, .prior = prior };
+            const t = q.translate(q.ctx, cell.arena.allocator(), quick) catch @as(api.Translation, .{ .abstain = .too_big });
+            // an inline value's quick translation is its whole one (no compile); other cells keep a graph program only
+            if (cell.form == .inline_expr or (t == .program and t.program.kind == .graph)) {
+                cell.translation = t;
+                cell.translated.store(true, .release);
+                return;
+            }
+        };
+        // settling: an inline value (microseconds to translate) waits on no thread's start
+        if (s.r.cfg.settle_us > 0 and c.form == .inline_expr) return task.run();
+        cell.thread = std.Thread.spawn(.{}, Translate.spawned, .{task}) catch blk: {
+            task.run();
+            break :blk null;
+        };
+    }
+
+    /// Advances translations and runs; the tokens to force when the awaited cell is settled (caller frees them).
+    pub fn tick(s: *Session) Allocator.Error!?[]u32 {
+        s.rec.rounds += 1;
+        if (s.waiting) |w| if (s.r.cfg.settle_us > 0) s.settle(s.cells.items[w.index]);
+        for (s.cells.items) |c| s.advance(c);
+        const w = s.waiting orelse return null;
+        const c = s.cells.items[w.index];
+        s.held_ticks += 1;
+        if (!c.abstained and c.result == null) return null;
+        s.waiting = null;
+        const held_ms = (nowNs() -| s.held_at) / std.time.ns_per_ms;
+        s.held_ms += held_ms;
+        return try s.conclude(w, c, held_ms);
+    }
+
+    /// cfg.sync_graph at a trigger: a graph program run here, its tokens forced this round (empty: abstain, null: hold)
+    fn now(s: *Session, w: scan.Trigger) Allocator.Error!?[]u32 {
+        const c = s.cells.items[w.index];
+        if (!c.translated.load(.acquire) or c.job != null) return null;
+        if (c.thread) |th| {
+            th.join();
+            c.thread = null;
+        }
+        if (c.result == null and !c.abstained) switch (c.translation) {
+            .abstain => c.abstained = true,
+            .program => |p| {
+                if (p.kind != .graph) return null;
+                const res = s.r.backend.now(p, s.r.cfg.max_steps, sync_steps) orelse return null;
+                s.take(c, res);
+            },
+        };
+        s.held_ticks = 0;
+        return try s.conclude(w, c, 0);
+    }
+
+    /// A settled cell's tokens to force after its trigger (empty: abstained), counted and logged with the hold's ticks.
+    fn conclude(s: *Session, w: scan.Trigger, c: *Cell, held_ms: u64) Allocator.Error![]u32 {
+        if (w.trace) return try s.ownTrace(c, w.index, held_ms);
+        // an inline value is owned only when the run halted with a one-line value
+        if (!c.abstained and w.inline_space != null and (c.result.?.status != .ok or std.mem.indexOfScalar(u8, std.mem.trimEnd(u8, c.result.?.out, "\n"), '\n') != null)) c.abstained = true;
+        if (!c.abstained and s.r.cfg.inline_mark and w.inline_space != null) {
+            const value = output.value(c.result.?.out);
+            if (std.mem.trim(u8, value, " \t\r").len == 0 or std.mem.indexOfAny(u8, value, "\r\n") != null)
+                c.abstained = true;
+        }
+        if (c.abstained) {
+            abstain.told(s, c, w.index, held_ms, null);
+            log.info("reply {d} cell {d} ({s} {t}): abstain ({s}), held {d} ms, ticks {d}", .{ s.id, w.index, c.lang, c.form, why(c), held_ms, s.held_ticks });
+            return try s.r.gpa.alloc(u32, 0);
+        }
+        const res = c.result.?;
+        const ids = try s.owned(res, w);
+        if (s.r.cfg.inline_mark and w.inline_space != null and ids.len == 0) {
+            abstain.told(s, c, w.index, held_ms, .token_cap);
+            log.info("reply {d} cell {d}: marked inline value exceeds token cap", .{ s.id, w.index });
+            return ids;
+        }
+        s.owned_n += 1;
+        c.told = .owned;
+        c.owned_tokens = @intCast(ids.len);
+        s.rec.owned(s.r.gpa, w.index, ids) catch {
+            s.rec.on = false; // out of memory: this reply's receipt has no records
+        };
+        s.forcing = .{
+            .at = nowNs(),
+            .left = ids.len,
+            .cell = w.index,
+            .inline_bytes_left = if (s.r.cfg.inline_mark and w.inline_space != null)
+                output.value(res.out).len + @intFromBool(w.inline_space.?)
+            else
+                null,
+        };
+        log.info("reply {d} cell {d} ({s} {t}): owned {d} tokens, {t} after {d} steps, run {d} ms, held {d} ms, ticks {d}", .{ s.id, w.index, c.lang, c.form, ids.len, res.status, res.steps, res.exec_ns / std.time.ns_per_ms, held_ms, s.held_ticks });
+        return answer.after(s, c, w, w.index, ids);
+    }
+
+    /// Form trace: one `[exact: <expr> = <value>]` line, or nothing (abstain) unless the run printed one integer value.
+    fn ownTrace(s: *Session, c: *Cell, index: u32, held_ms: u64) Allocator.Error![]u32 {
+        const gpa = s.r.gpa;
+        const tx = s.r.text.?;
+        const line = if (!c.abstained and c.result.?.status == .ok) try trace.owned(gpa, s.format, c.stated.?.display, c.stated.?.divmod, c.result.?.out, s.check) else null;
+        if (line) |text| {
+            defer gpa.free(text);
+            const ids = try tx.encode(tx.ctx, gpa, text);
+            if (ids.len <= s.r.cfg.max_tokens) {
+                s.owned_n += 1;
+                c.told = .owned;
+                c.owned_tokens = @intCast(ids.len);
+                s.rec.owned(gpa, index, ids) catch {
+                    s.rec.on = false;
+                };
+                s.forcing = .{ .at = nowNs(), .left = ids.len, .cell = index };
+                const res = c.result.?;
+                log.info("reply {d} cell {d} (trace): owned {d} tokens, {d} steps, run {d} ms, held {d} ms, ticks {d}", .{ s.id, index, ids.len, res.steps, res.exec_ns / std.time.ns_per_ms, held_ms, s.held_ticks });
+                return ids;
+            }
+            gpa.free(ids);
+        }
+        abstain.told(s, c, index, held_ms, if (line != null) .token_cap else if (c.result != null and c.result.?.status == .ok and !c.abstained) .trace_shape else null);
+        log.info("reply {d} cell {d} (trace): abstain ({s}), held {d} ms, ticks {d}", .{ s.id, index, if (c.result != null and c.result.?.status == .ok) "not one value" else why(c), held_ms, s.held_ticks });
+        return try gpa.alloc(u32, 0);
+    }
+
+    fn why(c: *const Cell) []const u8 {
+        if (c.translation == .abstain) return @tagName(c.translation.abstain);
+        const res = c.result orelse return "backend start";
+        if (res.status == .abstain) return if (res.abstain) |a| @tagName(a) else "backend";
+        if (res.status != .ok) return @tagName(res.status); // inline: budget or fault
+        return if (res.out.len == 0) "empty output" else "multi-line inline value";
+    }
+
+    /// The awaited cell's stages on this tick for up to settle_us: run here if that ends it, else its job waited on.
+    fn settle(s: *Session, c: *Cell) void {
+        const until = nowNs() + @as(u64, s.r.cfg.settle_us) * std.time.ns_per_us;
+        var tried = false;
+        while (true) {
+            if (c.thread) |th| if (c.translated.load(.acquire)) {
+                th.join();
+                c.thread = null;
+            };
+            if (!tried and c.thread == null and c.job == null and c.result == null and !c.abstained and
+                c.translated.load(.acquire) and c.translation == .program)
+            {
+                tried = true;
+                const quick = @as(u64, s.r.cfg.settle_us) * quick_steps_per_us;
+                if (s.r.backend.now(c.translation.program, s.r.cfg.max_steps, quick)) |res| return s.take(c, res);
+            }
+            s.advance(c);
+            if (c.abstained or c.result != null or nowNs() >= until) return;
+            var ts: std.c.timespec = .{ .sec = 0, .nsec = 20 * std.time.ns_per_us };
+            _ = std.c.nanosleep(&ts, null);
+        }
+    }
+
+    fn advance(s: *Session, c: *Cell) void {
+        if (c.thread) |th| {
+            if (!c.translated.load(.acquire)) return;
+            th.join();
+            c.thread = null;
+        } else if (!c.translated.load(.acquire)) return;
+        if (c.abstained or c.result != null) return;
+        const prog = switch (c.translation) {
+            .abstain => {
+                c.abstained = true;
+                return;
+            },
+            .program => |p| p,
+        };
+        const job = c.job orelse {
+            c.job = s.r.backend.start(s.id, prog, s.r.cfg.max_steps) catch |e| switch (e) {
+                error.Busy => return, // tried again next round: tokens never depend on it
+                error.OutOfMemory => {
+                    c.abstained = true;
+                    return;
+                },
+            };
+            // settling: a run that is done at once is taken on the tick that started it
+            if (s.r.cfg.settle_us == 0) return;
+            s.poll(c, c.job.?);
+            return;
+        };
+        s.poll(c, job);
+    }
+
+    fn poll(s: *Session, c: *Cell, job: api.JobId) void {
+        switch (s.r.backend.poll(job)) {
+            .running => {},
+            .done => |res| {
+                c.job = null;
+                s.take(c, res);
+            },
+        }
+    }
+
+    fn take(_: *Session, c: *Cell, res: api.Result) void {
+        var kept = res;
+        kept.out = c.arena.allocator().dupe(u8, res.out) catch {
+            c.abstained = true;
+            return;
+        };
+        c.result = kept;
+        if (res.status == .abstain or (res.status == .ok and res.out.len == 0)) c.abstained = true;
+    }
+
+    /// The owned text for a settled run, as token ids within the token cap.
+    fn owned(s: *Session, res: api.Result, w: scan.Trigger) Allocator.Error![]u32 {
+        return output.owned(s.r.gpa, s.r.text.?, res, w, .{
+            .max_tokens = s.r.cfg.max_tokens,
+            .inline_mark = s.r.cfg.inline_mark,
+        });
+    }
+
+    /// Whether the session waits on a run (its stream is held at a trigger).
+    pub fn awaiting(s: *const Session) bool {
+        return s.waiting != null;
+    }
+
+    /// The reply's runner receipt as JSON (runtime.runner, runner_receipt.zig); valid until the session is destroyed.
+    pub fn receipt(s: *Session) []const u8 {
+        return records.write(s);
+    }
+
+    /// Cancels runs, joins translations and frees the session; the backend drops the stream's machines.
+    pub fn destroy(s: *Session) void {
+        const gpa = s.r.gpa;
+        gpa.free(s.sync_ids);
+        if (s.cells.items.len > 0) log.info("reply {d}: {d} cells closed, {d} owned, {d} abstained at a header, {d} never claimed", .{ s.id, s.cells.items.len, s.owned_n, s.abstained_n, s.cells.items.len - s.owned_n - s.abstained_n });
+        for (s.cells.items) |c| if (c.thread) |th| th.join(); // all first: a later cell's prior borrows earlier code
+        for (s.cells.items) |c| {
+            if (c.job) |j| s.r.backend.cancel(j);
+            gpa.free(c.lang);
+            gpa.free(c.code);
+            c.arena.deinit();
+            gpa.destroy(c);
+        }
+        s.r.backend.release(s.id);
+        s.cells.deinit(gpa);
+        s.scan.deinit(gpa);
+        gpa.free(s.format);
+        s.rec.deinit(gpa);
+        gpa.destroy(s);
+    }
+};
+
+/// Settling's cap on a run on the engine thread: steps per microsecond of settle_us (a graph step is about 20 ns).
+const quick_steps_per_us = 20;
+
+/// sync_graph's cap on a run at its trigger, on the engine thread: about 2 ms of graph steps; longer runs hold.
+const sync_steps = 100_000;
+
+/// Monotonic nanoseconds for the serving log only.
+fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+const Translate = struct {
+    cell: *Cell,
+    fe: api.Frontend,
+    prior: []const []const u8,
+    placer: ?*place.Placer = null,
+
+    /// On its own thread: placed first. The inline fallback (no thread) stays on the engine thread's CPU and niceness.
+    fn spawned(t: Translate) void {
+        if (t.placer) |p| p.enter();
+        t.run();
+    }
+
+    fn run(t: Translate) void {
+        const c = t.cell;
+        const cell: api.Cell = .{ .form = c.form, .lang = c.lang, .code = c.code, .prior = t.prior };
+        c.translation = t.fe.translate(t.fe.ctx, c.arena.allocator(), cell) catch .{ .abstain = .too_big };
+        c.translated.store(true, .release);
+    }
+};
+
+test {
+    _ = @import("runner_scan.zig");
+    _ = @import("runner_api.zig");
+    _ = @import("runner_trace_test.zig");
+    _ = @import("runner_settle_test.zig");
+    _ = @import("runner_sync_test.zig");
+    _ = @import("runner_probe.zig");
+    _ = @import("runner_graph_table_test.zig");
+    _ = @import("runner_inline_mod_test.zig");
+    _ = @import("runner_inline_arith_test.zig");
+    _ = @import("runner_inline_chain_test.zig");
+    _ = @import("runner_receipt_test.zig");
+    _ = @import("runner_inline_context_test.zig");
+    _ = @import("runner_inline_hex_test.zig");
+    _ = @import("runner_trace_stated_test.zig");
+    _ = @import("runner_trace_divmod_test.zig");
+    _ = @import("runner_trace_named_test.zig");
+    _ = @import("runner_trace_check_test.zig");
+    _ = @import("runner_graph_edit.zig");
+    _ = @import("runner_commit.zig");
+}
diff --git a/zig/src/core/runner_abstain.zig b/zig/src/core/runner_abstain.zig
new file mode 100644
index 000000000..2e0d13dd7
--- /dev/null
+++ b/zig/src/core/runner_abstain.zig
@@ -0,0 +1,146 @@
+//! Abstain records (PREFIX_ABSTAINS, with CELLS): each abstained cell's source, reason, stage and decision point.
+const std = @import("std");
+const receipt = @import("runner_receipt.zig");
+const Allocator = std.mem.Allocator;
+
+pub const schema = 1;
+
+/// Why a cell abstained, as one stable name; its refusal stage follows from it (`stage`).
+pub const Reason = enum {
+    context, // the reply's own number context (exact inline math in a Python-float reply)
+    language, // a `calc` / `exact` cell with exact cells off
+    unsupported,
+    syntax,
+    name,
+    too_long,
+    too_big, // the frontend's own tags (runner_api.Abstain), as it gave them
+    out_of_memory, // the backend start, or keeping its result
+    backend_abstain,
+    budget,
+    fault, // the run: its own abstain (error_name: its tag), the step budget, a machine fault
+    empty_output,
+    multiline_output, // an inline value that is not one line
+    mark_value_shape, // INLINE_MARK: a blank or multi-line value cannot carry the mark
+    token_cap, // the owned text would pass the token cap
+    trace_shape, // a trace run that did not print one value
+};
+
+pub fn stage(r: Reason) []const u8 {
+    return switch (r) {
+        .context => "context",
+        .language, .unsupported, .syntax, .name, .too_long, .too_big => "frontend",
+        .out_of_memory => "dispatch",
+        .backend_abstain, .budget, .fault => "execute",
+        .empty_output, .multiline_output, .mark_value_shape, .token_cap, .trace_shape => "own",
+    };
+}
+
+/// One abstained cell at its decision; the log fills the reply's coordinates there, as an owned record's.
+pub const Abstain = struct {
+    cell: u32,
+    reason: Reason,
+    error_name: ?[]const u8 = null, // the original tag (static text)
+    held_ms: u64 = 0,
+    steps: u64 = 0,
+    content: bool = false,
+    at: u64 = 0,
+    token: u32 = 0,
+    round: u32 = 0,
+};
+
+/// Where cell `cell`'s source closed: its field and that field's bytes through the closing token.
+pub const Close = struct { cell: u32, content: bool, end: u64 };
+
+/// Why a settled cell abstained, read off its translation and result; `hint`: what only its caller knows.
+pub fn reason(c: anytype, hint: ?Reason) struct { Reason, ?[]const u8 } {
+    if (hint) |h| return .{ h, null };
+    switch (c.translation) {
+        .abstain => |t| switch (t) {
+            inline else => |x| return .{ @field(Reason, @tagName(x)), @tagName(x) },
+        },
+        .program => {},
+    }
+    const res = c.result orelse return .{ .out_of_memory, "OutOfMemory" };
+    return switch (res.status) {
+        .abstain => .{ .backend_abstain, if (res.abstain) |a| @tagName(a) else null },
+        .budget => .{ .budget, "budget" },
+        .fault => .{ .fault, "fault" },
+        .ok => if (res.out.len == 0) .{ .empty_output, null } else if (std.mem.indexOfScalar(u8, std.mem.trimEnd(u8, res.out, "\n"), '\n') != null) .{ .multiline_output, null } else .{ .mark_value_shape, null },
+    };
+}
+
+/// Cell `index` abstains at its decision: told, counted, and recorded when abstain records are on.
+pub fn told(s: anytype, c: anytype, index: u32, held_ms: u64, hint: ?Reason) void {
+    const why = reason(c, hint);
+    c.abstained = true;
+    c.told = .abstained;
+    s.abstained_n += 1;
+    s.rec.abstained(s.r.gpa, .{ .cell = index, .reason = why[0], .error_name = why[1], .held_ms = held_ms, .steps = if (c.result) |r| r.steps else 0 });
+}
+
+/// The receipt's abstain fields after its records: `abstains`, completeness, and the runner config they ran under.
+pub fn write(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, l: anytype, cfg: anytype) Allocator.Error!void {
+    try o.print(gpa, ",\"abstain_schema\":{d},\"abstains\":[", .{schema});
+    for (l.abstains.items, 0..) |a, i| {
+        if (i > 0) try o.append(gpa, ',');
+        try one(o, gpa, cells, l, a);
+    }
+    // op, op_families, plan width and route attempts: the frontend gives the runner only its abstain tag
+    try o.print(gpa, "],\"abstains_complete\":{},\"abstains_dropped\":{d},\"abstain_frontend_detail\":false", .{ l.dropped == 0 and !l.anchors_lost, l.dropped });
+    if (@TypeOf(cfg) != @TypeOf(null)) try o.print(gpa, ",\"runner_config\":{{\"backend\":\"{t}\",\"exact\":{},\"sync_graph\":{},\"inline_mark\":{},\"settle_us\":{d},\"max_steps\":{d},\"max_tokens\":{d},\"compile_steps\":{d},\"compile\":{},\"inline_math\":{},\"trace\":{}}}", .{ cfg.backend, cfg.exact, cfg.sync_graph, cfg.inline_mark, cfg.settle_us, cfg.max_steps, cfg.max_tokens, cfg.compile_steps, cfg.compile, cfg.scan.inline_math, cfg.scan.trace });
+}
+
+fn one(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, l: anytype, a: Abstain) Allocator.Error!void {
+    const c = cells[a.cell];
+    const kind: []const u8 = if (c.translation == .program) @tagName(c.translation.program.kind) else "none";
+    const route: []const u8 = if (c.translation != .program) "none" else if (c.translation.program.kind == .graph) "graph" else "circuit";
+    try o.print(gpa, "{{\"cell\":{d},\"form\":\"{s}\",", .{ a.cell, receipt.form_names[if (c.stated != null) 3 else @backingInt(c.form)] });
+    try receipt.text(o, gpa, "lang", c.lang);
+    try receipt.text(o, gpa, "code", c.code);
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(c.code, &digest, .{});
+    try o.print(gpa, "\"span_sha256\":\"{s}\",\"span_len\":{d},\"prior\":[", .{ std.fmt.bytesToHex(digest, .lower), c.code.len });
+    // the notebook its frontend was given: earlier code cells, never inline values or stated computations (open)
+    var n: usize = 0;
+    if (c.stated == null) for (cells[0..a.cell]) |p| if (p.form != .inline_expr and p.stated == null) {
+        if (n > 0) try o.append(gpa, ',');
+        try receipt.quoted(o, gpa, p.code);
+        n += 1;
+    };
+    try o.appendSlice(gpa, "],");
+    if (c.stated) |st| try receipt.text(o, gpa, "display", st.display) else try o.appendSlice(gpa, "\"display\":null,");
+    const src = source(l, a.cell, if (c.stated) |st| st.display else c.code);
+    if (src.close) |cl| {
+        try o.print(gpa, "\"source_field\":\"{s}\",", .{field(cl.content)});
+        if (src.at) |at| try o.print(gpa, "\"source_at\":{d},\"source_end\":{d},", .{ at, src.end }) else try o.appendSlice(gpa, "\"source_at\":null,\"source_end\":null,");
+        try o.print(gpa, "\"source_close_at\":{d},", .{cl.end});
+    } else try o.appendSlice(gpa, "\"source_field\":null,\"source_at\":null,\"source_end\":null,\"source_close_at\":null,");
+    var next = l.tokens;
+    for (l.records.items) |r| if (r.token > a.token and r.token < next) {
+        next = r.token;
+    };
+    for (l.abstains.items) |b| if (b.token > a.token and b.token < next) {
+        next = b.token;
+    };
+    try o.print(gpa, "\"program_kind\":\"{s}\",\"backend_route\":\"{s}\",\"stage\":\"{s}\",\"reason\":\"{t}\",", .{ kind, route, stage(a.reason), a.reason });
+    if (a.error_name) |e| try o.print(gpa, "\"error_name\":\"{s}\",", .{e}) else try o.appendSlice(gpa, "\"error_name\":null,");
+    try o.print(gpa, "\"resume_field\":\"{s}\",\"resume_at\":{d},\"resume_token\":{d},\"round\":{d},\"next_decision_token\":{d},\"reply_tokens\":{d},\"owned_tokens\":0,\"steps\":{d},\"held_ms\":{d}}}", .{ field(a.content), a.at, a.token, a.round, next, l.tokens, a.steps, a.held_ms });
+}
+
+fn field(content: bool) []const u8 {
+    return if (content) "content" else "reasoning";
+}
+
+/// The source's bytes [at, end): its last exact copy before the cell closed (none: normalized, e.g. REPL prompts cut).
+fn source(l: anytype, cell: u32, needle: []const u8) struct { close: ?Close, at: ?u64 = null, end: u64 = 0 } {
+    const cl = for (l.closes.items) |x| {
+        if (x.cell == cell) break x;
+    } else return .{ .close = null };
+    const text = l.text[@intFromBool(cl.content)].items;
+    const hay = text[0..@min(text.len, cl.end)];
+    for ([_][]const u8{ needle, std.mem.trim(u8, needle, " \t\r\n") }) |want| {
+        if (want.len == 0) continue;
+        if (std.mem.lastIndexOf(u8, hay, want)) |at| return .{ .close = cl, .at = at, .end = at + want.len };
+    }
+    return .{ .close = cl };
+}
diff --git a/zig/src/core/runner_abstain_test.zig b/zig/src/core/runner_abstain_test.zig
new file mode 100644
index 000000000..cbc74377d
--- /dev/null
+++ b/zig/src/core/runner_abstain_test.zig
@@ -0,0 +1,260 @@
+//! Abstain records end to end on a lane host (each reason forced, records on/off byte-identical) and on a fake session.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const scan = @import("runner_scan.zig");
+const records = @import("runner_receipt.zig");
+const abstain = @import("runner_abstain.zig");
+const rt = @import("runner_test.zig");
+
+const gpa = std.testing.allocator;
+const t = std.testing;
+
+const Ab = struct { cell: u32, form: []const u8, code: []const u8, display: ?[]const u8, prior: []const []const u8, source_field: ?[]const u8, source_at: ?u64, source_end: ?u64, source_close_at: ?u64, program_kind: []const u8, backend_route: []const u8, stage: []const u8, reason: []const u8, error_name: ?[]const u8, resume_field: []const u8, resume_at: u64, resume_token: u32, round: u32, next_decision_token: u32, reply_tokens: u32, owned_tokens: u32, steps: u64, held_ms: u64 };
+const Count = struct { closed: u32, owned: u32, abstained: u32 };
+const Receipt = struct { fence: Count, repl: Count, @"inline": Count, trace: Count, abstain_schema: u32 = 0, abstains: []const Ab = &.{}, abstains_complete: bool = false, abstains_dropped: u32 = 99 };
+
+fn parse(receipt: []const u8) !std.json.Parsed(Receipt) {
+    return std.json.parseFromSlice(Receipt, gpa, receipt, .{ .ignore_unknown_fields = true, .allocate = .alloc_always });
+}
+
+const mul_lead = "Need multiply A=987654 B=137. Need exact product.\nLet's do long multiplication.\n";
+const fence_lead = "```python\nprint(2**100)\n```\nResult:\n";
+
+/// `receipt` with its wall-clock fields (held_ms, resume_ms) zeroed: everything else must match byte for byte.
+fn untimed(receipt: []const u8) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 0;
+    while (i < receipt.len) {
+        const key = for ([_][]const u8{ "\"held_ms\":", "\"resume_ms\":" }) |k| {
+            if (std.mem.startsWith(u8, receipt[i..], k)) break k;
+        } else null;
+        if (key) |k| {
+            try out.appendSlice(gpa, k);
+            try out.append(gpa, '0');
+            i += k.len;
+            while (i < receipt.len and std.ascii.isDigit(receipt[i])) i += 1;
+        } else {
+            try out.append(gpa, receipt[i]);
+            i += 1;
+        }
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+/// One forced abstain: the reply, the runner's options and the fake run's result; what its record must say.
+const Case = struct { lead: []const u8, guess: []const u8 = "42", o: rt.Opts = .{}, result: ?rapi.Result = null, reason: []const u8, stage: []const u8, error_name: ?[]const u8 = null, kind: []const u8 = "calc", source: ?[]const u8 = null };
+
+const cases = [_]Case{
+    .{ .lead = "```python\nprint(undefined_total)\n```\nResult:\n", .reason = "name", .stage = "frontend", .error_name = "name", .kind = "none", .source = "print(undefined_total)\n" },
+    .{ .lead = "```calc\n2**100\n```\nResult:\n", .reason = "language", .stage = "frontend", .error_name = "language", .kind = "none", .source = "2**100\n" },
+    .{ .lead = "In Python, as a float: 1.5+2.25 =", .o = .{ .inline_math = true }, .reason = "context", .stage = "context", .error_name = "context", .kind = "none", .source = "1.5+2.25" },
+    .{ .lead = "So 99 * 13 =", .o = .{ .inline_math = true }, .reason = "fault", .stage = "execute", .error_name = "fault", .source = "99 * 13" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true }, .result = .{ .status = .budget, .out = "3901" }, .reason = "budget", .stage = "execute", .error_name = "budget" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true }, .result = .{ .status = .abstain, .abstain = .too_big }, .reason = "backend_abstain", .stage = "execute", .error_name = "too_big" },
+    .{ .lead = fence_lead, .result = .{ .status = .ok, .out = "" }, .reason = "empty_output", .stage = "own", .source = "print(2**100)\n" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true }, .result = .{ .status = .ok, .out = "3\n4\n" }, .reason = "multiline_output", .stage = "own" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true, .inline_mark = true }, .result = .{ .status = .ok, .out = " \n" }, .reason = "mark_value_shape", .stage = "own" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true, .inline_mark = true, .result_tokens = 5 }, .reason = "token_cap", .stage = "own" },
+    .{ .lead = mul_lead, .guess = "ok", .o = .{ .trace = true }, .result = .{ .status = .ok, .out = "1\n2\n" }, .reason = "trace_shape", .stage = "own" },
+    .{ .lead = mul_lead, .guess = "ok", .o = .{ .trace = true, .result_tokens = 5 }, .result = .{ .status = .ok, .out = "135308598\n" }, .reason = "token_cap", .stage = "own" },
+};
+
+/// The reply and receipt of `c` with abstain records on or off.
+fn run(c: Case, on: bool) !struct { text: []u8, receipt: []u8 } {
+    var back: rt.Back = .{ .result = c.result };
+    defer back.deinit();
+    var m = [_]rt.Model{.{ .lead = c.lead, .guess = c.guess }};
+    var sums: [1][]u8 = undefined;
+    var o = c.o;
+    o.summaries = &sums;
+    o.abstains = on;
+    const texts = try rt.replies(&m, o, &back);
+    defer gpa.free(texts);
+    return .{ .text = texts[0], .receipt = sums[0] };
+}
+
+test "runner abstain records: each reason forced on a lane host, with its source, stage and decision point" {
+    for (cases) |c| {
+        const on = try run(c, true);
+        defer gpa.free(on.text);
+        defer gpa.free(on.receipt);
+        const p = try parse(on.receipt);
+        defer p.deinit();
+        const r = p.value;
+        errdefer std.debug.print("case {s} / {s}: {s}\n", .{ c.lead, c.reason, on.receipt });
+        // the model's own text stands: its guess right after the decision, nothing owned
+        try t.expect(std.mem.endsWith(u8, on.text, "\nDone."));
+        try t.expectEqualStrings(c.guess, on.text[on.text.len - 6 - c.guess.len ..][0..c.guess.len]);
+        try t.expectEqual(1, r.abstain_schema);
+        try t.expect(r.abstains_complete);
+        try t.expectEqual(0, r.abstains_dropped);
+        try t.expectEqual(1, r.abstains.len);
+        // conservation: one record per abstained cell over every form's counter
+        try t.expectEqual(r.abstains.len, r.fence.abstained + r.repl.abstained + r.@"inline".abstained + r.trace.abstained);
+        const a = r.abstains[0];
+        try t.expectEqualStrings(c.reason, a.reason);
+        try t.expectEqualStrings(c.stage, a.stage);
+        if (c.error_name) |e| try t.expectEqualStrings(e, a.error_name.?);
+        try t.expectEqualStrings(c.kind, a.program_kind);
+        try t.expectEqualStrings(if (std.mem.eql(u8, c.kind, "none")) "none" else "circuit", a.backend_route);
+        try t.expectEqual(0, a.owned_tokens);
+        // one token a character: the decision is the trigger's end, where the model's own continuation begins
+        try t.expectEqualStrings("content", a.resume_field);
+        try t.expectEqual(a.resume_at, a.resume_token);
+        try t.expect(a.resume_at <= c.lead.len and a.resume_at + 2 >= c.lead.len);
+        try t.expectEqualStrings(c.lead[0..a.resume_at], on.text[0..a.resume_at]);
+        try t.expectEqual(on.text.len + 1, a.reply_tokens); // the EOS is a committed token too
+        try t.expectEqual(a.reply_tokens, a.next_decision_token);
+        try t.expectEqualStrings("content", a.source_field.?);
+        try t.expect(a.source_close_at.? <= a.resume_at);
+        if (c.source) |want| {
+            try t.expectEqualStrings(want, on.text[a.source_at.?..a.source_end.?]);
+            try t.expect(std.mem.eql(u8, want, a.code) or std.mem.eql(u8, want, std.mem.trim(u8, a.code, " ")));
+        }
+        if (a.source_at) |at| try t.expectEqualStrings(std.mem.trim(u8, a.code, " \t\r\n"), std.mem.trim(u8, on.text[at..a.source_end.?], " \t\r\n"));
+        if (std.mem.eql(u8, a.form, "trace")) try t.expect(a.display != null) else try t.expect(a.display == null);
+        // records off: the same tokens, and the receipt is the one before abstain records, byte for byte
+        const off = try run(c, false);
+        defer gpa.free(off.text);
+        defer gpa.free(off.receipt);
+        try t.expectEqualStrings(off.text, on.text);
+        try t.expect(std.mem.indexOf(u8, off.receipt, "\"abstains") == null and std.mem.indexOf(u8, off.receipt, "abstain_") == null);
+        const on_u = try untimed(on.receipt);
+        defer gpa.free(on_u);
+        const off_u = try untimed(off.receipt);
+        defer gpa.free(off_u);
+        try t.expect(std.mem.startsWith(u8, on_u, off_u[0 .. off_u.len - 1]));
+        try t.expect(std.mem.startsWith(u8, on_u[off_u.len - 1 ..], ",\"abstain_schema\":1,\"abstains\":["));
+    }
+}
+
+test "runner abstain records: the reason of every frontend tag, a lost start, and the run's own abstain tag" {
+    const Fake = struct { translation: rapi.Translation, result: ?rapi.Result = null };
+    for (std.enums.values(rapi.Abstain)) |tag| {
+        const why = abstain.reason(Fake{ .translation = .{ .abstain = tag } }, null);
+        try t.expectEqualStrings(@tagName(tag), @tagName(why[0]));
+        try t.expectEqualStrings(@tagName(tag), why[1].?);
+        try t.expectEqualStrings(if (tag == .context) "context" else "frontend", abstain.stage(why[0]));
+    }
+    const prog: rapi.Translation = .{ .program = .{ .kind = .graph, .bytes = "" } };
+    const lost = abstain.reason(Fake{ .translation = prog }, null);
+    try t.expectEqual(abstain.Reason.out_of_memory, lost[0]);
+    try t.expectEqualStrings("dispatch", abstain.stage(lost[0]));
+    const bare = abstain.reason(Fake{ .translation = prog, .result = .{ .status = .abstain } }, null);
+    try t.expectEqual(abstain.Reason.backend_abstain, bare[0]);
+    try t.expect(bare[1] == null);
+    try t.expectEqual(abstain.Reason.token_cap, abstain.reason(Fake{ .translation = prog, .result = .{ .status = .ok, .out = "1" } }, .token_cap)[0]);
+}
+
+/// The fields records.write and abstain.told read off a runner.Session and its cells.
+const FakeCell = struct {
+    form: rapi.Form = .fence,
+    stated: ?scan.Stated = null,
+    told: enum { none, owned, abstained } = .none,
+    abstained: bool = false,
+    owned_tokens: u32 = 0,
+    translation: rapi.Translation = .{ .program = .{ .kind = .graph, .bytes = "" } },
+    result: ?rapi.Result = .{ .status = .fault, .steps = 7 },
+    lang: []const u8 = "python",
+    code: []const u8 = "x = 1\n",
+};
+
+const FakeSession = struct {
+    r: struct { gpa: std.mem.Allocator = gpa } = .{},
+    cells: struct { items: []const *FakeCell },
+    held_ms: u64 = 0,
+    resume_ms: u64 = 0,
+    abstained_n: u32 = 0,
+    rec: records.Log = .{ .abstains_on = true },
+    fn feed(s: *FakeSession, text: []const u8) !void {
+        for (text) |c| try s.rec.token(gpa, c, &[_]u8{c}, false);
+    }
+};
+
+test "runner abstain records: mixed decisions, the source's last copy, a normalized source, the next decision, completeness" {
+    var c0: FakeCell = .{ .code = "y = 2\n" };
+    var c1: FakeCell = .{ .form = .repl, .code = "y\nz\n" };
+    var c2: FakeCell = .{ .code = "y = 2\n", .translation = .{ .abstain = .syntax }, .result = null };
+    var s: FakeSession = .{ .cells = .{ .items = &.{ &c0, &c1, &c2 } } };
+    defer s.rec.deinit(gpa);
+    try s.feed("```python\ny = 2\n```\n");
+    s.rec.closed(gpa, 0);
+    try s.feed("Out:");
+    try s.rec.owned(gpa, 0, &.{ 'O', 'K' });
+    c0.told = .owned;
+    try s.feed("OK\n>>> y\n>>> z\n");
+    s.rec.closed(gpa, 1);
+    abstain.told(&s, &c1, 1, 3, null); // fault: the run's own status
+    try s.feed("5\nAgain:\n```python\ny = 2\n```\n");
+    s.rec.closed(gpa, 2);
+    s.rec.rounds = 4;
+    abstain.told(&s, &c2, 2, 0, null);
+    try s.feed("tail");
+    const got = records.write(&s);
+    const p = try parse(got);
+    defer p.deinit();
+    const r = p.value;
+    try t.expectEqual(2, s.abstained_n);
+    try t.expect(c1.told == .abstained and c1.abstained and c2.told == .abstained);
+    try t.expectEqual(2, r.abstains.len);
+    const a1 = r.abstains[0];
+    try t.expectEqualStrings("fault", a1.reason);
+    try t.expectEqual(7, a1.steps);
+    try t.expectEqual(3, a1.held_ms);
+    try t.expect(a1.source_at == null); // a REPL line's code is not its bytes in the reply (the prompt is cut)
+    try t.expectEqual(1, a1.prior.len);
+    try t.expectEqualStrings("y = 2\n", a1.prior[0]);
+    try t.expectEqual(a1.resume_token, a1.resume_at);
+    try t.expectEqual(r.abstains[1].resume_token, a1.next_decision_token); // the next decision: the later abstain
+    const a2 = r.abstains[1];
+    const text = "```python\ny = 2\n```\nOut:OK\n>>> y\n>>> z\n5\nAgain:\n```python\ny = 2\n```\ntail";
+    try t.expectEqualStrings("syntax", a2.reason);
+    try t.expectEqualStrings("none", a2.program_kind);
+    try t.expectEqual(std.mem.lastIndexOf(u8, text[0..a2.source_close_at.?], "y = 2\n").?, a2.source_at.?); // its own copy
+    try t.expect(a2.source_at.? > 10);
+    try t.expectEqual(4, a2.round);
+    try t.expectEqual(text.len, a2.next_decision_token);
+    try t.expectEqual(text.len, a2.reply_tokens);
+    try t.expectEqual(2, a2.prior.len);
+    try t.expect(r.abstains_complete);
+    // a record lost to memory: the receipt says the census is incomplete
+    s.rec.dropped = 1;
+    const lossy = try parse(records.write(&s));
+    defer lossy.deinit();
+    try t.expect(!lossy.value.abstains_complete);
+    try t.expectEqual(1, lossy.value.abstains_dropped);
+    // abstain records off: nothing kept, nothing written, the receipt as before
+    var c3: FakeCell = .{};
+    var off: FakeSession = .{ .cells = .{ .items = &.{&c3} }, .rec = .{} };
+    defer off.rec.deinit(gpa);
+    try off.feed("abc");
+    off.rec.closed(gpa, 0);
+    abstain.told(&off, &c3, 0, 0, null);
+    try t.expectEqual(0, off.rec.text[1].items.len);
+    try t.expectEqual(0, off.rec.abstains.items.len);
+    try t.expectEqual(1, off.abstained_n);
+    try t.expect(std.mem.endsWith(u8, records.write(&off), "\"cells\":[]}"));
+}
+
+test "runner abstain records: PREFIX_ABSTAINS is off unless 1, and a session records abstains only with cells on" {
+    const K = struct {
+        var set: []const [2][]const u8 = &.{};
+        fn get(name: []const u8) ?[]const u8 {
+            for (set) |kv| if (std.mem.eql(u8, kv[0], name)) return kv[1];
+            return null;
+        }
+    };
+    const runner = @import("runner.zig");
+    K.set = &.{ .{ "TF_R", "1" }, .{ "TF_R_CIRCUIT", "/c.bin" } };
+    try t.expect(!(try runner.Config.parse(&K.get, "TF_R")).?.abstains);
+    K.set = &.{ .{ "TF_R", "1" }, .{ "TF_R_CIRCUIT", "/c.bin" }, .{ "TF_R_ABSTAINS", "1" } };
+    try t.expect((try runner.Config.parse(&K.get, "TF_R")).?.abstains);
+    K.set = &.{ .{ "TF_R", "1" }, .{ "TF_R_CIRCUIT", "/c.bin" }, .{ "TF_R_ABSTAINS", "2" } };
+    try t.expectError(error.BadKnob, runner.Config.parse(&K.get, "TF_R"));
+    // cells off: no records of either kind, whatever ABSTAINS says
+    const c: Case = .{ .lead = "```python\nprint(undefined_total)\n```\nResult:\n", .o = .{ .cells = false }, .reason = "name", .stage = "frontend" };
+    const off = try run(c, true);
+    defer gpa.free(off.text);
+    defer gpa.free(off.receipt);
+    try t.expect(std.mem.indexOf(u8, off.receipt, "\"abstains") == null and std.mem.indexOf(u8, off.receipt, "\"cells\"") == null);
+}
diff --git a/zig/src/core/runner_api.zig b/zig/src/core/runner_api.zig
new file mode 100644
index 000000000..4a2f8cb5b
--- /dev/null
+++ b/zig/src/core/runner_api.zig
@@ -0,0 +1,107 @@
+//! The in-model runner's contracts: a cell the model wrote, the circuit program a frontend makes of it, the backend.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// How the model wrote a cell: a fenced block, a `>>> ` REPL line, or an inline `A op B =`.
+pub const Form = enum { fence, repl, inline_expr };
+
+/// A closed cell of the reply being generated (never prompt history).
+pub const Cell = struct {
+    form: Form,
+    /// The fence's language tag, lowercase and trimmed ("" when none; "python" for repl and inline_expr).
+    lang: []const u8,
+    /// The cell's source without fence lines or `>>> ` / `... ` prefixes; inline_expr: the text before `=`.
+    code: []const u8,
+    /// Sources of this reply's earlier cells whose runs ended ok, oldest first (notebook state; may be ignored).
+    prior: []const []const u8 = &.{},
+};
+
+/// What the circuit runs. calc: an ASCII expression for the calc firmware. elf: an rv32im_zba ELF image.
+pub const Program = struct {
+    kind: enum { calc, elf, graph },
+    bytes: []const u8,
+};
+
+/// Why a frontend or backend declines; the model's own continuation then stands (nothing is owned).
+pub const Abstain = enum { language, unsupported, syntax, name, too_long, too_big, context };
+
+pub const Translation = union(enum) { program: Program, abstain: Abstain };
+
+/// Code text to a circuit program, or an abstain; pure and deterministic, the result allocated from `a`.
+pub const Frontend = struct {
+    ctx: ?*anyopaque = null,
+    translate: *const fn (ctx: ?*anyopaque, a: Allocator, cell: Cell) Allocator.Error!Translation,
+};
+
+pub const Status = enum {
+    /// The program halted; `out` is everything it printed.
+    ok,
+    /// The run declined (the backend's own reasons); the model's continuation stands.
+    abstain,
+    /// The step budget ran out before the halt; `out` is what was printed so far.
+    budget,
+    /// The machine faulted (illegal instruction, bad access); `out` is what was printed so far.
+    fault,
+};
+
+/// A finished run. status, out and steps are a pure function of the program; exec_ns is reporting only.
+pub const Result = struct {
+    status: Status,
+    out: []const u8 = "",
+    steps: u64 = 0,
+    exec_ns: u64 = 0,
+    abstain: ?Abstain = null,
+};
+
+pub const JobId = u64;
+pub const Poll = union(enum) { running, done: Result };
+
+/// Runs programs off the engine thread. Every call comes from the one engine host thread; none blocks on a run.
+pub const Backend = struct {
+    ctx: *anyopaque,
+    vtable: *const VTable,
+
+    pub const VTable = struct {
+        /// Starts `program` for engine stream `stream` (the backend copies it); Busy when no slot is free now.
+        start: *const fn (ctx: *anyopaque, stream: u64, program: Program, budget: u64) error{ OutOfMemory, Busy }!JobId,
+        /// .done once, then the job is gone; `out` stays valid until the next call for the same stream.
+        poll: *const fn (ctx: *anyopaque, job: JobId) Poll,
+        /// Stops a job (its result is never wanted); a later poll of it is undefined.
+        cancel: *const fn (ctx: *anyopaque, job: JobId) void,
+        /// The stream ended: drop its jobs, machines and buffers.
+        release: *const fn (ctx: *anyopaque, stream: u64) void,
+        /// On the calling thread: the run's result if it ends within `quick` steps, else null (start it then).
+        now: ?*const fn (ctx: *anyopaque, program: Program, budget: u64, quick: u64) ?Result = null,
+    };
+
+    pub fn start(b: Backend, stream: u64, program: Program, budget: u64) error{ OutOfMemory, Busy }!JobId {
+        return b.vtable.start(b.ctx, stream, program, budget);
+    }
+    pub fn poll(b: Backend, job: JobId) Poll {
+        return b.vtable.poll(b.ctx, job);
+    }
+    pub fn cancel(b: Backend, job: JobId) void {
+        b.vtable.cancel(b.ctx, job);
+    }
+    pub fn release(b: Backend, stream: u64) void {
+        b.vtable.release(b.ctx, stream);
+    }
+    /// A started job's result, when the backend runs it here within `quick` steps (`out` lives to the next call).
+    pub fn now(b: Backend, program: Program, budget: u64, quick: u64) ?Result {
+        const f = b.vtable.now orelse return null;
+        return f(b.ctx, program, budget, quick);
+    }
+};
+
+/// How one machine run ended (the circuit evaluator's contract, CPU and CUDA alike).
+pub const RunEnd = struct {
+    end: enum { halted, budget, cancelled, fault },
+    steps: u64,
+};
+
+test "the contract types compose" {
+    const t: Translation = .{ .program = .{ .kind = .calc, .bytes = "2*3" } };
+    try std.testing.expectEqual(.calc, t.program.kind);
+    const r: Result = .{ .status = .abstain, .abstain = .syntax };
+    try std.testing.expect(r.out.len == 0 and r.abstain.? == .syntax);
+}
diff --git a/zig/src/core/runner_circuit.zig b/zig/src/core/runner_circuit.zig
new file mode 100644
index 000000000..88fbcb0e4
--- /dev/null
+++ b/zig/src/core/runner_circuit.zig
@@ -0,0 +1,128 @@
+//! The R1 machine: a compiled circuit booted from its snapshot plus a program, stepped one trace token at a time.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const model = @import("runner_circuit_model.zig");
+const eval = @import("runner_circuit_eval.zig");
+const state_mod = @import("runner_circuit_state.zig");
+const elf = @import("runner_circuit_elf.zig");
+
+pub const Circuit = model.Circuit;
+pub const State = state_mod.State;
+const Allocator = std.mem.Allocator;
+
+/// Monotonic nanoseconds, for exec_ns and rates only (never for results).
+pub fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+/// Steps between cancel checks.
+pub const cancel_every: u64 = 4096;
+
+pub const Machine = struct {
+    state: State,
+    next: u32,
+    halted: bool = false,
+    faulted: bool = false,
+
+    /// The circuit's boot snapshot with `program` loaded as data; the computing is the weights'.
+    pub fn boot(gpa: Allocator, c: *const Circuit, program: api.Program) !Machine {
+        var s = try State.init(gpa, c);
+        errdefer s.deinit();
+        switch (program.kind) {
+            .calc => {
+                if (c.program.kind != .calc) return error.CircuitNotCalc;
+                try patchInput(&s, program.bytes);
+            },
+            .elf => try elf.load(&s, program.bytes),
+            .graph => return error.CircuitProgramKind, // graph packets run on the graph backend (T1)
+        }
+        return .{ .state = s, .next = c.go };
+    }
+
+    pub fn deinit(m: *Machine, gpa: Allocator) void {
+        _ = gpa;
+        m.state.deinit();
+        m.* = undefined;
+    }
+
+    /// Up to `budget` more steps, until HALT or `cancel`; BYTE payloads below 256 go to `out`, each token to `trace`.
+    pub fn run(m: *Machine, budget: u64, out: *std.ArrayList(u8), trace: ?*std.ArrayList(u32), cancel: *const std.atomic.Value(bool)) !api.RunEnd {
+        const c = m.state.circuit;
+        const gpa = m.state.gpa;
+        var steps: u64 = 0;
+        while (!m.halted) : (steps += 1) {
+            if (steps == budget) return .{ .end = .budget, .steps = steps };
+            if (steps % cancel_every == 0 and cancel.load(.acquire)) return .{ .end = .cancelled, .steps = steps };
+            const t = try eval.step(&m.state, m.next);
+            if (trace) |tr| try tr.append(gpa, t);
+            const fam, const pay = c.split(t).?;
+            if (fam == c.byte_family and pay < 256) try out.append(gpa, @intCast(pay));
+            if (c.fault_family) |f| m.faulted = m.faulted or fam == f;
+            m.halted = t == c.halt;
+            m.next = t;
+        }
+        return .{ .end = if (m.faulted) .fault else .halted, .steps = steps };
+    }
+
+    /// Canonical bytes of the full state: the tables, channel histories and step count, then the next input token.
+    pub fn snapshot(m: *const Machine, gpa: Allocator) ![]u8 {
+        const body = try m.state.canonical(gpa);
+        defer gpa.free(body);
+        const out = try gpa.alloc(u8, body.len + 4);
+        @memcpy(out[0..body.len], body);
+        std.mem.writeInt(u32, out[body.len..][0..4], m.next, .little);
+        return out;
+    }
+};
+
+/// Writes the calc expression and its NUL at the firmware's input address, as calc.machine patches RAM.
+pub fn patchInput(s: *State, text: []const u8) !void {
+    const p = s.circuit.program;
+    if (std.mem.indexOfScalar(u8, text, 0) != null) return error.CircuitInputNul;
+    if (text.len + 1 > p.input_capacity) return error.CircuitInputTooLong;
+    for (0..text.len + 1) |i| {
+        const addr = p.input_address + @as(u32, @intCast(i));
+        const byte: u32 = if (i < text.len) text[i] else 0;
+        const shift: u5 = @intCast(8 * (addr & 3));
+        const word = try readWord(s, addr >> 2);
+        try writeWord(s, addr >> 2, word & ~(@as(u32, 0xff) << shift) | byte << shift);
+    }
+}
+
+const RamRow = struct { table: u32, row: u32 };
+
+/// RAM word wi lives in head ram<h>, h = (wi & 15) | (wi >> 12) << 4, value head (wi >> 4) & 1, row (wi >> 5) & 127.
+fn ramRow(s: *const State, wi: u32) !RamRow {
+    if (wi >= 1 << 13) return error.CircuitRamAddress;
+    const base = s.circuit.program.ram_tables[(wi & 15) | (wi >> 12) << 4];
+    if (base == std.math.maxInt(u32)) return error.CircuitRamTables;
+    return .{ .table = base + (wi >> 4 & 1), .row = wi >> 5 & 127 };
+}
+
+pub fn readWord(s: *State, wi: u32) !u32 {
+    const at = try ramRow(s, wi);
+    if (!s.rowPresent(at.table, at.row)) return 0;
+    const r = s.row(at.table, at.row);
+    var word: u32 = 0;
+    for (0..32) |i| {
+        const v = r[2 + i];
+        if (v == s.circuit.program.a_bit) word |= @as(u32, 1) << @intCast(i) else if (v != 0) return error.CircuitRamRow;
+    }
+    return word;
+}
+
+/// A nonzero word carries the ballast in columns 0 and 1 and A_BIT per set bit in columns 2..33; zero is absent.
+pub fn writeWord(s: *State, wi: u32, word: u32) !void {
+    const at = try ramRow(s, wi);
+    s.force = true;
+    if (word == 0) return s.clearRow(at.table, at.row);
+    var r: [model.hd]model.Scalar = @splat(0);
+    r[0] = s.circuit.program.a_ref;
+    r[1] = s.circuit.program.a_ref;
+    for (0..32) |i| if (word >> @intCast(i) & 1 == 1) {
+        r[2 + i] = s.circuit.program.a_bit;
+    };
+    try s.writeRow(at.table, at.row, &r);
+}
diff --git a/zig/src/core/runner_circuit_backend.zig b/zig/src/core/runner_circuit_backend.zig
new file mode 100644
index 000000000..b29ae4378
--- /dev/null
+++ b/zig/src/core/runner_circuit_backend.zig
@@ -0,0 +1,238 @@
+//! The CPU Backend: each job boots a fresh machine on its own worker thread; the engine thread never waits on a run.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const rc = @import("runner_circuit.zig");
+const place = @import("runner_place.zig");
+
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner_circuit);
+const too_long: [300]u8 = @splat('9');
+
+const Job = struct {
+    id: api.JobId,
+    stream: u64,
+    program: []u8,
+    kind: @FieldType(api.Program, "kind"),
+    budget: u64,
+    thread: ?std.Thread = null,
+    done: std.atomic.Value(bool) = .init(false),
+    cancel: std.atomic.Value(bool) = .init(false),
+    result: api.Result = .{ .status = .abstain, .abstain = .unsupported },
+    out: std.ArrayList(u8) = .empty,
+};
+
+const Cpu = struct {
+    gpa: Allocator,
+    circuit: *const rc.Circuit,
+    workers: u8,
+    placer: ?*place.Placer = null,
+    next_id: api.JobId = 1,
+    jobs: std.ArrayList(*Job) = .empty,
+    dropped: std.ArrayList(*Job) = .empty,
+    delivered: std.ArrayList(*Job) = .empty,
+
+    fn live(c: *Cpu) usize {
+        return c.jobs.items.len + c.dropped.items.len;
+    }
+
+    fn free(c: *Cpu, j: *Job) void {
+        if (j.thread) |t| t.join();
+        j.out.deinit(c.gpa);
+        c.gpa.free(j.program);
+        c.gpa.destroy(j);
+    }
+
+    /// Joins and frees cancelled jobs whose worker has stopped.
+    fn reap(c: *Cpu) void {
+        var i: usize = 0;
+        while (i < c.dropped.items.len) {
+            const j = c.dropped.items[i];
+            if (!j.done.load(.acquire)) {
+                i += 1;
+                continue;
+            }
+            _ = c.dropped.swapRemove(i);
+            c.free(j);
+        }
+    }
+
+    /// `out` of a stream's previous result stays valid only until the next call for that stream.
+    fn forget(c: *Cpu, stream: u64) void {
+        var i: usize = 0;
+        while (i < c.delivered.items.len) {
+            if (c.delivered.items[i].stream != stream) {
+                i += 1;
+                continue;
+            }
+            c.free(c.delivered.swapRemove(i));
+        }
+    }
+
+    fn find(c: *Cpu, id: api.JobId) ?usize {
+        for (c.jobs.items, 0..) |j, i| if (j.id == id) return i;
+        return null;
+    }
+
+    fn drop(c: *Cpu, i: usize) void {
+        const j = c.jobs.swapRemove(i);
+        j.cancel.store(true, .release);
+        c.dropped.append(c.gpa, j) catch {
+            if (j.thread) |t| t.join();
+            c.free(j);
+        };
+    }
+};
+
+fn work(c: *Cpu, j: *Job) void {
+    defer j.done.store(true, .release);
+    if (c.placer) |p| p.enter();
+    const t0 = rc.nowNs();
+    var m = rc.Machine.boot(c.gpa, c.circuit, .{ .kind = j.kind, .bytes = j.program }) catch |e| {
+        j.result = .{ .status = .abstain, .abstain = switch (e) {
+            error.CircuitInputTooLong => .too_long,
+            error.CircuitInputNul => .syntax,
+            else => .unsupported,
+        } };
+        if (e != error.CircuitInputTooLong) log.warn("circuit boot refused: {s}", .{@errorName(e)});
+        return;
+    };
+    defer m.deinit(c.gpa);
+    const end = m.run(j.budget, &j.out, null, &j.cancel) catch |e| {
+        log.warn("circuit run failed after {d} steps: {s}", .{ m.state.steps, @errorName(e) });
+        j.result = .{ .status = .abstain, .abstain = .unsupported, .steps = m.state.steps };
+        return;
+    };
+    j.result = .{
+        .status = switch (end.end) {
+            .halted => .ok,
+            .budget => .budget,
+            .fault => .fault,
+            .cancelled => .abstain,
+        },
+        .steps = end.steps,
+        .exec_ns = rc.nowNs() - t0,
+        .abstain = if (end.end == .cancelled) .unsupported else null,
+    };
+}
+
+fn start(ctx: *anyopaque, stream: u64, program: api.Program, budget: u64) error{ OutOfMemory, Busy }!api.JobId {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    c.forget(stream);
+    if (c.live() >= c.workers) return error.Busy;
+    const j = try c.gpa.create(Job);
+    errdefer c.gpa.destroy(j);
+    const bytes = try c.gpa.dupe(u8, program.bytes);
+    errdefer c.gpa.free(bytes);
+    j.* = .{ .id = c.next_id, .stream = stream, .program = bytes, .kind = program.kind, .budget = budget };
+    try c.jobs.ensureUnusedCapacity(c.gpa, 1);
+    j.thread = std.Thread.spawn(.{}, work, .{ c, j }) catch return error.Busy;
+    c.jobs.appendAssumeCapacity(j);
+    c.next_id += 1;
+    return j.id;
+}
+
+fn poll(ctx: *anyopaque, id: api.JobId) api.Poll {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    const i = c.find(id) orelse return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    const j = c.jobs.items[i];
+    if (!j.done.load(.acquire)) return .running;
+    _ = c.jobs.swapRemove(i);
+    if (j.thread) |t| t.join();
+    j.thread = null;
+    c.forget(j.stream);
+    c.delivered.append(c.gpa, j) catch {
+        c.free(j);
+        return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    };
+    var r = j.result;
+    r.out = j.out.items;
+    return .{ .done = r };
+}
+
+fn cancel(ctx: *anyopaque, id: api.JobId) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    if (c.find(id)) |i| c.drop(i);
+    c.reap();
+}
+
+fn release(ctx: *anyopaque, stream: u64) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    var i: usize = 0;
+    while (i < c.jobs.items.len) {
+        if (c.jobs.items[i].stream == stream) c.drop(i) else i += 1;
+    }
+    c.forget(stream);
+    c.reap();
+}
+
+const vtable: api.Backend.VTable = .{ .start = start, .poll = poll, .cancel = cancel, .release = release };
+
+/// A CPU backend running at most `workers` machines at once over a circuit the caller keeps alive.
+pub fn backend(gpa: Allocator, circuit: *const rc.Circuit, workers: u8) !api.Backend {
+    return placed(gpa, circuit, workers, null);
+}
+
+/// As `backend`, each job's thread placed by `placer` (which the caller keeps alive) before it boots a machine.
+pub fn placed(gpa: Allocator, circuit: *const rc.Circuit, workers: u8, placer: ?*place.Placer) !api.Backend {
+    if (workers == 0) return error.NoWorkers;
+    const c = try gpa.create(Cpu);
+    c.* = .{ .gpa = gpa, .circuit = circuit, .workers = workers, .placer = placer };
+    return .{ .ctx = c, .vtable = &vtable };
+}
+
+/// Cancels every job, waits for the workers and frees the backend.
+pub fn destroy(b: api.Backend) void {
+    const c: *Cpu = @ptrCast(@alignCast(b.ctx));
+    for (c.jobs.items) |j| j.cancel.store(true, .release);
+    for ([_]*std.ArrayList(*Job){ &c.jobs, &c.dropped, &c.delivered }) |list| {
+        for (list.items) |j| c.free(j);
+        list.deinit(c.gpa);
+    }
+    c.gpa.destroy(c);
+}
+
+test "the backend runs jobs off the caller's thread, reports Busy at its worker limit and frees on release" {
+    const tiny = @import("runner_circuit_tiny_test.zig");
+    const gpa = std.testing.allocator;
+    const bytes = try tiny.build(gpa, .good);
+    defer gpa.free(bytes);
+    var circuit = try @import("runner_circuit_load.zig").fromBytes(gpa, bytes);
+    defer circuit.deinit(gpa);
+    const b = try backend(gpa, &circuit, 1);
+    defer destroy(b);
+    const id = try b.start(7, .{ .kind = .calc, .bytes = "1+1" }, 100);
+    try std.testing.expectError(error.Busy, b.start(8, .{ .kind = .calc, .bytes = "2" }, 100));
+    var result: api.Result = undefined;
+    while (true) switch (b.poll(id)) {
+        .running => std.Thread.yield() catch {},
+        .done => |r| {
+            result = r;
+            break;
+        },
+    };
+    try std.testing.expectEqual(api.Status.ok, result.status);
+    try std.testing.expectEqualStrings("hi", result.out);
+    try std.testing.expectEqual(@as(u64, 3), result.steps);
+    const capped = try b.start(8, .{ .kind = .calc, .bytes = "" }, 1);
+    while (true) switch (b.poll(capped)) {
+        .running => std.Thread.yield() catch {},
+        .done => |r| {
+            try std.testing.expectEqual(api.Status.budget, r.status);
+            try std.testing.expectEqualStrings("h", r.out);
+            break;
+        },
+    };
+    const long = try b.start(9, .{ .kind = .calc, .bytes = &too_long }, 100);
+    while (true) switch (b.poll(long)) {
+        .running => std.Thread.yield() catch {},
+        .done => |r| {
+            try std.testing.expectEqual(api.Abstain.too_long, r.abstain.?);
+            break;
+        },
+    };
+    b.release(7);
+    b.release(8);
+    b.release(9);
+}
