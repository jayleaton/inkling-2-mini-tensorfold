index 000000000..f8df16d88
--- /dev/null
+++ b/zig/src/core/runner_trace_text.zig
@@ -0,0 +1,548 @@
+//! The runner's `trace` form: sentence, definition, statement-phrase and hand-trace cue predicates over one line.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub fn isWord(c: u8) bool {
+    return std.ascii.isAlphanumeric(c) or c == '_';
+}
+
+pub fn isSpace(c: u8) bool {
+    return c == ' ' or c == '\t' or c == '\r';
+}
+
+/// Case-insensitive `words` at `i`, separated by one or more spaces; the end index, else null.
+pub fn seq(s: []const u8, i: usize, words: []const []const u8) ?usize {
+    var j = i;
+    for (words, 0..) |w, k| {
+        if (k > 0) {
+            const from = j;
+            while (j < s.len and isSpace(s[j])) j += 1;
+            if (j == from) return null;
+        }
+        if (j + w.len > s.len or !std.ascii.eqlIgnoreCase(s[j .. j + w.len], w)) return null;
+        j += w.len;
+    }
+    return j;
+}
+
+pub fn wordAt(s: []const u8, i: usize, w: []const u8, whole: bool) bool {
+    if (i > 0 and isWord(s[i - 1])) return false;
+    if (i + w.len > s.len or !std.ascii.eqlIgnoreCase(s[i .. i + w.len], w)) return false;
+    return !whole or i + w.len == s.len or !isWord(s[i + w.len]);
+}
+
+fn anyWord(s: []const u8, words: []const []const u8, whole: bool) bool {
+    for (0..s.len) |i| for (words) |w| if (wordAt(s, i, w, whole)) return true;
+    return false;
+}
+
+/// Doubt or approximation near a number: ? ~ ≈, 1.2e20, maybe/known/wait/around, approx…/estimate…/guess….
+pub fn approx(s: []const u8) bool {
+    if (std.mem.indexOfAny(u8, s, "?~") != null or std.mem.indexOf(u8, s, "≈") != null) return true;
+    for (0..s.len) |i| {
+        if (!std.ascii.isDigit(s[i])) continue;
+        var j = i + 1;
+        if (j < s.len and s[j] == '.') j += 1;
+        while (j < s.len and std.ascii.isDigit(s[j])) j += 1;
+        if (j + 1 < s.len and (s[j] == 'e' or s[j] == 'E') and std.ascii.isDigit(s[j + 1])) return true;
+    }
+    return anyWord(s, &.{ "maybe", "known", "wait", "around" }, true) or anyWord(s, &.{ "approx", "estimate", "guess" }, false);
+}
+
+/// A sentence with a question or a hypothesis (if/suppose/would/could/…) defines nothing.
+pub fn hypothetical(s: []const u8) bool {
+    if (std.mem.indexOfScalar(u8, s, '?') != null) return true;
+    const t = std.mem.trimStart(u8, s, " \t");
+    for ([_][]const u8{ "if", "suppose", "assume", "maybe", "wait", "perhaps" }) |w| if (wordAt(t, 0, w, true)) return true;
+    return anyWord(s, &.{ "maybe", "would", "could", "should", "might", "if" }, true);
+}
+
+/// The sentence of `clean` around byte `i` (ends at ". ", "? " or "! ").
+pub fn sentenceAt(clean: []const u8, i: usize) []const u8 {
+    var a: usize = 0;
+    for ([_][]const u8{ ". ", "? ", "! " }) |sep| {
+        if (std.mem.lastIndexOf(u8, clean[0..i], sep)) |k| a = @max(a, k + 2);
+    }
+    var b: usize = clean.len;
+    for ([_][]const u8{ ". ", "? ", "! " }) |sep| {
+        if (std.mem.indexOfPos(u8, clean, i, sep)) |k| b = @min(b, k + 1);
+    }
+    return clean[@min(a, b)..b];
+}
+
+/// Drops digit-count notes ("(20 digits?)", "(30 nines)", "(7 groups)") and the spaces before them.
+pub fn stripNotes(a: Allocator, raw: []const u8) Allocator.Error![]const u8 {
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 0;
+    while (i < raw.len) {
+        if (raw[i] == '(') if (std.mem.indexOfScalarPos(u8, raw, i + 1, ')')) |close| {
+            const inner = raw[i + 1 .. close];
+            if (std.mem.indexOfScalar(u8, inner, '(') == null and isNote(inner)) {
+                while (out.items.len > 0 and isSpace(out.items[out.items.len - 1])) out.items.len -= 1;
+                i = close + 1;
+                continue;
+            }
+        };
+        try out.append(a, raw[i]);
+        i += 1;
+    }
+    return out.items;
+}
+
+fn isNote(inner: []const u8) bool {
+    for (0..inner.len) |i| {
+        if (wordAt(inner, i, "digit", true) or wordAt(inner, i, "digits", true)) return true;
+        if (wordAt(inner, i, "group", true) or wordAt(inner, i, "groups", true)) return true;
+    }
+    var j: usize = 0;
+    while (j < inner.len and std.ascii.isDigit(inner[j])) j += 1;
+    if (j == 0) return false;
+    const k = j;
+    while (j < inner.len and isSpace(inner[j])) j += 1;
+    return j > k and std.mem.eql(u8, inner[j..], "nines");
+}
+
+/// A hand trace starts here: a step, table or digit line, or words like long division, carry, borrow, by hand.
+pub fn cueIn(s: []const u8) bool {
+    var i: usize = 0;
+    while (i < s.len and isSpace(s[i])) i += 1;
+    for ([_][]const u8{ "so", "now" }) |w| if (seq(s, i, &.{w})) |j| if (j < s.len and isSpace(s[j])) {
+        i = j;
+        while (i < s.len and isSpace(s[i])) i += 1;
+        break;
+    };
+    if (i < s.len and std.ascii.isDigit(s[i])) return true;
+    if (wordAt(s, i, "step", true) or wordAt(s, i, "start", true) or (seq(s, i, &.{"first,"}) != null)) return true;
+    if (i < s.len and (s[i] == 'i' or s[i] == 'I')) {
+        var j = i + 1;
+        while (j < s.len and isSpace(s[j])) j += 1;
+        if (j < s.len and s[j] == '=') {
+            j += 1;
+            while (j < s.len and isSpace(s[j])) j += 1;
+            if (j < s.len and s[j] == '0' and (j + 1 == s.len or !isWord(s[j + 1]))) return true;
+        }
+    }
+    if (seq(s, i, &.{"row"})) |j| {
+        var k = j;
+        while (k < s.len and isSpace(s[k])) k += 1;
+        if (k < s.len and s[k] == '0' and (k + 1 == s.len or !isWord(s[k + 1]))) return true;
+    }
+    const phrases = [_][]const []const u8{
+        &.{ "long", "division" },   &.{ "partial", "product" }, &.{ "repeated", "squaring" },
+        &.{ "step", "by", "step" }, &.{ "by", "hand" },
+    };
+    const lets = [_][]const u8{ "compute", "calculate", "do", "multiply", "perform", "use", "divide", "subtract", "add", "square" };
+    for (0..s.len) |k| {
+        for (phrases) |p| if (seq(s, k, p) != null) return true;
+        for ([_][]const u8{ "carry", "carries" }) |w| if (wordAt(s, k, w, true)) return true;
+        for ([_][]const u8{ "group", "borrow", "manual" }) |w| if (wordAt(s, k, w, false)) return true;
+        if (wordAt(s, k, "base", false)) {
+            var j = k + 4;
+            while (j < s.len and isSpace(s[j])) j += 1;
+            for ([_][]const u8{ "1000", "10^", "1e", "10**" }) |b| if (std.mem.startsWith(u8, s[j..], b)) return true;
+        }
+        for ([_][]const u8{ "let's", "lets" }) |l| for (lets) |v| if (seq(s, k, &.{ l, v }) != null) return true;
+        for ([_][]const u8{ "carefully", "exactly", "step" }) |v| if (seq(s, k, &.{ "compute", v }) != null) return true;
+        for ([_][]const u8{ "use", "perform", "do", "compute" }) |v| if (seq(s, k, &.{ "we", "can", v }) != null) return true;
+    }
+    return false;
+}
+
+// ---- definitions ----
+
+pub const Def = struct { start: usize, name_end: usize, rhs: usize };
+
+pub fn nameLen(s: []const u8, i: usize) usize {
+    if (i >= s.len or !std.ascii.isUpper(s[i])) return 0;
+    var j = i + 1;
+    if (j < s.len and std.ascii.isAlphabetic(s[j])) j += 1;
+    if (j < s.len and std.ascii.isDigit(s[j])) j += 1;
+    return j - i;
+}
+
+/// `Name = ` at `i` (not inside a word, a comma group or a decimal).
+pub fn defAt(s: []const u8, i: usize) ?Def {
+    if (i > 0 and (isWord(s[i - 1]) or s[i - 1] == ',' or s[i - 1] == '.')) return null;
+    const n = nameLen(s, i);
+    if (n == 0) return null;
+    var j = i + n;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    if (j >= s.len or s[j] != '=') return null;
+    j += 1;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    return .{ .start = i, .name_end = i + n, .rhs = j };
+}
+
+/// The name starts a definition: it does not follow an operator, `=`, a closing bracket or a digit ("A * B = …").
+pub fn defLeftOk(left: []const u8) bool {
+    const l = std.mem.trimEnd(u8, left, " \t");
+    if (l.len == 0) return true;
+    const c = l[l.len - 1];
+    if (std.ascii.isDigit(c) or std.mem.indexOfScalar(u8, "+-*/^=)]>", c) != null) return false;
+    return !std.mem.endsWith(u8, l, "×");
+}
+
+/// `Name =` here assigns the name (a label, `Let` or a digit may lead: "Step3 N = …"); after an operator it states one.
+pub fn assignLeft(left: []const u8) bool {
+    const l = std.mem.trimEnd(u8, left, " \t");
+    if (l.len == 0) return true;
+    if (std.mem.indexOfScalar(u8, "+-*/^=", l[l.len - 1]) != null) return false;
+    return !std.mem.endsWith(u8, l, "×");
+}
+
+/// The shortest right side followed by a sentence end, ", ", " (", or " by|from|and|then|is|which|so|has".
+pub fn defEnd(s: []const u8, rhs: usize) ?usize {
+    var k = rhs + 1;
+    while (k <= s.len) : (k += 1) {
+        var j = k;
+        while (j < s.len and isSpace(s[j])) j += 1;
+        if (j == s.len) return k;
+        if ((s[j] == '.' or s[j] == ';') and (j + 1 == s.len or isSpace(s[j + 1]))) return k;
+        if (s[j] == ',' and j + 1 < s.len and isSpace(s[j + 1])) return k;
+        if (j > k and s[j] == '(') return k;
+        if (j > k) for ([_][]const u8{ "by", "from", "and", "then", "is", "which", "so", "has" }) |w| {
+            if (j + w.len <= s.len and std.mem.eql(u8, s[j .. j + w.len], w) and (j + w.len == s.len or !isWord(s[j + w.len]))) return k;
+        };
+    }
+    return null;
+}
+
+pub fn sentenceEndsAt(s: []const u8, k: usize) bool {
+    var j = k;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    return j == s.len or ((s[j] == '.' or s[j] == ';') and (j + 1 == s.len or isSpace(s[j + 1])));
+}
+
+// ---- statements ----
+
+pub const Head = struct {
+    end: usize,
+    bare: bool = false,
+    pub fn less(_: void, x: Head, y: Head) bool {
+        return x.end < y.end;
+    }
+};
+
+/// need / we need / need to / let's / compute / calculate / evaluate / expression, then optionally a verb.
+pub fn goalHeads(a: Allocator, s: []const u8, out: *std.ArrayList(Head)) Allocator.Error!void {
+    const heads = [_][]const []const u8{ &.{ "we", "need", "to" }, &.{ "we", "need" }, &.{ "need", "to" }, &.{"need"}, &.{"let's"}, &.{"lets"}, &.{"compute"}, &.{"calculate"}, &.{"evaluate"}, &.{"expression"} };
+    var i: usize = 0;
+    while (i < s.len) {
+        if (i > 0 and !(isSpace(s[i - 1]) or s[i - 1] == '.' or s[i - 1] == ':' or s[i - 1] == ';')) {
+            i += 1;
+            continue;
+        }
+        var end: ?usize = null;
+        for (heads) |h| if (seq(s, i, h)) |j| if (j == s.len or !isWord(s[j])) {
+            end = j;
+            break;
+        };
+        var j = end orelse {
+            i += 1;
+            continue;
+        };
+        for ([_][]const u8{ "compute", "calculate", "evaluate", "find", "to" }) |v| {
+            var k = j;
+            while (k < s.len and isSpace(s[k])) k += 1;
+            if (k > j and seq(s, k, &.{v}) != null and k + v.len < s.len and isSpace(s[k + v.len])) {
+                j = k + v.len;
+                break;
+            }
+        }
+        const after = j;
+        while (j < s.len and isSpace(s[j])) j += 1;
+        if (j == after) {
+            i += 1;
+            continue;
+        }
+        try out.append(a, .{ .end = j });
+        i = j;
+    }
+}
+
+/// A sentence that is only an expression: a digit or `(` to a digit or `)` before ". " (`commas`: thousands groups).
+pub fn bareHeads(a: Allocator, s: []const u8, commas: bool, out: *std.ArrayList(Head)) Allocator.Error!void {
+    var i: usize = 0;
+    while (i < s.len) : (i += 1) {
+        if (!(i == 0 or (i >= 2 and s[i - 2] == '.' and s[i - 1] == ' '))) continue;
+        if (!(std.ascii.isDigit(s[i]) or s[i] == '(')) continue;
+        var j = i;
+        while (j < s.len) {
+            const c = s[j];
+            if (std.ascii.isAlphanumeric(c) or std.mem.indexOfScalar(u8, "^*+-() ", c) != null) {
+                j += 1;
+            } else if (commas and thousandsAt(s, j)) {
+                j += 1;
+            } else if (std.mem.startsWith(u8, s[j..], "×")) {
+                j += 2;
+            } else if (std.mem.startsWith(u8, s[j..], "−")) {
+                j += 3;
+            } else break;
+        }
+        if (j > i and j < s.len and s[j] == '.' and (j + 1 == s.len or isSpace(s[j + 1])) and
+            (std.ascii.isDigit(s[j - 1]) or s[j - 1] == ')')) try out.append(a, .{ .end = i, .bare = true });
+    }
+}
+
+pub const Phrase = struct { kind: enum { divmod, mul, subfrom, expr, gcd, isqrt, edit }, parts: [2][2]usize = undefined, n: usize = 1, end: usize };
+
+const fill_words = [_][]const u8{ "the", "answer", "exact", "exactly", "value", "of", "integer", "decimal", "product", "sum", "difference", "result", "floor", "huge", "number", "big" };
+const trail_words = [_][]const u8{ "exactly", "exact", "accurately", "carefully", "precisely", "manually" };
+
+/// The phrase a head introduces, up to the first sentence end (`.,;:` then a space, or the line's end; `whole`: named).
+pub fn phrase(rest: []const u8, whole: bool) ?Phrase {
+    var i: usize = 0;
+    var n: usize = 0;
+    var integral = false; // "integer" or "floor" read: a square root is isqrt's
+    while (n < 4) : (n += 1) {
+        var hit = false;
+        for (fill_words) |w| if (seq(rest, i, &.{w})) |j| if (j < rest.len and isSpace(rest[j])) {
+            integral = integral or std.mem.eql(u8, w, "integer") or std.mem.eql(u8, w, "floor");
+            i = j;
+            while (i < rest.len and isSpace(rest[i])) i += 1;
+            hit = true;
+            break;
+        };
+        if (!hit) break;
+    }
+    if (verbPhrase(rest, i, "divide", &.{"by"})) |p| return .{ .kind = .divmod, .parts = p.parts, .n = 2, .end = p.end };
+    if (verbPhrase(rest, i, "multiply", &.{ "by", "and", "with" })) |p| return .{ .kind = .mul, .parts = p.parts, .n = 2, .end = p.end };
+    if (multiplyDefs(rest, i)) |p| return .{ .kind = .mul, .parts = p.parts, .n = 2, .end = p.end };
+    if (verbPhrase(rest, i, "subtract", &.{"from"})) |p| return .{ .kind = .subfrom, .parts = p.parts, .n = 2, .end = p.end };
+    if (whole) if (gcdCall(rest, i)) |p| return .{ .kind = .gcd, .parts = p.parts, .n = 2, .end = p.end };
+    if (whole) if (gcdOf(rest, i)) |p| return .{ .kind = .gcd, .parts = p.parts, .n = 2, .end = p.end };
+    if (whole) if (isqrtOf(rest, i, integral)) |p| return .{ .kind = .isqrt, .parts = p.parts, .end = p.end };
+    if (whole) if (editDistance(rest, i)) |p| return .{ .kind = .edit, .parts = p.parts, .n = 2, .end = p.end };
+    const e = lazyEnd(rest, i) orelse return null;
+    return .{ .kind = .expr, .parts = .{ .{ i, e.text }, undefined }, .end = e.end };
+}
+
+const Two = struct { parts: [2][2]usize, end: usize };
+
+/// An optional `Name =` before an operand (case-insensitive name, as the census regex reads it).
+fn skipDef(s: []const u8, i: usize) usize {
+    if (i >= s.len or !std.ascii.isAlphabetic(s[i])) return i;
+    var j = i + 1;
+    if (j < s.len and std.ascii.isAlphabetic(s[j])) j += 1;
+    if (j < s.len and std.ascii.isDigit(s[j])) j += 1;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    if (j >= s.len or s[j] != '=') return i;
+    j += 1;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    return j;
+}
+
+/// `verb X <sep> Y`: X up to the first spaced separator word, Y up to the first sentence end.
+fn verbPhrase(s: []const u8, i: usize, verb: []const u8, seps: []const []const u8) ?Two {
+    var j = seq(s, i, &.{verb}) orelse return null;
+    const after = j;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    if (j == after) return null;
+    const x0 = skipDef(s, j);
+    var k = x0 + 1;
+    while (k < s.len) : (k += 1) {
+        if (!isSpace(s[k])) continue;
+        var m = k;
+        while (m < s.len and isSpace(s[m])) m += 1;
+        for (seps) |sep| {
+            if (m + sep.len < s.len and std.ascii.eqlIgnoreCase(s[m .. m + sep.len], sep) and isSpace(s[m + sep.len])) {
+                var y = m + sep.len;
+                while (y < s.len and isSpace(s[y])) y += 1;
+                y = skipDef(s, y);
+                const e = lazyEnd(s, y) orelse return null;
+                return .{ .parts = .{ .{ x0, k }, .{ y, e.text } }, .end = e.end };
+            }
+        }
+    }
+    return null;
+}
+
+/// `gcd(X, Y)` then a sentence end: X and Y split at the call's one top-level comma.
+fn gcdCall(s: []const u8, i: usize) ?Two {
+    const open = seq(s, i, &.{"gcd("}) orelse return null;
+    var depth: usize = 0;
+    var comma: ?usize = null;
+    var k = open;
+    while (k < s.len) : (k += 1) {
+        switch (s[k]) {
+            '(' => depth += 1,
+            ')' => {
+                if (depth == 0) break;
+                depth -= 1;
+            },
+            ',' => if (depth == 0) {
+                if (comma != null) return null; // three arguments, or a thousands comma: not one reading
+                comma = k;
+            },
+            else => {},
+        }
+    } else return null;
+    const c = comma orelse return null;
+    const e = endAt(s, k + 1) orelse return null;
+    return .{ .parts = .{ .{ open, c }, .{ c + 1, k } }, .end = e };
+}
+
+/// `gcd of X and Y` / `greatest common divisor of X, Y` then a sentence end: two literals, each maybe after `Name=`.
+fn gcdOf(s: []const u8, i: usize) ?Two {
+    var j = seq(s, i, &.{ "gcd", "of" }) orelse seq(s, i, &.{ "greatest", "common", "divisor", "of" }) orelse return null;
+    j = spaces(s, j) orelse return null;
+    const x = literal(s, skipDef(s, j)) orelse return null;
+    const comma = x[1] < s.len and s[x[1]] == ',';
+    const sep = spaces(s, x[1] + @intFromBool(comma)) orelse return null;
+    const y0 = if (comma) sep else spaces(s, seq(s, sep, &.{"and"}) orelse return null) orelse return null;
+    const y = literal(s, skipDef(s, y0)) orelse return null;
+    // "gcd of 12,345, 18" may be three numbers, as in gcd(12,345, 18): a comma splits only plain literals
+    if (comma and (std.mem.indexOfScalar(u8, s[x[0]..x[1]], ',') != null or std.mem.indexOfScalar(u8, s[y[0]..y[1]], ',') != null)) return null;
+    // a third argument after a comma ("gcd of 12, 18, 30") is not a gcd of two
+    var k = y[1];
+    while (k < s.len and isSpace(s[k])) k += 1;
+    if (k < s.len and s[k] == ',') return null;
+    const e = trailEnd(s, y[1]) orelse return null;
+    return .{ .parts = .{ x, y }, .end = e };
+}
+
+/// A decimal integer literal at `i` (thousands commas, not zero-led) that no word character continues.
+fn literal(s: []const u8, i: usize) ?[2]usize {
+    var j = i;
+    while (j < s.len and (std.ascii.isDigit(s[j]) or thousandsAt(s, j))) j += 1;
+    if (j == i or (s[i] == '0' and j > i + 1) or (j < s.len and isWord(s[j]))) return null;
+    return .{ i, j };
+}
+
+/// `isqrt(N)`, or `sqrt of N` / `square root of N` after "integer" or "floor" (bare, it may mean the real root).
+fn isqrtOf(s: []const u8, i: usize, integral: bool) ?Two {
+    var j: usize = undefined;
+    var call = false;
+    if (seq(s, i, &.{"isqrt("})) |k| {
+        j = k;
+        call = true;
+    } else if (integral) {
+        j = seq(s, i, &.{ "sqrt", "of" }) orelse seq(s, i, &.{ "square", "root", "of" }) orelse return null;
+        j = skipDef(s, spaces(s, j) orelse return null);
+    } else return null;
+    const x0 = j;
+    while (j < s.len and (std.ascii.isDigit(s[j]) or thousandsAt(s, j))) j += 1;
+    if (j == x0 or (j < s.len and isWord(s[j]))) return null;
+    const x1 = j;
+    if (call) {
+        if (j >= s.len or s[j] != ')') return null;
+        j += 1;
+    }
+    const e = trailEnd(s, j) orelse return null;
+    return .{ .parts = .{ .{ x0, x1 }, undefined }, .end = e };
+}
+
+/// The longest string an edit distance takes as written (the frontend refuses long ones on cost anyway).
+pub const max_edit = 32;
+
+/// `Levenshtein [distance]` or `edit distance`, [between|of|from] "A" and|to "B": quoted literals, not prose words.
+fn editDistance(s: []const u8, i: usize) ?Two {
+    var j = seq(s, i, &.{ "levenshtein", "distance" }) orelse seq(s, i, &.{ "edit", "distance" }) orelse
+        seq(s, i, &.{"levenshtein"}) orelse return null;
+    j = spaces(s, j) orelse return null;
+    for ([_][]const u8{ "between", "of", "from" }) |w| if (seq(s, j, &.{w})) |k| {
+        j = spaces(s, k) orelse return null;
+        break;
+    };
+    const x = quoted(s, j) orelse return null;
+    var k = spaces(s, x.end) orelse return null;
+    k = seq(s, k, &.{"and"}) orelse seq(s, k, &.{"to"}) orelse return null;
+    k = spaces(s, k) orelse return null;
+    const y = quoted(s, k) orelse return null;
+    const e = trailEnd(s, y.end) orelse return null;
+    return .{ .parts = .{ x.text, y.text }, .end = e };
+}
+
+/// A quoted literal at `i` ('…', "…", ‘…’ or “…”): its contents, printable ASCII without quotes or a backslash.
+fn quoted(s: []const u8, i: usize) ?struct { text: [2]usize, end: usize } {
+    const marks = [_][2][]const u8{ .{ "\"", "\"" }, .{ "'", "'" }, .{ "“", "”" }, .{ "‘", "’" } };
+    for (marks) |q| if (std.mem.startsWith(u8, s[i..], q[0])) {
+        const from = i + q[0].len;
+        const close = std.mem.indexOfPos(u8, s, from, q[1]) orelse return null;
+        if (close == from or close - from > max_edit) return null;
+        for (s[from..close]) |c| if (c < 0x20 or c > 0x7e or c == '"' or c == '\'' or c == '\\') return null;
+        return .{ .text = .{ from, close }, .end = close + q[1].len };
+    };
+    return null;
+}
+
+/// Past one or more spaces at `i`; null without one.
+fn spaces(s: []const u8, i: usize) ?usize {
+    var j = i;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    return if (j > i) j else null;
+}
+
+/// A sentence end at `k`, or after one trailer word ("exactly").
+fn trailEnd(s: []const u8, k: usize) ?usize {
+    if (endAt(s, k)) |e| return e;
+    const j = spaces(s, k) orelse return null;
+    for (trail_words) |w| if (seq(s, j, &.{w})) |t| if (endAt(s, t)) |e| return e;
+    return null;
+}
+
+/// `multiply A=x B=y`: two definitions side by side.
+fn multiplyDefs(s: []const u8, i: usize) ?Two {
+    var j = seq(s, i, &.{"multiply"}) orelse return null;
+    const after = j;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    if (j == after) return null;
+    const x0 = skipDef(s, j);
+    if (x0 == j) return null;
+    var k = x0 + 1;
+    while (k < s.len) : (k += 1) {
+        if (!isSpace(s[k])) continue;
+        var m = k;
+        while (m < s.len and isSpace(s[m])) m += 1;
+        const y = skipDef(s, m);
+        if (y == m) continue;
+        const e = lazyEnd(s, y) orelse return null;
+        return .{ .parts = .{ .{ x0, k }, .{ y, e.text } }, .end = e.end };
+    }
+    return null;
+}
+
+/// The shortest text from `i` (at least one byte) followed by an optional trailer word and a sentence end.
+fn lazyEnd(s: []const u8, i: usize) ?struct { text: usize, end: usize } {
+    var k = i + 1;
+    while (k <= s.len) : (k += 1) {
+        var j = k;
+        while (j < s.len and isSpace(s[j])) j += 1;
+        if (j > k) for (trail_words) |w| if (seq(s, j, &.{w})) |t| if (endAt(s, t)) |e| return .{ .text = k, .end = e };
+        if (endAt(s, k)) |e| return .{ .text = k, .end = e };
+    }
+    return null;
+}
+
+fn endAt(s: []const u8, k: usize) ?usize {
+    var j = k;
+    while (j < s.len and isSpace(s[j])) j += 1;
+    if (j == s.len) return j;
+    if (std.mem.indexOfScalar(u8, ".;:,", s[j]) != null and (j + 1 == s.len or isSpace(s[j + 1]))) {
+        return if (j + 1 < s.len) j + 2 else j + 1;
+    }
+    return null;
+}
+
+/// A thousands comma at `j`: a digit before it, exactly three digits after it.
+pub fn thousandsAt(s: []const u8, j: usize) bool {
+    if (j == 0 or j + 4 > s.len or s[j] != ',' or !std.ascii.isDigit(s[j - 1])) return false;
+    for (s[j + 1 .. j + 4]) |c| if (!std.ascii.isDigit(c)) return false;
+    return j + 4 == s.len or !std.ascii.isDigit(s[j + 4]);
+}
+
+/// "Compute D*349, D*350": a phrase ending in a comma before another candidate is a list, not one computation.
+pub fn listed(rest: []const u8, ph: Phrase) bool {
+    if (ph.end < 2 or rest[ph.end - 2] != ',') return false;
+    const w = rest[ph.end - 2 .. @min(rest.len, ph.end + 2)];
+    var j: usize = 1;
+    while (j < w.len and isSpace(w[j])) j += 1;
+    if (j < w.len and std.ascii.isDigit(w[j])) return true;
+    if (j < w.len and std.ascii.isUpper(w[j])) {
+        j += 1;
+        if (j < w.len and isWord(w[j])) j += 1;
+        while (j < w.len and isSpace(w[j])) j += 1;
+        return j < w.len and (w[j] == '*' or w[j] == 0xC3);
+    }
+    return false;
+}
diff --git a/zig/src/core/runner_trace_value.zig b/zig/src/core/runner_trace_value.zig
new file mode 100644
index 000000000..879a4065d
--- /dev/null
+++ b/zig/src/core/runner_trace_value.zig
@@ -0,0 +1,131 @@
+//! The runner's `trace` form: the integer value of a checked source, to tell a restated name from a reassigned one.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const Int = std.math.big.int.Managed;
+
+/// The widest value evaluated: a wider source is never called the same (the name it would keep is poisoned instead).
+const max_bits = 4096;
+
+/// `x` and `y` (sources over + - * ** % /, brackets, decimal and 0x literals) are one integer; `a` should be an arena.
+pub fn same(a: Allocator, x: []const u8, y: []const u8) Allocator.Error!bool {
+    const u = try value(a, x) orelse return false;
+    const v = try value(a, y) orelse return false;
+    return u.eql(v);
+}
+
+fn value(a: Allocator, s: []const u8) Allocator.Error!?Int {
+    var p: Eval = .{ .a = a, .s = s };
+    const v = p.sum() catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.Refused => return null,
+    };
+    return if (p.i == s.len) v else null;
+}
+
+/// Python's precedence: sum := term (+|- term)*; term := unary (*|%|/ unary)*; unary := -unary | atom [** digits].
+const Eval = struct {
+    a: Allocator,
+    s: []const u8,
+    i: usize = 0,
+
+    const Error = error{ OutOfMemory, Refused };
+
+    fn fail(e: anyerror) Error {
+        return if (e == error.OutOfMemory) error.OutOfMemory else error.Refused;
+    }
+
+    fn eat(p: *Eval, op: []const u8) bool {
+        if (!std.mem.startsWith(u8, p.s[p.i..], op)) return false;
+        p.i += op.len;
+        return true;
+    }
+
+    fn wide(v: Int) Error!Int {
+        return if (v.bitCountAbs() > max_bits) error.Refused else v;
+    }
+
+    fn sum(p: *Eval) Error!Int {
+        var v = try p.term();
+        while (p.i < p.s.len and (p.s[p.i] == '+' or p.s[p.i] == '-')) {
+            const plus = p.s[p.i] == '+';
+            p.i += 1;
+            const r = try p.term();
+            var out = Int.init(p.a) catch |e| return fail(e);
+            if (plus) out.add(&v, &r) catch |e| return fail(e) else out.sub(&v, &r) catch |e| return fail(e);
+            v = try wide(out);
+        }
+        return v;
+    }
+
+    fn term(p: *Eval) Error!Int {
+        var v = try p.unary();
+        while (p.i < p.s.len and (p.s[p.i] == '%' or p.s[p.i] == '/' or (p.s[p.i] == '*' and !std.mem.startsWith(u8, p.s[p.i..], "**")))) {
+            const op = p.s[p.i];
+            p.i += 1;
+            const r = try p.unary();
+            var out = Int.init(p.a) catch |e| return fail(e);
+            if (op == '*') {
+                out.mul(&v, &r) catch |e| return fail(e);
+            } else {
+                if (r.eqlZero()) return error.Refused;
+                var q = Int.init(p.a) catch |e| return fail(e);
+                q.divFloor(&out, &v, &r) catch |e| return fail(e); // Python's % takes the divisor's sign
+                if (op == '/') {
+                    if (!out.eqlZero()) return error.Refused; // a quotient only when nothing is left over
+                    out.swap(&q);
+                }
+            }
+            v = try wide(out);
+        }
+        return v;
+    }
+
+    fn unary(p: *Eval) Error!Int {
+        if (p.eat("-")) {
+            var v = try p.unary();
+            v.negate();
+            return v;
+        }
+        const base = try p.atom();
+        if (!p.eat("**")) return base;
+        const k0 = p.i;
+        while (p.i < p.s.len and std.ascii.isDigit(p.s[p.i])) p.i += 1;
+        const k = std.fmt.parseInt(u32, p.s[k0..p.i], 10) catch return error.Refused;
+        if (base.bitCountAbs() > 1 and @as(u64, base.bitCountAbs()) * k > max_bits + 64) return error.Refused;
+        var out = Int.init(p.a) catch |e| return fail(e);
+        out.pow(&base, k) catch |e| return fail(e);
+        return wide(out);
+    }
+
+    fn atom(p: *Eval) Error!Int {
+        if (p.eat("(")) {
+            const v = try p.sum();
+            if (!p.eat(")")) return error.Refused;
+            return v;
+        }
+        const hex = p.eat("0x");
+        const d0 = p.i;
+        while (p.i < p.s.len and (if (hex) std.ascii.isHex(p.s[p.i]) else std.ascii.isDigit(p.s[p.i]))) p.i += 1;
+        if (p.i == d0 or p.i - d0 > max_bits / 3) return error.Refused;
+        var v = Int.init(p.a) catch |e| return fail(e);
+        v.setString(if (hex) 16 else 10, p.s[d0..p.i]) catch |e| return fail(e);
+        return wide(v);
+    }
+};
+
+test "runner trace value: a restatement in another form is the same integer; a different value, a wide or bad one is not" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    try std.testing.expect(try same(a, "12345678901", "12000000000+345678901"));
+    try std.testing.expect(try same(a, "(0xFEDCBA98)*2**32+(0x76543210)", "18364758544493064720"));
+    try std.testing.expect(try same(a, "-7%3", "2")); // Python: the divisor's sign
+    try std.testing.expect(try same(a, "-2**2", "-4"));
+    try std.testing.expect(!try same(a, "280223976814164", "18364758544493064720"));
+    try std.testing.expect(!try same(a, "2**100000", "2**100000")); // too wide to evaluate: poisoned, never kept
+    try std.testing.expect(!try same(a, "5%0", "5"));
+    try std.testing.expect(!try same(a, "12+", "12"));
+    try std.testing.expect(try same(a, "(10**30-85)/97", "10309278350515463917525773195"));
+    try std.testing.expect(!try same(a, "(10**30-86)/97", "10309278350515463917525773195")); // not exact: refused
+    try std.testing.expect(!try same(a, "7/0", "0"));
+}
diff --git a/zig/src/core/steps_v1/runner_circuit_eval.zig b/zig/src/core/steps_v1/runner_circuit_eval.zig
new file mode 100644
index 000000000..5bef406c7
--- /dev/null
+++ b/zig/src/core/steps_v1/runner_circuit_eval.zig
@@ -0,0 +1,175 @@
+//! Exact CPU evaluation of one circuit step: token features, SwiGLU units, one-hot DeltaNet heads, output code.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const State = @import("runner_circuit_state.zig").State;
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+
+/// The residual a token starts from: dim 0 is one, each feature dim a function of the token's family and payload.
+pub fn embed(s: *State, token: u32) !void {
+    const c = s.circuit;
+    const fam, const pay = c.split(token) orelse return error.CircuitUnknownToken;
+    s.clearResidual();
+    s.x[0] = 1;
+    s.touch(0);
+    for (c.features) |f| {
+        const v = f.value(fam, pay, c.family_bits);
+        if (v == 0) continue;
+        s.x[f.dim] = v;
+        s.touch(f.dim);
+    }
+}
+
+/// Feeds one token through every batch in stored node order and returns the token the output code names.
+pub fn step(s: *State, token: u32) !u32 {
+    const c = s.circuit;
+    try embed(s, token);
+    for (c.batches) |*b| switch (b.*) {
+        .ffn => |*f| ffn(s, f),
+        .heads => |*h| try heads(s, h),
+    };
+    s.steps += 1;
+    return decode(c, s.x);
+}
+
+fn commit(s: *State, outs: []const model.Out, values: []const Scalar) void {
+    for (outs, values) |o, v| {
+        s.x[o.dim] = if (o.into) s.x[o.dim] + v else v;
+        s.touch(o.dim);
+    }
+}
+
+/// Silent units (gate <= 0) add exactly zero; each form's units are sorted by constant, so the walk stops early.
+fn ffn(s: *State, f: *const model.Ffn) void {
+    const y = s.work[0..f.outs.len];
+    const up = s.work[f.outs.len..][0..f.up.forms.outputs];
+    const gate = s.work[f.outs.len + up.len ..][0..f.gate.forms.outputs];
+    @memset(y, 0);
+    f.up.forms.apply(s.x, s.active.items, up);
+    f.gate.forms.apply(s.x, s.active.items, gate);
+    for (gate, f.starts[0 .. f.starts.len - 1], f.starts[1..]) |v, lo, hi| for (f.order[lo..hi]) |t| {
+        const g = f.gate.bias[t] + v;
+        if (!(g > 0)) break;
+        unit(f, t, g, up, y);
+    };
+    for (f.always) |t| unit(f, t, f.gate.bias[t], up, y);
+    commit(s, f.outs, y);
+}
+
+fn unit(f: *const model.Ffn, t: u32, g: Scalar, up: []const Scalar, y: []Scalar) void {
+    const uf = f.up.form[t];
+    const u = if (uf == model.no_form) f.up.bias[t] else f.up.bias[t] + up[uf];
+    y[f.slot[t]] += f.coef[t] * u * g;
+}
+
+fn heads(s: *State, h: *const model.Heads) !void {
+    const width = h.proj.columns();
+    const p = s.work[0..width];
+    const values = s.work[width..][0..h.outs.len];
+    const rest = s.work[width + h.outs.len ..];
+    const v = rest[2 * hd .. 3 * hd];
+    const z = rest[3 * hd .. 4 * hd];
+    const o = rest[4 * hd .. 5 * hd];
+    h.proj.eval(s.x, s.active.items, rest[5 * hd ..][0..h.proj.forms.outputs], p);
+    for (p[0..h.channels], h.taps, 0..) |*e, t, i| {
+        const past = s.channelHistory(h.first_channel + @as(u32, @intCast(i)));
+        const now = e.*;
+        e.* = @max(t[0] * now + t[1] * past[0] + t[2] * past[1] + t[3] * past[2], 0);
+        past[2] = past[1];
+        past[1] = past[0];
+        past[0] = now;
+    }
+    for (h.heads) |*head| {
+        var key: ?u32 = null;
+        for (head.k) |k| if (p[k.column] > 0) {
+            if (key != null) return error.CircuitKeyNotOneHot;
+            key = k.at;
+        };
+        var rows: [hd]u32 = undefined;
+        var n: usize = 0;
+        for (head.q) |q| if (p[q.column] > 0) {
+            rows[n] = q.at;
+            n += 1;
+        };
+        for (head.value_heads) |*vh| {
+            if (vh.a) |col| try decay(s, vh.table, p[col]);
+            if (key) |r| if (try writeEnabled(vh.beta, p)) {
+                scatter(vh.v, p, v, false);
+                try s.writeRow(vh.table, r, v);
+            };
+            const out = values[vh.out_first..][0..vh.out_cols.len];
+            if (!try read(s, vh.table, rows[0..n], o)) {
+                @memset(out, 0);
+                continue;
+            }
+            scatter(vh.z, p, z, true);
+            for (vh.out_cols, vh.out_w, out) |col, w, *y| y.* = o[col] * z[col] * w;
+        }
+    }
+    commit(s, h.outs, values);
+}
+
+fn scatter(picks: []const model.Pick, p: []const Scalar, into: []Scalar, rectify: bool) void {
+    @memset(into, 0);
+    for (picks) |k| into[k.at] = if (rectify) @max(p[k.column], 0) else p[k.column];
+}
+
+/// beta: absent is 1; 1 writes, an integer <= 0 does not, anything else breaks the circuit's exact range.
+fn writeEnabled(beta: ?u32, p: []const Scalar) !bool {
+    const b = p[beta orelse return true];
+    if (b == 1) return true;
+    if (b <= 0 and b == @round(b)) return false;
+    return error.CircuitWriteGate;
+}
+
+fn decay(s: *State, table: u32, selector: Scalar) !void {
+    if (selector == model.keep_selector) return;
+    if (!s.writable(table)) return error.CircuitTableReadOnly;
+    if (selector == model.halve_selector) {
+        var live = s.present[table];
+        while (live != 0) : (live &= live - 1) {
+            for (s.row(table, @ctz(live))) |*e| e.* *= 0.5;
+        }
+        return;
+    }
+    if (selector != model.clear_selector) return error.CircuitDecaySelector;
+    @memset(s.tables[table], 0);
+    s.present[table] = 0;
+}
+
+/// Sum of the rows a multi-hot query selects over the ballast norm o / sqrt((o0^2 + o1^2) / hd); false if none.
+fn read(s: *State, table: u32, rows: []const u32, o: []Scalar) !bool {
+    var any = false;
+    for (rows) |r| {
+        if (!s.rowPresent(table, r)) continue;
+        if (!any) @memset(o, 0);
+        for (o, s.row(table, r)) |*a, b| a.* += b;
+        any = true;
+    }
+    if (!any) return false;
+    const ref = o[0] * o[0] + o[1] * o[1];
+    if (ref == 0) {
+        for (o) |a| if (a != 0) return error.CircuitReadBallast;
+        return false;
+    }
+    const norm = @sqrt(ref / @as(Scalar, hd));
+    for (o) |*a| a.* /= norm;
+    return true;
+}
+
+/// The output code: family bits then 16 payload bits, each the sign of a code dim (+kappa is 1, -kappa is 0).
+pub fn decode(c: *const model.Circuit, x: []const Scalar) !u32 {
+    var code: u64 = 0;
+    for (c.code_dims, 0..) |d, i| {
+        if (x[d] == 0 or !std.math.isFinite(x[d])) return error.CircuitOutputCode;
+        code |= @as(u64, @intFromBool(x[d] > 0)) << @intCast(i);
+    }
+    const mask = (@as(u64, 1) << @intCast(c.family_bits)) - 1;
+    const fam = code & mask;
+    const pay: u32 = @intCast(code >> @intCast(c.family_bits));
+    if (fam >= c.families.len) return error.CircuitOutputFamily;
+    const f = c.families[@intCast(fam)];
+    if (pay >= f.size) return error.CircuitOutputPayload;
+    return f.base + pay;
+}
diff --git a/zig/src/core/steps_v1/runner_circuit_load.zig b/zig/src/core/steps_v1/runner_circuit_load.zig
new file mode 100644
index 000000000..d84f21703
--- /dev/null
+++ b/zig/src/core/steps_v1/runner_circuit_load.zig
@@ -0,0 +1,458 @@
+//! Reads a TFIMR001 circuit container (CIRCUIT-FORMAT.md v1) into batched, hazard-checked runtime form.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+const header_bytes = 64;
+
+const Term = struct { u32, f64 };
+const Expr = []const Term;
+const Chan = struct { expr: Expr, taps: [model.lags]f64 };
+const ChanAt = struct { u32, Chan };
+const ExprAt = struct { u32, Expr };
+const OutAt = struct { u32, u32, f64 };
+const InitRow = struct { u32, []const Term };
+const JValueHead = struct { v: []const ChanAt, a: Expr, beta: ?Expr, z: []const ExprAt, out: []const OutAt, into: bool, init: []const InitRow };
+const JNode = struct {
+    kind: []const u8,
+    name: []const u8 = "",
+    out: ?u32 = null,
+    into: ?bool = null,
+    terms: ?[]const struct { f64, Expr, Expr } = null,
+    n_cols: ?u32 = null,
+    levels: ?[]const u8 = null,
+    q: ?[]const ChanAt = null,
+    k: ?[]const ChanAt = null,
+    value_heads: ?[]const JValueHead = null,
+};
+const JFeature = struct { dim: u32, kind: []const u8, family: ?u32 = null, bit: ?u32 = null, digit: ?u32 = null, qs_family: ?u32 = null, qd_family: ?u32 = null, family_bits: ?u32 = null, amplitude: ?f64 = null };
+const JFamily = struct { name: []const u8, base: u32, size: u32 };
+const Doc = struct {
+    format: []const u8,
+    version: u32,
+    stats: struct { dims: u32 },
+    constants: struct { one_dim: u32, head_dim: u32, a_ref: f64, a_bit: f64, ref_cols: [2]u32 },
+    dims: []const struct { name: []const u8 },
+    features: []const JFeature,
+    nodes: []const JNode,
+    tokens: struct { vocab: u32, families: []const JFamily, go: u32, halt: u32, byte_family: u32 },
+    output: struct { family_bits: u32, payload_bits: u32, code_dims: []const u32, families: []const JFamily },
+    program: struct { kind: []const u8, input_address: u32, input_capacity: u32, entry: u32, rom_le_hex: []const u8, drom_hex: []const u8, ram_hex: []const u8 },
+};
+
+/// The checked JSON payload of a container: magic, version, sizes, flags and SHA-256 all as the format requires.
+pub fn payload(bytes: []const u8) !struct { []const u8, [32]u8 } {
+    if (bytes.len < header_bytes) return error.CircuitTruncated;
+    if (!std.mem.eql(u8, bytes[0..8], "TFIMR001")) return error.CircuitMagic;
+    const r = std.mem.readInt;
+    if (r(u32, bytes[8..12], .little) != 1 or r(u32, bytes[12..16], .little) != header_bytes) return error.CircuitVersion;
+    if (r(u32, bytes[24..28], .little) != 0 or r(u32, bytes[28..32], .little) != 0) return error.CircuitFlags;
+    if (r(u64, bytes[16..24], .little) != bytes.len - header_bytes) return error.CircuitTruncated;
+    const body = bytes[header_bytes..];
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(body, &digest, .{});
+    if (!std.mem.eql(u8, &digest, bytes[32..64])) return error.CircuitChecksum;
+    return .{ body, digest };
+}
+
+/// Reads a container file; at most 1 GiB.
+pub fn fromPath(gpa: std.mem.Allocator, path: []const u8) !model.Circuit {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const io = threaded.io();
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 30));
+    defer gpa.free(bytes);
+    return fromBytes(gpa, bytes);
+}
+
+/// Parses and compiles a whole container; the circuit owns everything through its arena.
+pub fn fromBytes(gpa: std.mem.Allocator, bytes: []const u8) !model.Circuit {
+    const body, const digest = try payload(bytes);
+    var parse_arena = std.heap.ArenaAllocator.init(gpa);
+    defer parse_arena.deinit();
+    const doc = std.json.parseFromSliceLeaky(Doc, parse_arena.allocator(), body, .{ .ignore_unknown_fields = true }) catch
+        return error.CircuitJson;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    errdefer arena.deinit();
+    var c = try compile(arena.allocator(), parse_arena.allocator(), &doc);
+    c.payload_sha256 = digest;
+    c.arena = arena;
+    return c;
+}
+
+fn exact(v: f64) !Scalar {
+    if (!std.math.isFinite(v)) return error.CircuitNumber;
+    const s: Scalar = @floatCast(v);
+    if (@as(f64, s) != v) return error.CircuitNotExact;
+    return s;
+}
+
+fn compile(a: std.mem.Allocator, tmp: std.mem.Allocator, doc: *const Doc) !model.Circuit {
+    if (!std.mem.eql(u8, doc.format, "tensorfold.runner.p2") or doc.version != 1) return error.CircuitVersion;
+    const dims: u32 = @intCast(doc.dims.len);
+    const k = doc.constants;
+    if (dims == 0 or dims != doc.stats.dims or k.one_dim != 0 or k.head_dim != hd) return error.CircuitDims;
+    if (k.ref_cols[0] != 0 or k.ref_cols[1] != 1) return error.CircuitDims;
+    const families = try a.alloc(model.Family, doc.tokens.families.len);
+    var end: u32 = 0;
+    for (doc.tokens.families, doc.output.families, families) |f, g, *out| {
+        if (f.base != end or f.size == 0 or f.size > 1 << 16 or f.base != g.base or f.size != g.size) return error.CircuitFamilies;
+        out.* = .{ .base = f.base, .size = f.size };
+        end += f.size;
+    }
+    if (doc.tokens.families.len != doc.output.families.len or end != doc.tokens.vocab) return error.CircuitFamilies;
+    const o = doc.output;
+    if (o.family_bits == 0 or o.family_bits > 16 or o.payload_bits != 16 or o.code_dims.len != o.family_bits + 16) return error.CircuitOutputCode;
+    if (@as(usize, 1) << @intCast(o.family_bits) < families.len) return error.CircuitOutputCode;
+    for (o.code_dims) |d| if (d >= dims) return error.CircuitIndex;
+    if (doc.tokens.go >= end or doc.tokens.halt >= end or doc.tokens.byte_family >= families.len) return error.CircuitTokens;
+    var b: Builder = .{ .a = a, .tmp = tmp, .dims = dims };
+    for (doc.nodes) |*n| try b.node(n);
+    try b.flush();
+    return .{
+        .dims = dims,
+        .batches = b.batches.items,
+        .features = try features(a, doc, dims, @intCast(families.len)),
+        .families = families,
+        .family_bits = o.family_bits,
+        .code_dims = try a.dupe(u32, o.code_dims),
+        .go = doc.tokens.go,
+        .halt = doc.tokens.halt,
+        .byte_family = doc.tokens.byte_family,
+        .fault_family = for (doc.tokens.families, 0..) |f, i| {
+            if (std.mem.eql(u8, f.name, "FLT")) break @intCast(i);
+        } else null,
+        .tables = b.tables.items,
+        .table_names = b.names.items,
+        .channels = b.channels,
+        .nodes = @intCast(doc.nodes.len),
+        .program = try program(a, doc, b.names.items, b.tables.items),
+        .payload_sha256 = undefined,
+        .arena = undefined,
+    };
+}
+
+fn features(a: std.mem.Allocator, doc: *const Doc, dims: u32, n_families: u32) ![]model.Feature {
+    const out = try a.alloc(model.Feature, doc.features.len);
+    for (doc.features, out) |f, *g| {
+        if (f.dim == 0 or f.dim >= dims) return error.CircuitFeatures;
+        const kind = std.meta.stringToEnum(model.Feature.Kind, f.kind) orelse return error.CircuitFeatures;
+        g.* = .{ .dim = f.dim, .kind = kind };
+        switch (kind) {
+            .family, .payload_bit => {
+                g.family = f.family orelse return error.CircuitFeatures;
+                if (kind == .payload_bit) g.bit = f.bit orelse return error.CircuitFeatures;
+                if (g.family >= n_families or g.bit >= 16) return error.CircuitFeatures;
+            },
+            .next_digit => {
+                g.digit = f.digit orelse return error.CircuitFeatures;
+                g.family = f.qs_family orelse return error.CircuitFeatures;
+                g.qd_family = f.qd_family orelse return error.CircuitFeatures;
+                if (g.digit >= 8 or g.family >= n_families or g.qd_family >= n_families) return error.CircuitFeatures;
+            },
+            .code_bit => {
+                g.bit = f.bit orelse return error.CircuitFeatures;
+                g.amplitude = try exact(f.amplitude orelse return error.CircuitFeatures);
+                if (f.family_bits != doc.output.family_bits or g.bit >= doc.output.family_bits + 16) return error.CircuitFeatures;
+            },
+        }
+    }
+    return out;
+}
+
+fn unhex(a: std.mem.Allocator, text: []const u8, len: usize) ![]u8 {
+    if (text.len % 2 != 0 or text.len / 2 > len) return error.CircuitProgram;
+    const out = try a.alloc(u8, len);
+    @memset(out, 0);
+    _ = std.fmt.hexToBytes(out[0 .. text.len / 2], text) catch return error.CircuitProgram;
+    return out;
+}
+
+fn program(a: std.mem.Allocator, doc: *const Doc, names: []const []const u8, tables: []const model.Table) !model.Program {
+    const p = doc.program;
+    const rom_bytes = try unhex(a, p.rom_le_hex, 4 << 16);
+    if (p.rom_le_hex.len != 2 * rom_bytes.len or p.ram_hex.len != 2 * (4 << 13)) return error.CircuitProgram;
+    const rom = try a.alloc(u32, 1 << 16);
+    for (rom, 0..) |*w, i| w.* = std.mem.readInt(u32, rom_bytes[4 * i ..][0..4], .little);
+    a.free(rom_bytes);
+    var out: model.Program = .{
+        .kind = if (std.mem.eql(u8, p.kind, "calc")) .calc else if (std.mem.eql(u8, p.kind, "elf")) .elf else return error.CircuitProgram,
+        .input_address = p.input_address,
+        .input_capacity = p.input_capacity,
+        .ram_tables = @splat(std.math.maxInt(u32)),
+        .a_ref = try exact(doc.constants.a_ref),
+        .a_bit = try exact(doc.constants.a_bit),
+        .image = .{ .rom = rom, .drom = try unhex(a, p.drom_hex, 4 << 15), .ram = try unhex(a, p.ram_hex, 4 << 13), .entry = p.entry },
+    };
+    for (names, 0..) |name, t| {
+        if (!std.mem.startsWith(u8, name, "ram")) continue;
+        const h = std.fmt.parseInt(u5, name[3..], 10) catch continue;
+        if (out.ram_tables[h] == std.math.maxInt(u32)) out.ram_tables[h] = @intCast(t);
+    }
+    for (out.ram_tables) |t| {
+        if (t == std.math.maxInt(u32)) continue;
+        if (t + 1 >= tables.len or !tables[t].writable or !tables[t + 1].writable) return error.CircuitProgram;
+    }
+    return out;
+}
+
+/// Accumulates nodes into batches: a batch ends at a kind change or at a read of a dim the batch already wrote.
+const Builder = struct {
+    a: std.mem.Allocator,
+    tmp: std.mem.Allocator,
+    dims: u32,
+    batches: std.ArrayList(model.Batch) = .empty,
+    tables: std.ArrayList(model.Table) = .empty,
+    names: std.ArrayList([]const u8) = .empty,
+    channels: u32 = 0,
+    pending: std.ArrayList(*const JNode) = .empty,
+    pending_heads: bool = false,
+    written: std.DynamicBitSetUnmanaged = .{},
+
+    fn node(b: *Builder, n: *const JNode) !void {
+        if (b.written.bit_length == 0) b.written = try .initEmpty(b.tmp, b.dims);
+        const is_head = std.mem.eql(u8, n.kind, "head");
+        if (!is_head and !std.mem.eql(u8, n.kind, "ffn")) return error.CircuitNodeKind;
+        var reads: std.ArrayList(u32) = .empty;
+        var writes: std.ArrayList(u32) = .empty;
+        if (is_head) try headDims(b, n, &reads, &writes) else try ffnDims(b, n, &reads, &writes);
+        var hazard = b.pending.items.len > 0 and is_head != b.pending_heads;
+        for (reads.items) |d| hazard = hazard or b.written.isSet(d);
+        if (hazard) try b.flush();
+        b.pending_heads = is_head;
+        try b.pending.append(b.tmp, n);
+        for (writes.items) |d| b.written.set(d);
+    }
+
+    fn check(b: *Builder, e: Expr, reads: *std.ArrayList(u32)) !void {
+        for (e, 0..) |t, i| {
+            if (t[0] >= b.dims) return error.CircuitIndex;
+            for (e[0..i]) |u| if (u[0] == t[0]) return error.CircuitDuplicateDim;
+            _ = try exact(t[1]);
+            try reads.append(b.tmp, t[0]);
+        }
+    }
+
+    fn ffnDims(b: *Builder, n: *const JNode, reads: *std.ArrayList(u32), writes: *std.ArrayList(u32)) !void {
+        const out = n.out orelse return error.CircuitNode;
+        if (out == 0 or out >= b.dims or n.into == null) return error.CircuitIndex;
+        for (n.terms orelse return error.CircuitNode) |t| {
+            _ = try exact(t[0]);
+            try b.check(t[1], reads);
+            try b.check(t[2], reads);
+        }
+        try writes.append(b.tmp, out);
+    }
+
+    fn headDims(b: *Builder, n: *const JNode, reads: *std.ArrayList(u32), writes: *std.ArrayList(u32)) !void {
+        if (n.n_cols != hd) return error.CircuitHeadShape;
+        for ([_]?[]const ChanAt{ n.q, n.k }) |chans| for (chans orelse return error.CircuitNode) |ch| try b.channel(ch, reads);
+        for (n.value_heads orelse return error.CircuitNode) |*vh| {
+            const own = writes.items.len;
+            var mine: std.ArrayList(u32) = .empty;
+            for (vh.v) |ch| try b.channel(ch, &mine);
+            try b.check(vh.a, &mine);
+            if (vh.beta) |e| try b.check(e, &mine);
+            for (vh.z) |z| {
+                if (z[0] >= hd) return error.CircuitIndex;
+                try b.check(z[1], &mine);
+            }
+            for (mine.items) |d| for (writes.items[0..own]) |w| if (d == w) return error.CircuitHazard;
+            try reads.appendSlice(b.tmp, mine.items);
+            for (vh.out) |t| {
+                if (t[0] >= hd or t[1] == 0 or t[1] >= b.dims) return error.CircuitIndex;
+                _ = try exact(t[2]);
+                try writes.append(b.tmp, t[1]);
+            }
+        }
+    }
+
+    fn channel(b: *Builder, ch: ChanAt, reads: *std.ArrayList(u32)) !void {
+        if (ch[0] >= hd) return error.CircuitIndex;
+        try b.check(ch[1].expr, reads);
+        for (ch[1].taps) |t| _ = try exact(t);
+    }
+
+    fn flush(b: *Builder) !void {
+        if (b.pending.items.len == 0) return;
+        const batch: model.Batch = if (b.pending_heads) .{ .heads = try b.headBatch() } else .{ .ffn = try b.ffnBatch() };
+        try b.batches.append(b.a, batch);
+        b.pending.clearRetainingCapacity();
+        b.written.unsetAll();
+    }
+
+    fn ffnBatch(b: *Builder) !model.Ffn {
+        var up: FormSet = .{};
+        var gate: FormSet = .{};
+        var coef: std.ArrayList(Scalar) = .empty;
+        var slot: std.ArrayList(u32) = .empty;
+        const outs = try b.a.alloc(model.Out, b.pending.items.len);
+        for (b.pending.items, outs, 0..) |n, *out, s| {
+            out.* = .{ .dim = n.out.?, .into = n.into.? };
+            for (n.terms.?) |t| {
+                try coef.append(b.a, try exact(t[0]));
+                try slot.append(b.a, @intCast(s));
+                try up.add(b, t[1]);
+                try gate.add(b, t[2]);
+            }
+        }
+        const g = try gate.finish(b);
+        const starts = try b.a.alloc(u32, gate.forms + 1);
+        @memset(starts, 0);
+        var always: std.ArrayList(u32) = .empty;
+        for (g.form, g.bias, 0..) |f, c, t| {
+            if (f != model.no_form) starts[f + 1] += 1 else if (c > 0) try always.append(b.a, @intCast(t));
+        }
+        for (1..starts.len) |i| starts[i] += starts[i - 1];
+        const order = try b.a.alloc(u32, starts[gate.forms]);
+        const fill = try b.tmp.dupe(u32, starts[0..gate.forms]);
+        for (g.form, 0..) |f, t| if (f != model.no_form) {
+            order[fill[f]] = @intCast(t);
+            fill[f] += 1;
+        };
+        for (0..gate.forms) |f| std.mem.sort(u32, order[starts[f]..starts[f + 1]], g.bias, struct {
+            fn gt(bias: []const Scalar, x: u32, y: u32) bool {
+                return bias[x] > bias[y] or (bias[x] == bias[y] and x < y);
+            }
+        }.gt);
+        return .{ .terms = @intCast(coef.items.len), .up = try up.finish(b), .gate = g, .coef = coef.items, .slot = slot.items, .outs = outs, .order = order, .starts = starts, .always = always.items };
+    }
+
+    fn headBatch(b: *Builder) !model.Heads {
+        var cols: FormSet = .{};
+        var taps: std.ArrayList([model.lags]Scalar) = .empty;
+        for (b.pending.items) |n| {
+            for ([_][]const ChanAt{ n.q.?, n.k.? }) |chans| for (chans) |ch| try b.addChannel(&cols, &taps, ch[1]);
+            for (n.value_heads.?) |vh| for (vh.v) |ch| try b.addChannel(&cols, &taps, ch[1]);
+        }
+        const channels: u32 = @intCast(taps.items.len);
+        var column = channels;
+        var chan: u32 = 0;
+        var outs: std.ArrayList(model.Out) = .empty;
+        const heads = try b.a.alloc(model.Head, b.pending.items.len);
+        for (b.pending.items, heads) |n, *h| {
+            const q = try b.picks(n.q.?, &chan);
+            const kk = try b.picks(n.k.?, &chan);
+            const vhs = try b.a.alloc(model.ValueHead, n.value_heads.?.len);
+            for (n.value_heads.?, vhs) |*jv, *vh| {
+                const table: u32 = @intCast(b.tables.items.len);
+                try b.tables.append(b.a, try initTable(b.a, jv, kk.len > 0 or jv.a.len > 0));
+                try b.names.append(b.a, try b.a.dupe(u8, n.name));
+                vh.* = .{ .table = table, .v = try b.picks(jv.v, &chan), .a = null, .beta = null, .z = &.{}, .out_first = @intCast(outs.items.len), .out_cols = &.{}, .out_w = &.{} };
+                if (jv.a.len > 0) vh.a = try plain(b, &cols, jv.a, &column);
+                if (jv.beta) |e| vh.beta = try plain(b, &cols, e, &column);
+                const z = try b.a.alloc(model.Pick, jv.z.len);
+                for (jv.z, z) |e, *p| p.* = .{ .at = e[0], .column = try plain(b, &cols, e[1], &column) };
+                vh.z = z;
+                const out_cols = try b.a.alloc(u32, jv.out.len);
+                const ws = try b.a.alloc(Scalar, jv.out.len);
+                for (jv.out, out_cols, ws) |t, *c, *x| {
+                    c.* = t[0];
+                    x.* = try exact(t[2]);
+                    try outs.append(b.a, .{ .dim = t[1], .into = jv.into });
+                }
+                vh.out_cols = out_cols;
+                vh.out_w = ws;
+            }
+            h.* = .{ .q = q, .k = kk, .value_heads = vhs };
+        }
+        const first = b.channels;
+        b.channels += channels;
+        return .{
+            .proj = try cols.finish(b),
+            .channels = channels,
+            .first_channel = first,
+            .taps = taps.items,
+            .heads = heads,
+            .outs = outs.items,
+        };
+    }
+
+    fn addChannel(b: *Builder, cols: *FormSet, taps: *std.ArrayList([model.lags]Scalar), ch: Chan) !void {
+        try cols.add(b, ch.expr);
+        var t: [model.lags]Scalar = undefined;
+        for (&t, ch.taps) |*x, v| x.* = try exact(v);
+        try taps.append(b.a, t);
+    }
+
+    fn picks(b: *Builder, chans: []const ChanAt, next: *u32) ![]model.Pick {
+        const out = try b.a.alloc(model.Pick, chans.len);
+        for (chans, out, 0..) |ch, *p, i| {
+            for (chans[0..i]) |prev| if (prev[0] == ch[0]) return error.CircuitDuplicateChannel;
+            p.* = .{ .at = ch[0], .column = next.* };
+            next.* += 1;
+        }
+        return out;
+    }
+};
+
+fn plain(b: *Builder, cols: *FormSet, e: Expr, column: *u32) !u32 {
+    try cols.add(b, e);
+    column.* += 1;
+    return column.* - 1;
+}
+
+/// Columns as distinct linear forms (keyed by their sorted non-constant terms) plus each column's constant.
+const FormSet = struct {
+    keys: std.StringHashMapUnmanaged(u32) = .empty,
+    src: std.ArrayList(u32) = .empty,
+    dst: std.ArrayList(u32) = .empty,
+    w: std.ArrayList(Scalar) = .empty,
+    form: std.ArrayList(u32) = .empty,
+    bias: std.ArrayList(Scalar) = .empty,
+    forms: u32 = 0,
+
+    fn add(fs: *FormSet, b: *Builder, e: Expr) !void {
+        const terms = try b.tmp.dupe(Term, e);
+        std.mem.sort(Term, terms, {}, struct {
+            fn lt(_: void, x: Term, y: Term) bool {
+                return x[0] < y[0];
+            }
+        }.lt);
+        var key: std.ArrayList(u8) = .empty;
+        var bias: Scalar = 0;
+        for (terms) |t| {
+            const w = try exact(t[1]);
+            if (t[0] == 0) {
+                bias += w;
+                continue;
+            }
+            try key.appendSlice(b.tmp, std.mem.asBytes(&t[0]));
+            try key.appendSlice(b.tmp, std.mem.asBytes(&w));
+        }
+        try fs.bias.append(b.a, bias);
+        if (key.items.len == 0) return fs.form.append(b.a, model.no_form);
+        const got = try fs.keys.getOrPut(b.tmp, key.items);
+        if (!got.found_existing) {
+            got.value_ptr.* = fs.forms;
+            for (terms) |t| if (t[0] != 0) {
+                try fs.src.append(b.tmp, t[0]);
+                try fs.dst.append(b.tmp, fs.forms);
+                try fs.w.append(b.tmp, try exact(t[1]));
+            };
+            fs.forms += 1;
+        }
+        try fs.form.append(b.a, got.value_ptr.*);
+    }
+
+    fn finish(fs: *FormSet, b: *Builder) !model.Shared {
+        return .{ .forms = try model.sparse(b.a, b.dims, fs.forms, fs.src.items, fs.dst.items, fs.w.items), .form = fs.form.items, .bias = fs.bias.items };
+    }
+};
+
+fn initTable(a: std.mem.Allocator, vh: *const JValueHead, writable: bool) !model.Table {
+    const rows = try a.alloc(Scalar, hd * hd);
+    @memset(rows, 0);
+    var present: u128 = 0;
+    for (vh.init) |r| {
+        if (r[0] >= hd) return error.CircuitIndex;
+        const bit = @as(u128, 1) << @intCast(r[0]);
+        if (present & bit != 0) return error.CircuitDuplicateRow;
+        present |= bit;
+        for (r[1]) |cv| {
+            if (cv[0] >= hd) return error.CircuitIndex;
+            rows[r[0] * hd + cv[0]] = try exact(cv[1]);
+        }
+    }
+    return .{ .present = present, .rows = rows, .writable = writable };
+}
diff --git a/zig/src/core/steps_v1/runner_circuit_model.zig b/zig/src/core/steps_v1/runner_circuit_model.zig
new file mode 100644
index 000000000..a8cc68322
--- /dev/null
+++ b/zig/src/core/steps_v1/runner_circuit_model.zig
@@ -0,0 +1,272 @@
+//! A compiled circuit in memory: batched SwiGLU units and one-hot DeltaNet heads in stored node order.
+const std = @import("std");
+
+/// Evaluation precision; the loader refuses any weight or state value this type cannot hold exactly.
+pub const Scalar = f32;
+/// Key/value head width and the rows a one-hot key can address.
+pub const hd: u32 = 128;
+/// Conv taps of a q/k/v channel: projections at t, t-1, t-2, t-3.
+pub const lags: u32 = 4;
+/// Decay selectors (Qwenputer's DECAY with dt_bias -110): keep, halve, clear.
+pub const keep_selector: Scalar = 0;
+pub const halve_selector: Scalar = 110;
+pub const clear_selector: Scalar = 238;
+
+/// y = x * W over the nonzeros, stored by source so zero inputs cost nothing.
+pub const Sparse = struct {
+    sources: u32,
+    outputs: u32,
+    starts: []const u32,
+    dst: []const u32,
+    w: []const Scalar,
+    /// Sources with at least one entry, ascending.
+    used: []const u32,
+
+    /// y = x * W: zeroes y, then scatters the inputs listed in `active` (every other input is zero).
+    pub fn apply(m: *const Sparse, x: []const Scalar, active: []const u32, y: []Scalar) void {
+        @memset(y, 0);
+        for (if (m.used.len < active.len) m.used else active) |i| {
+            const v = x[i];
+            if (v == 0) continue;
+            for (m.starts[i]..m.starts[i + 1]) |e| y[m.dst[e]] += v * m.w[e];
+        }
+    }
+
+    pub fn nonzeros(m: *const Sparse) usize {
+        return m.dst.len;
+    }
+};
+
+/// Where a node's value lands: x[dim] = value, or x[dim] += value when `into`.
+pub const Out = struct { dim: u32, into: bool };
+
+pub const no_form = std.math.maxInt(u32);
+
+/// A batch's expressions as distinct linear forms: column c = bias[c] + forms[form[c]], the constant dim folded out.
+pub const Shared = struct {
+    forms: Sparse,
+    form: []const u32,
+    bias: []const Scalar,
+
+    pub fn columns(s: *const Shared) usize {
+        return s.form.len;
+    }
+
+    /// `scratch` holds forms.outputs values.
+    pub fn eval(s: *const Shared, x: []const Scalar, active: []const u32, scratch: []Scalar, y: []Scalar) void {
+        s.forms.apply(x, active, scratch);
+        for (y, s.form, s.bias) |*o, f, c| o.* = if (f == no_form) c else c + scratch[f];
+    }
+};
+
+/// Consecutive FFN nodes with no read of a dim written earlier in the batch: y = sum c * up * max(gate, 0).
+pub const Ffn = struct {
+    terms: u32,
+    up: Shared,
+    gate: Shared,
+    coef: []const Scalar,
+    slot: []const u32,
+    outs: []const Out,
+    /// Terms grouped by gate form (starts has forms + 1 entries), each group by gate constant, largest first.
+    order: []const u32,
+    starts: []const u32,
+    /// Terms whose gate is a positive constant; terms with a constant gate <= 0 never fire and are dropped.
+    always: []const u32,
+};
+
+/// (row or column, projection column) of a channel or expression.
+pub const Pick = struct { at: u32, column: u32 };
+
+pub const ValueHead = struct {
+    table: u32,
+    v: []const Pick,
+    a: ?u32,
+    beta: ?u32,
+    z: []const Pick,
+    out_first: u32,
+    out_cols: []const u32,
+    out_w: []const Scalar,
+};
+
+pub const Head = struct {
+    q: []const Pick,
+    k: []const Pick,
+    value_heads: []const ValueHead,
+};
+
+/// Consecutive head nodes. Projection columns [0, channels) are conv channels with taps; the rest are plain exprs.
+pub const Heads = struct {
+    proj: Shared,
+    channels: u32,
+    first_channel: u32,
+    taps: []const [lags]Scalar,
+    heads: []const Head,
+    outs: []const Out,
+};
+
+pub const Batch = union(enum) { ffn: Ffn, heads: Heads };
+
+/// One input feature: its dim's value is a function of the token's family id and payload.
+pub const Feature = struct {
+    dim: u32,
+    kind: Kind,
+    family: u32 = 0,
+    bit: u32 = 0,
+    digit: u32 = 0,
+    qd_family: u32 = 0,
+    amplitude: Scalar = 0,
+
+    pub const Kind = enum { family, payload_bit, next_digit, code_bit };
+
+    pub fn value(f: Feature, fam: u32, pay: u32, family_bits: u32) Scalar {
+        return switch (f.kind) {
+            .family => @floatFromInt(@intFromBool(fam == f.family)),
+            .payload_bit => if (fam == f.family) @floatFromInt(pay >> @intCast(f.bit) & 1) else 0,
+            .next_digit => @floatFromInt(@intFromBool((fam == f.family and pay == f.digit) or
+                (f.digit > 0 and fam == f.qd_family and pay >> 4 == f.digit - 1))),
+            .code_bit => blk: {
+                const code = @as(u64, fam) | @as(u64, pay) << @intCast(family_bits);
+                break :blk if (code >> @intCast(f.bit) & 1 == 1) f.amplitude else -f.amplitude;
+            },
+        };
+    }
+};
+
+pub const Family = struct { base: u32, size: u32 };
+
+/// A head's initial table: present rows (bit mask) of hd columns each, row-major hd x hd.
+pub const Table = struct {
+    present: u128,
+    rows: []const Scalar,
+    writable: bool,
+};
+
+/// A static program's memory: ROM instruction words, DROM bytes, RAM bytes and the entry address.
+pub const Image = struct {
+    rom: []u32,
+    drom: []u8,
+    ram: []u8,
+    entry: u32,
+
+    pub fn deinit(img: Image, a: std.mem.Allocator) void {
+        a.free(img.rom);
+        a.free(img.drom);
+        a.free(img.ram);
+    }
+};
+
+/// Where the calc firmware takes its expression, the RAM tables (ram<h>) the patch edits, and the boot image.
+pub const Program = struct {
+    kind: enum { calc, elf },
+    input_address: u32,
+    input_capacity: u32,
+    ram_tables: [32]u32,
+    a_ref: Scalar,
+    a_bit: Scalar,
+    image: Image,
+};
+
+pub const Circuit = struct {
+    dims: u32,
+    batches: []const Batch,
+    features: []const Feature,
+    families: []const Family,
+    family_bits: u32,
+    code_dims: []const u32,
+    go: u32,
+    halt: u32,
+    byte_family: u32,
+    fault_family: ?u32,
+    tables: []const Table,
+    table_names: []const []const u8,
+    channels: u32,
+    nodes: u32,
+    program: Program,
+    payload_sha256: [32]u8,
+    arena: std.heap.ArenaAllocator,
+
+    /// Reads and checks a circuit file (CIRCUIT-FORMAT.md v1).
+    pub fn load(gpa: std.mem.Allocator, path: []const u8) !Circuit {
+        return @import("runner_circuit_load.zig").fromPath(gpa, path);
+    }
+
+    /// The arena owns everything; `gpa` is the allocator `load` was given.
+    pub fn deinit(c: *Circuit, gpa: std.mem.Allocator) void {
+        _ = gpa;
+        c.arena.deinit();
+        c.* = undefined;
+    }
+
+    /// The family id and payload of token t, or null when t is outside the vocabulary.
+    pub fn split(c: *const Circuit, t: u32) ?struct { u32, u32 } {
+        var lo: usize = 0;
+        var hi: usize = c.families.len;
+        while (lo < hi) {
+            const mid = (lo + hi) / 2;
+            const f = c.families[mid];
+            if (t < f.base) hi = mid else if (t - f.base >= f.size) lo = mid + 1 else return .{ @intCast(mid), t - f.base };
+        }
+        return null;
+    }
+
+    /// Weights the evaluator reads per step, for sizing and reports.
+    pub fn nonzeros(c: *const Circuit) usize {
+        var n: usize = 0;
+        for (c.batches) |*b| n += switch (b.*) {
+            .ffn => |*f| f.up.forms.nonzeros() + f.gate.forms.nonzeros(),
+            .heads => |*h| h.proj.forms.nonzeros(),
+        };
+        return n;
+    }
+};
+
+/// Builds a Sparse from (source, output, weight) triples in any order; a source's entries keep their input order.
+pub fn sparse(a: std.mem.Allocator, sources: u32, outputs: u32, src: []const u32, dst_in: []const u32, w_in: []const Scalar) !Sparse {
+    if (src.len != dst_in.len or src.len != w_in.len) return error.CircuitSparseShape;
+    const starts = try a.alloc(u32, sources + 1);
+    @memset(starts, 0);
+    for (src) |s| {
+        if (s >= sources) return error.CircuitIndex;
+        starts[s + 1] += 1;
+    }
+    for (1..starts.len) |i| starts[i] += starts[i - 1];
+    const fill = try a.dupe(u32, starts[0..sources]);
+    defer a.free(fill);
+    const dst = try a.alloc(u32, src.len);
+    const w = try a.alloc(Scalar, src.len);
+    for (src, dst_in, w_in) |s, d, v| {
+        if (d >= outputs) return error.CircuitIndex;
+        dst[fill[s]] = d;
+        w[fill[s]] = v;
+        fill[s] += 1;
+    }
+    var used: std.ArrayList(u32) = .empty;
+    for (0..sources) |i| if (starts[i + 1] > starts[i]) try used.append(a, @intCast(i));
+    return .{ .sources = sources, .outputs = outputs, .starts = starts, .dst = dst, .w = w, .used = used.items };
+}
+
+test "sparse apply skips zero inputs and adds repeated entries" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const m = try sparse(arena.allocator(), 3, 2, &.{ 0, 2, 2, 1 }, &.{ 1, 0, 0, 1 }, &.{ 2, 3, 4, 5 });
+    var y = [_]Scalar{ 7, 7 };
+    m.apply(&.{ 1, 0, 2 }, &.{ 0, 1, 2 }, &y);
+    try std.testing.expectEqualSlices(Scalar, &.{ 14, 2 }, &y);
+    m.apply(&.{ 1, 0, 2 }, &.{2}, &y);
+    try std.testing.expectEqualSlices(Scalar, &.{ 14, 0 }, &y);
+    try std.testing.expectError(error.CircuitIndex, sparse(arena.allocator(), 3, 2, &.{3}, &.{0}, &.{1}));
+}
+
+test "features follow the format's token-bus encodings" {
+    const nd: Feature = .{ .dim = 1, .kind = .next_digit, .family = 9, .qd_family = 10, .digit = 0 };
+    try std.testing.expectEqual(@as(Scalar, 1), nd.value(9, 0, 5));
+    try std.testing.expectEqual(@as(Scalar, 0), nd.value(10, 0xff, 5));
+    const nd3: Feature = .{ .dim = 1, .kind = .next_digit, .family = 9, .qd_family = 10, .digit = 3 };
+    try std.testing.expectEqual(@as(Scalar, 1), nd3.value(10, 2 << 4 | 7, 5));
+    const cb: Feature = .{ .dim = 1, .kind = .code_bit, .bit = 6, .amplitude = 128 };
+    try std.testing.expectEqual(@as(Scalar, 128), cb.value(3, 2, 5));
+    try std.testing.expectEqual(@as(Scalar, -128), cb.value(3, 1, 5));
+    const pb: Feature = .{ .dim = 1, .kind = .payload_bit, .family = 4, .bit = 2 };
+    try std.testing.expectEqual(@as(Scalar, 1), pb.value(4, 4, 5));
+    try std.testing.expectEqual(@as(Scalar, 0), pb.value(5, 4, 5));
+}
diff --git a/zig/src/core/steps_v1/runner_circuit_state.zig b/zig/src/core/steps_v1/runner_circuit_state.zig
new file mode 100644
index 000000000..96b48af62
--- /dev/null
+++ b/zig/src/core/steps_v1/runner_circuit_state.zig
@@ -0,0 +1,160 @@
+//! Per-machine circuit state: the DeltaNet tables (the RAM op's rows), per-channel conv history and canonical bytes.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+const table_floats = hd * hd;
+const history = model.lags - 1;
+
+/// Read-only tables stay shared with the circuit; tables a key or decay can change are copied per machine.
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    circuit: *const model.Circuit,
+    tables: [][]Scalar,
+    owned: []bool,
+    present: []u128,
+    history: []Scalar,
+    steps: u64 = 0,
+    x: []Scalar,
+    active: std.ArrayList(u32),
+    seen: []bool,
+    work: []Scalar,
+
+    pub fn init(gpa: std.mem.Allocator, c: *const model.Circuit) !State {
+        const tables = try gpa.alloc([]Scalar, c.tables.len);
+        errdefer gpa.free(tables);
+        var copied: usize = 0;
+        errdefer for (c.tables[0..copied], tables[0..copied]) |t, s| if (t.writable) gpa.free(s);
+        for (c.tables, tables) |t, *s| {
+            s.* = if (t.writable) try gpa.dupe(Scalar, t.rows) else @constCast(t.rows);
+            copied += 1;
+        }
+        const owned = try gpa.alloc(bool, c.tables.len);
+        errdefer gpa.free(owned);
+        for (c.tables, owned) |t, *o| o.* = t.writable;
+        const present = try gpa.alloc(u128, c.tables.len);
+        errdefer gpa.free(present);
+        for (c.tables, present) |t, *p| p.* = t.present;
+        const hist = try gpa.alloc(Scalar, @as(usize, c.channels) * history);
+        errdefer gpa.free(hist);
+        @memset(hist, 0);
+        const x = try gpa.alloc(Scalar, c.dims);
+        errdefer gpa.free(x);
+        @memset(x, 0);
+        const seen = try gpa.alloc(bool, c.dims);
+        errdefer gpa.free(seen);
+        @memset(seen, false);
+        var active: std.ArrayList(u32) = .empty;
+        try active.ensureTotalCapacity(gpa, c.dims);
+        errdefer active.deinit(gpa);
+        const work = try gpa.alloc(Scalar, workSize(c));
+        return .{ .gpa = gpa, .circuit = c, .tables = tables, .owned = owned, .present = present, .history = hist, .x = x, .active = active, .seen = seen, .work = work };
+    }
+
+    pub fn deinit(s: *State) void {
+        for (s.owned, s.tables) |o, rows| if (o) s.gpa.free(rows);
+        s.gpa.free(s.tables);
+        s.gpa.free(s.owned);
+        s.gpa.free(s.present);
+        s.gpa.free(s.history);
+        s.gpa.free(s.x);
+        s.gpa.free(s.seen);
+        s.active.deinit(s.gpa);
+        s.gpa.free(s.work);
+        s.* = undefined;
+    }
+
+    /// Zeroes the residual for a new step; only listed dims can be nonzero.
+    pub fn clearResidual(s: *State) void {
+        for (s.active.items) |d| {
+            s.x[d] = 0;
+            s.seen[d] = false;
+        }
+        s.active.clearRetainingCapacity();
+    }
+
+    /// Lists dim d as possibly nonzero (capacity is the dim count, so this never allocates).
+    pub fn touch(s: *State, d: u32) void {
+        if (s.seen[d]) return;
+        s.seen[d] = true;
+        s.active.appendAssumeCapacity(d);
+    }
+
+    pub fn writable(s: *const State, table: u32) bool {
+        return s.circuit.tables[table].writable;
+    }
+
+    pub fn row(s: *State, table: u32, r: u32) []Scalar {
+        return s.tables[table][r * hd ..][0..hd];
+    }
+
+    pub fn rowPresent(s: *const State, table: u32, r: u32) bool {
+        return s.present[table] >> @intCast(r) & 1 == 1;
+    }
+
+    /// Copies a shared table into this machine before the host rewrites it (an ELF boot's ROM and DROM).
+    pub fn own(s: *State, table: u32) !void {
+        if (s.owned[table]) return;
+        s.tables[table] = try s.gpa.dupe(Scalar, s.tables[table]);
+        s.owned[table] = true;
+    }
+
+    /// Replaces one row (the RAM op's write) of a table this machine owns.
+    pub fn writeRow(s: *State, table: u32, r: u32, values: []const Scalar) !void {
+        if (!s.owned[table]) return error.CircuitTableReadOnly;
+        if (r >= hd or values.len != hd) return error.CircuitIndex;
+        @memcpy(s.row(table, r), values);
+        s.present[table] |= @as(u128, 1) << @intCast(r);
+    }
+
+    pub fn clearRow(s: *State, table: u32, r: u32) !void {
+        if (!s.owned[table]) return error.CircuitTableReadOnly;
+        if (r >= hd) return error.CircuitIndex;
+        @memset(s.row(table, r), 0);
+        s.present[table] &= ~(@as(u128, 1) << @intCast(r));
+    }
+
+    /// The last three pre-convolution projections of global channel i, newest first.
+    pub fn channelHistory(s: *State, i: u32) *[history]Scalar {
+        return s.history[i * history ..][0..history];
+    }
+
+    /// Bytes this machine owns beyond the shared circuit (copied tables, history, scratch), for admission.
+    pub fn ownedBytes(s: *const State) usize {
+        var n: usize = (s.history.len + s.x.len + s.work.len) * @sizeOf(Scalar);
+        for (s.owned) |o| n += if (o) table_floats * @sizeOf(Scalar) else 0;
+        return n;
+    }
+
+    /// Canonical bytes: steps, then every table and every channel history as binary64 LE, absent rows as zeros.
+    pub fn canonical(s: *const State, gpa: std.mem.Allocator) ![]u8 {
+        const n = 8 + (s.tables.len * table_floats + s.history.len) * 8;
+        const out = try gpa.alloc(u8, n);
+        std.mem.writeInt(u64, out[0..8], s.steps, .little);
+        var at: usize = 8;
+        for (s.tables, s.present) |t, p| for (0..hd) |r| {
+            const live = p >> @intCast(r) & 1 == 1;
+            for (t[r * hd ..][0..hd]) |v| {
+                const w: f64 = if (live) v else 0;
+                std.mem.writeInt(u64, out[at..][0..8], @bitCast(w + 0), .little);
+                at += 8;
+            }
+        };
+        for (s.history) |v| {
+            const w: f64 = v;
+            std.mem.writeInt(u64, out[at..][0..8], @bitCast(w + 0), .little);
+            at += 8;
+        }
+        return out;
+    }
+};
+
+fn workSize(c: *const model.Circuit) usize {
+    var n: usize = 0;
+    for (c.batches) |*b| n = @max(n, switch (b.*) {
+        .ffn => |*f| f.outs.len + f.up.forms.outputs + f.gate.forms.outputs,
+        .heads => |*h| h.proj.columns() + h.outs.len + 5 * hd + h.proj.forms.outputs,
+    });
+    return n;
+}
