+test "runner guide: opt-in request byte boundaries preserve injection and off behavior" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const user = try json.newObject(a);
+    try user.put(a, "role", .{ .string = "user" });
+    try user.put(a, "content", .{ .string = "Compute 47*83." });
+    var one = [_]Value{.{ .object = user }};
+    const chat: Value = .{ .array = &one };
+    const bytes = try a.alloc(u8, 2049);
+    @memset(bytes, 'x');
+    const Case = struct { limit: usize, len: usize, accept: bool };
+    for ([_]Case{
+        .{ .limit = 512, .len = 512, .accept = true },
+        .{ .limit = 512, .len = 586, .accept = false },
+        .{ .limit = 1024, .len = 586, .accept = true },
+        .{ .limit = 2048, .len = 512, .accept = true },
+        .{ .limit = 2048, .len = 586, .accept = true },
+        .{ .limit = 2048, .len = 2048, .accept = true },
+        .{ .limit = 2048, .len = 2049, .accept = false },
+    }) |c| {
+        const set: Set = .{ .default = "Boot guide", .max_request_bytes = c.limit };
+        try std.testing.expectEqualStrings(try std.fmt.allocPrint(a, "runner_guide must be a string of at most {d} bytes", .{c.limit}), try set.refusal(a));
+        const asked: Value = .{ .string = bytes[0..c.len] };
+        if (c.accept) {
+            const got = try apply(a, &set, asked, chat);
+            try std.testing.expectEqualStrings(bytes[0..c.len], got.guide.?);
+            try std.testing.expectEqualStrings(bytes[0..c.len], got.messages.array[0].strField("content").?);
+            try std.testing.expectEqualStrings("Compute 47*83.", got.messages.array[1].strField("content").?);
+        } else try std.testing.expectError(error.BadGuide, apply(a, &set, asked, chat));
+        const off = try apply(a, null, asked, chat);
+        try std.testing.expect(off.guide == null);
+        try std.testing.expectEqualStrings(try json.stringify(a, chat, .{}), try json.stringify(a, off.messages, .{}));
+        try std.testing.expectEqualStrings("Boot guide", (try apply(a, &set, .null, chat)).guide.?);
+        try std.testing.expectEqualStrings("", (try apply(a, &set, .{ .string = "" }, chat)).guide.?);
+    }
+    const capped: Set = .{ .max_request_bytes = 2048 };
+    @memset(bytes, ' ');
+    try std.testing.expectError(error.BadGuide, apply(a, &capped, .{ .string = bytes }, chat));
+    for (0..1024) |i| {
+        bytes[2 * i] = 0xc3;
+        bytes[2 * i + 1] = 0xa9;
+    }
+    bytes[2048] = 'x';
+    try std.testing.expectEqual(@as(usize, 2048), (try apply(a, &capped, .{ .string = bytes[0..2048] }, chat)).guide.?.len);
+    try std.testing.expectError(error.BadGuide, apply(a, &capped, .{ .string = bytes }, chat));
+}
diff --git a/zig/src/server/runner_live_test.zig b/zig/src/server/runner_live_test.zig
new file mode 100644
index 000000000..7bfaf2e1d
--- /dev/null
+++ b/zig/src/server/runner_live_test.zig
@@ -0,0 +1,183 @@
+//! The runner's live records (Generation.liveCells): a stream the client leaves mid-write keeps a record per write.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const server = @import("server.zig");
+const chat = @import("chat.zig");
+const model_text = @import("model_text.zig");
+const Cx = @import("errors.zig").Cx;
+const Note = @typeInfo(@FieldType(api.Event, "cells")).pointer.child;
+
+const gpa = std.testing.allocator;
+
+/// One byte a token.
+const Bytes = struct {
+    fn text(t: *Bytes) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocab, .eos_ids = eos, .render = render, .template_source = template } };
+    }
+    fn encode(_: *anyopaque, a: std.mem.Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const ids = try a.alloc(u32, input.len);
+        for (input, ids) |byte, *id| id.* = byte;
+        return ids;
+    }
+    fn decode(_: *anyopaque, a: std.mem.Allocator, ids: []const u32) std.mem.Allocator.Error![]u8 {
+        const out = try a.alloc(u8, ids.len);
+        for (out, ids) |*v, id| v.* = @intCast(id);
+        return out;
+    }
+    fn tokenId(_: *anyopaque, _: []const u8) ?u32 {
+        return null;
+    }
+    fn tokenString(_: *anyopaque, a: std.mem.Allocator, id: u32) ![]u8 {
+        return std.fmt.allocPrint(a, "{d}", .{id});
+    }
+    fn vocab(_: *anyopaque) u32 {
+        return 256;
+    }
+    fn eos(_: *anyopaque) []const u32 {
+        return &.{};
+    }
+    fn render(_: *anyopaque, a: std.mem.Allocator, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) model_text.Error!model_text.Rendered {
+        return .{ .text = try a.dupe(u8, "prompt") };
+    }
+    fn template(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+/// What the engine gives in one round: the records as they stand, then the tokens that land them (LaneHost.send).
+const Step = struct { notes: []const Note = &.{}, tokens: []const u8 };
+
+const a0 = "{\"cell\":0,\"form\":\"inline\",\"value\":\"\",\"field\":\"content\",\"at\":9,\"ids\":2,\"landed\":0}";
+const a1 = "{\"cell\":0,\"form\":\"inline\",\"value\":\" 6\",\"field\":\"content\",\"at\":9,\"ids\":2,\"landed\":2}";
+const b0 = "{\"cell\":1,\"form\":\"inline\",\"value\":\"\",\"field\":\"content\",\"at\":22,\"ids\":3,\"landed\":0}";
+const b1 = "{\"cell\":1,\"form\":\"inline\",\"value\":\" 2\",\"field\":\"content\",\"at\":22,\"ids\":3,\"landed\":1}";
+const b2 = "{\"cell\":1,\"form\":\"inline\",\"value\":\" 2!\",\"field\":\"content\",\"at\":22,\"ids\":3,\"landed\":2}";
+
+/// `x = 2*3 = 6. y = 4*5 = 2` then a `!` the stream holds back (stop `!!`): the client leaves inside the second write.
+const steps = [_]Step{
+    .{ .notes = &.{.{ .index = 0, .content = true, .end = 9, .json = a0 }}, .tokens = "x = 2*3 =" },
+    .{ .notes = &.{.{ .index = 0, .content = true, .end = 11, .json = a1 }}, .tokens = " 6" },
+    .{ .notes = &.{.{ .index = 1, .content = true, .end = 22, .json = b0 }}, .tokens = ". y = 4*5 =" },
+    .{ .notes = &.{.{ .index = 1, .content = true, .end = 24, .json = b1 }}, .tokens = " 2" },
+    .{ .notes = &.{.{ .index = 1, .content = true, .end = 25, .json = b2 }}, .tokens = "!" },
+};
+
+/// An engine that gives a round each time the request's thread checks on its client, then sees the client leave.
+const Script = struct {
+    records: bool,
+    sink: ?api.Sink = null,
+    id: api.Id = 0,
+    next: usize = 0,
+    fn engine(s: *Script) api.Engine {
+        return .{ .ctx = s, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 8192 };
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, _: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const s: *Script = @ptrCast(@alignCast(ctx));
+        s.sink = sink;
+        s.id = id;
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        s.round();
+    }
+    fn round(s: *Script) void {
+        const step = steps[s.next];
+        s.next += 1;
+        const sink = s.sink.?;
+        if (s.records) sink.event(sink.ctx, s.id, &.{ .cells = step.notes });
+        var tokens: [16]u32 = undefined;
+        for (step.tokens, 0..) |b, i| tokens[i] = b;
+        sink.event(sink.ctx, s.id, &.{ .tokens = tokens[0..step.tokens.len] });
+    }
+    fn cancel(ctx: *anyopaque, _: api.Id) void {
+        const s: *Script = @ptrCast(@alignCast(ctx));
+        const sink = s.sink.?;
+        sink.event(sink.ctx, s.id, &.{ .finished = .{ .reason = .cancelled } });
+    }
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const Gone = struct {
+    s: *Script,
+    checks: *usize,
+    pub fn check(g: @This()) bool {
+        if (g.s.sink == null) return false; // chat.prepare looks before the engine has the request
+        g.checks.* += 1;
+        if (g.s.next < steps.len) {
+            g.s.round();
+            return false;
+        }
+        return g.checks.* > steps.len + 1; // one more look after the last round, then the client is gone
+    }
+};
+
+/// The client: the text it has, every other delta as JSON, and the newest records with any it got ahead of its bytes.
+const Client = struct {
+    a: std.mem.Allocator,
+    text: std.ArrayList(u8) = .empty,
+    plain: std.ArrayList([]const u8) = .empty,
+    last: ?json.Value = null,
+    sent: usize = 0,
+    ahead: usize = 0,
+    fn call(ctx: *anyopaque, delta: json.Value) error{Closed}!void {
+        const c: *Client = @ptrCast(@alignCast(ctx));
+        if (delta == .object) if (delta.get("tensorfold")) |tf| {
+            const run = tf.get("runner") orelse return error.Closed;
+            for ((run.get("cells") orelse return error.Closed).array) |cell| {
+                const at: usize = @intCast(cell.get("at").?.int64().?);
+                const len = cell.strField("value").?.len;
+                if (at + len > c.text.items.len) c.ahead += 1;
+            }
+            c.last = run;
+            c.sent += 1;
+            return;
+        };
+        c.plain.append(c.a, json.stringify(c.a, delta, .{}) catch return error.Closed) catch return error.Closed;
+        if (delta == .string) c.text.appendSlice(c.a, delta.string) catch return error.Closed;
+    }
+    fn sink(c: *Client) chat.Sink {
+        return .{ .ctx = c, .call = call };
+    }
+};
+
+fn stream(a: std.mem.Allocator, records: bool) !Client {
+    var script: Script = .{ .records = records };
+    var bytes: Bytes = .{};
+    const srv = try server.Server.init(gpa, std.testing.io, script.engine(), bytes.text(), .{ .served_name = "test", .model_ids = &.{"test"}, .enable_thinking = false }, null);
+    defer srv.deinit();
+    var client: Client = .{ .a = a };
+    var checks: usize = 0;
+    var cx: Cx = .{ .a = a };
+    const fields = try json.newObject(a);
+    try fields.put(a, "stop", .{ .string = "!!" });
+    const input: chat.Input = .{ .id = "chatcmpl-live", .prompt = .{ .text = "prompt" }, .max_tokens = 100, .fields = .{ .object = fields } };
+    try std.testing.expectError(error.Cancelled, chat.run(srv, &cx, input, client.sink(), Gone{ .s = &script, .checks = &checks }));
+    try std.testing.expectEqual(steps.len, script.next);
+    return client;
+}
+
+test "runner live records: a client that leaves inside a write has a record for each write it was shown" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const on = try stream(a, true);
+    try std.testing.expectEqualStrings("x = 2*3 = 6. y = 4*5 = 2", on.text.items);
+    try std.testing.expectEqual(0, on.ahead); // never a record whose bytes the client did not yet have
+    try std.testing.expectEqual(4, on.sent); // a0; a1; a1 b0; a1 b1 (not b2: its `!` is held back)
+    const last = on.last.?;
+    try std.testing.expect(last.get("live").?.bool);
+    const want = try json.parse(a, "[" ++ a1 ++ "," ++ b1 ++ "]");
+    try std.testing.expectEqualStrings(try json.stringify(a, want.ok, .{}), try json.stringify(a, last.get("cells").?, .{}));
+    // records off: no records chunk, and every other delta byte for byte the same
+    const off = try stream(a, false);
+    try std.testing.expectEqual(0, off.sent);
+    try std.testing.expectEqual(on.plain.items.len, off.plain.items.len);
+    for (on.plain.items, off.plain.items) |x, y| try std.testing.expectEqualStrings(x, y);
+}
diff --git a/zig/src/server/runner_owned.zig b/zig/src/server/runner_owned.zig
new file mode 100644
index 000000000..3deddf230
--- /dev/null
+++ b/zig/src/server/runner_owned.zig
@@ -0,0 +1,130 @@
+//! A reply segment's engine-owned content bytes: where its runner cells landed, so no strip cuts into them.
+const std = @import("std");
+const json = @import("json");
+const tool_parse = @import("tool_parse.zig");
+const Owned = @import("reply_text.zig").Owned;
+const Allocator = std.mem.Allocator;
+
+/// The owned span of `content` (a slice of `raw`, `pieces` its tokens' bytes) before its first tool envelope, or null.
+pub fn of(a: Allocator, records: []const []const u8, base: usize, pieces: []const []const u8, raw: []const u8, content: []const u8) Allocator.Error!?Owned {
+    if (records.len == 0) return null;
+    const from = @intFromPtr(content.ptr) -% @intFromPtr(raw.ptr); // past raw.len: content is not raw's bytes
+    // each token's first byte in `raw`, which the token bytes must spell exactly (a lossy decode is no map)
+    const at = try a.alloc(usize, pieces.len + 1);
+    at[0] = 0;
+    for (pieces, 0..) |p, i| {
+        at[i + 1] = at[i] + p.len;
+        if (at[i + 1] > raw.len or !std.mem.eql(u8, raw[at[i]..at[i + 1]], p)) return null;
+    }
+    if (at[pieces.len] != raw.len) return null;
+    const envs = try tool_parse.envelopes(a, content);
+    const limit = if (envs.len > 0) envs[0].start else content.len;
+    var span: ?Owned = null;
+    for (records) |text| {
+        const r = switch (try json.parse(a, text)) {
+            .ok => |v| v,
+            .err => continue,
+        };
+        if (!std.mem.eql(u8, r.strField("field") orelse "", "content")) continue;
+        const token = std.math.cast(usize, (r.get("token") orelse continue).int64() orelse continue) orelse continue;
+        const landed = std.math.cast(usize, (r.get("landed") orelse continue).int64() orelse continue) orelse continue;
+        if (token < base or token - base >= pieces.len) continue; // another segment's write
+        const lo = at[token - base];
+        const hi = at[@min(token - base + landed, pieces.len)];
+        if (lo < from or hi - from > limit or hi == lo) continue; // outside the content, in or past a call, or no bytes
+        span = Owned.join(span, .{ .lo = lo - from, .hi = hi - from });
+    }
+    return span;
+}
+
+fn record(a: Allocator, field: []const u8, token: usize, landed: usize) ![]const u8 {
+    return std.fmt.allocPrint(a, "{{\"cell\":0,\"field\":\"{s}\",\"token\":{d},\"landed\":{d}}}", .{ field, token, landed });
+}
+
+test "runner projection: owned span is the landed tokens' bytes in the content, by the segment's base" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const pieces = [_][]const u8{ "plan", "</think>", "[2^66 = ", "73786976294838206464]", "\n", "<tool_call>{\"name\":\"f\"}</tool_call>" };
+    const raw = try std.mem.concat(a, u8, &pieces);
+    const content = raw["plan</think>".len..];
+    const trace = try record(a, "content", 7, 3);
+    try std.testing.expectEqual(Owned{ .lo = 0, .hi = 30 }, (try of(a, &.{trace}, 5, &pieces, raw, content)).?);
+    // the same write, read as a later segment's (base past it), or as reasoning: none
+    try std.testing.expectEqual(null, try of(a, &.{trace}, 8, &pieces, raw, content));
+    try std.testing.expectEqual(null, try of(a, &.{try record(a, "reasoning", 7, 3)}, 5, &pieces, raw, content));
+    try std.testing.expectEqual(null, try of(a, &.{try record(a, "content", 7, 0)}, 5, &pieces, raw, content));
+    try std.testing.expectEqual(null, try of(a, &.{try record(a, "content", 12, 1)}, 5, &pieces, raw, content));
+    // a write that lands in the call block owns nothing the prose keeps
+    try std.testing.expectEqual(Owned{ .lo = 0, .hi = 30 }, (try of(a, &.{ trace, try record(a, "content", 10, 1) }, 5, &pieces, raw, content)).?);
+    try std.testing.expectEqual(null, try of(a, &.{try record(a, "content", 10, 1)}, 5, &pieces, raw, content));
+    // token bytes that do not spell the decoded text, or content that is not its slice: no proof, so none
+    const lossy = [_][]const u8{ "plan", "</think>", "[2^66 = ", "73786976294838206464]", "\r", pieces[5] };
+    try std.testing.expectEqual(null, try of(a, &.{trace}, 5, &lossy, raw, content));
+    try std.testing.expectEqual(null, try of(a, &.{trace}, 5, &pieces, raw, try a.dupe(u8, content)));
+}
+
+test "runner projection: owned bytes stay through the finish strip, the cut strip and tool parsing" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const reply_text = @import("reply_text.zig");
+    const trace = "[exact, computed by the engine: 2^66 = 73786976294838206464]\n";
+    const call = "<tool_call>{\"name\":\"f\",\"arguments\":{}}</tool_call>";
+    const text = trace ++ "\n" ++ call;
+    const own: Owned = .{ .lo = 0, .hi = trace.len };
+    try std.testing.expectEqualStrings(trace, try expectValid(try reply_text.finishedProse(a, text, own)));
+    try std.testing.expectEqualStrings(trace[0 .. trace.len - 1], try expectValid(try reply_text.finishedProse(a, text, null)));
+    try std.testing.expectEqualStrings(trace[0 .. trace.len - 1], try expectValid(try reply_text.finishedProse(a, text, .{ .lo = 0, .hi = text.len })));
+    try std.testing.expectEqualStrings(trace, try expectValid(try reply_text.cutProse(a, trace ++ "\n<tool_call>{\"name\":\"f\",\"argu", own)));
+    const tools = [_]json.Value{(try json.parse(a, "{\"type\":\"function\",\"function\":{\"name\":\"f\",\"parameters\":{\"type\":\"object\",\"properties\":{}}}}")).ok};
+    const parsed = try tool_parse.parseOwned(a, " \n" ++ text, &tools, null, .{ .lo = 2, .hi = 2 + trace.len });
+    try std.testing.expectEqualStrings(trace, try expectValid(parsed.content));
+    try std.testing.expectEqual(Owned{ .lo = 0, .hi = trace.len }, parsed.owned.?);
+    // an owned lead blank stays too, and a span past the text is no offsets of it
+    try std.testing.expectEqualStrings(" 7\n", try expectValid(reply_text.stripOwned("\n 7\n\n", .{ .lo = 1, .hi = 4 })));
+    try std.testing.expectEqualStrings("7", try expectValid(reply_text.stripOwned("\n 7\n\n", .{ .lo = 1, .hi = 9 })));
+}
+
+/// One byte a token, as T5's counterexample tokenizes it.
+fn bytePieces(a: Allocator, raw: []const u8) ![]const []const u8 {
+    const pieces = try a.alloc([]const u8, raw.len);
+    for (pieces, 0..) |*p, i| p.* = raw[i..][0..1];
+    return pieces;
+}
+
+fn expectValid(s: []const u8) ![]const u8 {
+    try std.testing.expect(std.unicode.utf8ValidateSlice(s));
+    return s;
+}
+
+test "runner projection: owned trim limits widen to whole code points, so no trim leaves invalid UTF-8" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const reply_text = @import("reply_text.zig");
+    const call = "<tool_call>{\"name\":\"f\",\"arguments\":{}}</tool_call>";
+    const tools = [_]json.Value{(try json.parse(a, "{\"type\":\"function\",\"function\":{\"name\":\"f\",\"parameters\":{\"type\":\"object\",\"properties\":{}}}}")).ok};
+    // T5-OWNED-WS-REVIEW: raw 78 0a c2 a0, a record owning only the C2 of U+00A0, then a whole call
+    const raw = "x\n\u{a0}" ++ call;
+    const own = (try of(a, &.{try record(a, "content", 2, 1)}, 0, try bytePieces(a, raw), raw, raw)).?;
+    try std.testing.expectEqual(Owned{ .lo = 2, .hi = 3 }, own);
+    try std.testing.expectEqualStrings("x\n\u{a0}", try expectValid((try tool_parse.parseOwned(a, raw, &tools, null, own)).content));
+    try std.testing.expectEqualStrings("x\n\u{a0}", try expectValid(try reply_text.finishedProse(a, raw, own)));
+    // right and left ends inside 2-, 3- and 4-byte code points (U+00A0, U+3000, U+1F600); none takes four as a blank
+    const Case = struct { text: []const u8, own: Owned, want: []const u8 };
+    const cases = [_]Case{
+        .{ .text = "x\n\u{3000}\n", .own = .{ .lo = 2, .hi = 3 }, .want = "x\n\u{3000}" },
+        .{ .text = "x\n\u{3000}\n", .own = .{ .lo = 3, .hi = 4 }, .want = "x\n\u{3000}" },
+        .{ .text = "x \u{1f600}\u{a0}", .own = .{ .lo = 3, .hi = 4 }, .want = "x \u{1f600}" },
+        .{ .text = "\n\u{a0}x", .own = .{ .lo = 2, .hi = 3 }, .want = "\u{a0}x" },
+        .{ .text = "\u{3000}x\n", .own = .{ .lo = 1, .hi = 2 }, .want = "\u{3000}x" },
+        .{ .text = "\u{3000}x\n", .own = .{ .lo = 2, .hi = 4 }, .want = "\u{3000}x" },
+        .{ .text = "\n\u{1f600}x ", .own = .{ .lo = 2, .hi = 3 }, .want = "\u{1f600}x" },
+    };
+    for (cases) |c| {
+        try std.testing.expectEqualStrings(c.want, try expectValid(reply_text.stripOwned(c.text, c.own)));
+        const parsed = try tool_parse.parseOwned(a, try std.mem.concat(a, u8, &.{ c.text, call }), &tools, null, c.own);
+        try std.testing.expectEqualStrings(c.want, try expectValid(parsed.content));
+    }
+}
diff --git a/zig/src/server/runner_owned_http_test.zig b/zig/src/server/runner_owned_http_test.zig
new file mode 100644
index 000000000..8aa44deec
--- /dev/null
+++ b/zig/src/server/runner_owned_http_test.zig
@@ -0,0 +1,207 @@
+//! Runner-owned trace lines beside tool calls (AB3 t02): their bytes reach the client whole, lane or not, cut or not.
+const std = @import("std");
+const json = @import("json");
+const api = @import("engine_api");
+const HfText = @import("hf_text.zig").HfText;
+const tf = @import("control_tokens_fixture.zig");
+const lane_test = @import("compute_lane_http_test.zig");
+const lane = api.compute_lane;
+const t = std.testing;
+const Allocator = std.mem.Allocator;
+const Note = @typeInfo(@FieldType(api.Event, "cells")).pointer.child;
+
+/// An owned write in a segment: its first token's offset there and its token count.
+const Write = struct { at: usize, n: usize };
+
+/// An engine that gives each segment after the last resume, its records first; held at each EOS, else cut (length).
+const Script = struct {
+    a: Allocator,
+    segments: []const []const u32, // each its EOS last
+    writes: []const []const Write, // per segment
+    sink: ?api.Sink = null,
+    id: api.Id = 0,
+    sent: usize = 0, // the reply's tokens so far, the inserted results' too: what a record's `token` counts
+    next: usize = 0,
+    records: usize = 0,
+
+    fn engine(s: *@This()) api.Engine {
+        return .{ .ctx = s, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory, .resume_held = resumeHeld } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 32768 };
+    }
+    fn segment(s: *@This()) void {
+        const sink = s.sink.?;
+        var notes: std.ArrayList(Note) = .empty;
+        for (s.writes[s.next]) |w| {
+            const text = std.fmt.allocPrint(s.a, "{{\"cell\":{d},\"form\":\"trace\",\"field\":\"content\",\"token\":{d},\"ids\":{d},\"landed\":{d}}}", .{ s.records, s.sent + w.at, w.n, w.n }) catch unreachable;
+            notes.append(s.a, .{ .index = @intCast(s.records), .content = true, .end = 0, .json = text }) catch unreachable;
+            s.records += 1;
+        }
+        if (notes.items.len > 0) sink.event(sink.ctx, s.id, &.{ .cells = notes.items });
+        sink.event(sink.ctx, s.id, &.{ .tokens = s.segments[s.next] });
+        s.sent += s.segments[s.next].len;
+        s.next += 1;
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const s: *@This() = @ptrCast(@alignCast(ctx));
+        s.sink = sink;
+        s.id = id;
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        s.segment();
+        if (!request.hold_eos) sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .length } });
+    }
+    fn resumeHeld(ctx: *anyopaque, id: api.Id, r: api.Resume) void {
+        const s: *@This() = @ptrCast(@alignCast(ctx));
+        const sink = s.sink.?;
+        if (r.tokens.len == 0 or s.next == s.segments.len) return sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+        sink.event(sink.ctx, id, &.{ .tokens = r.tokens });
+        s.sent += r.tokens.len;
+        s.segment();
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+/// The reply, whole or as the stream's content deltas added up.
+const Reply = struct {
+    a: Allocator,
+    code: u16 = 0,
+    body: json.Value = .null,
+    content: std.ArrayList(u8) = .empty,
+    calls: bool = false,
+    fn out(r: *@This()) @import("openai.zig").Out {
+        return .{ .ctx = r, .vt = &.{ .open = open, .event = event, .reply = reply } };
+    }
+    fn open(_: *anyopaque, _: usize) error{Closed}!void {}
+    fn event(ctx: *anyopaque, value: ?json.Value) error{Closed}!void {
+        const r: *@This() = @ptrCast(@alignCast(ctx));
+        const cs = ((value orelse return).get("choices") orelse return).array;
+        if (cs.len == 0) return;
+        const d = cs[0].get("delta") orelse return;
+        r.calls = r.calls or d.get("tool_calls") != null;
+        r.content.appendSlice(r.a, json.strOr(d.get("content"))) catch return error.Closed;
+    }
+    fn reply(ctx: *anyopaque, code: u16, v: json.Value) void {
+        const r: *@This() = @ptrCast(@alignCast(ctx));
+        r.code = code;
+        r.body = v;
+    }
+};
+
+const trace = "[exact, computed by the engine: 2^66 = 73786976294838206464]\n";
+const later = "[exact, computed by the engine: 2^66 + 1 = 73786976294838206465]\n";
+
+/// The template's tokens for an assistant turn making `call` after `history` (its EOS last).
+fn callTokens(a: Allocator, text: anytype, history: json.Value, call: []const u8) ![]const u32 {
+    var problem: []const u8 = "";
+    const turn = try lane_test.obj(a, call);
+    const asked = try text.renderIds(a, history, .{ .add_generation_prompt = true }, &problem);
+    const called = try text.renderIds(a, try lane_test.appendTo(a, history, &.{turn}), .{ .add_generation_prompt = false }, &problem);
+    try t.expect(std.mem.startsWith(u32, called, asked));
+    return called[asked.len..];
+}
+
+/// The t02 shape twice: an owned trace line, then the lane's python call; a longer one, then a client's call.
+fn run(a: Allocator, stream: bool) !Reply {
+    const python = "/usr/bin/python3";
+    std.Io.Dir.accessAbsolute(t.io, python, .{}) catch return error.SkipZigTest;
+    var tmp = try lane_test.fixture(a);
+    defer tmp.deinit();
+    var problem: []const u8 = "";
+    const hf = try HfText.load(a, t.io, tmp.path, null, a, &problem);
+    defer hf.deinit();
+    const text = hf.text();
+    const history = try tf.messages(a, "What is 2^66?");
+    const py = try callTokens(a, text, history,
+        \\{"role":"assistant","content":"","tool_calls":[{"id":"c1","type":"function","function":{"name":"python","arguments":"{\"code\":\"print(2**66)\"}"}}]}
+    );
+    const f = try callTokens(a, text, history,
+        \\{"role":"assistant","content":"","tool_calls":[{"id":"c2","type":"function","function":{"name":"f","arguments":"{}"}}]}
+    );
+    const first = try text.encodePlain(a, trace);
+    const second = try text.encodePlain(a, later);
+    try t.expect(second.len > first.len);
+    var script: Script = .{
+        .a = a,
+        .segments = &.{ try std.mem.concat(a, u32, &.{ first, py }), try std.mem.concat(a, u32, &.{ second, f }) },
+        // the first segment's second record lands inside the python call: no byte the prose keeps
+        .writes = &.{ &.{ .{ .at = 0, .n = first.len }, .{ .at = first.len + py.len / 2, .n = 1 } }, &.{.{ .at = 0, .n = second.len }} },
+    };
+    const srv = try @import("server.zig").Server.init(a, t.io, script.engine(), text, .{ .served_name = "m", .model_ids = &.{"m"}, .enable_thinking = false, .use_drafts = false }, null);
+    defer srv.deinit();
+    const cfg: lane.Config = .{ .python = python };
+    srv.info.compute = cfg;
+    srv.compute = lane.Pool.init(cfg, &.{ "/bin/sh", "-c", "exec \"$0\" -I -B -u -c \"$1\"", python, lane.runner.runner });
+    var reply: Reply = .{ .a = a };
+    var conn = try @import("http_conn.zig").Conn.init(a, -1, "fixture");
+    defer conn.deinit();
+    const body = try json.newObject(a);
+    try body.put(a, "model", .{ .string = "m" });
+    try body.put(a, "max_tokens", try json.intValue(a, 600));
+    try body.put(a, "stream", .{ .bool = stream });
+    try body.put(a, "messages", history);
+    try body.put(a, "tools", try lane_test.obj(a, "[{\"type\":\"code_interpreter\"},{\"type\":\"function\",\"function\":{\"name\":\"f\",\"parameters\":{\"type\":\"object\",\"properties\":{}}}}]"));
+    @import("openai.zig").run(srv, a, reply.out(), .{ .conn = &conn }, true, .{ .object = body });
+    try t.expectEqual(@as(usize, 2), script.next); // the python result went in, the client's call ended the reply
+    return reply;
+}
+
+test "compute lane: owned trace lines before the lane's call and a client's call keep their newlines, whole and streamed" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const whole = try run(a, false);
+    errdefer std.debug.print("OWNED_REPLY {s}\n", .{json.stringify(a, whole.body, .{}) catch ""});
+    try t.expectEqual(@as(u16, 200), whole.code);
+    const choice = whole.body.get("choices").?.array[0];
+    try t.expectEqualStrings("tool_calls", choice.get("finish_reason").?.string);
+    try t.expectEqualStrings(trace ++ later, choice.get("message").?.strField("content").?);
+    const streamed = try run(a, true);
+    try t.expect(streamed.calls);
+    try t.expectEqualStrings(trace ++ later, streamed.content.items);
+}
+
+/// The same line after a word (a reply led by `[` streams no call), then a call max_tokens cuts, without the lane.
+fn cut(a: Allocator, stream: bool) !Reply {
+    var bytes: @import("runner_projection_http_test.zig").Bytes = .{};
+    const said = "So:\n" ++ trace ++ "\n<tool_call>\n<function=write_file>\n<parameter=path>\nnotes.txt\n</parameter>\n<parameter=content>\nThe history of";
+    const reply = try a.alloc(u32, said.len);
+    for (said, reply) |b, *id| id.* = b;
+    var script: Script = .{ .a = a, .segments = &.{reply}, .writes = &.{&.{.{ .at = 4, .n = trace.len }}} };
+    const srv = try @import("server.zig").Server.init(a, t.io, script.engine(), bytes.text(), .{ .served_name = "m", .model_ids = &.{"m"}, .enable_thinking = false, .use_drafts = false }, null);
+    defer srv.deinit();
+    var out: Reply = .{ .a = a };
+    var conn = try @import("http_conn.zig").Conn.init(a, -1, "fixture");
+    defer conn.deinit();
+    const body = try json.newObject(a);
+    try body.put(a, "model", .{ .string = "m" });
+    try body.put(a, "max_tokens", try json.intValue(a, reply.len));
+    try body.put(a, "stream", .{ .bool = stream });
+    try body.put(a, "messages", try lane_test.obj(a, "[{\"role\":\"user\",\"content\":\"What is 2^66?\"}]"));
+    try body.put(a, "tools", try lane_test.obj(a, "[{\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}}}}}]"));
+    @import("openai.zig").run(srv, a, out.out(), .{ .conn = &conn }, true, .{ .object = body });
+    return out;
+}
+
+test "runner projection: HTTP an owned trace line before a call max_tokens cut keeps its newline, whole and streamed" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const whole = try cut(a, false);
+    errdefer std.debug.print("OWNED_CUT_REPLY {s}\n", .{json.stringify(a, whole.body, .{}) catch ""});
+    try t.expectEqual(@as(u16, 200), whole.code);
+    const choice = whole.body.get("choices").?.array[0];
+    try t.expectEqualStrings("length", choice.get("finish_reason").?.string);
+    const calls = choice.get("message").?.get("tool_calls") orelse .null;
+    try t.expect(calls != .null);
+    try t.expectEqualStrings("So:\n" ++ trace, choice.get("message").?.strField("content").?);
+    const streamed = try cut(a, true);
+    try t.expect(streamed.calls);
+    try t.expectEqualStrings("So:\n" ++ trace, streamed.content.items);
+}
diff --git a/zig/src/server/runner_projection.zig b/zig/src/server/runner_projection.zig
new file mode 100644
index 000000000..f50b621f8
--- /dev/null
+++ b/zig/src/server/runner_projection.zig
@@ -0,0 +1,192 @@
+//! Runner receipt anchors projected from the engine's raw field bytes into the reply's fields as the client gets them.
+const std = @import("std");
+const json = @import("json");
+const reply_text = @import("reply_text.zig");
+const tool_parse = @import("tool_parse.zig");
+const model_text = @import("model_text.zig");
+const chat = @import("chat.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+/// One field's map: final byte p is raw byte `lead + p`, for p in [0, kept].
+pub const Map = struct { raw: usize, lead: usize, kept: usize };
+
+/// The runner's field bytes as runner_text.zig keeps them (none for the think close); null without token bytes.
+pub fn rawFields(a: Allocator, text: model_text.Text, tokens: []const u32, think_end: ?u32) Allocator.Error!?[2][]const u8 {
+    if (text.vtable.token_bytes == null) return null;
+    var fields: [2]std.ArrayList(u8) = .{ .empty, .empty };
+    var field: usize = if (think_end == null) 1 else 0;
+    for (tokens) |t| {
+        if (field == 0 and t == think_end.?) {
+            field = 1;
+            continue;
+        }
+        try fields[field].appendSlice(a, (try text.tokenBytes(a, t)) orelse "");
+    }
+    return .{ fields[0].items, fields[1].items };
+}
+
+/// The final field as the one raw run with only blanks and whole tool envelopes outside; else null (bad UTF-8, cuts).
+pub fn mapOf(a: Allocator, raw: []const u8, final: []const u8, open: []const u8) Allocator.Error!?Map {
+    if (!std.unicode.utf8ValidateSlice(raw) or !std.unicode.utf8ValidateSlice(final)) return null;
+    const body: usize = if (open.len > 0 and std.mem.startsWith(u8, raw, open)) open.len else 0;
+    const cut = try Cut.of(a, raw, try tool_parse.envelopes(a, raw), body);
+    if (final.len == 0) return if (cut.before[raw.len]) .{ .raw = raw.len, .lead = raw.len, .kept = 0 } else null;
+    var found: ?Map = null;
+    var from = body;
+    while (std.mem.indexOfPos(u8, raw, from, final)) |lead| : (from = lead + 1) {
+        if (!cut.before[lead] or !cut.after[lead + final.len]) continue;
+        if (found != null) return null; // two runs fit: no provenance
+        found = .{ .raw = raw.len, .lead = lead, .kept = final.len };
+    }
+    return found;
+}
+
+/// Per raw byte p: raw[body..p] (`before`) and raw[p..] (`after`) are only blanks and whole envelopes, none across p.
+const Cut = struct {
+    before: []bool,
+    after: []bool,
+
+    /// One pass each way over the envelopes (sorted, apart); an unfinished one (to EOF) is no proof of deletion.
+    fn of(a: Allocator, raw: []const u8, envs: []const tool_parse.Envelope, body: usize) Allocator.Error!Cut {
+        const c: Cut = .{ .before = try a.alloc(bool, raw.len + 1), .after = try a.alloc(bool, raw.len + 1) };
+        @memset(c.before, false);
+        @memset(c.after, false);
+        var ok = true;
+        var p = body;
+        for (envs) |e| if (e.end > body) {
+            ok = if (e.start < body) false else gap(c.before, raw, p, e.start, ok, true) and e.complete;
+            p = e.end;
+        };
+        _ = gap(c.before, raw, p, raw.len, ok, true);
+        ok = true;
+        var q = raw.len;
+        var i = envs.len;
+        while (i > 0 and envs[i - 1].end > body) : (i -= 1) {
+            const e = envs[i - 1];
+            ok = gap(c.after, raw, e.end, q, ok, false) and e.complete;
+            q = e.start;
+            if (q < body) return c;
+        }
+        _ = gap(c.after, raw, body, q, ok, false);
+        return c;
+    }
+
+    /// Marks the code point starts of raw[from..to] reached from its envelope side through blanks; true when all blank.
+    fn gap(marks: []bool, raw: []const u8, from: usize, to: usize, ok: bool, head: bool) bool {
+        const g = raw[from..to];
+        const s = reply_text.pyStrip(g);
+        const lead = if (s.len == 0) g.len else @intFromPtr(s.ptr) - @intFromPtr(g.ptr);
+        const tail = if (s.len == 0) g.len else g.len - lead - s.len;
+        const lo, const hi = if (head) .{ from, from + lead + 1 } else .{ to - tail, to + 1 };
+        if (ok) for (lo..hi) |i| {
+            marks[i] = i == raw.len or raw[i] & 0xc0 != 0x80; // inside a multibyte blank: half of it is no deletion
+        };
+        return ok and s.len == 0;
+    }
+};
+
+/// The reasoning and content a stream sent, read off each chunk as the client gets it.
+pub const Sent = struct {
+    fields: [2]std.ArrayList(u8) = .{ .empty, .empty },
+    streamed: bool = false,
+
+    pub fn seen(s: *Sent, a: Allocator, payload: Value) Allocator.Error!Value {
+        s.streamed = true;
+        const choices = (payload.get("choices") orelse return payload).items() orelse return payload;
+        if (choices.len == 0) return payload;
+        const c = choices[0];
+        if (c.get("delta")) |d| {
+            try s.fields[0].appendSlice(a, json.strOr(d.get("reasoning_content")));
+            try s.fields[1].appendSlice(a, json.strOr(d.get("content")));
+        } else try s.fields[1].appendSlice(a, json.strOr(c.get("text")));
+        return payload;
+    }
+};
+
+/// The runtime with abstain anchors mapped onto the fields the client got: as sent, else after tool parsing.
+pub fn runtimeOf(a: Allocator, reply: *const chat.Reply, sent: *const Sent, is_chat: bool) Allocator.Error!Value {
+    const raw = reply.runner_raw orelse return reply.runtime;
+    const runner = reply.runtime.get("runner") orelse return reply.runtime;
+    const got: [2][]const u8 = if (sent.streamed) .{ sent.fields[0].items, sent.fields[1].items } else .{ if (is_chat) reply.reasoning orelse "" else "", reply.content };
+    try apply(a, runner, .{ try mapOf(a, raw[0], got[0], "<think>"), try mapOf(a, raw[1], got[1], "") });
+    return reply.runtime;
+}
+
+fn project(m: ?Map, raw: ?i64) ?usize {
+    const map = m orelse return null;
+    const r = std.math.cast(usize, raw orelse return null) orelse return null;
+    if (r < map.lead or r - map.lead > map.kept) return null; // in a dropped head or tail: no final byte
+    return r - map.lead;
+}
+
+fn put(a: Allocator, o: *json.Object, key: []const u8, n: ?usize) !void {
+    try o.put(a, key, if (n) |v| try json.intValue(a, v) else .null);
+}
+
+fn mapValue(a: Allocator, m: ?Map) !Value {
+    const map = m orelse return .null;
+    const o = try json.newObject(a);
+    try put(a, o, "raw_bytes", map.raw);
+    try put(a, o, "dropped_lead", map.lead);
+    try put(a, o, "final_bytes", map.kept);
+    return .{ .object = o };
+}
+
+fn fieldOf(v: Value, key: []const u8) ?usize {
+    const name = v.strField(key) orelse return null;
+    if (std.mem.eql(u8, name, "reasoning")) return 0;
+    if (std.mem.eql(u8, name, "content")) return 1;
+    return null;
+}
+
+const anchors = [_][]const u8{ "source_at", "source_end", "source_close_at", "resume_at" };
+
+/// A raw anchor that is no byte offset (negative, past the bytes rebuilt here, not an i64): that field has no map.
+fn bound(maps: *[2]?Map, i: ?usize, raw: ?Value) void {
+    const f = i orelse return;
+    const m = maps[f] orelse return;
+    const v = raw orelse return;
+    if (v == .null) return;
+    const r = v.int64() orelse return {
+        maps[f] = null;
+    };
+    if (r < 0 or r > m.raw) maps[f] = null;
+}
+
+/// With abstain records only: `field_projection`, cells' `final_at`, abstain anchors in final bytes (raw: `raw_*`).
+pub fn apply(a: Allocator, runner: Value, given: [2]?Map) !void {
+    const abstains = runner.get("abstains") orelse return;
+    const cells = if (runner.get("cells")) |c| c.items() orelse &.{} else &.{};
+    var maps = given;
+    for (cells) |c| bound(&maps, fieldOf(c, "field"), c.get("at"));
+    for (abstains.items() orelse &.{}) |x| for (anchors) |key|
+        bound(&maps, fieldOf(x, if (key[0] == 'r') "resume_field" else "source_field"), x.get(key));
+    const fields = try json.newObject(a);
+    try fields.put(a, "reasoning", try mapValue(a, maps[0]));
+    try fields.put(a, "content", try mapValue(a, maps[1]));
+    try runner.object.put(a, "field_projection", .{ .object = fields });
+    for (cells) |c| if (c == .object) {
+        const m = if (fieldOf(c, "field")) |f| maps[f] else null;
+        try put(a, c.object, "final_at", project(m, if (c.get("at")) |v| v.int64() else null));
+    };
+    for (abstains.items() orelse &.{}) |x| if (x == .object) for (anchors) |key| {
+        const raw = x.object.get(key) orelse continue;
+        const f = fieldOf(x, if (key[0] == 'r') "resume_field" else "source_field");
+        try x.object.put(a, try std.mem.concat(a, u8, &.{ "raw_", key }), raw);
+        try put(a, x.object, key, project(if (f) |i| maps[i] else null, raw.int64()));
+    };
+}
+
+test "runner projection: deletable cuts fall only between code points, never inside a multibyte blank" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_][]const u8{ "\u{a0}", "\u{3000}" }) |blank| { // two- and three-byte blanks (none takes four bytes)
+        const c = try Cut.of(a, blank, &.{}, 0);
+        for (0..blank.len + 1) |i| {
+            try std.testing.expectEqual(i == 0 or i == blank.len, c.before[i]);
+            try std.testing.expectEqual(i == 0 or i == blank.len, c.after[i]);
+        }
+    }
+}
diff --git a/zig/src/server/runner_projection_http_test.zig b/zig/src/server/runner_projection_http_test.zig
new file mode 100644
index 000000000..4587ed4fa
--- /dev/null
+++ b/zig/src/server/runner_projection_http_test.zig
@@ -0,0 +1,438 @@
+//! Abstain anchors through the OpenAI HTTP handler: raw runner bytes projected into the final fields.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const openai = @import("openai.zig");
+const projection = @import("runner_projection.zig");
+const Server = @import("server.zig").Server;
+const Conn = @import("http_conn.zig").Conn;
+const model_text = @import("model_text.zig");
+const Allocator = std.mem.Allocator;
+
+const close_id: u32 = 300;
+const eos_id: u32 = 301;
+
+/// One byte a token below 256 (255 decodes lossily to U+FFFD, its token bytes stay FF); 300 is `</think>`, 301 EOS.
+pub const Bytes = struct {
+    pub fn text(t: *Bytes) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocab, .eos_ids = eos, .render = render, .template_source = template, .token_bytes = tokenBytes } };
+    }
+    fn encode(_: *anyopaque, a: Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const ids = try a.alloc(u32, input.len);
+        for (input, ids) |byte, *id| id.* = byte;
+        return ids;
+    }
+    fn decode(_: *anyopaque, a: Allocator, ids: []const u32) Allocator.Error![]u8 {
+        var out: std.ArrayList(u8) = .empty;
+        for (ids) |id| if (id == close_id) try out.appendSlice(a, "</think>") else if (id == 255) try out.appendSlice(a, "\u{fffd}") else if (id < 256) try out.append(a, @intCast(id));
+        return out.items;
+    }
+    fn tokenBytes(_: *anyopaque, a: Allocator, id: u32) Allocator.Error!?[]u8 {
+        if (id == close_id) return try a.dupe(u8, "</think>");
+        return if (id < 256) try a.dupe(u8, &.{@intCast(id)}) else null;
+    }
+    fn tokenId(_: *anyopaque, piece: []const u8) ?u32 {
+        return if (std.mem.eql(u8, piece, "</think>")) close_id else null;
+    }
+    fn tokenString(_: *anyopaque, a: Allocator, id: u32) ![]u8 {
+        return std.fmt.allocPrint(a, "{d}", .{id});
+    }
+    fn vocab(_: *anyopaque) u32 {
+        return 302;
+    }
+    fn eos(_: *anyopaque) []const u32 {
+        return &.{eos_id};
+    }
+    fn render(_: *anyopaque, a: Allocator, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) model_text.Error!model_text.Rendered {
+        return .{ .text = try a.dupe(u8, "prompt") };
+    }
+    fn template(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+/// Gives its tokens in one round, then ends (stop) with its runner receipt.
+const Script = struct {
+    tokens: []const u32,
+    receipt: []const u8,
+    fn engine(s: *Script) api.Engine {
+        return .{ .ctx = s, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 8192 };
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, _: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const s: *Script = @ptrCast(@alignCast(ctx));
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        sink.event(sink.ctx, id, &.{ .tokens = s.tokens });
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop, .runner = s.receipt } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const Reply = struct {
+    a: Allocator,
+    status: ?u16 = null,
+    whole: ?json.Value = null,
+    events: std.ArrayList(json.Value) = .empty,
+    fn out(r: *Reply) openai.Out {
+        return .{ .ctx = r, .vt = &.{ .open = open, .event = event, .reply = reply } };
+    }
+    fn open(_: *anyopaque, _: usize) error{Closed}!void {}
+    fn event(ctx: *anyopaque, value: ?json.Value) error{Closed}!void {
+        const r: *Reply = @ptrCast(@alignCast(ctx));
+        if (value) |v| r.events.append(r.a, v) catch return error.Closed;
+    }
+    fn reply(ctx: *anyopaque, status_code: u16, value: json.Value) void {
+        const r: *Reply = @ptrCast(@alignCast(ctx));
+        r.status = status_code;
+        r.whole = value;
+    }
+};
+
+/// The client's fields (whole, or the stream's deltas added up), the receipt's runner block, and any tool calls.
+const Got = struct { reasoning: []const u8, content: []const u8, runner: json.Value, calls: bool = false };
+
+/// A thinking chat reply of `reasoning`, the close token and `content`, through openai.run.
+fn post(a: Allocator, reasoning: []const u8, content: []const u8, receipt: []const u8, stream: bool) !Got {
+    return postWith(a, reasoning, content, receipt, stream, "");
+}
+
+/// As `post`; `extra`: more request fields, each led by a comma (tools).
+fn postWith(a: Allocator, reasoning: []const u8, content: []const u8, receipt: []const u8, stream: bool, extra: []const u8) !Got {
+    var ids: std.ArrayList(u32) = .empty;
+    for (reasoning) |b| try ids.append(a, b);
+    try ids.append(a, close_id);
+    for (content) |b| try ids.append(a, b);
+    try ids.append(a, eos_id);
+    var s: Script = .{ .tokens = ids.items, .receipt = receipt };
+    var bytes: Bytes = .{};
+    const srv = try Server.init(std.testing.allocator, std.testing.io, s.engine(), bytes.text(), .{ .served_name = "m", .model_ids = &.{"m"}, .use_drafts = false }, null);
+    defer srv.deinit();
+    const text = try std.fmt.allocPrint(a, "{{\"model\":\"m\",\"messages\":[{{\"role\":\"user\",\"content\":\"hi\"}}],\"max_tokens\":500,\"stream\":{}{s}}}", .{ stream, extra });
+    var conn = Conn{ .fd = -1, .peer = "", .buf = &.{}, .gpa = a };
+    var response = Reply{ .a = a };
+    openai.run(srv, a, response.out(), .{ .conn = &conn }, true, (try json.parse(a, text)).ok);
+    if (!stream) {
+        const m = response.whole.?.get("choices").?.array[0].get("message").?;
+        return .{ .reasoning = json.strOr(m.get("reasoning_content")), .content = json.strOr(m.get("content")), .runner = response.whole.?.get("tensorfold").?.get("runner").?, .calls = m.get("tool_calls") != null };
+    }
+    var r: std.ArrayList(u8) = .empty;
+    var c: std.ArrayList(u8) = .empty;
+    var runner: ?json.Value = null;
+    var calls = false;
+    for (response.events.items) |v| {
+        if (v.get("tensorfold")) |t| if (t.get("runner")) |x| if (x.get("live") == null) {
+            runner = x;
+        };
+        const cs = (v.get("choices") orelse continue).array;
+        if (cs.len == 0) continue;
+        const d = cs[0].get("delta") orelse continue;
+        calls = calls or d.get("tool_calls") != null;
+        try r.appendSlice(a, json.strOr(d.get("reasoning_content")));
+        try c.appendSlice(a, json.strOr(d.get("content")));
+    }
+    return .{ .reasoning = r.items, .content = c.items, .runner = runner orelse return error.MissingReceipt, .calls = calls };
+}
+
+fn num(v: json.Value, key: []const u8) ?i64 {
+    return (v.get(key) orelse return null).int64();
+}
+
+/// Each abstain's final [source_at, source_end) holds its source in the field the client has; raw_* keeps the engine's.
+fn expectAbstain(got: Got, i: usize, source: []const u8, raw: [4]?i64, final: [4]?i64) !void {
+    const x = got.runner.get("abstains").?.array[i];
+    for ([_][]const u8{ "source_at", "source_end", "source_close_at", "resume_at" }, raw, final) |key, want_raw, want| {
+        try std.testing.expectEqual(want, num(x, key));
+        var name: [32]u8 = undefined;
+        try std.testing.expectEqual(want_raw, num(x, try std.fmt.bufPrint(&name, "raw_{s}", .{key})));
+    }
+    if (source.len == 0) return;
+    const field = if (std.mem.eql(u8, x.strField("source_field").?, "content")) got.content else got.reasoning;
+    try std.testing.expectEqualStrings(source, field[@intCast(final[0].?)..@intCast(final[1].?)]);
+}
+
+fn abstain(a: Allocator, field: []const u8, source: [3]?usize, resume_field: []const u8, resume_at: usize) ![]const u8 {
+    var o: std.ArrayList(u8) = .empty;
+    try o.print(a, "{{\"cell\":0,\"form\":\"fence\",\"source_field\":\"{s}\"", .{field});
+    for ([_][]const u8{ "source_at", "source_end", "source_close_at" }, source) |key, v|
+        if (v) |n| try o.print(a, ",\"{s}\":{d}", .{ key, n }) else try o.print(a, ",\"{s}\":null", .{key});
+    try o.print(a, ",\"resume_field\":\"{s}\",\"resume_at\":{d}}}", .{ resume_field, resume_at });
+    return o.items;
+}
+
+// T5's counterexample: the runner finds `print(undefined_total)\n` at raw content byte 12, the client at byte 10.
+const t5_content = "\n\n```python\nprint(undefined_total)\n```\nResult:\n";
+
+test "runner projection: HTTP abstain anchors after the think close's newlines are final content bytes, raw kept" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const receipt = try std.fmt.allocPrint(a, "{{\"cells\":[{{\"cell\":1,\"field\":\"content\",\"at\":12}}],\"abstain_schema\":1,\"abstains\":[{s},{s}]}}", .{
+        try abstain(a, "content", .{ 12, 35, 39 }, "content", 47),
+        try abstain(a, "content", .{ null, null, null }, "content", 1), // resumed inside the dropped newlines
+    });
+    for ([_]bool{ false, true }) |stream| {
+        const got = try post(a, "plan", t5_content, receipt, stream);
+        try std.testing.expectEqualStrings("plan", got.reasoning);
+        try std.testing.expectEqualStrings(t5_content[2..], got.content);
+        try expectAbstain(got, 0, "print(undefined_total)\n", .{ 12, 35, 39, 47 }, .{ 10, 33, 37, 45 });
+        try expectAbstain(got, 1, "", .{ null, null, null, 1 }, .{ null, null, null, null });
+        try std.testing.expectEqual(10, num(got.runner.get("cells").?.array[0], "final_at"));
+        const content = got.runner.get("field_projection").?.get("content").?;
+        try std.testing.expectEqual(47, num(content, "raw_bytes"));
+        try std.testing.expectEqual(2, num(content, "dropped_lead"));
+        try std.testing.expectEqual(45, num(content, "final_bytes"));
+    }
+}
+
+test "runner projection: HTTP reasoning anchors follow the reply's strip, whole or streamed" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const reasoning = " \n x\n```python\nprint(4)\n```\n";
+    const receipt = try std.fmt.allocPrint(a, "{{\"cells\":[],\"abstains\":[{s}]}}", .{try abstain(a, "reasoning", .{ 15, 24, 28 }, "reasoning", 28)});
+    const whole = try post(a, reasoning, "ok", receipt, false);
+    try std.testing.expectEqualStrings(reasoning[3 .. reasoning.len - 1], whole.reasoning);
+    // the close and resume bytes sit in the stripped trailing newline: no final byte, only the raw one
+    try expectAbstain(whole, 0, "print(4)\n", .{ 15, 24, 28, 28 }, .{ 12, 21, null, null });
+    // the stream sends the reasoning stripped as the whole reply strips it (Generation.streamed_reasoning)
+    const streamed = try post(a, reasoning, "ok", receipt, true);
+    try std.testing.expectEqualStrings(reasoning[3 .. reasoning.len - 1], streamed.reasoning);
+    try expectAbstain(streamed, 0, "print(4)\n", .{ 15, 24, 28, 28 }, .{ 12, 21, null, null });
+}
+
+test "runner projection: HTTP a receipt without abstain records keeps its bytes" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const receipt = "{\"cells\":[{\"cell\":0,\"field\":\"content\",\"at\":12}]}";
+    for ([_]bool{ false, true }) |stream| {
+        const got = try post(a, "plan", t5_content, receipt, stream);
+        try std.testing.expectEqualStrings(try json.stringify(a, (try json.parse(a, receipt)).ok, .{}), try json.stringify(a, got.runner, .{}));
+    }
+}
+
+// T5's r10 fixtures (T5-ORACLE-R10-REVIEW.md): the map is taken after tool parsing, on the fields the client gets
+const tool_text = "<tool_call>{\"name\":\"f\",\"arguments\":{}}</tool_call>\n```python\nprint(undefined_total)\n```\n";
+const tools = ",\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"f\",\"parameters\":{\"type\":\"object\",\"properties\":{}}}}]";
+
+test "runner projection: HTTP a tool envelope cut from the content moves the anchors to the content sent, whole and streamed" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const source = "print(undefined_total)\n";
+    const at = std.mem.indexOf(u8, tool_text, source).?;
+    const receipt = try std.fmt.allocPrint(a, "{{\"cells\":[],\"abstains\":[{s}]}}", .{try abstain(a, "content", .{ at, at + source.len, tool_text.len }, "content", tool_text.len)});
+    for ([_]bool{ false, true }) |stream| {
+        const got = try postWith(a, "plan", tool_text, receipt, stream, tools);
+        try std.testing.expect(got.calls); // the tool path ran: the envelope became a call
+        const actual = std.mem.indexOf(u8, got.content, source).?;
+        const x = got.runner.get("abstains").?.array[0];
+        try std.testing.expectEqual(@as(?i64, @as(i64, @intCast(actual))), num(x, "source_at"));
+        try std.testing.expectEqual(@as(?i64, @as(i64, @intCast(at))), num(x, "raw_source_at"));
+    }
+}
+
+test "runner projection: HTTP a lossy decode (FF as U+FFFD) publishes no map for that field, its raw anchors kept" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const text = "\xff\n```python\nprint(undefined_total)\n```\n";
