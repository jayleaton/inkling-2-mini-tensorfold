+            },
+            else => return error.Unsupported,
+        }
+    }
+    fn block(r: *Runtime, f: *Frame, body: []const ast.Stmt, b: ?*const Binding) Error!Flow {
+        for (body, 0..) |s, statement_index| {
+            try r.heap.charge(10);
