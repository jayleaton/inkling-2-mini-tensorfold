+    for (allowed) |name| {
+        if (eq(kind, name)) supported = true;
+    }
+    if (!supported) return false;
+    for (items(field(node, "inner"))) |child| if (!constantContext(child, depth + 1)) return false;
+    return true;
+}
+
+const Pass = struct {
+    a: A,
+    source: []const u8,
+    offset: usize,
+    edits: std.ArrayList(Edit) = .empty,
+    data: std.ArrayList(u8) = .empty,
