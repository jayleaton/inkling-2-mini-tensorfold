+                if (!std.mem.eql(u8, other, e.value_ptr.*)) std.debug.print("{s}: {s} differs\n{s}\n", .{ level, e.key_ptr.*, code });
+                try t.expectEqualStrings(e.value_ptr.*, other);
+            }
+            try t.expect(count >= 3);
