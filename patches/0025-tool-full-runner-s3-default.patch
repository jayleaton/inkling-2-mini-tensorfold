diff --git a/zig/src/core/lane_host_runner.zig b/zig/src/core/lane_host_runner.zig
new file mode 100644
index 000000000..dd2fee8fe
--- /dev/null
+++ b/zig/src/core/lane_host_runner.zig
@@ -0,0 +1,64 @@
+//! The in-model runner on the engine thread: each round advances the reply sessions and continues held streams.
+const std = @import("std");
+const lanes = @import("lanes");
+const LaneHost = @import("lane_host.zig").LaneHost;
+
+/// Advances every started job's runner session; a settled result is forced after the trigger it waited at.
+pub fn tick(h: *LaneHost) void {
+    if (h.runner == null) return;
+    var ended = false;
+    for (h.admitted.items) |job| {
+        if (!job.started) continue;
+        const s = job.runner orelse continue;
+        const tokens = s.tick() catch {
+            fail(job, "out of memory for a runner result");
+            ended = true;
+            continue;
+        } orelse continue;
+        defer h.gpa.free(tokens);
+        const ok = resumeResult(h, job, tokens) catch {
+            fail(job, "out of memory for a runner result");
+            ended = true;
+            continue;
+        };
+        ended = ended or job.stream.finished;
+        if (!ok) std.log.warn("lane host: a runner result for request {d}, which is not held, was dropped", .{job.id});
+    }
+    if (ended) h.core.sweep() catch {};
+}
+
+/// An idle loop's wait: 1 ms while a stream is held at a runner trigger (its run settles off-thread, waking nothing).
+pub fn idleWait(h: *LaneHost, idle_ms: i64) i64 {
+    if (h.runner == null) return idle_ms;
+    for (h.admitted.items) |job| {
+        if (!job.started) continue;
+        const s = job.runner orelse continue;
+        if (s.awaiting()) return @min(idle_ms, held_poll_ms);
+    }
+    return idle_ms;
+}
+
+const held_poll_ms = 1;
+
+fn fail(job: anytype, words: []const u8) void {
+    const st = &job.stream;
+    st.held = false;
+    st.paused = false;
+    st.awaiting = false;
+    st.finished = true;
+    st.reason = .@"error";
+    st.problem = words;
+}
+
+/// Flushes before releasing a terminal hold; a successful insertion skips its internal EOS exactly once.
+pub fn resumeResult(h: *LaneHost, job: *LaneHost.Job, tokens: []const u32) std.mem.Allocator.Error!bool {
+    const terminal = job.stream.runner_eos_pending;
+    if (terminal) h.send(job);
+    const ok = try lanes.hold.resumeAwaiting(&job.stream, h.gpa, tokens);
+    if (ok and terminal and !job.stream.finished) job.delivered += 1;
+    return ok;
+}
+
+test {
+    _ = @import("lane_host_runner_eos_test.zig");
+}
diff --git a/zig/src/core/lane_host_runner_eos_test.zig b/zig/src/core/lane_host_runner_eos_test.zig
new file mode 100644
index 000000000..1996b9cdc
--- /dev/null
+++ b/zig/src/core/lane_host_runner_eos_test.zig
@@ -0,0 +1,121 @@
+//! The terminal runner fence hides EOS tokens and rows until a result can be delivered before them.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const LaneHost = @import("lane_host.zig").LaneHost;
+const runner = @import("lane_host_runner.zig");
+const t = std.testing;
+const a = t.allocator;
+
+const Box = struct {
+    tokens: std.ArrayList(u32) = .empty,
+    rows: std.ArrayList(u32) = .empty,
+    fn event(ptr: *anyopaque, _: api.Id, e: *const api.Event) void {
+        const b: *Box = @ptrCast(@alignCast(ptr));
+        switch (e.*) {
+            .tokens => |tokens| b.tokens.appendSlice(a, tokens) catch unreachable,
+            .logprobs => |rows| for (rows) |row| {
+                b.rows.append(a, row.token) catch unreachable;
+            },
+            else => {},
+        }
+    }
+};
+
+const Hook = struct {
+    armed: bool = true,
+    fn token(_: *anyopaque, _: u32, _: bool, _: bool, _: bool) bool {
+        return false;
+    }
+    fn eos(ptr: *anyopaque, _: bool, _: bool) bool {
+        const h: *Hook = @ptrCast(@alignCast(ptr));
+        const armed = h.armed;
+        h.armed = false;
+        return armed;
+    }
+};
+
+test "host terminal resume flushes an unsent prefix then skips just the internal EOS and its row" {
+    for ([_]bool{ false, true }) |abstain| {
+        var h: LaneHost = .{ .gpa = a, .io = t.io, .core = undefined, .info_ = .{ .lanes = 1 } };
+        defer h.decoded.deinit(a);
+        var box: Box = .{};
+        defer box.tokens.deinit(a);
+        defer box.rows.deinit(a);
+        var hook: Hook = .{};
+        const request: api.Request = .{ .prompt = &.{1}, .max_tokens = 12 };
+        var job: LaneHost.Job = .{
+            .host = &h,
+            .id = 1,
+            .request = &request,
+            .sink = .{ .ctx = &box, .event = Box.event },
+            .stream = try lanes.Stream.init(a, .{
+                .id = "terminal",
+                .prompt = &.{1},
+                .max_new = 12,
+                .eos = &.{9},
+                .logprobs = 0,
+                .runner = .{ .ptr = &hook, .token = Hook.token, .eos = Hook.eos },
+            }),
+        };
+        defer job.stream.deinit(a);
+        const rows = [_]lanes.logprob.Row{ .{ .token = 5, .logprob = -1 }, .{ .token = 9, .logprob = -2 } };
+        _ = try job.stream.commit(a, &.{ 5, 9 }, &rows);
+        try t.expectEqual(@as(usize, 0), job.delivered);
+        try t.expect(try runner.resumeResult(&h, &job, if (abstain) &.{} else &.{ 6, 7 }));
+        try t.expectEqualSlices(u32, &.{5}, box.tokens.items);
+        try t.expectEqualSlices(u32, &.{5}, box.rows.items);
+        try t.expectEqual(@as(usize, if (abstain) 1 else 2), job.delivered);
+        if (!abstain) while (!job.stream.finished) {
+            const token = job.stream.popForce() orelse return error.ModelDrawRequired;
+            const row = [_]lanes.logprob.Row{.{ .token = token, .logprob = -1 }};
+            _ = try job.stream.commit(a, &.{token}, &row);
+        };
+        h.send(&job);
+        h.send(&job);
+        try t.expectEqualSlices(u32, if (abstain) &.{ 5, 9 } else &.{ 5, 6, 7, 9 }, box.tokens.items);
+        try t.expectEqualSlices(u32, box.tokens.items, box.rows.items);
+        try t.expect(job.stream.finished and job.stream.reason == .stop);
+        try t.expect(!try runner.resumeResult(&h, &job, &.{8}));
+        h.send(&job);
+        try t.expectEqualSlices(u32, if (abstain) &.{ 5, 9 } else &.{ 5, 6, 7, 9 }, box.tokens.items);
+    }
+}
+
+test "host send keeps a failed terminal EOS withheld while delivering its prefix rows" {
+    var h: LaneHost = .{ .gpa = a, .io = t.io, .core = undefined, .info_ = .{ .lanes = 1 } };
+    defer h.decoded.deinit(a);
+    var box: Box = .{};
+    defer box.tokens.deinit(a);
+    defer box.rows.deinit(a);
+    var hook: Hook = .{};
+    const request: api.Request = .{ .prompt = &.{1}, .max_tokens = 12 };
+    var job: LaneHost.Job = .{
+        .host = &h,
+        .id = 1,
+        .request = &request,
+        .sink = .{ .ctx = &box, .event = Box.event },
+        .stream = try lanes.Stream.init(a, .{
+            .id = "terminal",
+            .prompt = &.{1},
+            .max_new = 12,
+            .eos = &.{9},
+            .logprobs = 0,
+            .runner = .{ .ptr = &hook, .token = Hook.token, .eos = Hook.eos },
+        }),
+    };
+    defer job.stream.deinit(a);
+    const rows = [_]lanes.logprob.Row{ .{ .token = 5, .logprob = -1 }, .{ .token = 9, .logprob = -2 } };
+    _ = try job.stream.commit(a, &.{ 5, 9 }, &rows);
+    var fail = t.FailingAllocator.init(a, .{ .fail_index = 0, .resize_fail_index = 0 });
+    h.gpa = fail.allocator();
+    try t.expectError(error.OutOfMemory, runner.resumeResult(&h, &job, &.{ 6, 7 }));
+    h.gpa = a;
+    job.stream.finished = true;
+    job.stream.reason = .@"error";
+    h.send(&job);
+    try t.expectEqualSlices(u32, &.{5}, box.tokens.items);
+    try t.expectEqualSlices(u32, &.{5}, box.rows.items);
+    try t.expectEqual(@as(usize, 1), job.delivered);
+    try t.expectEqual(@as(usize, 0), job.stream.force.items.len);
+}
