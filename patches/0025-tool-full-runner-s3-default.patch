new file mode 100644
index 000000000..7efe17272
--- /dev/null
+++ b/tools/runner_graph_export.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Build reusable arithmetic weights and binding plans offline, then prepare native bank files."""
+
+import argparse
+import copy
+import gc
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+import shutil
+
+from runner_circuit import read_circuit
+from runner_export import write_circuit
+from runner_graph_ir import BUCKETS, build_template
+from runner_graph_plans import plan_catalog
+from runner_graph_algorithms import OPERATIONS as INTEGER_KERNELS, catalog
+from runner_graph_whole import OPERATIONS as WHOLE_KERNELS, plans as whole_plans
+
+
+OPERATIONS = ("add", "sub", "mul", "select", "divstep", "divfinal", *INTEGER_KERNELS, *WHOLE_KERNELS)
+
+
+def bridge(doc, baseline):
+    doc = dict(doc, format="tensorfold.runner.p2")
+    doc["experimental"] = {"kind": "graph_template", "contract": doc["program"], "entry": "State.init then GO"}
+    doc["program"] = copy.deepcopy(baseline["program"])
+    doc["program"].update(kind="elf", expression=None)
+    return doc
+
+
+def export(args):
+    args.output.mkdir(parents=True, exist_ok=args.resume)
+    sources = ("runner_graph_ir.py", "runner_graph_algorithms.py", "runner_graph_div.py",
+               "runner_graph_byte.py", "runner_graph_export.py", "runner_graph_plans.py", "runner_graph_whole.py", "runner_graph_format.py")
+    identity = {name: hashlib.sha256(Path(__file__).with_name(name).read_bytes()).hexdigest() for name in sources}
+    identity["widths"] = args.widths
+    legacy = json.loads(Path(__file__).with_name("runner-graph-legacy.json").read_text())
+    build_file = args.output / "build.json"
+    if build_file.exists() and json.loads(build_file.read_text()) != identity:
+        raise ValueError("resume compiler identity or widths changed")
+    build_file.write_text(json.dumps(identity, sort_keys=True) + "\n")
+    progress_file = args.output / "progress.json"
+    progress = json.loads(progress_file.read_text()) if args.resume and progress_file.exists() else []
+    full = read_circuit(args.baseline)
+    baseline = {"source": full["source"], "program": full["program"]}
+    del full
+    gc.collect()
+    descriptors, receipts = [], []
+    selections = [(op, width) for op in OPERATIONS for width in args.widths if op != "meta" or width >= 8]
+    if any(width < 8 for width in args.widths) and 8 not in args.widths:
+        selections.extend((op, 8) for op in ("meta", "add", "half", "divstep"))
+    if ("meta", 128) not in selections:
+        selections.append(("meta", 128))
+    selections += [("byte_check", 128), ("emit_byte", 4), ("format_f64", 62)]
+    selections += [("raw_meta", width) for width in (8, 16, 32, 62, 128)]
+    selections += [(op, width) for op in ("emit", "format") for width in (62, 128)]
+    selections += [(op, width) for op in ("emit_first", "emit_last") for width in (62, 128)
+                   if width == 62 or width in args.widths]
+    for op, width in selections:
+        start = time.monotonic()
+        stem = f"{op}-{width}"
+        prior = None
+        reuse_root = args.output
+        prior = next((r for r in progress if r["name"] == stem), None)
+        if prior is None and args.reuse_bank:
+            reuse_root = args.reuse_bank
+            provenance = json.loads((args.reuse_bank / "provenance.json").read_text())
+            prior = next((r for r in provenance["templates"] if r["name"] == stem), None)
+            if prior is not None and provenance.get("compiler_sources") != identity:
+                compatible = all(identity[name] == digest for name, digest in legacy["compatible_sources"].items())
+                if not compatible or legacy["templates"].get(stem) != prior["packed_sha256"]:
+                    raise ValueError(f"unqualified compiler reuse: {stem}")
+        if prior is not None:
+            packed = reuse_root / f"{stem}.tfgp"
+            if hashlib.sha256(packed.read_bytes()).hexdigest() != prior["packed_sha256"]:
+                raise ValueError(f"reuse checksum mismatch: {stem}")
+            if reuse_root != args.output:
+                shutil.copyfile(packed, args.output / packed.name)
+            metadata = prior["slots"]
+            descriptors.append({"name": op, "width": width, "path": packed.name,
+                                "inputs": metadata["input_arity"],
+                                "outputs": max(slot["index"] for slot in metadata["output_slots"]) + 1})
+            receipts.append(dict(prior, reused=True))
+            progress_file.write_text(json.dumps(receipts, separators=(",", ":")) + "\n")
+            print(json.dumps({"template": stem, "reused": True}), flush=True)
+            continue
+        doc, metadata = build_template(args.qwenputer, op, width)
+        source, packed = args.output / f"{stem}.tfimr", args.output / f"{stem}.tfgp"
+        info = write_circuit(bridge(doc, baseline), source)
+        stats = doc["stats"]
+        del doc
+        gc.collect()
+        subprocess.run([str(args.packer.resolve()), str(source), str(packed)], check=True)
+        descriptors.append({"name": op, "width": width, "path": packed.name,
+                            "inputs": metadata["input_arity"],
+                            "outputs": max(slot["index"] for slot in metadata["output_slots"]) + 1})
+        receipt = {"name": stem, "source": info, "packed_bytes": packed.stat().st_size,
+                   "packed_sha256": hashlib.sha256(packed.read_bytes()).hexdigest(),
+                   "build_seconds": time.monotonic() - start, "slots": metadata}
+        receipts.append(receipt)
+        progress_file.write_text(json.dumps(receipts, separators=(",", ":")) + "\n")
+        print(json.dumps({"template": stem, "bytes": receipt["packed_bytes"], "stats": stats}), flush=True)
+        if not args.keep_ir:
+            source.unlink()
+            source.with_name(source.name + ".sha256").unlink()
+    plans = plan_catalog()
+    allowed = {(op, width) for op, width in selections}
+    plans = [plan for plan in plans if all(call["op"] == "bind" or (call["op"], call["width"]) in allowed
+                                         for call in plan["ops"])]
+    plans += catalog(args.widths)
+    plans += whole_plans(args.widths)
+    manifest = {"version": 1, "templates": descriptors, "plans": plans}
+    (args.output / "bank.json").write_text(json.dumps(manifest, separators=(",", ":")) + "\n")
+    (args.output / "Qwenputer-MIT.txt").write_text(baseline["source"]["license_text"])
+    (args.output / "provenance.json").write_text(json.dumps({"source": baseline["source"],
+        "format": "tensorfold.runner.graph-bank-provenance", "version": 1,
+        "compiler": "offline Qwenputer P2 IR -> T2 prepared graph pack", "request_graph_compilation": False,
+        "compiler_sources": identity,
+        "templates": receipts, "plans": len(plans), "widths": args.widths}, sort_keys=True, indent=2) + "\n")
+    print(json.dumps({"pass": True, "templates": len(descriptors), "plans": len(plans),
+                      "pack_bytes": sum(r["packed_bytes"] for r in receipts)}), flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qwenputer", type=Path, required=True)
+    parser.add_argument("--baseline", type=Path, required=True)
+    parser.add_argument("--packer", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--widths", default=",".join(map(str, BUCKETS)))
+    parser.add_argument("--keep-ir", action="store_true")
+    parser.add_argument("--reuse-bank", type=Path)
+    parser.add_argument("--resume", action="store_true")
+    args = parser.parse_args()
+    args.widths = [int(value) for value in args.widths.split(",")]
+    if not args.widths or len(set(args.widths)) != len(args.widths) or any(w not in BUCKETS for w in args.widths):
+        parser.error("widths must be distinct supported digit buckets")
+    export(args)
+
+
+if __name__ == "__main__":
+    if os.environ.get("PYTHONHASHSEED") != "0":
+        os.execve(sys.executable, [sys.executable, *sys.argv], dict(os.environ, PYTHONHASHSEED="0"))
+    main()
diff --git a/tools/runner_graph_extend.py b/tools/runner_graph_extend.py
new file mode 100644
index 000000000..f90f4fce9
--- /dev/null
+++ b/tools/runner_graph_extend.py
@@ -0,0 +1,366 @@
+#!/usr/bin/env python3
+"""Append optional 256-digit operation families to a qualified bank without recompiling old payloads."""
+
+import argparse
+import copy
+import gc
+import hashlib
+import json
+import os
+from pathlib import Path
+import resource
+import shutil
+import subprocess
+import sys
+
+
+WIDTH = 256
+OPERATIONS = ("add", "sub", "mul", "emit", "format")
+DIVISION_OPERATIONS = ("meta", "divstep", "divfinal", "emit_first", "emit_last")
+POWMOD_OPERATIONS = ("half", "mulmodstep")
+
+
+def family_operations(family):
+    return {"basic": OPERATIONS, "division": DIVISION_OPERATIONS, "powmod": POWMOD_OPERATIONS}[family]
+WORKER_MIB = 1792
+PARENT_MIB = 192
+SOURCES = ("runner_graph_extend.py", "runner_graph_ir.py", "runner_graph_registers.py", "runner_graph_format.py",
+           "runner_graph_plans.py", "runner_graph_export.py", "runner_graph_algorithms.py",
+           "runner_graph_whole.py", "runner_graph_div.py", "runner_graph_byte.py",
+           "runner_export.py", "runner_trace.py", "runner_circuit.py", "runner_isolate.py")
+
+
+def digest(path):
+    value = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            value.update(block)
+    return value.hexdigest()
+
+
+def atomic_json(path, value):
+    temporary = path.with_name(path.name + ".tmp")
+    temporary.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
+    temporary.replace(path)
+
+
+def limited_child():
+    limit = WORKER_MIB << 20
+    resource.setrlimit(resource.RLIMIT_AS, (limit, limit))
+
+
+def extension_plans(family="basic"):
+    if family == "powmod":
+        return [{"name": f"powmod-{WIDTH}", "inputs": 3, "literals": [], "ops": [],
+                 "result": 0, "algorithm": "powmod", "width": WIDTH}]
+
+    if family == "division":
+        from runner_graph_div import optional_plans
+        return optional_plans(WIDTH)
+
+    from runner_graph_plans import binary_plan
+
+    plans = [binary_plan(op, 128) for op in ("add", "sub", "mul")]
+    plans += [binary_plan("pow", 128, exponent) for exponent in range(1000)]
+    for plan in plans:
+        plan["name"] = plan["name"].removesuffix("-128") + f"-{WIDTH}"
+        for call in plan["ops"]:
+            call.update(width=WIDTH, checked=True)
+    return plans
+
+
+def append_manifest(raw, templates, plans):
+    """Insert only new array elements, retaining every byte of every old entry."""
+    decoder = json.JSONDecoder()
+    document = json.loads(raw)
+    additions = {"templates": templates, "plans": plans}
+    edits, seen = [], set()
+    position = raw.index("{") + 1
+    while True:
+        while raw[position].isspace() or raw[position] == ",":
+            position += 1
+        if raw[position] == "}":
+            break
+        key, position = decoder.raw_decode(raw, position)
+        if key in seen:
+            raise ValueError("duplicate manifest key")
+        seen.add(key)
+        while raw[position].isspace():
+            position += 1
+        if raw[position] != ":":
+            raise ValueError("invalid manifest key separator")
+        position += 1
+        while raw[position].isspace():
+            position += 1
+        value, end = decoder.raw_decode(raw, position)
+        if key in additions:
+            if not isinstance(value, list):
+                raise ValueError(f"manifest {key} must be an array")
+            insertion = ("," if value else "") + ",".join(
+                json.dumps(item, sort_keys=True, separators=(",", ":")) for item in additions[key])
+            edits.append((end - 1, insertion))
+        position = end
+    if not additions.keys() <= seen:
+        raise ValueError("manifest requires templates and plans")
+    for position, insertion in sorted(edits, reverse=True):
+        raw = raw[:position] + insertion + raw[position:]
+    extended = json.loads(raw)
+    for key in additions:
+        if extended[key] != document[key] + additions[key]:
+            raise ValueError("manifest append changed an existing entry")
+    return raw
+
+
+def streamed_circuit(doc, path):
+    """Stream canonical JSON to avoid simultaneous document, JSON string and payload copies."""
+    from runner_circuit import validate
+    from runner_export import HEADER, MAGIC
+
+    validate(doc)
+    temporary = path.with_name(path.name + ".tmp")
+    payload_hash, length = hashlib.sha256(), 0
+    encoder = json.JSONEncoder(sort_keys=True, separators=(",", ":"), allow_nan=False)
+    with temporary.open("wb") as stream:
+        stream.write(bytes(HEADER.size))
+        for piece in encoder.iterencode(doc):
+            block = piece.encode("utf-8")
+            stream.write(block)
+            payload_hash.update(block)
+            length += len(block)
+        stream.seek(0)
+        stream.write(HEADER.pack(MAGIC, 1, HEADER.size, length, 0, 0, payload_hash.digest()))
+    temporary.replace(path)
+    info = {"file": path.name, "bytes": path.stat().st_size, "sha256": digest(path),
+            "payload_sha256": payload_hash.hexdigest(), "stats": doc["stats"]}
+    return info
+
+
+def build_one(args):
+    limited_child()
+    from runner_circuit import read_circuit
+    from runner_graph_export import bridge
+    from runner_graph_ir import build_template
+    from runner_graph_registers import compact
+
+    baseline = read_circuit(args.baseline)
+    source, program = baseline["source"], baseline["program"]
+    del baseline
+    gc.collect()
+    doc, slots = build_template(args.qwenputer, args.worker, WIDTH)
+    gc.collect()
+    registers = compact(doc)
+    doc["register_allocation"] = registers
+    if doc["source"] != source:
+        raise ValueError("baseline and template upstream provenance differ")
+    if WIDTH + (WIDTH - 1) // 3 + 8 >= 1 << doc["output"]["payload_bits"]:
+        raise ValueError("wide control bounds exceed the token payload")
+    info = streamed_circuit(bridge(doc, {"program": program}), args.output / f"{args.worker}-{WIDTH}.tfimr")
+    atomic_json(args.output / f"{args.worker}-{WIDTH}.source.json",
+                {"source": info, "slots": slots, "register_allocation": registers})
+
+
+def bank_snapshot(root):
+    files = {}
+    for path in sorted(root.rglob("*")):
+        if path.is_symlink():
+            raise ValueError("input bank must contain regular files, not symlinks")
+        if path.is_file():
+            files[path.relative_to(root).as_posix()] = digest(path)
+    return files
+
+
+def copy_verified(source, target, expected):
+    if not target.exists():
+        target.parent.mkdir(parents=True, exist_ok=True)
+        temporary = target.with_name(target.name + ".tmp")
+        shutil.copyfile(source, temporary)
+        if digest(temporary) != expected:
+            raise ValueError(f"input changed during copy: {source.name}")
+        temporary.replace(target)
+    if digest(target) != expected:
+        raise ValueError(f"resume payload checksum mismatch: {target.name}")
+
+
+def input_identity(args):
+    from runner_export import UPSTREAM
+
+    revision = subprocess.check_output(["git", "-C", str(args.qwenputer), "rev-parse", "HEAD"], text=True).strip()
+    dirty = subprocess.check_output(
+        ["git", "-C", str(args.qwenputer), "status", "--porcelain", "--untracked-files=no"], text=True).strip()
+    if revision != UPSTREAM or dirty:
+        raise ValueError("Qwenputer must be clean at the pinned upstream commit")
+    names = subprocess.check_output(
+        ["git", "-C", str(args.qwenputer), "ls-files", "-z"], text=True).split("\0")
+    upstream = {name: digest(args.qwenputer / name) for name in names if name}
+    return {"format": "tensorfold.runner.graph-extension-build", "version": 1,
+            "width": WIDTH, "operations": list(family_operations(args.family)), "old_bank": bank_snapshot(args.bank),
+            "compiler_sources": {name: digest(Path(__file__).with_name(name)) for name in SOURCES},
+            "qwenputer_commit": revision, "qwenputer_sources": upstream,
+            "baseline_sha256": digest(args.baseline), "packer_sha256": digest(args.packer)}
+
+
+def validate_base(args, identity):
+    raw = (args.bank / "bank.json").read_bytes().decode("utf-8")
+    manifest = json.loads(raw)
+    provenance = json.loads((args.bank / "provenance.json").read_text())
+    if manifest["version"] != 1 or not manifest["templates"] or not manifest["plans"]:
+        raise ValueError("expected an existing version-1 graph bank")
+    if provenance["source"]["license"] != "MIT":
+        raise ValueError("input bank must retain Qwenputer MIT provenance")
+    if (args.bank / "Qwenputer-MIT.txt").read_bytes() != provenance["source"]["license_text"].encode():
+        raise ValueError("bank MIT text differs from upstream provenance")
+    receipts = {item["name"]: item for item in provenance["templates"]}
+    paths = set()
+    for template in manifest["templates"]:
+        path = Path(template["path"])
+        if path.is_absolute() or ".." in path.parts or path.as_posix() not in identity["old_bank"]:
+            raise ValueError("unsafe or missing old template payload")
+        if len(path.parts) != 1 or path.suffix != ".tfgp":
+            raise ValueError("extension requires the qualified bank's flat packed-payload layout")
+        if path.name in {f"{op}-{WIDTH}.tfgp" for op in family_operations(args.family)}:
+            raise ValueError("old payload path collides with a new template")
+        receipt = receipts[f"{template['name']}-{template['width']}"]
+        if identity["old_bank"][path.as_posix()] != receipt["packed_sha256"]:
+            raise ValueError("old payload does not match its qualified provenance")
+        paths.add(path.as_posix())
+    if paths != {name for name in identity["old_bank"] if name.endswith(".tfgp")}:
+        raise ValueError("old bank contains unreferenced packed payloads")
+    if args.family == "powmod":
+        required = (("meta", 2, 3), ("divstep", 3, 2), ("divfinal", 4, 2),
+                    ("sub", 2, 1), ("emit", 1, 1), ("format", 2, 2))
+        for name, inputs, outputs in required:
+            matches = [t for t in manifest["templates"] if t["name"] == name and t["width"] == WIDTH]
+            if len(matches) != 1 or matches[0].get("inputs") != inputs or matches[0].get("outputs") != outputs:
+                raise ValueError(f"powmod requires division-bank dependency {name}-{WIDTH} with correct arity")
+        if not any(p["name"] == f"divmod-{WIDTH}" and p.get("algorithm") == "divmod"
+                   and p.get("width") == WIDTH for p in manifest["plans"]):
+            raise ValueError("powmod requires the division-bank base")
+    plans = extension_plans(args.family)
+    if {item["name"] for item in plans} & {item["name"] for item in manifest["plans"]}:
+        raise ValueError("new plan names collide with old plans")
+    return raw, manifest, provenance, paths, plans
+
+
+def export(args):
+    resource.setrlimit(resource.RLIMIT_AS, (PARENT_MIB << 20, WORKER_MIB << 20))
+    if args.output == args.bank or args.output.is_relative_to(args.bank) or args.bank.is_relative_to(args.output):
+        raise ValueError("output and input bank directories must be separate")
+    current_identity = input_identity(args)
+    identity = current_identity
+    raw, manifest, provenance, paths, plans = validate_base(args, identity)
+    if (args.qwenputer / "LICENSE").read_bytes() != (args.bank / "Qwenputer-MIT.txt").read_bytes():
+        raise ValueError("old bank and pinned checkout MIT texts differ")
+    args.output.mkdir(parents=True, exist_ok=True)
+    build_file = args.output / "extension-build.json"
+    if args.resume or args.publish_only:
+        if not build_file.exists():
+            raise ValueError("resume compiler identity missing")
+        previous = json.loads(build_file.read_text())
+        if args.publish_only:
+            before, after = copy.deepcopy(previous), copy.deepcopy(identity)
+            for item in (before, after):
+                del item["compiler_sources"][Path(__file__).name]
+            if before != after:
+                raise ValueError("publication numerical compiler/input identity changed")
+            identity = previous
+        elif previous != identity:
+            raise ValueError("resume input/compiler identity changed")
+    elif any(args.output.iterdir()):
+        raise ValueError("output must be a new or empty directory")
+    else:
+        atomic_json(build_file, identity)
+    for name, checksum in identity["old_bank"].items():
+        if name not in paths:
+            copy_verified(args.bank / name, args.output / "extension-base" / name, checksum)
+    for name in sorted(paths | {"Qwenputer-MIT.txt"}):
+        copy_verified(args.bank / name, args.output / name, identity["old_bank"][name])
+    operations = family_operations(args.family)
+    progress_file = args.output / "extension-progress.json"
+    progress = json.loads(progress_file.read_text()) if progress_file.exists() else []
+    if [row["name"] for row in progress] != [f"{op}-{WIDTH}" for op in operations[:len(progress)]]:
+        raise ValueError("invalid extension progress order")
+    if args.publish_only and len(progress) != len(operations):
+        raise ValueError("publication requires every template already packed")
+    descriptors, receipts = [], []
+    for index, op in enumerate(operations):
+        stem = f"{op}-{WIDTH}"
+        packed = args.output / f"{stem}.tfgp"
+        if index < len(progress):
+            receipt = progress[index]
+            if digest(packed) != receipt["packed_sha256"]:
+                raise ValueError(f"resume checksum mismatch: {stem}")
+        else:
+            command = [sys.executable, str(Path(__file__).resolve()), "--worker", op, "--family", args.family,
+                       "--qwenputer", str(args.qwenputer), "--baseline", str(args.baseline),
+                       "--output", str(args.output)]
+            subprocess.run(command, check=True, preexec_fn=limited_child)
+            receipt = json.loads((args.output / f"{stem}.source.json").read_text())
+            temporary = packed.with_name(packed.name + ".tmp")
+            subprocess.run([str(args.packer), str(args.output / f"{stem}.tfimr"), str(temporary)],
+                           check=True, preexec_fn=limited_child)
+            temporary.replace(packed)
+            receipt.update(name=stem, packed_bytes=packed.stat().st_size, packed_sha256=digest(packed))
+            progress.append(receipt)
+            atomic_json(progress_file, progress)
+        slots = receipt["slots"]
+        descriptors.append({"name": op, "width": WIDTH, "path": packed.name,
+                            "inputs": slots["input_arity"],
+                            "outputs": max(slot["index"] for slot in slots["output_slots"]) + 1})
+        receipts.append(receipt)
+        for suffix in (".tfimr", ".tfimr.tmp", ".source.json"):
+            (args.output / f"{stem}{suffix}").unlink(missing_ok=True)
+        print(json.dumps({"template": stem, "packed_bytes": receipt["packed_bytes"]}), flush=True)
+    if input_identity(args) != current_identity:
+        raise ValueError("inputs changed during extension")
+    for name in paths:
+        if digest(args.output / name) != identity["old_bank"][name]:
+            raise ValueError("old output payload changed during extension")
+    resource.setrlimit(resource.RLIMIT_AS, (512 << 20, WORKER_MIB << 20))
+    extended = copy.deepcopy(provenance)
+    extended["templates"] += receipts
+    extended["plans"] = len(manifest["plans"]) + len(plans)
+    extended["widths"] = list(dict.fromkeys([*provenance["widths"], WIDTH]))
+    extended["extension"] = {"identity": identity, "base_manifest": "extension-base/bank.json",
+                             "new_templates": receipts, "new_plans": len(plans),
+                             "request_graph_compilation": False, "measured_cost": None,
+                             "publication_identity": current_identity,
+                             "publication_only": args.publish_only}
+    atomic_json(args.output / "provenance.json", extended)
+    temporary = args.output / "bank.json.tmp"
+    temporary.write_bytes(append_manifest(raw, descriptors, plans).encode("utf-8"))
+    temporary.replace(args.output / "bank.json")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--bank", type=Path)
+    parser.add_argument("--qwenputer", type=Path, required=True)
+    parser.add_argument("--baseline", type=Path, required=True)
+    parser.add_argument("--packer", type=Path)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--resume", action="store_true")
+    parser.add_argument("--publish-only", action="store_true",
+                        help="Publish completed packs, retaining their original compiler provenance")
+    parser.add_argument("--family", choices=("basic", "division", "powmod"), default="basic")
+    parser.add_argument("--worker", choices=OPERATIONS + DIVISION_OPERATIONS + POWMOD_OPERATIONS, help=argparse.SUPPRESS)
+    args = parser.parse_args()
+    for name in ("bank", "qwenputer", "baseline", "packer", "output"):
+        value = getattr(args, name)
+        if value is not None:
+            setattr(args, name, value.resolve())
+    if args.worker:
+        if args.worker not in family_operations(args.family):
+            parser.error("worker does not belong to the selected family")
+        build_one(args)
+    elif args.bank is None or args.packer is None:
+        parser.error("--bank and --packer are required")
+    else:
+        export(args)
+
+
+if __name__ == "__main__":
+    environment = dict(os.environ, PYTHONHASHSEED="0", PYTHONDONTWRITEBYTECODE="1",
+                       OPENBLAS_NUM_THREADS="1", OMP_NUM_THREADS="1", MKL_NUM_THREADS="1")
+    if any(os.environ.get(name) != value for name, value in environment.items()):
+        os.execve(sys.executable, [sys.executable, *sys.argv], environment)
+    main()
diff --git a/tools/runner_graph_format.py b/tools/runner_graph_format.py
new file mode 100644
index 000000000..1f2e00adb
--- /dev/null
+++ b/tools/runner_graph_format.py
@@ -0,0 +1,143 @@
+"""Generic runtime-controlled decimal ASCII formatting compiled entirely into FFN weights."""
+
+ENDINGS = (b"\n", b" ", b"", b", ", b")\n", b"/", b") ", b")", b"), ")
+
+
+def _length(b, digits):
+    occupied = [b.ge(digit, 1, 0, 9) for digit in digits]
+    lengths = [(flag, (i + 1) * b.one) for i, flag in enumerate(occupied)]
+    while len(lengths) > 1:
+        merged = []
+        for i in range(0, len(lengths), 2):
+            if i + 1 == len(lengths):
+                merged.append(lengths[i])
+            else:
+                low, high = lengths[i:i + 2]
+                merged.append((b.any([low[0], high[0]]), b.choose(high[0], high[1], low[1])))
+        lengths = merged
+    return b.choose(lengths[0][0], lengths[0][1], b.one)
+
+
+def _cursor(b, limit):
+    """Keep each counter's thermometer within the exact FP32 64/65 split used by the emitter."""
+    c = b.c
+    reset, step = c.fam["GO"], c.fam["BYTE"]
+    pieces = []
+    for offset in range(0, limit, 64):
+        name = f"format.cursor.{offset}"
+        count = c.counter(name, reset, step)
+        size = min(65, limit - offset)
+        flags = c.thermo(count, reset, size, name)
+        pieces.extend(flags[:64])
+        if offset + 64 < limit:
+            reset = b.one - flags[-1]
+            step = b.node([(1, c.fam["BYTE"], flags[-1])], "format.cursor.step")
+    return b.node([(1, sum(pieces, b.zero), b.one)], "format.cursor")
+
+
+def _controls(b, value, control, max_precision=18):
+    digits = control.digits
+    precision = b.node([(1, digits[0] + 10 * digits[1], b.one)], "format.precision")
+    modes = [b.eq(digits[2], mode, 0, 9) for mode in range(5)]
+    endings = [b.eq(digits[3], ending, 0, 9) for ending in range(len(ENDINGS))]
+    prefix = digits[4]
+    precision_nz = b.ge(precision, 1, 0, 99)
+    fixed = b.node([(1, modes[1], precision_nz)], "format.fixed")
+    invalid_precision = b.node([(1, b.one - modes[1], precision_nz)], "format.precision.invalid")
+    invalid_bool = b.node([(1, modes[4], b.any([b.nz(value.digits[1:]),
+                           b.ge(value.digits[0], 2, 0, 9),
+                           b.node([(1, value.sign, b.nz(value.digits))], "format.bool.negative")]))],
+                          "format.bool.invalid")
+    error = b.any([value.error, control.error, control.sign, b.nz(digits[5:]),
+                   b.ge(precision, max_precision + 1, 0, 99), b.ge(digits[2], 5, 0, 9),
+                   b.ge(digits[3], len(ENDINGS), 0, 9), b.ge(prefix, 2, 0, 9), invalid_precision, invalid_bool])
+    if b.width > 128:
+        precision = b.choose(error, b.zero, precision)
+        prefix = b.choose(error, b.zero, prefix)
+        fixed = b.choose(error, b.zero, fixed)
+    return precision, modes, endings, prefix, fixed, error
+
+
+def _layout(b, value, precision, modes, fixed):
+    width = b.width
+    length = _length(b, value.digits)
+    padded = b.choose(b.ge(precision - length, 0, -width, 98), precision + b.one, length)
+    coefficient_length = b.choose(modes[1], padded, length)
+    groups = b.node([(1, b.ge(length, 3 * i + 1, 1, width), b.one)
+                     for i in range(1, (width - 1) // 3 + 1)], "format.groups")
+    numeric_length = b.choose(modes[2], length + groups, coefficient_length + fixed)
+    numeric_length = b.choose(modes[3], length + 2 * b.one, numeric_length)
+    truth = b.ge(value.digits[0], 1, 0, 9)
+    body_length = b.choose(modes[4], 5 * b.one - truth, numeric_length)
+    preserve = b.any([b.nz(value.digits), modes[1], modes[3]])
+    sign = b.node([(1, value.sign, preserve)], "format.sign.nonzero")
+    sign = b.node([(1, sign, b.one - modes[4])], "format.sign")
+    return length, coefficient_length, groups, truth, body_length, sign
+
+
+def _numeric(b, value, n, precision, modes, fixed, layout, prefix, limit):
+    length, coefficient_length, groups, truth, body_length, sign = layout
+    position = n - prefix - sign
+    point = coefficient_length - precision
+    after_point = b.ge(position - point, 1, -limit, limit)
+    index = coefficient_length - b.one - position
+    index = b.choose(fixed, index + after_point, index)
+    reverse = length + groups - b.one - position
+    digits = []
+    for i, digit in enumerate(value.digits):
+        normal = b.eq(index, i, -limit, limit)
+        grouped = b.eq(reverse, i + i // 3, -limit, limit)
+        digits.append((1, digit, b.choose(modes[2], grouped, normal)))
+    digit = b.node(digits, "format.digit")
+    comma = b.node([(1, modes[2], b.any(b.eq(reverse, 4 * i - 1, -limit, limit)
+                                       for i in range(1, (b.width - 1) // 3 + 1)))], "format.comma")
+    dot = b.node([(1, fixed, b.eq(position - point, 0, -limit, limit)),
+                  (1, modes[3], b.eq(position - length, 0, -limit, limit))], "format.dot")
+    float_zero = b.node([(1, modes[3], b.eq(position - length, 1, -limit, limit))], "format.float.zero")
+    minus = b.node([(1, sign, b.eq(n - prefix, 0, -limit, limit))], "format.minus")
+    return digit, comma, dot, float_zero, minus, position
+
+
+def _emit(b, value, control, max_precision=18):
+    precision, modes, endings, prefix, fixed, error = _controls(b, value, control, max_precision)
+    layout = _layout(b, value, precision, modes, fixed)
+    length, coefficient_length, groups, truth, body_length, sign = layout
+    limit = b.width + (b.width - 1) // 3 + 8
+    n = _cursor(b, limit)
+    digit, comma, dot, float_zero, minus, position = _numeric(
+        b, value, n, precision, modes, fixed, layout, prefix, limit)
+    tail = n - prefix - sign - body_length
+    suffix_length = b.node([(len(suffix), flag, b.one) for suffix, flag in zip(ENDINGS, endings)],
+                           "format.ending.length")
+    done = b.ge(tail - suffix_length, 0, -limit, limit)
+    halt = b.choose(error, b.ge(n, 6, 0, limit), done)
+    opening = b.node([(1, b.eq(prefix, 1, 0, 9), b.eq(n, 0, 0, limit))], "format.opening")
+    ascii_bits = b.c.fn_bits(digit, 0, 9, lambda d: 48 + d, 8, "format.ascii")
+    payload = []
+    for bit, terms in enumerate(ascii_bits):
+        normal = b.node(terms, "format.ascii")
+        for flag, byte in ((comma, 44), (dot, 46), (float_zero, 48), (minus, 45)):
+            normal = b.choose(flag, ((byte >> bit) & 1) * b.one, normal)
+        boolean = b.node([(1, flag, b.eq(position, i, -limit, limit))
+                          for text, flag in ((b"True", truth), (b"False", b.one - truth))
+                          for i, byte in enumerate(text) if (byte >> bit) & 1], "format.bool")
+        normal = b.choose(modes[4], boolean, normal)
+        normal = b.choose(opening, ((40 >> bit) & 1) * b.one, normal)
+        for suffix, flag in zip(ENDINGS, endings):
+            for i, byte in enumerate(suffix):
+                at = b.node([(1, flag, b.eq(tail, i, -limit, limit))], "format.ending.at")
+                normal = b.choose(at, ((byte >> bit) & 1) * b.one, normal)
+        err = b.node([term for i, byte in enumerate(b"error\n") if (byte >> bit) & 1
+                      for term in b.c.t_eq(n, i, 0, limit)], "format.error")
+        payload.append(b.choose(error, err, normal))
+    b._exit(halt, payload)
+
+
+def finish(builder, inputs, max_precision=18):
+    """Latch coefficient and control as two output Values before emitting any BYTE steps."""
+    if builder.width not in (62, 128) or len(inputs) != 2:
+        raise ValueError("format requires width 62 or 128 and two input Values")
+    latched = [builder._latch(i, value, preserve_sign=True) for i, value in enumerate(inputs)]
+    _emit(builder, *latched, max_precision=max_precision)
+    builder.c.nodes.sort(key=lambda node: node.level)
+    return {"width": builder.width, "input_slots": builder.input_slots, "output_slots": builder.output_slots}
