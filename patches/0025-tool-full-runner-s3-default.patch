+    full.always = true;
+    const seq = [_]u32{ c.go, tok(2, 1 | 4), tok(2, 1 | 4), tok(1, 0), tok(1, 0), tok(1, 0), tok(1, 0), tok(3, 1), tok(3, 1), tok(2, 2), tok(3, 2), tok(4, 'h'), tok(4, 'h'), tok(1, 0), tok(2, 0), tok(2, 0), tok(1, 0), tok(1, 0), tok(1, 0), tok(3, 3), tok(1, 0) };
+    var skipped: usize = 0;
