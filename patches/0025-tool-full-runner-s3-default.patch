+        result = inputs + (shape == "factorial")
+        for i in range(bound):
+            value = inputs + 2 + i
+            if shape == "squares":
+                value = call("mul", value, value)
+            result = call("mul" if shape == "factorial" else "add", result, value)
+    elif shape == "fib":
+        result, other = inputs, inputs + 1
+        for _ in range(bound):
