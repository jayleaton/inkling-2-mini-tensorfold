+pub const dividend = "314159265358979323846264338327950288419716939937510";
+pub const divisor = "271828182845904523536";
+pub const inputs = "a=" ++ dividend ++ "\nb=" ++ divisor ++ "\n";
+pub const verification = inputs ++ "q,r=divmod(a,b)\nprint(q)\nprint(r)\nprint(q*b+r==a)";
+pub const expected = "1155727349790921717910215407028\n23663814570294126502\nTrue\n";
+
+const fixtures = [_][2][]const u8{
+    .{ verification, expected },
+    .{ "a=0x100000000;b=0x10001;q,r=divmod(a,b);print(q,r,q*b+r==a)", "65535 1 True\n" },
+    .{ "a=0x7fff00000000;b=0x8000ffff;q,r=divmod(a,b);print(q,r,q*b+r==a)", "65532 327676 True\n" },
+    .{ "a=0x800000000000ffff;b=0x800000000001;q,r=divmod(a,b);print(q,r,q*b+r==a)", "65535 140737488355328 True\n" },
+    .{ "print(1);print(2)", "1\n2\n" },
+    .{ inputs ++ "q,r=divmod(a,b)\nprint(q,r)", "1155727349790921717910215407028 23663814570294126502\n" },
+    .{ "a=-7; b=3; q,r=divmod(a,b); print(q); print(r); print(q*b+r==a)", "-3\n2\nTrue\n" },
+    .{ "q,r=divmod(7,-3); print(q,r); print(q*(-3)+r==7)", "-3 -2\nTrue\n" },
+    .{ "q,r=divmod(-7,-3); print(q,r,q*(-3)+r==-7)", "2 -1 True\n" },
+    .{ "q,q=divmod(7,3); print(q)", "1\n" },
+    .{ "x=7; print(x); x=11; print(x)", "7\n11\n" },
+    .{ "x=3==3; print(x); print(x+1)", "True\n2\n" },
+    .{ "a=100000000000000000000; b=a+1; print(a<b,a>=b,a!=b)", "True False True\n" },
+    .{ "import math; a=48; b=18; print(math.gcd(a,b))", "6\n" },
+    .{ "x=2; y=3\nprint(x+y); # trailing separator/comment\n", "5\n" },
+};
+
+const refused = [_][]const u8{
+    "print(+(1==1))",
+    "print(len(str(1==1)))",
+    "print(sum(map(int,str(1==1))))",
+    "x=1==1;print(len(str(x)))",
+    "q,r=divmod(7,0); print(q,r)",
+    "q,r=divmod(7.0,3); print(q,r)",
+    "q,r=divmod(7,3.0); print(q,r)",
+    "q,r,s=divmod(7,3); print(q,r)",
+    "q,r=(7,3); print(q,r)",
+    "q,r=divmod(7,3)[0]; print(q,r)",
+    "q,r=divmod(7,3); print(q,r,sep=':')",
+    "q,r=divmod(7,3); print(q and r)",
+    "q,r=divmod(7,3); print(0<q<3)",
+    "q,r=divmod(7,3); print(q); x=1//0",
+    "q,r=divmod(7,3); print(q); assert False",
+    "q,r=divmod(10**62,3); print(q,r)",
+    ";print(1)",
+    "x=2;;print(x)",
+    "x=2; ;print(x)",
+    "x=2;\n print(x)",
+    "x=2; y=int('3;4');print(x+y)",
+    "print(1); import os; print(2)",
+};
+
+test "whole integer tool scripts retain source DAGs and fit the unchanged cost cap" {
+    for (fixtures) |fixture| {
+        const result = (try python.lowerWithCost(t.allocator, fixture[0], 10_522)) orelse {
+            std.debug.print("script cost abstained: {s}\n", .{fixture[0]});
+            return error.UnexpectedAbstention;
+        };
+        defer t.allocator.free(result.source);
+        try t.expect(result.estimated_steps.? <= 10_522);
+        try t.expect(std.mem.indexOf(u8, result.source, "tf_run") != null);
+    }
+    const source = (try python.lower(t.allocator, verification)).?;
+    defer t.allocator.free(source);
+    try t.expect(std.mem.indexOf(u8, source, dividend) != null);
+    try t.expect(std.mem.indexOf(u8, source, divisor) != null);
+    try t.expect(std.mem.indexOf(u8, source, "1155727349790921717910215407028") == null);
+    try t.expect(std.mem.indexOf(u8, source, "23663814570294126502") == null);
+}
+
+test "whole script validation refuses malformed unpacking effects floats and chains" {
+    for (refused) |code| {
+        const result = try python.lower(t.allocator, code);
+        defer if (result) |s| t.allocator.free(s);
+        try t.expect(result == null);
+    }
+}
+
+test "configured whole scripts execute grouped and boolean prints exactly like CPython" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{
+        .clang = clang,
+        .linker = env.get("TF_RUNNER_LLD"),
+    } };
+    const f = context.frontend();
+    for (fixtures) |fixture| {
+        const translated = try f.translate(f.ctx, t.allocator, .{ .form = .fence, .lang = "python", .code = fixture[0] });
+        if (translated != .program) {
+            std.debug.print("script dispatch abstained: {s}\n", .{fixture[0]});
+            return error.UnexpectedAbstention;
+        }
+        defer t.allocator.free(translated.program.bytes);
+        try reference.check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", translated.program, fixture[1]);
+        if (translated.program.kind == .elf) try optimization.assertNoOutputInRodata(translated.program.bytes, fixture[1]);
+    }
+}
+
+test "configured whole division script passes optimized work and rodata folding guards" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    if (env.get("TF_RUNNER_CLANG") == null or env.get("TF_RUNNER_QWENPUTER") == null)
+        return error.SkipZigTest;
+    const source = (try python.lower(t.allocator, verification)).?;
+    defer t.allocator.free(source);
+    try optimization.checkOptimization(&env, source, expected, true);
+}
+
+test "configured Boolean coercion preserves CPython semantics through generic fallback" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    _ = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{
+        .clang = clang,
+        .linker = env.get("TF_RUNNER_LLD"),
+    } };
+    const f = context.frontend();
+    const result = try f.translate(f.ctx, t.allocator, .{
+        .form = .fence,
+        .lang = "python",
+        .code = "print(+(1==1))",
+    });
+    defer if (result == .program) t.allocator.free(result.program.bytes);
+    try t.expect(result == .program);
+    const compat = @import("runner_frontend_collections_compat_test.zig");
+    try compat.checkExact(&env, result.program, "print(+(1==1))");
+    for ([_][]const u8{
+        "print(+True)",
+        "print(-True)",
+        "print(len(str(1==1)))",
+        "x=1==1;print(len(str(x)))",
+        "print(sum(map(int,str(1==1))))",
+    }) |code| {
+        try compat.checkRejectionOrExact(&env, &f, .{ .form = .fence, .lang = "python", .code = code });
+    }
+}
diff --git a/zig/src/core/runner_frontend_value.zig b/zig/src/core/runner_frontend_value.zig
new file mode 100644
index 000000000..91a2d5500
--- /dev/null
+++ b/zig/src/core/runner_frontend_value.zig
@@ -0,0 +1,325 @@
+const std = @import("std");
+const Invalid = error{Unsupported};
+const limit: i512 = std.math.pow(i512, 10, 62);
+const Value = struct { n: i512, d: i512 = 1, scale: usize = 0, width: usize = 0 };
+
+// Checks firmware value limits; the returned program remains the source expression, not this validation value.
+pub fn valid(source: []const u8) bool {
+    if (source.len == 0 or source.len > 255) return false;
+    var p: Parser = .{ .src = source };
+    _ = p.expr() catch return false;
+    return p.pos == source.len;
+}
+
+// This admission estimate models firmware arithmetic; it never replaces the emitted source with a proof value.
+pub fn estimate(source: []const u8, budget: usize) ?usize {
+    if (source.len == 0 or source.len > 255) return null;
+    var p: Parser = .{ .src = source, .budget = budget };
+    p.charge(200) catch return null;
+    const value = p.expr() catch return null;
+    if (p.pos != source.len) return null;
+    const output = if (value.scale != 0)
+        @max(width(value), value.scale + 1) + 1
+    else if (value.d != 1)
+        digits(value.n) + digits(value.d) + 1
+    else
+        digits(value.n);
+    p.charge(40 + 10 * (output + @intFromBool(value.n < 0))) catch return null;
+    return p.steps;
+}
+
+fn magnitude(n: i512) i512 {
+    return if (n < 0) -n else n;
+}
+
+fn gcd(a: i512, b: i512) i512 {
+    var x = magnitude(a);
+    var y = magnitude(b);
+    while (y != 0) {
+        const r = @mod(x, y);
+        x = y;
+        y = r;
+    }
+    return x;
+}
+
+fn checked(n: i512, d: i512) Invalid!Value {
+    if (d == 0) return error.Unsupported;
+    const g = gcd(n, d);
+    const sign: i512 = if (d < 0) -1 else 1;
+    const v: Value = .{ .n = @divTrunc(n, g) * sign, .d = @divTrunc(d, g) * sign };
+    if (magnitude(v.n) >= limit or v.d >= limit) return error.Unsupported;
+    return v;
+}
+
+fn integer(v: Value) Invalid!i512 {
+    if (v.d != 1 or v.scale != 0) return error.Unsupported;
+    return v.n;
+}
+
+fn digits(n: i512) usize {
+    var v = magnitude(n);
+    var count: usize = 1;
+    while (v >= 10) : (count += 1) v = @divTrunc(v, 10);
+    return count;
+}
+
+fn rational(op: u8, a: Value, b: Value) Invalid!Value {
+    if (op == '*') {
+        if (digits(a.n) + digits(b.n) > 62 or
+            (a.d != 1 and b.d != 1 and digits(a.d) + digits(b.d) > 62)) return error.Unsupported;
+        return checked(a.n * b.n, a.d * b.d);
+    }
+    if (op == '/') {
+        if (b.n == 0 or (b.d != 1 and digits(a.n) + digits(b.d) > 62) or
+            (a.d != 1 and digits(a.d) + digits(b.n) > 62)) return error.Unsupported;
+        return checked(a.n * b.d, a.d * b.n);
+    }
+    if ((b.d != 1 and digits(a.n) + digits(b.d) > 62) or
+        (a.d != 1 and digits(b.n) + digits(a.d) > 62) or
+        (a.d != 1 and b.d != 1 and digits(a.d) + digits(b.d) > 62)) return error.Unsupported;
+    const x = a.n * b.d;
+    const y = if (op == '+') b.n * a.d else -b.n * a.d;
+    if ((x < 0) == (y < 0) and @max(digits(x), digits(y)) + 1 > 62) return error.Unsupported;
+    return checked(x + y, a.d * b.d);
+}
+
+fn width(v: Value) usize {
+    return if (v.width == 0) digits(v.n) else v.width;
+}
+
+fn decimal(op: u8, a: Value, b: Value) Invalid!Value {
+    if (op != '+' and op != '-' and op != '*') return error.Unsupported;
+    if (op == '*') {
+        const w = width(a) + width(b);
+        if (w > 62) return error.Unsupported;
+        var v = try checked(a.n * b.n, 1);
+        v.scale = a.scale + b.scale;
+        v.width = w;
+        return v;
+    }
+    // Firmware shift() leaves shifted zero untrimmed; reject it before later magnitude comparisons.
+    if ((a.n == 0 and a.scale < b.scale) or (b.n == 0 and b.scale < a.scale)) return error.Unsupported;
+    const scale = @max(a.scale, b.scale);
+    const wa = width(a) + scale - a.scale;
+    const wb = width(b) + scale - b.scale;
+    if (wa > 62 or wb > 62) return error.Unsupported;
+    const x = a.n * std.math.pow(i512, 10, scale - a.scale);
+    const y = b.n * std.math.pow(i512, 10, scale - b.scale) * @as(i512, if (op == '+') 1 else -1);
+    const w = @max(wa, wb) + @intFromBool((x < 0) == (y < 0));
+    if (w > 62) return error.Unsupported;
+    var v = try checked(x + y, 1);
+    v.scale = scale;
+    v.width = w;
+    return v;
+}
+
+const Parser = struct {
+    src: []const u8,
+    pos: usize = 0,
+    budget: ?usize = null,
+    steps: usize = 0,
+
+    fn charge(self: *Parser, amount: usize) Invalid!void {
+        const budget = self.budget orelse return;
+        if (amount > budget - self.steps) {
+            self.steps = budget +| 1;
+            return error.Unsupported;
+        }
+        self.steps += amount;
+    }
+
+    fn divisionCost(self: *Parser, a: i512, b: i512) Invalid!void {
+        try self.charge(80 + 8 * digits(a) * digits(b));
+    }
+
+    fn gcdCost(self: *Parser, a: i512, b: i512) Invalid!i512 {
+        if (self.budget == null) return gcd(a, b);
+        var x = magnitude(a);
+        var y = magnitude(b);
+        try self.charge(40);
+        while (y != 0) {
+            try self.divisionCost(x, y);
+            try self.charge(30);
+            const remainder = @mod(x, y);
+            x = y;
+            y = remainder;
+        }
+        return x;
+    }
+
+    fn reductionCost(self: *Parser, n: i512, d: i512) Invalid!void {
+        if (self.budget == null) return;
+        if (d == 1) return self.charge(20);
+        const g = try self.gcdCost(n, d);
+        try self.divisionCost(n, g);
+        try self.divisionCost(d, g);
+    }
+
+    fn multiplyCost(self: *Parser, a: usize, b: usize) Invalid!void {
+        try self.charge(80 + 3 * a * b);
+    }
+
+    fn apply(self: *Parser, op: u8, a: Value, b: Value) Invalid!Value {
+        const is_decimal = a.scale != 0 or b.scale != 0;
+        const result = if (is_decimal) try decimal(op, a, b) else try rational(op, a, b);
+        if (self.budget == null) return result;
+        if (is_decimal) {
+            if (op == '*') {
+                try self.multiplyCost(width(a), width(b));
+            } else {
+                const scale = @max(a.scale, b.scale);
+                const wa = width(a) + scale - a.scale;
+                const wb = width(b) + scale - b.scale;
+                try self.charge(40 + 5 * @max(wa, wb));
+                try self.charge(10 * ((scale - a.scale) * width(a) + (scale - b.scale) * width(b)));
+            }
+            try self.reductionCost(result.n, 1);
+            return result;
+        }
+        var n: i512 = undefined;
+        var d: i512 = undefined;
+        if (op == '*') {
+            try self.multiplyCost(digits(a.n), digits(b.n));
+            if (a.d != 1 and b.d != 1) try self.multiplyCost(digits(a.d), digits(b.d));
+            n = a.n * b.n;
+            d = a.d * b.d;
+        } else if (op == '/') {
+            try self.charge(60);
+            if (b.d != 1) try self.multiplyCost(digits(a.n), digits(b.d));
+            if (a.d != 1) try self.multiplyCost(digits(a.d), digits(b.n));
+            n = a.n * b.d;
+            d = a.d * b.n;
+        } else {
+            if (b.d != 1) try self.multiplyCost(digits(a.n), digits(b.d));
+            if (a.d != 1) try self.multiplyCost(digits(b.n), digits(a.d));
+            if (a.d != 1 and b.d != 1) try self.multiplyCost(digits(a.d), digits(b.d));
+            const x = a.n * b.d;
+            const y = b.n * a.d;
+            try self.charge(40 + 5 * @max(digits(x), digits(y)));
+            n = if (op == '+') x + y else x - y;
+            d = a.d * b.d;
+        }
+        try self.reductionCost(n, d);
+        return result;
+    }
+
+    fn take(self: *Parser, s: []const u8) bool {
+        if (!std.mem.startsWith(u8, self.src[self.pos..], s)) return false;
+        self.pos += s.len;
+        return true;
+    }
+
+    fn expr(self: *Parser) Invalid!Value {
+        var a = try self.term();
+        while (self.pos < self.src.len) {
+            const op = self.src[self.pos];
+            if (op != '+' and op != '-') break;
+            self.pos += 1;
+            const b = try self.term();
+            if ((a.scale != 0 or b.scale != 0) and (a.d != 1 or b.d != 1)) return error.Unsupported;
+            a = try self.apply(op, a, b);
+        }
+        return a;
+    }
+
+    fn term(self: *Parser) Invalid!Value {
+        var a = try self.factor();
+        while (self.pos < self.src.len) {
+            const op = self.src[self.pos];
+            if (op != '*' and op != '/' and op != '%') break;
+            self.pos += 1;
+            const floor = op == '/' and self.take("/");
+            const b = try self.factor();
+            if (floor or op == '%') {
+                const x = try integer(a);
+                const y = try integer(b);
+                if (y == 0) return error.Unsupported;
+                if ((x < 0) != (y < 0) and @rem(x, y) != 0 and digits(@divTrunc(x, y)) == 62)
+                    return error.Unsupported;
+                try self.divisionCost(x, y);
+                try self.charge(40);
+                a = try checked(if (floor) @divFloor(x, y) else x - @divFloor(x, y) * y, 1);
+                try self.reductionCost(a.n, 1);
+            } else if (a.scale != 0 or b.scale != 0) {
+                if (op != '*' or a.d != 1 or b.d != 1) return error.Unsupported;
+                a = try self.apply(op, a, b);
+            } else if (op == '/' or a.d != 1 or b.d != 1) {
+                a = try self.apply(op, a, b);
+            } else a = try self.apply('*', a, b);
+        }
+        return a;
+    }
+
+    fn factor(self: *Parser) Invalid!Value {
+        if (self.take("+")) {
+            try self.charge(20);
+            return self.factor();
+        }
+        if (self.take("-")) {
+            try self.charge(20);
+            var v = try self.factor();
+            v.n = -v.n;
+            return v;
+        }
+        var a = try self.atom();
+        if (self.take("**")) {
+            var exp = try integer(try self.factor());
+            if (exp < 0 or exp > 999) return error.Unsupported;
+            try self.charge(40);
+            var base = Value{ .n = try integer(a) };
+            a = .{ .n = 1 };
+            while (exp > 0) {
+                try self.charge(20);
+                if (@mod(exp, 2) == 1) a = try self.apply('*', a, base);
+                exp = @divTrunc(exp, 2);
+                if (exp > 0) base = try self.apply('*', base, base);
+            }
+        }
+        return a;
+    }
+
+    fn atom(self: *Parser) Invalid!Value {
+        if (self.take("gcd(")) {
+            try self.charge(40);
+            const a = try integer(try self.expr());
+            if (!self.take(",")) return error.Unsupported;
+            const b = try integer(try self.expr());
+            if (!self.take(")")) return error.Unsupported;
+            return .{ .n = try self.gcdCost(a, b) };
+        }
+        if (self.take("(")) {
+            try self.charge(40);
+            const v = try self.expr();
+            if (!self.take(")")) return error.Unsupported;
+            return v;
+        }
+        var n: i512 = 0;
+        var scale: usize = 0;
+        var dot = false;
+        var count: usize = 0;
+        const start = self.pos;
+        while (self.pos < self.src.len) {
+            const c = self.src[self.pos];
+            if (c == '.' and !dot) {
+                dot = true;
+            } else if (std.ascii.isDigit(c)) {
+                count += 1;
+                if (count > 62) return error.Unsupported;
+                n = n * 10 + c - '0';
+                if (dot) scale += 1;
+            } else break;
+            self.pos += 1;
+        }
+        if (start == self.pos or (self.budget != null and count == 0)) return error.Unsupported;
+        try self.charge(40 + 10 * count);
+        return .{ .n = n, .scale = scale };
+    }
+};
+
+test "value preflight refuses overflow and arithmetic errors" {
+    for ([_][]const u8{ "2**100", "-2**2", "(-2)**2", "7//-3", "1/3+2/3", "1.25*2.4" }) |s|
+        try std.testing.expect(valid(s));
+    for ([_][]const u8{ "10**100", "2**1000", "2**-1", "1/0", "1//0", "1%0", "gcd(1/2,3)", "(1/2)**3" }) |s|
+        try std.testing.expect(!valid(s));
+}
diff --git a/zig/src/core/runner_graph.zig b/zig/src/core/runner_graph.zig
new file mode 100644
index 000000000..8b3295083
--- /dev/null
+++ b/zig/src/core/runner_graph.zig
@@ -0,0 +1,234 @@
+//! Bounded graph workers over a boot-loaded bank; the engine thread never waits for a running job.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const place = @import("runner_place.zig");
+pub const Bank = @import("runner_graph_bank.zig").Bank;
+pub const Machine = @import("runner_graph_machine.zig").Machine;
+pub const Packet = @import("runner_graph_packet.zig").Packet;
+pub const Op = @import("runner_graph_packet.zig").Op;
+pub const Plan = @import("runner_graph_packet.zig").Plan;
+pub const Print = @import("runner_graph_packet.zig").Print;
+pub const PrintStyle = @import("runner_graph_packet.zig").Style;
+pub const PrintEnding = @import("runner_graph_packet.zig").Ending;
+pub const Builder = @import("runner_graph_packet.zig").Builder;
+pub const id = "graph";
+pub const bindCell = @import("runner_graph_bind.zig").cell;
+pub const bindExpression = @import("runner_graph_bind.zig").expression;
+pub const bindScript = @import("runner_graph_bind.zig").script;
+pub const directFrontend = @import("runner_graph_frontend.zig").frontend;
+
+const Allocator = std.mem.Allocator;
+
+const Job = struct {
+    id: api.JobId,
+    stream: u64,
+    program: []u8,
+    graph: bool,
+    budget: u64,
+    thread: ?std.Thread = null,
+    done: std.atomic.Value(bool) = .init(false),
+    cancel: std.atomic.Value(bool) = .init(false),
+    result: api.Result = .{ .status = .abstain, .abstain = .unsupported },
+    out: std.ArrayList(u8) = .empty,
+};
+
+const Cpu = struct {
+    gpa: Allocator,
+    bank: *const Bank,
+    workers: u8,
+    placer: ?*place.Placer = null,
+    next_id: api.JobId = 1,
+    jobs: std.ArrayList(*Job) = .empty,
+    dropped: std.ArrayList(*Job) = .empty,
+    delivered: std.ArrayList(*Job) = .empty,
+    now_out: std.ArrayList(u8) = .empty, // the last run on the engine thread's output
+
+    fn live(c: *Cpu) usize {
+        return c.jobs.items.len + c.dropped.items.len;
+    }
+
+    fn free(c: *Cpu, j: *Job) void {
+        if (j.thread) |t| t.join();
+        j.out.deinit(c.gpa);
+        c.gpa.free(j.program);
+        c.gpa.destroy(j);
+    }
+
+    /// Joins and frees cancelled jobs whose worker has stopped.
+    fn reap(c: *Cpu) void {
+        var i: usize = 0;
+        while (i < c.dropped.items.len) {
+            const j = c.dropped.items[i];
+            if (!j.done.load(.acquire)) {
+                i += 1;
+                continue;
+            }
+            _ = c.dropped.swapRemove(i);
+            c.free(j);
+        }
+    }
+
+    /// `out` of a stream's previous result stays valid only until the next call for that stream.
+    fn forget(c: *Cpu, stream: u64) void {
+        var i: usize = 0;
+        while (i < c.delivered.items.len) {
+            if (c.delivered.items[i].stream != stream) {
+                i += 1;
+                continue;
+            }
+            c.free(c.delivered.swapRemove(i));
+        }
+    }
+
+    fn find(c: *Cpu, job_id: api.JobId) ?usize {
+        for (c.jobs.items, 0..) |j, i| if (j.id == job_id) return i;
+        return null;
+    }
+
+    fn drop(c: *Cpu, i: usize) void {
+        const j = c.jobs.swapRemove(i);
+        j.cancel.store(true, .release);
+        c.dropped.appendAssumeCapacity(j);
+    }
+};
+
+fn work(c: *Cpu, j: *Job) void {
+    if (c.placer) |p| p.enter();
+    var began: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &began);
+    defer {
+        var ended: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(.MONOTONIC, &ended);
+        const ns = (ended.sec - began.sec) * std.time.ns_per_s + ended.nsec - began.nsec;
+        j.result.exec_ns = @intCast(@max(0, ns));
+        j.done.store(true, .release);
+    }
+    if (!j.graph) return;
+    var m = Machine.boot(c.gpa, c.bank, j.program) catch return;
+    defer m.deinit();
+    const end = m.run(j.budget, &j.out, &j.cancel) catch {
+        j.out.clearRetainingCapacity();
+        j.result = .{ .status = .abstain, .abstain = .unsupported, .steps = m.steps };
+        return;
+    };
+    j.result = resultOf(end);
+}
+
+fn resultOf(end: api.RunEnd) api.Result {
+    return .{
+        .status = switch (end.end) {
+            .halted => .ok,
+            .budget => .budget,
+            .fault => .fault,
+            .cancelled => .abstain,
+        },
+        .steps = end.steps,
+        .abstain = if (end.end == .cancelled) .unsupported else null,
+    };
+}
+
+/// A job's run here, capped at `quick` steps: one that ends sooner is the job's own result; else (or an error) null.
+fn now(ctx: *anyopaque, program: api.Program, budget: u64, quick: u64) ?api.Result {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    if (!std.mem.eql(u8, @tagName(program.kind), id) or program.bytes.len > @import("runner_graph_packet.zig").max_packet) return null;
+    c.now_out.clearRetainingCapacity();
+    var t0: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &t0);
+    var m = Machine.boot(c.gpa, c.bank, program.bytes) catch return null;
+    defer m.deinit();
+    m.decode = false; // the engine thread: a template's first decode (0.1-0.4 s wide) is the job's, in a hold
+    const cap = @min(budget, quick);
+    const end = m.run(cap, &c.now_out, null) catch return null;
+    if (end.end == .budget and cap < budget) return null;
+    var t1: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &t1);
+    var r = resultOf(end);
+    r.out = c.now_out.items;
+    r.exec_ns = @intCast(@max(0, (t1.sec - t0.sec) * std.time.ns_per_s + t1.nsec - t0.nsec));
+    return r;
+}
+
+fn start(ctx: *anyopaque, stream: u64, program: api.Program, budget: u64) error{ OutOfMemory, Busy }!api.JobId {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    c.forget(stream);
+    if (c.live() >= c.workers) return error.Busy;
+    const j = try c.gpa.create(Job);
+    errdefer c.gpa.destroy(j);
+    const valid = std.mem.eql(u8, @tagName(program.kind), id) and
+        program.bytes.len <= @import("runner_graph_packet.zig").max_packet;
+    const bytes = try c.gpa.dupe(u8, if (valid) program.bytes else "");
+    errdefer c.gpa.free(bytes);
+    j.* = .{ .id = c.next_id, .stream = stream, .program = bytes, .graph = valid, .budget = budget };
+    try c.jobs.ensureUnusedCapacity(c.gpa, 1);
+    j.thread = std.Thread.spawn(.{}, work, .{ c, j }) catch return error.Busy;
+    c.jobs.appendAssumeCapacity(j);
+    c.next_id += 1;
+    return j.id;
+}
+
+fn poll(ctx: *anyopaque, job_id: api.JobId) api.Poll {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    const i = c.find(job_id) orelse return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    const j = c.jobs.items[i];
+    if (!j.done.load(.acquire)) return .running;
+    _ = c.jobs.swapRemove(i);
+    if (j.thread) |t| t.join();
+    j.thread = null;
+    c.forget(j.stream);
+    c.delivered.append(c.gpa, j) catch {
+        c.free(j);
+        return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    };
+    var r = j.result;
+    r.out = j.out.items;
+    return .{ .done = r };
+}
+
+fn cancel(ctx: *anyopaque, job_id: api.JobId) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    if (c.find(job_id)) |i| c.drop(i);
+    c.reap();
+}
+
+fn release(ctx: *anyopaque, stream: u64) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    var i: usize = 0;
+    while (i < c.jobs.items.len) {
+        if (c.jobs.items[i].stream == stream) c.drop(i) else i += 1;
+    }
+    c.forget(stream);
+    c.reap();
+}
+
+const vtable: api.Backend.VTable = .{ .start = start, .poll = poll, .cancel = cancel, .release = release, .now = now };
+
+/// Runs at most workers jobs over a bank the caller keeps alive; gpa must support worker-thread allocations.
+pub fn backend(gpa: Allocator, bank: *const Bank, workers: u8) !api.Backend {
+    return placed(gpa, bank, workers, null);
+}
+
+/// As `backend`, each job's thread placed by `placer` (which the caller keeps alive) before it boots a machine.
+pub fn placed(gpa: Allocator, bank: *const Bank, workers: u8, placer: ?*place.Placer) !api.Backend {
+    if (workers == 0) return error.NoWorkers;
+    const c = try gpa.create(Cpu);
+    errdefer gpa.destroy(c);
+    c.* = .{ .gpa = gpa, .bank = bank, .workers = workers, .placer = placer };
+    try c.dropped.ensureTotalCapacity(gpa, workers);
+    errdefer c.dropped.deinit(gpa);
+    try c.jobs.ensureTotalCapacity(gpa, workers);
+    return .{ .ctx = c, .vtable = &vtable };
+}
+
+/// Cancels every job, waits for the workers and frees the backend.
+pub fn destroy(b: api.Backend) void {
+    const c: *Cpu = @ptrCast(@alignCast(b.ctx));
+    for (c.jobs.items) |j| j.cancel.store(true, .release);
+    for ([_]*std.ArrayList(*Job){ &c.jobs, &c.dropped, &c.delivered }) |list| {
+        for (list.items) |j| c.free(j);
+        list.deinit(c.gpa);
+    }
+    c.now_out.deinit(c.gpa);
+    c.gpa.destroy(c);
+}
diff --git a/zig/src/core/runner_graph_algorithms.zig b/zig/src/core/runner_graph_algorithms.zig
new file mode 100644
index 000000000..1e83f43e7
--- /dev/null
+++ b/zig/src/core/runner_graph_algorithms.zig
@@ -0,0 +1,403 @@
+//! Integer algorithms orchestrate prepared FFNs and transfer raw rows without decoding operands.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const packet = @import("runner_graph_packet.zig");
+const factor = @import("runner_graph_factor.zig");
+const End = @FieldType(api.RunEnd, "end");
+const Cancel = ?*const std.atomic.Value(bool);
+
+/// Executes an algorithm in request-local scratch and copies only its typed outputs back to the caller.
+pub fn compute(m: anytype, kind: []const u8, width: u16, precision: u8, refs: []const u32, dest: usize, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !End {
+    if (std.mem.startsWith(u8, kind, "f64_")) return @import("runner_graph_f64.zig").compute(m, kind, width, refs, dest, budget, out, cancel);
+    if (std.mem.eql(u8, kind, "factorize")) return error.GraphAlgorithm;
+    const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+    const outputs = packet.algorithmOutputs(family);
+    if (!packet.algorithmWidthValid(family, width) or refs.len != packet.algorithmArity(family) or dest + outputs > m.values.len)
+        return error.GraphAlgorithmScratch;
+    if (precision > 18 or (family != .fixed_div and precision != 0)) return error.GraphPrecision;
+    const original = m.values;
+    const zero = try packet.literal("0");
+    var scratch: [32]packet.Value = @splat(zero);
+    scratch[1] = try packet.literal("1");
+    for (refs, 0..) |ref, i| {
+        if (ref >= original.len) return error.GraphReference;
+        for (width..packet.max_digits) |digit| {
+            const bits = original[ref][digit / 31][2 + digit % 31 * 4 ..][0..4];
+            for (bits) |bit| if (bit != 0) return error.GraphNarrowBinding;
+        }
+        scratch[2 + i] = original[ref];
+    }
+    m.values = &scratch;
+    defer m.values = original;
+    const work_width = if (std.mem.eql(u8, kind, "smallest_factor")) @max(width, 8) else width;
+    var c: Context(@TypeOf(m)) = .{ .m = m, .width = work_width, .precision = precision, .budget = budget, .out = out, .cancel = cancel, .input_digits = occupiedDigits(&scratch[2]) };
+    const result = c.calculate(kind) catch |err| switch (err) {
+        error.GraphAlgorithmStopped => return c.end,
+        error.GraphAlgorithmLimit => return .budget,
+        error.GraphAlgorithmArithmetic => blk: {
+            scratch[0][0][127] = packet.bit_scale;
+            break :blk [2]u32{ 0, 0 };
+        },
+        else => return err,
+    };
+    const values = [2]packet.Value{ scratch[result[0]], scratch[result[1]] };
+    @memcpy(original[dest .. dest + outputs], values[0..outputs]);
+    return .halted;
+}
+
+/// Named legacy algorithms retain their token schedules; new fractional formats use the compiled formatter.
+pub fn run(m: anytype, kind: []const u8, width: u16, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !api.RunEnd {
+    if (std.mem.startsWith(u8, kind, "f64_")) return @import("runner_graph_f64.zig").run(m, kind, budget, out, cancel);
+    if (std.mem.eql(u8, kind, "factorize")) return runFactorize(m, width, budget, out, cancel);
+    const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+    const refs = [_]u32{ 0, 1, 2 };
+    var end = try compute(m, kind, width, m.precision, refs[0..packet.algorithmArity(family)], 0, budget, out, cancel);
+    if (end != .halted) return .{ .end = end, .steps = m.steps };
+    if (std.mem.eql(u8, kind, "smallest_factor")) {
+        end = try @import("runner_graph_print.zig").emit(m, .{ .ref = 0 }, budget, out, cancel);
+        return .{ .end = end, .steps = m.steps };
+    }
+    if (family == .fraction or family == .fixed_div) {
+        end = try @import("runner_graph_print.zig").emit(m, .{ .ref = 0, .second = if (family == .fraction) 1 else null, .style = if (family == .fraction) .fraction else .fixed, .precision = m.precision }, budget, out, cancel);
+        return .{ .end = end, .steps = m.steps };
+    }
+    var c: Context(@TypeOf(m)) = .{ .m = m, .width = width, .budget = budget, .out = out, .cancel = cancel, .input_digits = 1 };
+    const failed = m.values[0][0][127];
+    if (failed != 0 and failed != packet.bit_scale) return error.GraphPredicate;
+    if (family == .divmod and failed == 0) {
+        c.emitNamed("emit_first", 0) catch |err| switch (err) {
+            error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+            else => return err,
+        };
+        c.emitNamed("emit_last", 1) catch |err| switch (err) {
+            error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+            else => return err,
+        };
+    } else c.emit(0) catch |err| switch (err) {
+        error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+        else => return err,
+    };
+    return .{ .end = .halted, .steps = m.steps };
+}
+
+fn runFactorize(m: anytype, width: u16, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !api.RunEnd {
+    if (!packet.widthValid(width) or width > 128 or m.values.len < 2) return error.GraphAlgorithmScratch;
+    if (m.precision != 0) return error.GraphPrecision;
+    const original = m.values;
+    const zero = try packet.literal("0");
+    var scratch: [32]packet.Value = @splat(zero);
+    scratch[1] = try packet.literal("1");
+    for (original[0..2], 0..) |value, i| {
+        for (width..packet.max_digits) |digit| {
+            for (value[digit / 31][2 + digit % 31 * 4 ..][0..4]) |bit|
+                if (bit != 0) return error.GraphNarrowBinding;
+        }
+        scratch[2 + i] = value;
+    }
+    m.values = &scratch;
+    defer m.values = original;
+    var c: Context(@TypeOf(m)) = .{ .m = m, .width = @max(width, 8), .budget = budget, .out = out, .cancel = cancel, .input_digits = occupiedDigits(&scratch[2]) };
+    factor.factorize(&c) catch |err| switch (err) {
+        error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+        error.GraphAlgorithmLimit => return .{ .end = .budget, .steps = m.steps },
+        error.GraphAlgorithmArithmetic => {
+            scratch[0][0][127] = packet.bit_scale;
+            const end = try @import("runner_graph_print.zig").emit(m, .{ .ref = 0 }, budget, out, cancel);
+            return .{ .end = end, .steps = m.steps };
+        },
+        else => return err,
+    };
+    return .{ .end = .halted, .steps = m.steps };
+}
+
+fn Context(comptime M: type) type {
+    return struct {
+        m: M,
+        width: u16,
+        budget: u64,
+        out: *std.ArrayList(u8),
+        cancel: Cancel,
+        input_digits: usize,
+        precision: u8 = 0,
+        end: End = .halted,
+
+        const Self = @This();
+
+        pub fn call(c: *Self, name: []const u8, refs: []const u32, dest: usize) !void {
+            const width = if (std.mem.eql(u8, name, "meta")) @max(c.width, 8) else c.width;
+            var needed: usize = 1;
+            for (refs) |ref| needed = @max(needed, occupiedDigits(&c.m.values[ref]));
+            if (std.mem.eql(u8, name, "mul")) {
+                needed = occupiedDigits(&c.m.values[refs[0]]) + occupiedDigits(&c.m.values[refs[1]]);
+            } else if (std.mem.eql(u8, name, "add") or std.mem.eql(u8, name, "sub") or std.mem.eql(u8, name, "scale10")) {
+                needed += 1;
+            } else if (std.mem.eql(u8, name, "meta")) needed = @max(needed, 8);
+            const selected = bucket(@min(needed, width));
+            const t = (if (c.m.adaptive_widths) c.m.bank.find(name, selected) else null) orelse
+                c.m.bank.find(name, width) orelse return error.GraphTemplate;
+            c.end = try c.m.invoke(t, refs, dest, c.budget, c.out, c.cancel, false);
+            if (c.end != .halted) return error.GraphAlgorithmStopped;
+            for (dest..dest + t.outputs) |i| try clean(&c.m.values[i]);
+        }
+
+        fn emit(c: *Self, ref: u32) !void {
+            return c.emitNamed("emit", ref);
+        }
+
+        fn emitNamed(c: *Self, name: []const u8, ref: u32) !void {
+            const needed = if (c.m.adaptive_widths) occupiedDigits(&c.m.values[ref]) else c.width;
+            const width: u16 = if (needed > 128) 256 else if (needed > 62) 128 else 62;
+            const t = c.m.bank.find(name, width) orelse return error.GraphEmitMissing;
+            c.end = try c.m.invoke(t, &.{ref}, 0, c.budget, c.out, c.cancel, true);
+            if (c.end != .halted) return error.GraphAlgorithmStopped;
+        }
+
+        pub fn move(c: *Self, dest: usize, source: usize) void {
+            c.m.values[dest] = c.m.values[source];
+        }
+
+        pub fn meta(c: *Self, a: u32, b: u32) !void {
+            try c.call("meta", &.{ a, b }, 20);
+        }
+
+        pub fn flag(c: *Self, digit: usize) !bool {
+            return predicate(&c.m.values[22], digit);
+        }
+
+        pub fn nonzero(c: *Self, ref: u32) !bool {
+            try c.meta(ref, 0);
+            return c.flag(0);
+        }
+
+        /// Slots 24..30 are private to long division; both result slots must be outside that interval.
+        fn unsigned(c: *Self, a: u32, b: u32, q: usize, r: usize) !void {
+            c.move(24, a);
+            c.move(25, b);
+            c.move(26, 0);
+            c.move(27, 0);
+            var digit: usize = c.width;
+            while (digit > 0) {
+                digit -= 1;
+                c.move(28, 0);
+                packet.copyBits(&c.m.values[28], &c.m.values[24], .{
+                    .ref = 24,
+                    .from = @intCast(digit),
+                    .digits = 1,
+                });
+                try c.call("divstep", &.{ 27, 25, 28 }, 29);
+                c.move(27, 29);
+                packet.copyBits(&c.m.values[26], &c.m.values[30], .{
+                    .ref = 30,
+                    .to = @intCast(digit),
+                    .digits = 1,
+                });
+            }
+            c.move(q, 26);
+            c.move(r, 27);
+        }
+
+        fn calculate(c: *Self, kind: []const u8) ![2]u32 {
+            if (std.mem.eql(u8, kind, "smallest_factor")) return .{ try factor.smallest(c), 0 };
+            if (std.mem.eql(u8, kind, "divmod") or std.mem.eql(u8, kind, "divexact")) {
+                try c.meta(2, 3);
+                c.move(5, 20);
+                c.move(6, 21);
+                try c.unsigned(5, 6, 7, 8);
+                if (std.mem.eql(u8, kind, "divexact")) {
+                    if (try c.nonzero(8)) return error.GraphAlgorithmArithmetic;
+                    try c.call("round_div", &.{ 7, 8, 2, 3 }, 10);
+                    return .{ 10, 0 };
+                }
+                try c.call("divfinal", &.{ 7, 8, 2, 3 }, 10);
+                return .{ 10, 11 };
+            }
+            if (std.mem.eql(u8, kind, "fraction")) return c.fraction();
+            if (std.mem.eql(u8, kind, "fixed_div")) return .{ try c.fixedDivision(), 0 };
+            const result: u32 = if (std.mem.eql(u8, kind, "gcd")) try c.gcd() else if (std.mem.eql(u8, kind, "isqrt")) try c.isqrt() else if (std.mem.eql(u8, kind, "digit_sum")) try c.digitSum() else if (std.mem.eql(u8, kind, "powmod")) try c.powmod() else if (std.mem.eql(u8, kind, "square_offset")) try c.squareOffset() else try c.product(std.mem.eql(u8, kind, "factorial"));
+            return .{ result, 0 };
+        }
+
+        fn fraction(c: *Self) ![2]u32 {
+            const divisor = try c.gcd();
+            c.move(15, divisor);
+            try c.meta(2, 3);
+            if (!try c.flag(1)) return error.GraphAlgorithmArithmetic;
+            c.move(5, 20);
+            c.move(6, 21);
+            try c.unsigned(5, 15, 7, 8);
+            try c.unsigned(6, 15, 9, 10);
+            try c.call("divfinal", &.{ 7, 0, 2, 3 }, 10);
+            return .{ 10, 9 };
+        }
+
+        fn fixedDivision(c: *Self) !u32 {
+            try c.meta(2, 3);
+            if (!try c.flag(1)) return error.GraphAlgorithmArithmetic;
+            c.move(5, 20);
+            c.move(6, 21);
+            try c.unsigned(5, 6, 7, 8);
+            for (0..c.precision) |_| {
+                try c.call("scale10", &.{7}, 7);
+                try c.call("divstep", &.{ 8, 6, 0 }, 10);
+                c.move(8, 10);
+                try c.call("add", &.{ 7, 11 }, 7);
+            }
+            try c.call("round_div", &.{ 7, 8, 2, 3 }, 10);
+            return 10;
+        }
+
+        fn gcd(c: *Self) !u32 {
+            try c.meta(2, 3);
+            c.move(5, 20);
+            c.move(6, 21);
+            var iterations: usize = 0;
+            while (try c.nonzero(6)) {
+                if (iterations >= @as(usize, c.width) * 8) return error.GraphAlgorithmLimit;
+                iterations += 1;
+                try c.unsigned(5, 6, 7, 8);
+                c.move(5, 6);
+                c.move(6, 8);
+            }
+            return 5;
+        }
+
+        fn isqrt(c: *Self) !u32 {
+            try c.meta(2, 0);
+            if (try c.flag(2)) return error.GraphAlgorithmArithmetic;
+            if (!try c.flag(0)) return 0;
+            c.move(5, 20);
+            const nines: [packet.max_digits]u8 = @splat('9');
+            c.m.values[6] = try packet.literal(nines[0 .. (c.input_digits + 1) / 2]);
+            for (0..@as(usize, c.width) * 8) |_| {
+                try c.unsigned(5, 6, 7, 8);
+                try c.call("half", &.{6}, 12);
+                c.move(9, 12);
+                c.move(10, 13);
+                try c.call("half", &.{7}, 12);
+                try c.call("add", &.{ 9, 12 }, 11);
+                if (try predicate(&c.m.values[10], 0)) {
+                    if (try predicate(&c.m.values[13], 0)) {
+                        try c.call("add", &.{ 11, 1 }, 11);
+                    }
+                }
+                try c.meta(11, 6);
+                if (!try c.flag(4)) return 6;
+                c.move(6, 11);
+            }
+            return error.GraphAlgorithmLimit;
+        }
+
+        fn digitSum(c: *Self) !u32 {
+            try c.call("digit_sum", &.{2}, 6);
+            return 6;
+        }
+
+        fn squareOffset(c: *Self) !u32 {
+            try c.meta(2, 3);
+            if (!try c.flag(1)) return 0;
+            try c.call("add", &.{ 2, 3 }, 5);
+            try c.call("add", &.{ 2, 5 }, 6);
+            try c.call("mul", &.{ 6, 3 }, 7);
+            return 7;
+        }
+
+        /// Range products use [start, stop); factorial includes n and never constructs n+1.
+        fn product(c: *Self, factorial: bool) !u32 {
+            try c.meta(2, if (factorial) 0 else 3);
+            if (try c.flag(2)) return error.GraphAlgorithmArithmetic;
+            if (try c.flag(3)) return error.GraphAlgorithmArithmetic;
+            c.move(5, if (factorial) 1 else 20);
+            c.move(6, if (factorial) 20 else 21);
+            c.move(7, 1);
+            var iterations: usize = 0;
+            while (true) {
+                try c.meta(5, 6);
+                const less = try c.flag(4);
+                const equal = try c.flag(5);
+                if (!less and !(factorial and equal)) return 7;
+                if (iterations >= 10000) return error.GraphAlgorithmLimit;
+                iterations += 1;
+                try c.call("mul", &.{ 7, 5 }, 7);
+                if (factorial and equal) return 7;
+                try c.call("add", &.{ 5, 1 }, 5);
+            }
+        }
+
+        /// One prepared Horner step consumes a decimal multiplier digit; modulus stays in slot 7.
+        fn modmul(c: *Self, a: u32, b: u32, dest: usize) !void {
+            c.move(17, a);
+            c.move(18, b);
+            c.move(16, 0);
+            var digit = occupiedDigits(&c.m.values[18]);
+            while (digit > 0) {
+                digit -= 1;
+                c.move(19, 0);
+                packet.copyBits(&c.m.values[19], &c.m.values[18], .{
+                    .ref = 18,
+                    .from = @intCast(digit),
+                    .digits = 1,
+                });
+                try c.call("mulmodstep", &.{ 16, 17, 19, 7 }, 16);
+            }
+            c.move(dest, 16);
+        }
+
+        fn powmod(c: *Self) !u32 {
+            try c.meta(2, 4);
+            c.move(5, 20);
+            c.move(7, 21);
+            c.move(9, 22);
+            if (!try c.flag(1)) return error.GraphAlgorithmArithmetic;
+            try c.meta(3, 0);
+            if (try c.flag(2)) return error.GraphAlgorithmArithmetic;
+            c.move(6, 20);
+            try c.unsigned(5, 7, 10, 11);
+            try c.call("divfinal", &.{ 10, 11, 2, 7 }, 10);
+            c.move(5, 11);
+            try c.unsigned(1, 7, 10, 11);
+            c.move(8, 11);
+            var iterations: usize = 0;
+            while (try c.nonzero(6)) {
+                if (iterations >= @as(usize, c.width) * 4) return error.GraphAlgorithmLimit;
+                iterations += 1;
+                try c.call("half", &.{6}, 12);
+                c.move(6, 12);
+                if (try predicate(&c.m.values[13], 0)) try c.modmul(8, 5, 8);
+                if (try c.nonzero(6)) try c.modmul(5, 5, 5);
+            }
+            if (try predicate(&c.m.values[9], 3)) {
+                if (try c.nonzero(8)) try c.call("sub", &.{ 8, 7 }, 8);
+            }
+            return 8;
+        }
+    };
+}
+
+fn occupiedDigits(value: *const packet.Value) usize {
+    var digits: usize = packet.max_digits;
+    while (digits > 1) : (digits -= 1) {
+        const at = digits - 1;
+        for (value[at / 31][2 + at % 31 * 4 ..][0..4]) |bit| if (bit != 0) return digits;
+    }
+    return digits;
+}
+
+fn bucket(needed: usize) u16 {
+    for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128, 256 }) |width| if (needed <= width) return width;
+    unreachable;
+}
+
+fn clean(value: *const packet.Value) !void {
+    const bit = value[0][127];
+    if (bit == packet.bit_scale) return error.GraphAlgorithmArithmetic;
+    if (bit != 0) return error.GraphPredicate;
+}
+
+fn predicate(value: *const packet.Value, digit: usize) !bool {
+    try clean(value);
+    const bits = value[digit / 31][2 + digit % 31 * 4 ..][0..4];
+    for (bits[1..]) |bit| if (bit != 0) return error.GraphPredicate;
+    if (bits[0] == 0) return false;
+    if (bits[0] == packet.bit_scale) return true;
+    return error.GraphPredicate;
+}
diff --git a/zig/src/core/runner_graph_bank.zig b/zig/src/core/runner_graph_bank.zig
new file mode 100644
index 000000000..f57394243
--- /dev/null
+++ b/zig/src/core/runner_graph_bank.zig
@@ -0,0 +1,376 @@
+//! Stable template descriptors with once-only lazy prepared weights and validated named binding plans.
+const std = @import("std");
+const model = @import("steps_v1/runner_circuit_model.zig");
+const binary = @import("runner_graph_binary.zig");
+const packet = @import("runner_graph_packet.zig");
+const lazy = @import("runner_graph_lazy.zig");
+const Allocator = std.mem.Allocator;
+const missing = std.math.maxInt(u32);
+pub const Slots = lazy.Slots;
+
+pub const Template = struct {
+    name: []const u8,
+    width: u16,
+    circuit: model.Circuit,
+    inputs: u8,
+    outputs: u8,
+    in_slots: Slots,
+    out_slots: Slots,
+    preparation: ?*Preparation = null,
+    materialized: bool = true,
+
+    /// Circuit fields and logical slots may be read only after this succeeds; prepared copies keep their own circuit.
+    pub fn prepare(t: *const Template) !void {
+        const p = t.preparation orelse return;
+        if (p.ready.load(.acquire)) {
+            if (t != p.owner and !t.materialized) return error.GraphUnpreparedCopy;
+            return;
+        }
+        if (t != p.owner) return error.GraphUnpreparedCopy;
+        var threaded: std.Io.Threaded = .init_single_threaded;
+        const io = threaded.io();
+        p.mutex.lockUncancelable(io);
+        defer p.mutex.unlock(io);
+        if (p.ready.load(.acquire)) return;
+        if (p.failure) |err| return err;
+        _ = p.attempts.fetchAdd(1, .monotonic);
+        p.publish() catch |err| {
+            p.failure = err;
+            return err;
+        };
+    }
+
+    pub fn isPrepared(t: *const Template) bool {
+        const p = t.preparation orelse return true;
+        return p.ready.load(.acquire) and (t == p.owner or t.materialized);
+    }
+
+    pub fn loadAttempts(t: *const Template) u32 {
+        return if (t.preparation) |p| p.attempts.load(.monotonic) else 0;
+    }
+};
+
+const Preparation = struct {
+    gpa: Allocator,
+    owner: *Template,
+    path: []const u8,
+    header: binary.Header,
+    mutex: std.Io.Mutex = .init,
+    ready: std.atomic.Value(bool) = .init(false),
+    attempts: std.atomic.Value(u32) = .init(0),
+    failure: ?anyerror = null,
+
+    fn publish(p: *Preparation) !void {
+        const t = p.owner;
+        var circuit = try binary.loadPinned(p.gpa, p.path, t.name, t.width, &p.header);
+        errdefer circuit.deinit(p.gpa);
+        const layout = try lazy.Binding.inspect(&circuit, try binary.bindingWidth(t.width));
+        if ((t.inputs != 0 and layout.inputs != t.inputs) or (t.outputs != 0 and layout.outputs != t.outputs))
+            return error.GraphSlotArity;
+        if (t.inputs == 0) t.inputs = layout.inputs;
+        if (t.outputs == 0) t.outputs = layout.outputs;
+        t.circuit = circuit;
+        t.in_slots = layout.in_slots;
+        t.out_slots = layout.out_slots;
+        t.materialized = true;
+        p.ready.store(true, .release);
+    }
+};
+
+pub const LoadMode = enum { lazy, eager };
+
+const Descriptor = struct {
+    name: []const u8,
+    width: u16,
+    path: []const u8,
+    inputs: ?u8 = null,
+    outputs: ?u8 = null,
+};
+pub const PreparedPlan = struct {
+    name: []const u8,
+    inputs: u32,
+    ops: []const packet.Op,
+    result: u32,
+    constants: []const packet.Value,
+    total_values: usize,
+    algorithm: ?[]const u8,
+    width: u16,
+    precision: u8,
+};
+
+const Manifest = struct {
+    version: u32,
+    templates: []const Descriptor,
+    plans: []const packet.Plan = &.{},
+};
+
+pub const Bank = struct {
+    gpa: Allocator,
+    arena: std.heap.ArenaAllocator,
+    templates: []Template,
+    plans: []const PreparedPlan,
+
+    pub fn load(a: Allocator, path: []const u8) !Bank {
+        return loadWithMode(a, path, .lazy);
+    }
+
+    pub fn loadEager(a: Allocator, path: []const u8) !Bank {
+        return loadWithMode(a, path, .eager);
+    }
+
+    /// The allocator must support concurrent stream allocations; the bank owns all loaded circuits until deinit.
+    pub fn loadWithMode(a: Allocator, path: []const u8, mode: LoadMode) !Bank {
+        var threaded: std.Io.Threaded = .init_single_threaded;
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, a, .limited(32 << 20));
+        defer a.free(bytes);
+        var arena = std.heap.ArenaAllocator.init(a);
+        errdefer arena.deinit();
+        const doc = try std.json.parseFromSliceLeaky(Manifest, arena.allocator(), bytes, .{ .allocate = .alloc_always });
+        if (doc.version != 1 or doc.templates.len == 0 or doc.templates.len > 256) return error.GraphManifest;
+        const templates = try arena.allocator().alloc(Template, doc.templates.len);
+        const preparations = try arena.allocator().alloc(Preparation, doc.templates.len);
+        const expected_schema = binary.schemaHash();
+        var loaded: usize = 0;
+        errdefer for (templates[0..loaded]) |*t| {
+            if (t.isPrepared()) t.circuit.deinit(a);
+        };
+        for (doc.templates, templates, preparations) |d, *t, *preparation| {
+            if (!packet.widthValid(d.width) or d.width == 255 or d.name.len == 0 or d.path.len == 0) return error.GraphTemplate;
+            if (d.inputs) |n| if (n == 0 or n > packet.max_arity) return error.GraphSlotArity;
+            if (d.outputs) |n| if (n == 0 or n > packet.max_arity) return error.GraphSlotArity;
+            for (templates[0..loaded]) |prior| if (prior.width == d.width and std.mem.eql(u8, prior.name, d.name))
+                return error.GraphDuplicateTemplate;
+            const joined = if (std.fs.path.isAbsolute(d.path)) d.path else try std.fs.path.join(arena.allocator(), &.{ std.fs.path.dirname(path) orelse ".", d.path });
+            const resolved = try std.Io.Dir.cwd().realPathFileAlloc(threaded.io(), joined, arena.allocator());
+            const h = try binary.inspect(resolved, d.name, d.width, expected_schema);
+            const legacy = binary.isLegacy(&h);
+            const inputs = d.inputs orelse if (legacy) @as(u8, 0) else return error.GraphSlotArity;
+            const outputs = d.outputs orelse if (legacy) @as(u8, 0) else return error.GraphSlotArity;
+            if (!legacy and (inputs != h[80] or outputs != h[81])) return error.GraphSlotArity;
+            preparation.* = .{ .gpa = a, .owner = t, .path = resolved, .header = h };
+            t.* = .{ .name = d.name, .width = d.width, .circuit = undefined, .inputs = inputs, .outputs = outputs, .in_slots = @splat(@splat(missing)), .out_slots = @splat(@splat(missing)), .preparation = preparation, .materialized = false };
+            loaded += 1;
+            // Legacy headers omit bindings; validate the complete payload before exposing the descriptor.
+            if (legacy) try t.prepare();
+        }
+        const plans = try arena.allocator().alloc(PreparedPlan, doc.plans.len);
+        var bank: Bank = .{ .gpa = a, .arena = arena, .templates = templates, .plans = plans };
+        for (doc.plans, 0..) |p, i| {
+            if (p.name.len == 0) return error.GraphPlan;
+            for (doc.plans[0..i]) |prior| if (std.mem.eql(u8, prior.name, p.name)) return error.GraphDuplicatePlan;
+            if (p.inputs > packet.max_values or p.literals.len > packet.max_values - p.inputs)
+                return error.GraphPlanSize;
+            const constants = try arena.allocator().alloc(packet.Value, p.literals.len);
+            for (p.literals, constants) |text, *v| v.* = try packet.literal(text);
+            if (p.algorithm) |kind| {
+                const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+                if (p.inputs != packet.algorithmArity(family) or p.ops.len != 0 or constants.len != 0 or p.result != 0)
+                    return error.GraphAlgorithm;
+                try bank.validateAlgorithm(family, p.width, p.precision);
+            } else if (p.precision != 0) {
+                return error.GraphPrecision;
+            }
+            plans[i] = .{ .name = p.name, .inputs = p.inputs, .ops = p.ops, .result = p.result, .constants = constants, .total_values = if (p.algorithm != null) 32 else try bank.validate(p.inputs + p.literals.len, p.ops, p.result), .algorithm = p.algorithm, .width = p.width, .precision = p.precision };
+        }
+        const emitter = bank.find("emit", 62) orelse return error.GraphEmitMissing;
+        if (emitter.inputs != 1 or emitter.outputs != 1) return error.GraphSlotArity;
+        for (templates) |t| if (t.width == 128) {
+            const wide = bank.find("emit", 128) orelse return error.GraphEmitMissing;
+            if (wide.inputs != 1 or wide.outputs != 1) return error.GraphSlotArity;
+            break;
+        };
+        for (templates) |t| if (t.width == 256) {
+            try bank.require("emit", 256, 1, 1);
+            try bank.require("format", 256, 2, 2);
+            break;
+        };
+        bank.arena = arena;
+        if (mode == .eager) try bank.prepareAll();
+        return bank;
+    }
+
+    /// Destroy every backend and machine before freeing the bank; prepared copies borrow its circuit allocations.
+    pub fn deinit(b: *Bank) void {
+        for (b.templates) |*t| {
+            if (t.isPrepared()) t.circuit.deinit(b.gpa);
+        }
+        b.arena.deinit();
+        b.* = undefined;
+    }
+
+    pub fn prepareAll(b: *const Bank) !void {
+        for (b.templates) |*t| try t.prepare();
+    }
+
+    pub fn preparedCount(b: *const Bank) usize {
+        var count: usize = 0;
+        for (b.templates) |*t| count += @intFromBool(t.isPrepared());
+        return count;
+    }
+
+    pub fn loadAttempts(b: *const Bank) u64 {
+        var count: u64 = 0;
+        for (b.templates) |*t| count += t.loadAttempts();
+        return count;
+    }
+
+    /// Clears only a cached failure; the next use retries the pinned pack and successful circuits are never replaced.
+    pub fn retryFailed(b: *const Bank, name: []const u8, width: u16) !void {
+        const t = b.find(name, width) orelse return error.GraphTemplate;
+        const p = t.preparation orelse return error.GraphAlreadyPrepared;
+        var threaded: std.Io.Threaded = .init_single_threaded;
+        const io = threaded.io();
+        p.mutex.lockUncancelable(io);
+        defer p.mutex.unlock(io);
+        if (p.ready.load(.acquire)) return error.GraphAlreadyPrepared;
+        if (p.failure == null) return error.GraphNotFailed;
+        p.failure = null;
+    }
+
+    /// Lookup reads metadata only; call Template.prepare before accessing its circuit or logical slots.
+    pub fn find(b: *const Bank, name: []const u8, width: u16) ?*const Template {
+        for (b.templates) |*t| if (t.width == width and std.mem.eql(u8, t.name, name)) return t;
+        return null;
+    }
+
+    pub fn plan(b: *const Bank, name: []const u8) ?*const PreparedPlan {
+        for (b.plans) |*p| if (std.mem.eql(u8, p.name, name)) return p;
+        return null;
+    }
+
+    pub fn validate(b: *const Bank, inputs: usize, ops: []const packet.Op, result: u32) !usize {
+        if (inputs > packet.max_values or ops.len > packet.max_ops) return error.GraphPlanSize;
+        var count = inputs;
+        for (ops) |op| {
+            if (op.outputs == 0 or op.outputs > packet.max_arity or count + op.outputs > packet.max_values)
+                return error.GraphPlanSize;
+            if (std.mem.eql(u8, op.op, "bind")) {
+                if (op.outputs != 1 or op.copies.len > 128 or op.args != null or op.b != null or op.precision != 0)
+                    return error.GraphBinding;
+                for (op.copies) |c| if (c.ref >= count or c.from > packet.max_digits or c.to > packet.max_digits or
+                    c.digits > packet.max_digits - c.from or c.digits > packet.max_digits - c.to)
+                    return error.GraphBinding;
+                if (op.flags) |r| if (r >= count) return error.GraphReference;
+            } else {
+                if (std.mem.eql(u8, op.op, "factorize") or std.mem.eql(u8, op.op, "f64_repr")) return error.GraphAlgorithm;
+                if (std.mem.startsWith(u8, op.op, "emit") or (std.mem.eql(u8, op.op, "format") or std.mem.eql(u8, op.op, "format_f64")) or op.copies.len != 0 or op.flags != null)
+                    return error.GraphTemplate;
+                const arity: u8 = if (std.meta.stringToEnum(packet.Algorithm, op.op)) |family| blk: {
+                    try b.validateAlgorithm(family, op.width, op.precision);
+                    if (op.outputs != packet.algorithmOutputs(family)) return error.GraphSlotArity;
+                    break :blk packet.algorithmArity(family);
+                } else blk: {
+                    if (op.precision != 0) return error.GraphPrecision;
+                    const t = b.find(op.op, op.width) orelse return error.GraphTemplate;
+                    if (t.outputs != op.outputs) return error.GraphSlotArity;
+                    break :blk t.inputs;
+                };
+                if (op.args) |args| {
+                    if (args.len != arity) return error.GraphSlotArity;
+                    for (args) |r| if (r >= count) return error.GraphReference;
+                } else {
+                    if (arity != 1 + @as(usize, @intFromBool(op.b != null)) or op.a >= count)
+                        return error.GraphSlotArity;
+                    if (op.b) |r| if (r >= count) return error.GraphReference;
+                }
+            }
+            count += op.outputs;
+        }
+        if (result >= count) return error.GraphReference;
+        return count;
+    }
+
+    pub fn validatePrints(b: *const Bank, prints: []const packet.Print, count: usize) !void {
+        if (prints.len > packet.max_prints) return error.GraphPrint;
+        if (prints.len == 0) return;
+        try b.require("format", 62, 2, 2);
+        try b.require("format", 128, 2, 2);
+        for (prints) |p| {
+            if (p.ref >= count or p.precision > 18 or (p.style != .fixed and p.precision != 0)) return error.GraphPrint;
+            if (p.style == .byte) {
+                if (p.precision != 0 or p.prefix or p.ending != .empty or p.second != null) return error.GraphPrint;
+                try b.require("byte_check", 128, 1, 1);
+                try b.require("emit_byte", 4, 1, 1);
+                continue;
+            }
+            if (p.style == .prepared) {
+                try b.require("format_f64", 62, 2, 2);
+                if (p.prefix or p.precision != 0 or p.ending != .newline or p.second == null) return error.GraphPrint;
+            }
+            if ((p.style == .fraction or p.style == .tuple or p.style == .prepared) != (p.second != null)) return error.GraphPrint;
+            if (p.second) |ref| if (ref >= count) return error.GraphReference;
+            if (p.style == .fraction) try b.require("meta", 128, 2, 3);
+            if (p.style == .tuple and (p.prefix or (p.ending != .newline and p.ending != .space and p.ending != .empty and p.ending != .comma_space)))
+                return error.GraphPrint;
+        }
+    }
+
+    fn require(b: *const Bank, name: []const u8, width: u16, inputs: u8, outputs: u8) !void {
+        const t = b.find(name, width) orelse return error.GraphTemplate;
+        if (t.inputs != inputs or t.outputs != outputs) return error.GraphSlotArity;
+    }
+
+    fn validateAlgorithm256(b: *const Bank, family: packet.Algorithm) !void {
+        if (family != .divmod and family != .powmod) return error.GraphAlgorithm;
+        try b.require("meta", 256, 2, 3);
+        try b.require("divstep", 256, 3, 2);
+        try b.require("divfinal", 256, 4, 2);
+        if (family == .divmod) {
+            try b.require("emit_first", 256, 1, 1);
+            try b.require("emit_last", 256, 1, 1);
+        } else {
+            try b.require("half", 256, 1, 2);
+            try b.require("mulmodstep", 256, 4, 1);
+            try b.require("sub", 256, 2, 1);
+            try b.require("emit", 256, 1, 1);
+        }
+    }
+
+    fn validateAlgorithm(b: *const Bank, family: packet.Algorithm, width: u16, precision: u8) !void {
+        if (!packet.algorithmWidthValid(family, width) or precision > 18 or (family != .fixed_div and precision != 0))
+            return error.GraphAlgorithm;
+        if (width == 256) return b.validateAlgorithm256(family);
+        if (std.mem.startsWith(u8, @tagName(family), "f64_")) {
+            if (width != 128) return error.GraphAlgorithm;
+            try b.require("raw_meta", 128, 2, 3);
+            try b.require("format_f64", 62, 2, 2);
+            try b.require("decimal_mul", 128, 2, 1);
+            try b.require("compare", 128, 2, 1);
+            try b.require("round_div", 128, 4, 1);
+            try b.require("add", 128, 2, 1);
+            try b.require("sub", 128, 2, 1);
+            try b.require("half", 128, 1, 2);
+            try b.require("divstep", 128, 3, 2);
+            try b.require("format", 62, 2, 2);
+            return;
+        }
+        const factor = family == .smallest_factor or family == .factorize;
+        const work_width = if (factor) @max(width, 8) else width;
+        if (factor) {
+            try b.require("add", work_width, 2, 1);
+            try b.require("half", work_width, 1, 2);
+            try b.require("divstep", work_width, 3, 2);
+            try b.require("meta", work_width, 2, 3);
+            try b.require("format", 62, 2, 2);
+            try b.require("format", 128, 2, 2);
+            return;
+        }
+        const kernels = [_]struct { []const u8, u8, u8 }{
+            .{ "add", 2, 1 },        .{ "sub", 2, 1 },      .{ "mul", 2, 1 },  .{ "half", 1, 2 },
+            .{ "divstep", 3, 2 },    .{ "divfinal", 4, 2 }, .{ "meta", 2, 3 }, .{ "digit_sum", 1, 1 },
+            .{ "mulmodstep", 4, 1 },
+        };
+        for (kernels) |k| try b.require(k[0], if (std.mem.eql(u8, k[0], "meta")) @max(work_width, 8) else work_width, k[1], k[2]);
+        if (family == .fixed_div) {
+            try b.require("scale10", width, 1, 1);
+        }
+        if (family == .fixed_div or family == .divexact) try b.require("round_div", width, 4, 1);
+        if (family == .fraction or family == .fixed_div or factor) {
+            try b.require("format", 62, 2, 2);
+            try b.require("format", 128, 2, 2);
+        }
+        if (family == .fraction) try b.require("meta", 128, 2, 3);
+        if (family == .divmod) for ([_][]const u8{ "emit_first", "emit_last" }) |name|
+            try b.require(name, @max(width, 62), 1, 1);
+    }
+};
diff --git a/zig/src/core/runner_graph_binary.zig b/zig/src/core/runner_graph_binary.zig
new file mode 100644
index 000000000..de22a8f3e
--- /dev/null
+++ b/zig/src/core/runner_graph_binary.zig
@@ -0,0 +1,361 @@
+//! Offline prepared circuit encoding; lazy loading restores exact runtime fields without compiling graph IR.
+const std = @import("std");
+const builtin = @import("builtin");
+const model = @import("steps_v1/runner_circuit_model.zig");
+const binding = @import("runner_graph_lazy.zig");
+const Allocator = std.mem.Allocator;
+const Hash = std.crypto.hash.sha2.Sha256;
+const header = 160;
+pub const Header = [header]u8;
+const max_bytes = 1 << 30;
+const Prepared = struct { name: []const u8, width: u8, circuit: model.Circuit };
+
+fn schema(comptime T: type, h: *Hash) void {
+    switch (@typeInfo(T)) {
+        .@"struct" => |s| {
+            h.update("struct{");
+            inline for (s.field_names, s.field_types) |name, Field| {
+                if (comptime T == model.Circuit and std.mem.eql(u8, name, "arena")) continue;
+                h.update(name);
+                schema(Field, h);
+            }
+            h.update("}");
+        },
+        .@"union" => |u| {
+            h.update("union{");
+            schema(u.tag_type.?, h);
+            inline for (u.field_names, u.field_types) |name, Field| {
+                h.update(name);
+                schema(Field, h);
+            }
+            h.update("}");
+        },
+        .pointer => |p| {
+            h.update(if (p.size == .slice) "slice" else "pointer");
+            schema(p.child, h);
+        },
+        .optional => |o| {
+            h.update("optional");
+            schema(o.child, h);
+        },
+        .array => |a| {
+            h.update(std.fmt.comptimePrint("array{d}", .{a.len}));
+            schema(a.child, h);
+        },
+        .@"enum" => |e| {
+            h.update("enum");
+            inline for (e.field_names, e.field_values) |name, value|
+                h.update(std.fmt.comptimePrint("{s}={d};", .{ name, value }));
+        },
+        else => h.update(@typeName(T)),
+    }
+}
+
+pub fn schemaHash() [32]u8 {
+    return versionedSchemaHash(false);
+}
+
+fn versionedSchemaHash(legacy: bool) [32]u8 {
+    var h = Hash.init(.{});
+    h.update(if (legacy) "runner-graph-prepared-v1-rle:" else "runner-graph-prepared-v2-rle-bindings:");
+    h.update(builtin.zig_version_string);
+    h.update(@embedFile("steps_v1/runner_circuit_model.zig"));
+    h.update(@embedFile("steps_v1/runner_circuit_state.zig"));
+    h.update(@embedFile("steps_v1/runner_circuit_eval.zig"));
+    if (!legacy) h.update(@embedFile("runner_graph_lazy.zig"));
+    schema(Prepared, &h);
+    return h.finalResult();
+}
+
+fn leaf(comptime T: type) bool {
+    return switch (@typeInfo(T)) {
+        .int, .float => true,
+        else => false,
+    };
+}
+
+fn equalBits(comptime T: type, a: T, b: T) bool {
+    return std.mem.eql(u8, std.mem.asBytes(&a), std.mem.asBytes(&b));
+}
+
+const Encoder = struct {
+    a: Allocator,
+    bytes: std.ArrayList(u8) = .empty,
+
+    fn putLeaf(e: *Encoder, comptime T: type, values: []const T) anyerror!void {
+        var runs: usize = 0;
+        for (values, 0..) |v, i| {
+            if (i == 0 or !equalBits(T, v, values[i - 1])) runs += 1;
+        }
+        const compressed = runs * (4 + @sizeOf(T)) < values.len * @sizeOf(T);
+        try e.put(u8, @intFromBool(compressed));
+        if (!compressed) {
+            if (comptime builtin.cpu.arch.endian() == .little) {
+                try e.bytes.appendSlice(e.a, std.mem.sliceAsBytes(values));
+            } else for (values) |v| try e.put(T, v);
+            return;
+        }
+        var i: usize = 0;
+        while (i < values.len) {
+            var end = i + 1;
+            while (end < values.len and end - i < std.math.maxInt(u32) and equalBits(T, values[i], values[end]))
+                end += 1;
+            try e.put(u32, @intCast(end - i));
+            try e.put(T, values[i]);
+            i = end;
+        }
+    }
+
+    fn put(e: *Encoder, comptime T: type, value: T) anyerror!void {
+        switch (@typeInfo(T)) {
+            .bool => try e.bytes.append(e.a, @intFromBool(value)),
+            .int => {
+                var b: [@sizeOf(T)]u8 = undefined;
+                std.mem.writeInt(T, &b, value, .little);
+                try e.bytes.appendSlice(e.a, &b);
+            },
+            .float => {
+                const U = @Int(.unsigned, @bitSizeOf(T));
+                try e.put(U, @bitCast(value));
+            },
+            .@"enum" => try e.put(u32, @intCast(@backingInt(value))),
+            .optional => |o| {
+                try e.put(bool, value != null);
+                if (value) |v| try e.put(o.child, v);
+            },
+            .pointer => |p| {
+                if (p.size == .slice) {
+                    try e.put(u64, @intCast(value.len));
+                    if (comptime leaf(p.child)) {
+                        try e.putLeaf(p.child, value);
+                    } else for (value) |v| try e.put(p.child, v);
+                } else if (p.size == .one) try e.put(p.child, value.*) else @compileError("unsupported pointer");
+            },
+            .array => |ar| for (value) |v| try e.put(ar.child, v),
+            .@"struct" => |s| inline for (s.field_names, s.field_types) |name, Field| {
+                if (comptime T == model.Circuit and std.mem.eql(u8, name, "arena")) continue;
+                try e.put(Field, @field(value, name));
+            },
+            .@"union" => |u| {
+                const tag = std.meta.activeTag(value);
+                try e.put(u.tag_type.?, tag);
+                inline for (u.field_names, u.field_types) |name, Field| if (std.mem.eql(u8, name, @tagName(tag))) {
+                    try e.put(Field, @field(value, name));
+                };
+            },
+            else => @compileError("unsupported prepared field: " ++ @typeName(T)),
+        }
+    }
+};
+
+const Decoder = struct {
+    a: Allocator,
+    bytes: []const u8,
+    at: usize = 0,
+    allocated: usize = 0,
+
+    fn take(d: *Decoder, n: usize) ![]const u8 {
+        if (n > d.bytes.len - d.at) return error.GraphPackTruncated;
+        defer d.at += n;
+        return d.bytes[d.at..][0..n];
+    }
+
+    fn getLeaf(d: *Decoder, comptime T: type, out: []T) anyerror!void {
+        const mode = try d.get(u8);
+        if (mode == 0) {
+            if (comptime builtin.cpu.arch.endian() == .little) {
+                @memcpy(std.mem.sliceAsBytes(out), try d.take(out.len * @sizeOf(T)));
+            } else for (out) |*v| v.* = try d.get(T);
+        } else if (mode == 1) {
+            var i: usize = 0;
+            while (i < out.len) {
+                const n = try d.get(u32);
+                if (n == 0 or n > out.len - i) return error.GraphPackRun;
+                @memset(out[i..][0..n], try d.get(T));
+                i += n;
+            }
+        } else return error.GraphPackEncoding;
+    }
+
+    fn get(d: *Decoder, comptime T: type) anyerror!T {
+        return switch (@typeInfo(T)) {
+            .bool => switch ((try d.take(1))[0]) {
+                0 => false,
+                1 => true,
+                else => error.GraphPackBoolean,
+            },
+            .int => std.mem.readInt(T, (try d.take(@sizeOf(T)))[0..@sizeOf(T)], .little),
+            .float => @bitCast(try d.get(@Int(.unsigned, @bitSizeOf(T)))),
+            .@"enum" => std.enums.fromInt(T, try d.get(u32)) orelse return error.GraphPackTag,
+            .optional => |o| if (try d.get(bool)) try d.get(o.child) else null,
+            .pointer => |p| blk: {
+                const n: usize = if (p.size == .slice) std.math.cast(usize, try d.get(u64)) orelse
+                    return error.GraphPackSize else 1;
+                if (n > max_bytes / @max(1, @sizeOf(p.child))) return error.GraphPackSize;
+                const size = n * @sizeOf(p.child);
+                if (size > max_bytes - d.allocated) return error.GraphPackSize;
+                d.allocated += size;
+                if (p.size == .slice) {
+                    const out = try d.a.alloc(p.child, n);
+                    if (comptime leaf(p.child)) {
+                        try d.getLeaf(p.child, out);
+                    } else for (out) |*v| v.* = try d.get(p.child);
+                    break :blk out;
+                } else if (p.size == .one) {
+                    const out = try d.a.create(p.child);
+                    out.* = try d.get(p.child);
+                    break :blk out;
+                } else @compileError("unsupported pointer");
+            },
+            .array => |ar| blk: {
+                var out: T = undefined;
+                for (&out) |*v| v.* = try d.get(ar.child);
+                break :blk out;
+            },
+            .@"struct" => |s| blk: {
+                var out: T = undefined;
+                inline for (s.field_names, s.field_types) |name, Field| {
+                    if (comptime T == model.Circuit and std.mem.eql(u8, name, "arena")) continue;
+                    @field(out, name) = try d.get(Field);
+                }
+                break :blk out;
+            },
+            .@"union" => |u| blk: {
+                const tag = try d.get(u.tag_type.?);
+                inline for (u.field_names, u.field_types) |name, Field| if (std.mem.eql(u8, name, @tagName(tag))) {
+                    break :blk @unionInit(T, name, try d.get(Field));
+                };
+                return error.GraphPackTag;
+            },
+            else => @compileError("unsupported prepared field: " ++ @typeName(T)),
+        };
+    }
+};
+
+pub fn encode(a: Allocator, c: model.Circuit, name: []const u8, width: u16) ![]u8 {
+    if (name.len == 0) return error.GraphPackIdentity;
+    const code = try encodedWidth(width);
+    const layout = try binding.Binding.inspect(&c, try bindingWidth(width));
+    var e: Encoder = .{ .a = a };
+    errdefer e.bytes.deinit(a);
+    try e.bytes.appendNTimes(a, 0, header);
+    try e.put(Prepared, .{ .name = name, .width = code, .circuit = c });
+    @memcpy(e.bytes.items[0..8], "TFGRPH02");
+    std.mem.writeInt(u64, e.bytes.items[8..16], e.bytes.items.len - header, .little);
+    @memcpy(e.bytes.items[16..48], &schemaHash());
+    Hash.hash(e.bytes.items[header..], e.bytes.items[48..80], .{});
+    e.bytes.items[80] = layout.inputs;
+    e.bytes.items[81] = layout.outputs;
+    e.bytes.items[82] = code;
+    Hash.hash(name, e.bytes.items[96..128], .{});
+    Hash.hash(e.bytes.items[0..128], e.bytes.items[128..160], .{});
+    return e.bytes.toOwnedSlice(a);
+}
+
+pub fn decode(a: Allocator, bytes: []const u8, name: []const u8, width: u16) !model.Circuit {
+    if (bytes.len < 80) return error.GraphPackTruncated;
+    var h: Header = @splat(0);
+    @memcpy(h[0..80], bytes[0..80]);
+    const legacy = isLegacy(&h);
+    const offset: usize = if (legacy) 80 else header;
+    if (bytes.len < offset) return error.GraphPackTruncated;
+    @memcpy(h[0..offset], bytes[0..offset]);
+    try validateHeader(&h, bytes.len, name, width, schemaHash());
+    var digest: [32]u8 = undefined;
+    Hash.hash(bytes[offset..], &digest, .{});
+    if (!std.mem.eql(u8, bytes[48..80], &digest)) return error.GraphPackChecksum;
+    var arena = std.heap.ArenaAllocator.init(a);
+    errdefer arena.deinit();
+    var d: Decoder = .{ .a = arena.allocator(), .bytes = bytes[offset..] };
+    const prepared = try d.get(Prepared);
+    if (prepared.width != (try encodedWidth(width)) or !std.mem.eql(u8, prepared.name, name)) return error.GraphPackIdentity;
+    var out = prepared.circuit;
+    if (d.at != d.bytes.len) return error.GraphPackTrailing;
+    const layout = try binding.Binding.inspect(&out, try bindingWidth(width));
+    if (!legacy and (layout.inputs != h[80] or layout.outputs != h[81])) return error.GraphSlotArity;
+    out.arena = arena;
+    return out;
+}
+
+fn validateHeader(h: *const Header, size: u64, name: []const u8, width: u16, expected_schema: [32]u8) !void {
+    const code = try encodedWidth(width);
+    const legacy = isLegacy(h);
+    if (!legacy and !std.mem.eql(u8, h[0..8], "TFGRPH02")) return error.GraphPackMagic;
+    const offset: u64 = if (legacy) 80 else header;
+    if (size < offset or size > max_bytes or std.mem.readInt(u64, h[8..16], .little) != size - offset)
+        return error.GraphPackSize;
+    const expected = if (legacy) versionedSchemaHash(true) else expected_schema;
+    if (!std.mem.eql(u8, h[16..48], &expected)) return error.GraphPackSchema;
+    if (legacy) return;
+    var digest: [32]u8 = undefined;
+    Hash.hash(h[0..128], &digest, .{});
+    if (!std.mem.eql(u8, h[128..160], &digest)) return error.GraphPackChecksum;
+    Hash.hash(name, &digest, .{});
+    if (name.len == 0 or code != h[82] or !std.mem.eql(u8, h[96..128], &digest))
+        return error.GraphPackIdentity;
+    if (h[80] == 0 or h[80] > 16 or h[81] == 0 or h[81] > 16) return error.GraphSlotArity;
+    for (h[83..96]) |v| if (v != 0) return error.GraphPackEncoding;
+}
+
+pub fn isLegacy(h: *const Header) bool {
+    return std.mem.eql(u8, h[0..8], "TFGRPH01");
+}
+
+/// Reads only the checksummed descriptor header; payload verification is mandatory before first execution.
+pub fn inspect(path: []const u8, name: []const u8, width: u16, expected_schema: [32]u8) !Header {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const io = threaded.io();
+    const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    const size = (try file.stat(io)).size;
+    var h: Header = @splat(0);
+    if (try file.readPositionalAll(io, h[0..80], 0) != 80) return error.GraphPackTruncated;
+    if (!isLegacy(&h) and (try file.readPositionalAll(io, h[80..], 80)) != header - 80)
+        return error.GraphPackTruncated;
+    try validateHeader(&h, size, name, width, expected_schema);
+    return h;
+}
+
+/// Pins deferred loading to the exact header accepted at bank boot, including its payload digest.
+pub fn loadPinned(a: Allocator, path: []const u8, name: []const u8, width: u16, expected: *const Header) !model.Circuit {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, a, .limited(max_bytes));
+    defer a.free(bytes);
+    const offset: usize = if (isLegacy(expected)) 80 else header;
+    if (bytes.len < offset or !std.mem.eql(u8, bytes[0..offset], expected[0..offset]))
+        return error.GraphPackChanged;
+    return decode(a, bytes, name, width);
+}
+
+pub fn load(a: Allocator, path: []const u8, name: []const u8, width: u16) !model.Circuit {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, a, .limited(max_bytes));
+    defer a.free(bytes);
+    return decode(a, bytes, name, width);
+}
+
+// The deployed schema keeps Prepared.width as u8; zero was never a valid old width.
+fn encodedWidth(width: u16) !u8 {
+    if (!@import("runner_graph_packet.zig").widthValid(width) or width == 255) return error.GraphPackIdentity;
+    return if (width == 256) 0 else @intCast(width);
+}
+
+/// Slot inspection needs only the same nine group heads; numeric bounds always retain width 256.
+pub fn bindingWidth(width: u16) !u8 {
+    _ = try encodedWidth(width);
+    return if (width == 256) 255 else @intCast(width);
+}
+
+test "prepared width extension retains byte codes and reserves zero for 256" {
+    const t = std.testing;
+    for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128 }) |width| {
+        try t.expectEqual(@as(u8, @intCast(width)), try encodedWidth(width));
+        try t.expectEqual(@as(u8, @intCast(width)), try bindingWidth(width));
+    }
+    try t.expectEqual(@as(u8, 0), try encodedWidth(256));
+    try t.expectEqual(@as(u8, 255), try bindingWidth(256));
+    for ([_]u16{ 0, 129, 191, 255, 257 }) |width| {
+        try t.expectError(error.GraphPackIdentity, encodedWidth(width));
+        try t.expectError(error.GraphPackIdentity, bindingWidth(width));
+    }
+}
diff --git a/zig/src/core/runner_graph_bind.zig b/zig/src/core/runner_graph_bind.zig
new file mode 100644
index 000000000..54a05196d
--- /dev/null
+++ b/zig/src/core/runner_graph_bind.zig
@@ -0,0 +1,377 @@
+//! Exact integer source binding onto prepared graph kernels, independent of the Python/RV32 frontend.
+const std = @import("std");
+const packet = @import("runner_graph_packet.zig");
+const Bank = @import("runner_graph_bank.zig").Bank;
+const Allocator = std.mem.Allocator;
+const Failure = error{ OutOfMemory, Unsupported };
+
+pub const Syntax = enum { math, python };
+const Kind = enum { literal, add, sub, mul, div, mod, pow, powmod, divmod, gcd, isqrt, neg };
+const Node = struct { kind: Kind, a: u32 = 0, b: u32 = 0, c: u32 = 0, text: []const u8 = "" };
+const Bound = struct { ref: u32, digits: usize, second: ?u32 = null };
+
+/// Only empty-context Python inline/REPL cells qualify; callers retain their ordinary refusal path.
+pub fn cell(a: Allocator, bank: *const Bank, request: anytype) Allocator.Error!?[]u8 {
+    if (request.prior.len != 0 or !std.mem.eql(u8, request.lang, "python")) return null;
+    if (request.form == .fence) return script(a, bank, request.code);
+    const syntax: Syntax = if (request.form == .inline_expr) .math else if (request.form == .repl) .python else return null;
+    var source = std.mem.trim(u8, request.code, " \t");
+    if (request.form == .repl and std.mem.startsWith(u8, source, ">>>")) source = std.mem.trim(u8, source[3..], " \t");
+    if (try expression(a, bank, source, syntax)) |bound| return bound;
+    if (syntax == .math) return @import("runner_graph_exact.zig").expression(a, bank, source);
+    return if (request.form == .repl) script(a, bank, source) else null;
+}
+
+/// Parses literals and selects schedules; no expression answer, circuit weights or executable IR is built here.
+pub fn expression(a: Allocator, bank: *const Bank, source: []const u8, syntax: Syntax) Allocator.Error!?[]u8 {
+    if (source.len == 0 or source.len > 4096 or std.mem.indexOfAny(u8, source, "\x00\r\n") != null) return null;
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    var p: Parser = .{ .a = arena, .source = source, .syntax = syntax };
+    const root = p.sum() catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+    p.space();
+    if (p.at != source.len) return null;
+    var lower: Lower = .{ .a = arena, .bank = bank, .nodes = p.nodes.items };
+    const result = lower.build(root) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+    _ = bank.validate(lower.values.items.len, lower.ops.items, result.ref) catch return null;
+    return packet.Builder.program(a, lower.values.items, lower.ops.items, &.{.{ .ref = result.ref, .style = if (result.second != null) .tuple else .integer, .second = result.second }}) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+}
+
+/// Straight-line integer cells retain original operands, assignments, declared math intrinsics and print order.
+pub fn script(a: Allocator, bank: *const Bank, source: []const u8) Allocator.Error!?[]u8 {
+    if (source.len == 0 or source.len > 4096 or std.mem.indexOfAny(u8, source, "\x00\r") != null) return null;
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    var p: Parser = .{ .a = arena, .source = "", .syntax = .python };
+    var roots: std.ArrayList(struct { node: u32, ending: packet.Ending }) = .empty;
+    var schedule: std.ArrayList(u32) = .empty;
+    const statements = splitStatements(arena, source) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+    for (statements) |raw| {
+        const text = std.mem.trim(u8, raw, " \t");
+        if (text.len == 0) continue;
+        if (std.mem.eql(u8, text, "import math")) {
+            if (p.names.contains("math")) return null;
+            p.math_module = true;
+            continue;
+        }
+        if (std.mem.startsWith(u8, text, "from math import ")) {
+            var names = std.mem.splitScalar(u8, text[17..], ',');
+            while (names.next()) |name| {
+                const n = std.mem.trim(u8, name, " \t");
+                if (p.names.contains(n)) return null;
+                if (std.mem.eql(u8, n, "gcd")) p.gcd_import = true else if (std.mem.eql(u8, n, "isqrt")) p.isqrt_import = true else return null;
+            }
+            continue;
+        }
+        p.at = 0;
+        if (std.mem.startsWith(u8, text, "print(") and text[text.len - 1] == ')') {
+            p.source = text[6 .. text.len - 1];
+            while (true) {
+                const root = p.sum() catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+                try schedule.append(arena, root);
+                const more = p.take(",");
+                if (roots.items.len >= 128) return null;
+                try roots.append(arena, .{ .node = root, .ending = if (more) .space else .newline });
+                if (!more) break;
+            }
+        } else {
+            const equal = std.mem.indexOfScalar(u8, text, '=') orelse return null;
+            const name = std.mem.trim(u8, text[0..equal], " \t");
+            if (!identifier(name) or reserved(name)) return null;
+            p.source = text[equal + 1 ..];
+            const root = p.sum() catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+            try schedule.append(arena, root);
+            try p.names.put(arena, name, root);
+        }
+        p.space();
+        if (p.at != p.source.len) return null;
+    }
+    if (roots.items.len == 0) return null;
+    var lower: Lower = .{ .a = arena, .bank = bank, .nodes = p.nodes.items };
+    lower.initialize() catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+    for (schedule.items) |root| _ = lower.emit(root) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+    var prints: std.ArrayList(packet.Print) = .empty;
+    for (roots.items) |root| {
+        const value = lower.emit(root.node) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+        try prints.append(arena, .{ .ref = value.ref, .ending = root.ending, .style = if (value.second != null) .tuple else .integer, .second = value.second });
+    }
+    _ = bank.validate(lower.values.items.len, lower.ops.items, prints.items[0].ref) catch return null;
+    return packet.Builder.program(a, lower.values.items, lower.ops.items, prints.items) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+}
+
+fn identifier(text: []const u8) bool {
+    if (text.len == 0 or !(std.ascii.isAlphabetic(text[0]) or text[0] == '_')) return false;
+    for (text) |ch| if (!(std.ascii.isAlphanumeric(ch) or ch == '_')) return false;
+    return true;
+}
+
+fn splitStatements(a: Allocator, source: []const u8) Failure![]const []const u8 {
+    var statements: std.ArrayList([]const u8) = .empty;
+    var lines = std.mem.splitScalar(u8, source, '\n');
+    while (lines.next()) |line| {
+        if (std.mem.trim(u8, line, " \t").len == 0) continue;
+        if (line[0] == ' ' or line[0] == '\t') return error.Unsupported;
+        var pieces = std.mem.splitScalar(u8, line, ';');
+        var seen = false;
+        var trailing = false;
+        while (pieces.next()) |piece| {
+            const text = std.mem.trim(u8, piece, " \t");
+            if (text.len == 0) {
+                if (!seen or trailing) return error.Unsupported;
+                trailing = true;
+                continue;
+            }
+            if (trailing) return error.Unsupported;
+            try statements.append(a, text);
+            seen = true;
+        }
+    }
+    return statements.items;
+}
+
+fn reserved(text: []const u8) bool {
+    for ([_][]const u8{ "__debug__", "math", "pow", "divmod", "print", "gcd", "isqrt", "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield" }) |name|
+        if (std.mem.eql(u8, text, name)) return true;
+    return false;
+}
+
+const Parser = struct {
+    a: Allocator,
+    source: []const u8,
+    syntax: Syntax,
+    at: usize = 0,
+    depth: usize = 0,
+    nodes: std.ArrayList(Node) = .empty,
+    names: std.StringHashMapUnmanaged(u32) = .empty,
+    math_module: bool = false,
+    gcd_import: bool = false,
+    isqrt_import: bool = false,
+
+    fn space(p: *Parser) void {
+        while (p.at < p.source.len and (p.source[p.at] == ' ' or p.source[p.at] == '\t')) p.at += 1;
+    }
+
+    fn take(p: *Parser, text: []const u8) bool {
+        p.space();
+        if (!std.mem.startsWith(u8, p.source[p.at..], text)) return false;
+        p.at += text.len;
+        return true;
+    }
+
+    fn push(p: *Parser, node: Node) Failure!u32 {
+        if (p.nodes.items.len >= 256) return error.Unsupported;
+        try p.nodes.append(p.a, node);
+        return @intCast(p.nodes.items.len - 1);
+    }
+
+    fn sum(p: *Parser) Failure!u32 {
+        var lhs = try p.product();
+        while (true) {
+            const op: Kind = if (p.take("+")) .add else if (p.take("-")) .sub else break;
+            lhs = try p.push(.{ .kind = op, .a = lhs, .b = try p.product() });
+        }
+        return lhs;
+    }
+
+    fn product(p: *Parser) Failure!u32 {
+        var lhs = try p.unary();
+        while (true) {
+            p.space();
+            const word_mod = p.syntax == .math and p.at > 0 and
+                std.ascii.isWhitespace(p.source[p.at - 1]) and
+                std.mem.startsWith(u8, p.source[p.at..], "mod") and
+                p.at + 3 < p.source.len and std.ascii.isWhitespace(p.source[p.at + 3]);
+            const op: Kind = if (p.take("//")) .div else if (p.take("%")) blk: {
+                p.space();
+                if (p.syntax == .math and p.at < p.source.len and
+                    (p.source[p.at] == '+' or p.source[p.at] == '-')) return error.Unsupported;
+                break :blk .mod;
+            } else if (word_mod) blk: {
+                p.at += 3;
+                break :blk .mod;
+            } else if (p.take("*")) .mul else break;
+            lhs = try p.push(.{ .kind = op, .a = lhs, .b = try p.unary() });
+        }
+        return lhs;
+    }
+
+    fn unary(p: *Parser) Failure!u32 {
+        if (p.depth >= 32) return error.Unsupported;
+        p.depth += 1;
+        defer p.depth -= 1;
+        if (p.take("+")) return p.unary();
+        if (p.take("-")) return p.push(.{ .kind = .neg, .a = try p.unary() });
+        const lhs = try p.atom();
+        if (p.take("**") or (p.syntax == .math and p.take("^")))
+            return p.push(.{ .kind = .pow, .a = lhs, .b = try p.unary() });
+        return lhs;
+    }
+
+    fn atom(p: *Parser) Failure!u32 {
+        if (p.take("(")) {
+            const result = try p.sum();
+            if (!p.take(")")) return error.Unsupported;
+            return result;
+        }
+        if (p.take("divmod(")) {
+            const a = try p.sum();
+            if (!p.take(",")) return error.Unsupported;
+            const b = try p.sum();
+            if (!p.take(")")) return error.Unsupported;
+            return p.push(.{ .kind = .divmod, .a = a, .b = b });
+        }
+        if (p.take("pow(")) {
+            const a = try p.sum();
+            if (!p.take(",")) return error.Unsupported;
+            const b = try p.sum();
+            if (!p.take(",")) return error.Unsupported;
+            const c = try p.sum();
+            if (!p.take(")")) return error.Unsupported;
+            return p.push(.{ .kind = .powmod, .a = a, .b = b, .c = c });
+        }
+        p.space();
+        if (p.at < p.source.len and (std.ascii.isAlphabetic(p.source[p.at]) or p.source[p.at] == '_')) {
+            const start = p.at;
+            while (p.at < p.source.len and (std.ascii.isAlphanumeric(p.source[p.at]) or p.source[p.at] == '_' or p.source[p.at] == '.')) p.at += 1;
+            const name = p.source[start..p.at];
+            if (p.names.get(name)) |ref| return ref;
+            const qualified = std.mem.startsWith(u8, name, "math.");
+            if (qualified and !p.math_module) return error.Unsupported;
+            const bare = if (qualified) name[5..] else name;
+            const kind: Kind = if (std.mem.eql(u8, bare, "gcd") and (qualified or p.gcd_import or p.syntax == .math)) .gcd else if (std.mem.eql(u8, bare, "isqrt") and (qualified or p.isqrt_import or p.syntax == .math)) .isqrt else return error.Unsupported;
+            if (!p.take("(")) return error.Unsupported;
+            const a = try p.sum();
+            var b: u32 = 0;
+            if (kind == .gcd) {
+                if (!p.take(",")) return error.Unsupported;
+                b = try p.sum();
+            }
+            if (!p.take(")")) return error.Unsupported;
+            return p.push(.{ .kind = kind, .a = a, .b = b });
+        }
+        p.space();
+        const start = p.at;
+        const hex = std.mem.startsWith(u8, p.source[start..], "0x") or std.mem.startsWith(u8, p.source[start..], "0X");
+        if (hex) p.at += 2;
+        const digits = p.at;
+        while (p.at < p.source.len and (if (hex) std.ascii.isHex(p.source[p.at]) else std.ascii.isDigit(p.source[p.at]))) p.at += 1;
+        if (p.at == digits or p.at - start > 512) return error.Unsupported;
+        const text = p.source[start..p.at];
+        if (!hex and text.len > 1 and text[0] == '0')
+            for (text) |ch| if (ch != '0') return error.Unsupported;
+        const value = std.fmt.parseInt(u1024, if (hex) text[2..] else text, if (hex) 16 else 10) catch return error.Unsupported;
+        const decimal = try std.fmt.allocPrint(p.a, "{d}", .{value});
+        if (decimal.len > packet.max_digits) return error.Unsupported;
+        return p.push(.{ .kind = .literal, .text = decimal });
+    }
+};
+
+const Lower = struct {
+    a: Allocator,
+    bank: *const Bank,
+    nodes: []const Node,
+    values: std.ArrayList([]const u8) = .empty,
+    ops: std.ArrayList(packet.Op) = .empty,
+    literals: [256]u32 = @splat(0),
+    emitted: [256]?Bound = @splat(null),
+    produced: usize = 0,
+
+    fn build(l: *Lower, root: u32) Failure!Bound {
+        try l.initialize();
+        return l.emit(root);
+    }
+
+    fn initialize(l: *Lower) Failure!void {
+        try l.values.appendSlice(l.a, &.{ "0", "1" });
+        for (l.nodes, 0..) |node, i| if (node.kind == .literal) {
+            if (node.text.len > 128 and l.bank.find("format", 256) == null) return error.Unsupported;
+            l.literals[i] = @intCast(l.values.items.len);
+            try l.values.append(l.a, node.text);
+        };
+    }
+
+    fn width(digits: usize) Failure!u16 {
+        for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128 }) |w| if (digits <= w) return w;
+        // Conservative bounds may saturate; checked compiled kernels still refuse actual overflow.
+        return 256;
+    }
+
+    fn operation(l: *Lower, name: []const u8, args: []const u32, digits: usize) Failure!Bound {
+        const w = try width(digits);
+        if (l.ops.items.len >= 1024) return error.Unsupported;
+        if (std.mem.eql(u8, name, "powmod") or std.mem.eql(u8, name, "gcd") or std.mem.eql(u8, name, "isqrt")) {
+            const plan = try std.fmt.allocPrint(l.a, "{s}-{d}", .{ name, w });
+            if (l.bank.plan(plan) == null) return error.Unsupported;
+        } else if (l.bank.find(name, w) == null) return error.Unsupported;
+        const refs = try l.a.dupe(u32, args);
+        const ref: u32 = @intCast(l.values.items.len + l.produced);
+        try l.ops.append(l.a, .{ .op = name, .width = w, .args = refs, .checked = true });
+        l.produced += 1;
+        return .{ .ref = ref, .digits = @min(digits, packet.max_digits) };
+    }
+
+    fn modular(l: *Lower, a: u32, b: u32, c: u32) Failure!Bound {
+        const base = try l.emit(a);
+        const exponent = try l.emit(b);
+        const modulus = try l.emit(c);
+        if (base.second != null or exponent.second != null or modulus.second != null) return error.Unsupported;
+        return l.operation("powmod", &.{ base.ref, exponent.ref, modulus.ref }, @max(base.digits, @max(exponent.digits, modulus.digits)));
+    }
+
+    fn emit(l: *Lower, index: u32) Failure!Bound {
+        if (l.emitted[index]) |value| return value;
+        const value = try l.emitFresh(index);
+        l.emitted[index] = value;
+        return value;
+    }
+
+    fn emitFresh(l: *Lower, index: u32) Failure!Bound {
+        const node = l.nodes[index];
+        if (node.kind == .literal) return .{ .ref = l.literals[index], .digits = node.text.len };
+        if (node.kind == .mod and l.nodes[node.a].kind == .pow) {
+            const power = l.nodes[node.a];
+            return l.modular(power.a, power.b, node.b);
+        }
+        if (node.kind == .powmod) return l.modular(node.a, node.b, node.c);
+        const lhs = try l.emit(node.a);
+        if (lhs.second != null) return error.Unsupported;
+        if (node.kind == .neg) return l.operation("sub", &.{ 0, lhs.ref }, lhs.digits);
+        if (node.kind == .isqrt) return l.operation("isqrt", &.{lhs.ref}, lhs.digits);
+        if (node.kind == .pow) {
+            const exponent = l.nodes[node.b];
+            if (exponent.kind != .literal) return error.Unsupported;
+            var n = std.fmt.parseInt(u16, exponent.text, 10) catch return error.Unsupported;
+            if (n > 999) return error.Unsupported;
+            var result: Bound = .{ .ref = 1, .digits = 1 };
+            var factor = lhs;
+            while (n != 0) {
+                if (n & 1 != 0) result = try l.operation("mul", &.{ result.ref, factor.ref }, result.digits + factor.digits);
+                n >>= 1;
+                if (n != 0) factor = try l.operation("mul", &.{ factor.ref, factor.ref }, 2 * factor.digits);
+            }
+            return result;
+        }
+        const rhs = try l.emit(node.b);
+        if (rhs.second != null) return error.Unsupported;
+        if (node.kind == .gcd) return l.operation("gcd", &.{ lhs.ref, rhs.ref }, @max(lhs.digits, rhs.digits));
+        if (node.kind == .div or node.kind == .mod or node.kind == .divmod) {
+            const w = try width(@max(lhs.digits, rhs.digits));
+            const plan = try std.fmt.allocPrint(l.a, "divmod-{d}", .{w});
+            if (l.bank.plan(plan) == null or l.ops.items.len >= 1024) return error.Unsupported;
+            const refs = try l.a.dupe(u32, &.{ lhs.ref, rhs.ref });
+            const ref: u32 = @intCast(l.values.items.len + l.produced);
+            try l.ops.append(l.a, .{ .op = "divmod", .args = refs, .outputs = 2, .width = w, .checked = true });
+            l.produced += 2;
+            return .{ .ref = ref + @intFromBool(node.kind == .mod), .digits = @max(lhs.digits, rhs.digits), .second = if (node.kind == .divmod) ref + 1 else null };
+        }
+        const digits = switch (node.kind) {
+            .add, .sub => @max(lhs.digits, rhs.digits) + 1,
+            .mul => lhs.digits + rhs.digits,
+            .div, .mod => @max(lhs.digits, rhs.digits),
+            else => unreachable,
+        };
+        return l.operation(@tagName(node.kind), &.{ lhs.ref, rhs.ref }, digits);
+    }
+};
