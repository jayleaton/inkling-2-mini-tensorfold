@@ -0,0 +1,69 @@
+//! Inkling 2 Mini's kept states for the disk store (native/cuda_kept.zig): mini_snap's layout, a blank, its facts.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const be = @import("mini_backend.zig");
+const mm = @import("mini_model.zig");
+const snap = @import("mini_snap.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Target = be.Mini;
+pub const State = snap.Saved;
+pub const probe_seed: u64 = 0x696b;
+
+/// snap.each's copies as parts: a whole cache's codes (and fp8 scales) are rows from position 0, a ring's its tail.
+pub fn parts(t: *const Target, at: u32, out: anytype, a: Allocator) !void {
+    const m = t.m;
+    const rb: u64 = @as(u64, m.c.local.dim) * @as(u64, if (m.kv8) 1 else 2);
+    const scale: u64 = if (m.kv8) 4 else 0;
+    for (m.w.plan.visits.slice()) |step| {
+        const full = step.of(.full) != null;
+        if (full and at > m.full.ring) return error.PastContext;
+        for (0..2 * @as(usize, m.c.local.kv)) |_| {
+            if (full) {
+                try out.append(a, .{ .bytes = @as(u64, at) * rb, .row = @intCast(rb) });
+                if (scale > 0) try out.append(a, .{ .bytes = @as(u64, at) * scale, .row = @intCast(scale) });
+            } else try out.append(a, .{ .bytes = snap.tail(m.c.window, at) * (rb + scale) });
+        }
+        for (std.enums.values(mm.Site)) |site| {
+            const width: u64 = if (site == .k or site == .v) @as(u64, m.c.local.kv) * m.c.local.dim else m.c.hidden;
+            try out.append(a, .{ .bytes = 3 * width * 4 });
+        }
+    }
+}
+
+pub fn buffers(st: *const State) [2]?cuda.DeviceBuffer {
+    return .{ st.buf, null };
+}
+
+pub fn blank(t: *Target, at: u32) !*State {
+    const m = t.m;
+    if (at == 0 or at > m.context) return error.NotAtMark;
+    const k = try t.gpa.create(State);
+    errdefer t.gpa.destroy(k);
+    k.* = .{ .at = at, .visits = @intCast(m.w.plan.visits.len), .buf = try cuda.DeviceBuffer.alloc(m.d, @max(snap.bytes(m, at), 256)) };
+    return k;
+}
+
+/// The probe prefills without the drafter: a state holds the target's caches only (a drafter rebuilds its own).
+pub fn drafts(_: *const Target) bool {
+    return false;
+}
+
+pub fn context(t: *const Target) usize {
+    return t.m.context;
+}
+
+pub fn save(t: *Target, s: *lanes.Stream, at: u32) !*State {
+    return t.saveState(s, at);
+}
+
+pub fn drop(t: *Target, st: *State) void {
+    t.dropState(st);
+}
+
+/// The KV form past what the probe shows: fp8 or bf16 rows, the ring's span, a row's width, the plan's visits.
+pub fn facts(t: *const Target) [5]u64 {
+    const m = t.m;
+    return .{ @intFromBool(m.kv8), m.c.window, m.c.local.dim, m.c.local.kv, m.w.plan.visits.len };
+}
