+/// The lane's settings when the family left them unset: TF_INKLING2_COMPUTE_LANE for Inkling 2's reply format,
+/// TF_COMPUTE_LANE for any other, with the same `_WORKERS`, `_MAX_MS` and other limits after the name.
+pub fn fromEnv(srv: *const Server) error{BadKnob}!?lane.Config {
+    if (srv.text.vtable.format == .inkling) return lane.Config.parse(&env, "TF_INKLING2_COMPUTE_LANE");
+    return lane.Config.parse(&env, "TF_COMPUTE_LANE");
+}
+
+fn env(key: []const u8) ?[]const u8 {
+    var buf: [64]u8 = undefined;
+    if (key.len >= buf.len) return null;
+    @memcpy(buf[0..key.len], key);
+    buf[key.len] = 0;
+    const v = std.mem.span(std.c.getenv(buf[0..key.len :0]) orelse return null);
+    return if (std.mem.trim(u8, v, " \t\r\n").len == 0) null else v;
+}
