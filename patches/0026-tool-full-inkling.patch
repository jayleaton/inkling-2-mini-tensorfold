diff --git a/zig/src/server/runner_boot.zig b/zig/src/server/runner_boot.zig
new file mode 100644
index 000000000..a665f9f50
--- /dev/null
+++ b/zig/src/server/runner_boot.zig
@@ -0,0 +1,32 @@
+//! The in-model runner and S3 the family left unset: TF_INKLING2_ knobs for Inkling 2's replies, TF_ for any other.
+const std = @import("std");
+const api = @import("engine_api");
+const Server = @import("server.zig").Server;
+const env = @import("compute_turns.zig").env;
+
+/// Opens what the environment asks; unset, nothing opens and replies run no cells.
+pub fn open(srv: *Server) !void {
+    if (srv.text.vtable.format == .inkling) return openWith(srv, "TF_INKLING2_");
+    return openWith(srv, "TF_");
+}
+
+fn openWith(srv: *Server, comptime prefix: []const u8) !void {
+    if (srv.info.runner == null) if (try api.runner.Config.parse(&env, prefix ++ "RUNNER")) |parsed| {
+        var rc = parsed;
+        rc.place.engine = srv.info.runner_cpus; // PREFIX_RUNNER_CPUS=auto keeps the runner's threads off these
+        const r = try api.runner.open(srv.gpa, rc);
+        if (!srv.engine.attachRunner(r)) {
+            std.log.err("{s}RUNNER: this engine cannot run a reply's code cells (no lane host)", .{prefix});
+            return error.RunnerUnsupported;
+        }
+        srv.info.runner = r;
+    };
+    // S3: lane calls the frontend takes run on the circuit, shared with the runner above when it names the same files
+    if (srv.info.compute != null and srv.info.compute_runner == null) if (try api.runner.Config.parse(&env, prefix ++ "COMPUTE_LANE_RUNNER")) |parsed| {
+        const cfg = try api.compute_circuit.Config.parse(&env, prefix ++ "COMPUTE_LANE_RUNNER");
+        var rc = parsed;
+        rc.place.engine = srv.info.runner_cpus;
+        rc.compile = cfg.elf;
+        srv.info.compute_runner = .{ .runner = try api.runner.openSharing(srv.gpa, rc, srv.info.runner), .cfg = cfg };
+    };
+}
