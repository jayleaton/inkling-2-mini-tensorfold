+/// A tool block's `{"name": ..., "args": {...}}` naming an offered tool, under its spelling; else, as vLLM returns it,
+/// a function name the request did not declare with object arguments (a request with tools); null for anything else.
 fn call(a: std.mem.Allocator, payload: []const u8, offered: []const json.Value) !?Call {
     var doc = std.json.parseFromSlice(std.json.Value, a, payload, .{}) catch return null;
     defer doc.deinit();
     if (doc.value != .object) return null;
     const n = doc.value.object.get("name") orelse return null;
     if (n != .string) return null;
-    var known = try tool_parse.knownNames(a, offered);
-    const own = try tool_parse.callName(a, n.string, &known) orelse return null;
     const args = json_cut.find(try json_cut.members(a, std.mem.trimStart(u8, payload, " \t\r\n")), "args");
-    return .{ .name = own, .arguments = try a.dupe(u8, if (args) |m| m.value else "{}") };
+    const written = if (args) |m| m.value else "{}";
+    var known = try tool_parse.knownNames(a, offered);
+    const own = try tool_parse.callName(a, n.string, &known) orelse undeclared: {
+        // the client refuses the unknown tool and the model can retry; kept as text, the call ended the client's turn
+        const bare = std.mem.trim(u8, n.string, " \t\r\n");
+        if (offered.len == 0 or !functionName(bare) or !objectText(a, written)) return null;
+        break :undeclared bare;
+    };
+    return .{ .name = own, .arguments = try a.dupe(u8, written) };
+}
+
+/// 1 to 64 of `[A-Za-z0-9_-]`: a name OpenAI's API accepts for a function.
+fn functionName(text: []const u8) bool {
+    if (text.len == 0 or text.len > 64) return false;
+    for (text) |ch| if (!(std.ascii.isAlphanumeric(ch) or ch == '_' or ch == '-')) return false;
+    return true;
+}
+
+/// Whether `text` is a JSON object (JSON holds no NaN or infinity, so it is finite).
+fn objectText(a: std.mem.Allocator, text: []const u8) bool {
+    var doc = std.json.parseFromSlice(std.json.Value, a, text, .{}) catch return false;
+    defer doc.deinit();
+    return doc.value == .object;
 }
 
